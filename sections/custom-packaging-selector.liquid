<script>
  window.packSelector = (function () {
    var state = { option: null, frequency: null, tier: null };

    var pricingData = null;
    {%- if product != blank -%}
      (function () {
        var script = document.getElementById('pack-selector-pricing-{{ section.id }}');
        if (script) {
          try {
            pricingData = JSON.parse(script.textContent);
          } catch (e) {
            pricingData = null;
          }
        }
      })();
    {%- endif -%}

    function optionButtons() {
      return document.querySelectorAll('.pack-option');
    }

    function setOrRemoveSpan(row, className, text, insertBeforeEl) {
      var el = row.querySelector('.' + className);
      if (text) {
        if (!el) {
          el = document.createElement('span');
          el.className = className;
          if (insertBeforeEl) {
            row.insertBefore(el, insertBeforeEl);
          } else {
            row.appendChild(el);
          }
        }
        el.textContent = text;
      } else if (el) {
        el.remove();
      }
    }

    function updateTierPricing(tierEl, data) {
      var priceRow = tierEl.querySelector('.pack-tier__price-row');
      if (!priceRow) return;
      var currentEl = priceRow.querySelector('.pack-tier__price-current');
      setOrRemoveSpan(priceRow, 'pack-tier__price-original', data.compareAtPrice, currentEl);
      if (currentEl) currentEl.textContent = data.price;
      setOrRemoveSpan(priceRow, 'pack-tier__badge', data.save, null);
    }

    function updatePricesForVariant(variantId) {
      if (!pricingData) return;

      var onetimePrice = document.querySelector('.pack-onetime__price');
      if (onetimePrice && pricingData.onetime && pricingData.onetime[variantId] !== undefined) {
        onetimePrice.textContent = pricingData.onetime[variantId];
      }

      if (!pricingData.subscriptions || !pricingData.subscriptions[variantId]) return;
      var variantPlans = pricingData.subscriptions[variantId];
      var tierEls = document.querySelectorAll('.pack-tier');
      var firstPlanId = null;

      tierEls.forEach(function (tierEl, i) {
        var planId = tierEl.getAttribute('data-tier');
        if (i === 0) firstPlanId = planId;
        var data = variantPlans[planId];
        if (data) updateTierPricing(tierEl, data);
      });

      if (firstPlanId && variantPlans[firstPlanId]) {
        var headerData = variantPlans[firstPlanId];
        var headerContainer = document.querySelector('.pack-subscribe__price');
        var headerCurrent = document.querySelector('.pack-subscribe__price-current');
        if (headerContainer) {
          setOrRemoveSpan(headerContainer, 'pack-subscribe__price-original', headerData.compareAtPrice, headerCurrent);
        }
        if (headerCurrent) headerCurrent.textContent = headerData.price;
      }
    }

    function selectOption(index) {
      optionButtons().forEach(function (btn) {
        btn.setAttribute('aria-checked', btn.getAttribute('data-index') === index ? 'true' : 'false');
      });
      state.option = index;
      updateVariant();
      updatePricesForVariant(index);
    }

    function selectFrequency(frequency) {
      var subscribe = document.querySelector('.pack-subscribe');
      var onetime = document.querySelector('.pack-onetime');
      if (subscribe) subscribe.setAttribute('aria-checked', frequency === 'subscribe' ? 'true' : 'false');
      if (onetime) onetime.setAttribute('aria-checked', frequency === 'onetime' ? 'true' : 'false');

      state.frequency = frequency;

      if (frequency === 'subscribe' && !state.tier) {
        var firstTier = document.querySelector('.pack-tier');
        if (firstTier) selectTier(firstTier.getAttribute('data-tier'));
      }
      updateVariant();
    }

    function selectTier(tier) {
      document.querySelectorAll('.pack-tier').forEach(function (el) {
        el.setAttribute('aria-checked', el.getAttribute('data-tier') === tier ? 'true' : 'false');
      });
      state.tier = tier;
      selectFrequency('subscribe');
    }

    function selectMedia(index) {
      document.querySelectorAll('.pack-media__mainItem').forEach(function (el) {
        el.classList.toggle('is-active', el.getAttribute('data-media-index') === index);
      });
      document.querySelectorAll('.pack-media__thumb').forEach(function (el) {
        el.classList.toggle('is-active', el.getAttribute('data-media-index') === index);
      });
    }

    function changeQty(delta) {
      var input = document.getElementById('pack-qty-input');
      if (!input) return;
      var next = (parseInt(input.value, 10) || 1) + delta;
      if (next < 1) next = 1;
      input.value = next;
    }

    function updateVariant() {
      var variantInput = document.getElementById('selected-variant-id');
      var sellingPlanInput = document.getElementById('selected-selling-plan');
      var selectedOption = document.querySelector('.pack-option[aria-checked="true"]');

      if (variantInput) {
        variantInput.value = selectedOption ? selectedOption.getAttribute('data-variant-id') : '';
      }
      if (sellingPlanInput) {
        if (state.frequency === 'subscribe' && state.tier) {
          var tierEl = document.querySelector('.pack-tier[data-tier="' + state.tier + '"]');
          sellingPlanInput.value = tierEl ? (tierEl.getAttribute('data-selling-plan') || '') : '';
        } else {
          sellingPlanInput.value = '';
        }
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      var firstOption = document.querySelector('.pack-option');
      if (firstOption) selectOption(firstOption.getAttribute('data-index'));
      selectFrequency('subscribe');
    });

    return {
      selectOption: selectOption,
      selectFrequency: selectFrequency,
      selectTier: selectTier,
      selectMedia: selectMedia,
      changeQty: changeQty
    };
  })();
</script>

