          </svg>
        {%- endif -%}
        {%- if qty_shape_desktop == 'custom' -%}
          <span class="pack-qty__shape pack-qty__shape--desktop" aria-hidden="true"></span>
        {%- endif -%}
        {%- if qty_shape_mobile == 'custom' -%}
          <span class="pack-qty__shape pack-qty__shape--mobile" aria-hidden="true"></span>
        {%- endif -%}
        {%- comment -%}
          shape-defs also publishes each silhouette as `#outline-<id>`, a stroked
          path carrying vector-effect="non-scaling-stroke", so stretching the
          1:1 viewBox across the bar keeps the outline an even 2px.
        {%- endcomment -%}
        {%- if qty_shape_clip_desktop != blank -%}
          <svg class="pack-qty__frame pack-qty__frame--shaped-desktop" viewBox="0 0 200 200" preserveAspectRatio="none" fill="none" aria-hidden="true">
            <use href="#outline-{{ qty_shape_id_desktop }}" fill="none" stroke="currentColor" stroke-width="2"/>
          </svg>
        {%- endif -%}
        {%- if qty_shape_clip_mobile != blank -%}
          <svg class="pack-qty__frame pack-qty__frame--shaped-mobile" viewBox="0 0 200 200" preserveAspectRatio="none" fill="none" aria-hidden="true">
            <use href="#outline-{{ qty_shape_id_mobile }}" fill="none" stroke="currentColor" stroke-width="2"/>
          </svg>
        {%- endif -%}
        <span class="pack-qty__label caption">{{ section.settings.qty_label }}</span>
        <button type="button" class="pack-qty__btn" aria-label="{{ 'products.product.quantity.decrease_html' | t: product: '' | default: 'Decrease quantity' | escape }}" onclick="packSelector.changeQty(-1)">&minus;</button>
        <input type="number" name="quantity" id="pack-qty-input" class="pack-qty__input" value="{{ section.settings.qty_default | default: 1 }}" min="1" inputmode="numeric">
        <button type="button" class="pack-qty__btn" aria-label="{{ 'products.product.quantity.increase_html' | t: product: '' | default: 'Increase quantity' | escape }}" onclick="packSelector.changeQty(1)">+</button>
      </div>

      <button type="submit" class="btn-primary pack-selector__submit">
        {{ section.settings.button_label }}
      </button>
    </form>

    {%- comment -%} Ingredients / Nutrition / Shipping accordion {%- endcomment -%}
    {%- liquid
      assign nutrition_has_content = false
      if section.settings.nutrition_content_type == 'image'
        if section.settings.nutrition_image != blank
          assign nutrition_has_content = true
        endif
      elsif section.settings.nutrition_content != blank
        assign nutrition_has_content = true
      endif
    -%}
    {%- if section.settings.ingredients_content != blank or nutrition_has_content or section.settings.shipping_content != blank -%}
      <div class="pack-accordion">
        {%- if section.settings.ingredients_content != blank -%}
          <details class="pack-accordion__item">
            <summary class="pack-accordion__summary">
              <span class="pack-accordion__label h3">{{ section.settings.ingredients_label }}</span>
              <svg class="pack-accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 4L7 10L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="pack-accordion__panel body-large">{{ section.settings.ingredients_content }}</div>
          </details>
        {%- endif -%}
        {%- if nutrition_has_content -%}
          <details class="pack-accordion__item">
            <summary class="pack-accordion__summary">
              <span class="pack-accordion__label h3">{{ section.settings.nutrition_label }}</span>
              <svg class="pack-accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 4L7 10L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="pack-accordion__panel{% if section.settings.nutrition_content_type != 'image' %} body-large{% endif %}">
              {%- if section.settings.nutrition_content_type == 'image' -%}
                <img
                  src="{{ section.settings.nutrition_image | image_url: width: 800 }}"
                  alt="{{ section.settings.nutrition_image.alt | default: section.settings.nutrition_label | escape }}"
                  width="{{ section.settings.nutrition_image.width }}"
                  height="{{ section.settings.nutrition_image.height }}"
                  loading="lazy"
                  class="pack-accordion__image"
                >
              {%- else -%}
                {{ section.settings.nutrition_content }}
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}
        {%- if section.settings.shipping_content != blank -%}
          <details class="pack-accordion__item">
            <summary class="pack-accordion__summary">
              <span class="pack-accordion__label h3">{{ section.settings.shipping_label }}</span>
              <svg class="pack-accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 4L7 10L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="pack-accordion__panel body-large">{{ section.settings.shipping_content }}</div>
          </details>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  </div>
</div>

{%- if product != blank -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <script type="application/json" id="pack-selector-pricing-{{ section.id }}">
    {
      "onetime": {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {{ variant.price | money | strip_html | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }{%- if has_selling_plans -%},
      "subscriptions": {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {
            {%- for allocation in variant.selling_plan_allocations -%}
              {%- assign tier_save = '' -%}
              {%- if allocation.compare_at_price > allocation.price -%}
                {%- assign tier_discount = allocation.compare_at_price | minus: allocation.price -%}
                {%- assign tier_save_percent = tier_discount | times: 100.0 | divided_by: allocation.compare_at_price | round -%}
                {%- assign tier_save = 'Save ' | append: tier_save_percent | append: '%' -%}
              {%- endif -%}
              "{{ allocation.selling_plan.id }}": {
                "price": {{ allocation.price | money | strip_html | json }},
                "compareAtPrice": {% if allocation.compare_at_price > allocation.price %}{{ allocation.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
                "save": {% if tier_save != blank %}{{ tier_save | json }}{% else %}null{% endif %}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
      {%- endif -%}
    }
  </script>
{%- endif -%}

<style>
  .pack-selector {
    padding: var(--space-6) var(--space-4);
    font-family: var(--font-body);
    max-width: 100%;
    overflow-x: hidden;
  }
  .pack-selector__layout {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    min-width: 0;
  }
  @media (min-width: 769px) {
    .pack-selector__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
  .pack-selector__inner {
    max-width: 480px;
    margin: 0 auto;
    width: 100%;
    min-width: 0;
  }
  @media (min-width: 769px) {
    .pack-selector__inner {
      max-width: 640px;
      margin: 0;
    }
  }

  /* Product media */
  .pack-media {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .pack-media__main {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-cream);
  }
  .pack-media__mainItem {
    display: none;
    position: absolute;
    inset: 0;
  }
  .pack-media__mainItem.is-active {
    display: block;
  }
  .pack-media__mainImg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pack-media__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: var(--color-cream);
    border: 2px solid var(--color-black);
    color: var(--color-near-black);
    cursor: pointer;
    transition: transform 0.15s ease-out;
  }
  .pack-media__nav:hover {
    transform: translateY(-50%) scale(1.05);
  }
  .pack-media__main[data-nav-shape="custom"] .pack-media__nav {
    background: transparent;
    background-image: var(--nav-shape);
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100% 100%;
    border: none;
  }
  /* Squared to 48px because the shapes are authored on a 1:1 viewBox — a 40px
     rectangle would stretch them — and 48px meets the minimum tap target. The
     border goes because a clip path slices it off mid-edge. */
  .pack-media__main[data-nav-shape="shaped"] .pack-media__nav {
    width: var(--space-12);
    height: var(--space-12);
    border: none;
    -webkit-clip-path: var(--nav-clip);
    clip-path: var(--nav-clip);
  }
  .pack-media__main[data-nav-shape="shaped"] .pack-media__nav:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
  }
  .pack-media__nav--prev {
    left: var(--space-3);
  }
  .pack-media__nav--next {
    right: var(--space-3);
  }
  .pack-media__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .pack-media__thumb {
    width: 64px;
    height: 64px;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    background: var(--color-cream);
    border: 2px solid var(--color-black);
    flex-shrink: 0;
  }
  .pack-media__thumb.is-active {
    border-color: var(--color-red);
  }
  .pack-media__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Custom shape for the product media. The clip cuts any border away, so the
     shaped thumbs drop their frame and show selection through opacity/scale. */
  .pack-selector[data-image-shape="shaped"] .pack-media__mainImg {
    clip-path: var(--pack-img-clip);
  }
  .pack-selector[data-image-shape="shaped"] .pack-media__main {
    background: transparent;
  }
  .pack-selector[data-image-shape="shaped"] .pack-media__thumb {
    background: transparent;
    border: none;
    overflow: visible;
    opacity: 0.55;
    transition: opacity 0.15s ease-out, transform 0.15s ease-out;
  }
  .pack-selector[data-image-shape="shaped"] .pack-media__thumb img {
    clip-path: var(--pack-img-clip);
  }
  .pack-selector[data-image-shape="shaped"] .pack-media__thumb:hover {
    opacity: 0.85;
  }
  /* The clip removes the border, so focus needs its own ring to stay visible. */
  .pack-selector[data-image-shape="shaped"] .pack-media__thumb:focus-visible {
    opacity: 1;
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
  }
  .pack-selector[data-image-shape="shaped"] .pack-media__thumb.is-active {
    opacity: 1;
    transform: scale(1.08);
  }

  /* Accordion */
  .pack-accordion {
    margin-top: var(--space-8);
    border-top: 2px solid var(--color-black);
  }
  .pack-accordion__item {
    border-bottom: 2px solid var(--color-black);
  }
  .pack-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    cursor: pointer;
    list-style: none;
  }
  .pack-accordion__summary::-webkit-details-marker {
    display: none;
  }
  .pack-accordion__label {
    margin: 0;
    color: rgb(var(--color-scheme-text));
    min-width: 0;
    overflow-wrap: break-word;
  }
  .pack-accordion__icon {
    flex-shrink: 0;
    color: rgb(var(--color-scheme-text));
    transition: transform 0.2s ease-out;
  }
  .pack-accordion__item[open] .pack-accordion__icon {
    transform: rotate(180deg);
  }
  .pack-accordion__panel {
    padding: 0 0 var(--space-4);
    color: rgb(var(--color-scheme-text));
  }
  .pack-accordion__image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }
  .pack-selector__heading {
    color: rgb(var(--color-scheme-text));
    margin: 0 0 var(--space-4);
  }

  /* Purchase options */
  .pack-selector__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .pack-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    background: var(--color-cream);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition: background 0.15s ease-out;
  }
  .pack-option__check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-black);
    background: var(--color-cream);
    position: relative;
  }
  .pack-option[aria-checked="true"] {
    background: var(--color-lime);
  }
  .pack-option[aria-checked="true"] .pack-option__check {
    background: var(--color-black);
  }
  .pack-option[aria-checked="true"] .pack-option__check::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid var(--color-cream);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .pack-option__label {
    color: var(--color-near-black);
  }

  /* Frequency block */
  .pack-frequency {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .pack-subscribe {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--color-cream);
    padding: var(--space-4);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    gap: var(--space-4);
