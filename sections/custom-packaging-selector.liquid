{%- liquid
  assign purchase_options = "1,2,3" | split: ","
  assign tiers = "1,2,3" | split: ","
-%}

<div
  class="pack-selector bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="pack-selector__inner">
    <p class="pack-selector__heading h3">
      {{ section.settings.title }}
    </p>

    {%- comment -%} Purchase options (pack size) {%- endcomment -%}
    <div class="pack-selector__options" role="radiogroup" aria-label="{{ section.settings.options_label | escape }}">
      {%- for i in purchase_options -%}
        {%- assign option_label = section.settings["option" | append: i | append: "_label"] -%}
        {%- if option_label != blank -%}
          <button
            type="button"
            class="pack-option"
            data-index="{{ i }}"
            data-variant-id="{{ section.settings["option" | append: i | append: "_variant_id"] }}"
            role="radio"
            aria-checked="false"
            onclick="packSelector.selectOption('{{ i }}')"
          >
            <span class="pack-option__check" aria-hidden="true"></span>
            <span class="pack-option__label">{{ option_label }}</span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Frequency / subscription {%- endcomment -%}
    <p class="pack-selector__subheading caption">{{ section.settings.frequency_label }}</p>

    <div class="pack-frequency">
      <button
        type="button"
        class="pack-subscribe"
        data-frequency="subscribe"
        role="radio"
        aria-checked="false"
        onclick="packSelector.selectFrequency('subscribe')"
      >
        <span class="pack-subscribe__header">
          <span class="pack-subscribe__title-row">
            <span class="pack-subscribe__check" aria-hidden="true"></span>
            <span class="pack-subscribe__title h3">{{ section.settings.subscribe_title }}</span>
          </span>
          <span class="pack-subscribe__price">
            {%- if section.settings.subscribe_price_original != blank -%}
              <span class="pack-subscribe__price-original">{{ section.settings.subscribe_price_original }}</span>
            {%- endif -%}
            <span class="pack-subscribe__price-current">{{ section.settings.subscribe_price_current }}</span>
          </span>
        </span>

        <span class="pack-subscribe__tiers">
          {%- for i in tiers -%}
            {%- assign tier_title = section.settings["tier" | append: i | append: "_title"] -%}
            {%- if tier_title != blank -%}
              {%- assign tier_subtitle = section.settings["tier" | append: i | append: "_subtitle"] -%}
              {%- assign tier_price_original = section.settings["tier" | append: i | append: "_price_original"] -%}
              {%- assign tier_price_current = section.settings["tier" | append: i | append: "_price_current"] -%}
              {%- assign tier_price_unit = section.settings["tier" | append: i | append: "_price_unit"] -%}
              {%- assign tier_save = section.settings["tier" | append: i | append: "_save_badge"] -%}
              {%- assign tier_selling_plan = section.settings["tier" | append: i | append: "_selling_plan_id"] -%}
              <span
                class="pack-tier"
                data-tier="{{ i }}"
                data-selling-plan="{{ tier_selling_plan }}"
                role="radio"
                aria-checked="false"
                tabindex="0"
                onclick="event.stopPropagation(); packSelector.selectTier('{{ i }}')"
                onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();event.stopPropagation();packSelector.selectTier('{{ i }}');}"
              >
                <span class="pack-tier__info">
                  <span class="pack-tier__title">{{ tier_title }}</span>
                  {%- if tier_subtitle != blank -%}
                    <span class="pack-tier__subtitle caption">{{ tier_subtitle }}</span>
                  {%- endif -%}
                </span>
                <span class="pack-tier__pricing">
                  <span class="pack-tier__price-row">
                    {%- if tier_price_original != blank -%}
                      <span class="pack-tier__price-original">{{ tier_price_original }}</span>
                    {%- endif -%}
                    <span class="pack-tier__price-current">{{ tier_price_current }}</span>
                    {%- if tier_save != blank -%}
                      <span class="pack-tier__badge">{{ tier_save }}</span>
                    {%- endif -%}
                  </span>
                  {%- if tier_price_unit != blank -%}
                    <span class="pack-tier__price-unit caption">{{ tier_price_unit }}</span>
                  {%- endif -%}
                </span>
              </span>
            {%- endif -%}
          {%- endfor -%}
        </span>

        {%- if section.settings.benefit1_text != blank or section.settings.benefit2_text != blank or section.settings.benefit3_text != blank -%}
          <span class="pack-subscribe__benefits">
            {%- for benefit in (1..3) -%}
              {%- assign benefit_text = section.settings["benefit" | append: benefit | append: "_text"] -%}
              {%- if benefit_text != blank -%}
                <span class="pack-subscribe__benefit">
                  <svg class="pack-subscribe__benefit-icon" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.4 4.6L12 6L7.4 7.4L6 12L4.6 7.4L0 6L4.6 4.6Z" fill="currentColor"/></svg>
                  {{ benefit_text }}
                </span>
              {%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
      </button>

      <button
        type="button"
        class="pack-onetime"
        data-frequency="onetime"
        role="radio"
        aria-checked="false"
        onclick="packSelector.selectFrequency('onetime')"
      >
        <span class="pack-onetime__row">
          <span class="pack-onetime__title-row">
            <span class="pack-onetime__check" aria-hidden="true"></span>
            <span class="pack-onetime__title h3">{{ section.settings.onetime_title }}</span>
          </span>
          <span class="pack-onetime__price">{{ section.settings.onetime_price }}</span>
        </span>
        {%- if section.settings.onetime_caption != blank -%}
          <span class="pack-onetime__caption caption">{{ section.settings.onetime_caption }}</span>
        {%- endif -%}
      </button>
    </div>

    {%- comment -%} Quantity + Add to cart {%- endcomment -%}
    <form action="/cart/add" method="post" class="pack-selector__form">
      <input type="hidden" name="id" id="selected-variant-id" value="">
      <input type="hidden" name="selling_plan" id="selected-selling-plan" value="">

      <div class="pack-qty">
        <span class="pack-qty__label caption">{{ section.settings.qty_label }}</span>
        <button type="button" class="pack-qty__btn" aria-label="{{ 'products.product.quantity.decrease_html' | t: product: '' | default: 'Decrease quantity' | escape }}" onclick="packSelector.changeQty(-1)">&minus;</button>
        <input type="number" name="quantity" id="pack-qty-input" class="pack-qty__input" value="{{ section.settings.qty_default | default: 1 }}" min="1" inputmode="numeric">
        <button type="button" class="pack-qty__btn" aria-label="{{ 'products.product.quantity.increase_html' | t: product: '' | default: 'Increase quantity' | escape }}" onclick="packSelector.changeQty(1)">+</button>
      </div>

      <button type="submit" class="btn-primary pack-selector__submit">
        {{ section.settings.button_label }}
      </button>
    </form>
  </div>
</div>

<style>
  .pack-selector {
    padding: var(--space-6) var(--space-4);
    font-family: var(--font-body);
  }
  .pack-selector__inner {
    max-width: 480px;
    margin: 0 auto;
  }
  @media (min-width: 769px) {
    .pack-selector__inner {
      max-width: 640px;
    }
  }
  .pack-selector__heading {
    color: var(--color-near-black);
    margin: 0 0 var(--space-4);
  }
  .pack-selector__subheading {
    color: var(--color-near-black);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-2);
  }

  /* Purchase options */
  .pack-selector__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .pack-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    background: var(--color-cream);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition: background 0.15s ease-out;
  }
  .pack-option__check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-black);
    border-radius: 4px;
    background: var(--color-cream);
    position: relative;
  }
  .pack-option[aria-checked="true"] {
    background: var(--color-lime);
  }
  .pack-option[aria-checked="true"] .pack-option__check {
    background: var(--color-black);
  }
  .pack-option[aria-checked="true"] .pack-option__check::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid var(--color-cream);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .pack-option__label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    color: var(--color-near-black);
    text-transform: uppercase;
  }

  /* Frequency block */
  .pack-frequency {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .pack-subscribe {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--color-yellow);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    gap: var(--space-4);
  }
  .pack-subscribe__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .pack-subscribe__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .pack-subscribe__check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-black);
    border-radius: 4px;
    background: var(--color-cream);
    position: relative;
  }
  .pack-subscribe[aria-checked="true"] .pack-subscribe__check {
    background: var(--color-black);
  }
  .pack-subscribe[aria-checked="true"] .pack-subscribe__check::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid var(--color-cream);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .pack-subscribe__title {
    margin: 0;
    color: var(--color-near-black);
  }
  .pack-subscribe__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 700;
  }
  .pack-subscribe__price-original {
    color: var(--color-mid-grey);
    text-decoration: line-through;
    font-size: 16px;
  }
  .pack-subscribe__price-current {
    color: var(--color-near-black);
    font-size: 20px;
  }

  .pack-subscribe__tiers {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .pack-tier {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    background: var(--color-yellow);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    transition: background 0.15s ease-out;
  }
  .pack-tier[aria-checked="true"] {
    background: var(--color-cream);
  }
  .pack-tier__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pack-tier__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    color: var(--color-near-black);
    text-transform: uppercase;
  }
  .pack-tier__subtitle {
    color: var(--color-near-black);
  }
  .pack-tier__pricing {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }
  .pack-tier__price-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .pack-tier__price-original {
    color: var(--color-mid-grey);
    text-decoration: line-through;
    font-family: var(--font-heading);
    font-size: 13px;
  }
  .pack-tier__price-current {
    color: var(--color-near-black);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
  }
  .pack-tier__badge {
    background: var(--color-pink);
    color: var(--color-black);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11px;
    padding: 2px 10px;
    border-radius: var(--radius-btn);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pack-tier__price-unit {
    color: var(--color-near-black);
  }

  .pack-subscribe__benefits {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .pack-subscribe__benefit {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 14px;
    color: var(--color-near-black);
  }
  .pack-subscribe__benefit-icon {
    flex-shrink: 0;
    color: var(--color-red);
  }

  .pack-onetime {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    background: var(--color-cream);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
  }
  .pack-onetime[aria-checked="true"] {
    background: var(--color-lime);
  }
  .pack-onetime__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .pack-onetime__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .pack-onetime__check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-black);
    border-radius: 4px;
    background: var(--color-cream);
    position: relative;
  }
  .pack-onetime[aria-checked="true"] .pack-onetime__check {
    background: var(--color-black);
  }
  .pack-onetime[aria-checked="true"] .pack-onetime__check::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid var(--color-cream);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .pack-onetime__title {
    margin: 0;
    color: var(--color-near-black);
  }
  .pack-onetime__price {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-near-black);
  }
  .pack-onetime__caption {
    color: var(--color-red);
    padding-left: calc(20px + var(--space-3));
  }

  /* Qty + submit */
  .pack-selector__form {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .pack-qty {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    border: 2px dashed var(--color-black);
    border-radius: var(--radius-btn);
    padding: var(--space-2) var(--space-3);
  }
  .pack-qty__label {
    color: var(--color-near-black);
    text-transform: uppercase;
    margin-right: var(--space-1);
  }
  .pack-qty__btn {
    width: 32px;
    height: 32px;
    min-width: 48px;
    min-height: 32px;
    border: none;
    background: transparent;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-near-black);
    cursor: pointer;
    line-height: 1;
  }
  .pack-qty__input {
    width: 32px;
    border: none;
    background: transparent;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: var(--color-near-black);
    -moz-appearance: textfield;
  }
  .pack-qty__input::-webkit-outer-spin-button,
  .pack-qty__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pack-selector__submit {
    flex: 1 1 auto;
    min-width: 200px;
  }

  @media (max-width: 480px) {
    .pack-selector__form {
      flex-direction: column;
      align-items: stretch;
    }
    .pack-qty {
      justify-content: center;
    }
  }
</style>

<script>
  window.packSelector = (function () {
    var state = { option: null, frequency: null, tier: null };

    function optionButtons() {
      return document.querySelectorAll('.pack-option');
    }

    function selectOption(index) {
      optionButtons().forEach(function (btn) {
        btn.setAttribute('aria-checked', btn.getAttribute('data-index') === index ? 'true' : 'false');
      });
      state.option = index;
      updateVariant();
    }

    function selectFrequency(frequency) {
      var subscribe = document.querySelector('.pack-subscribe');
      var onetime = document.querySelector('.pack-onetime');
      if (subscribe) subscribe.setAttribute('aria-checked', frequency === 'subscribe' ? 'true' : 'false');
      if (onetime) onetime.setAttribute('aria-checked', frequency === 'onetime' ? 'true' : 'false');

      state.frequency = frequency;

      if (frequency === 'subscribe' && !state.tier) {
        var firstTier = document.querySelector('.pack-tier');
        if (firstTier) selectTier(firstTier.getAttribute('data-tier'));
      }
      updateVariant();
    }

    function selectTier(tier) {
      document.querySelectorAll('.pack-tier').forEach(function (el) {
        el.setAttribute('aria-checked', el.getAttribute('data-tier') === tier ? 'true' : 'false');
      });
      state.tier = tier;
      selectFrequency('subscribe');
    }

    function changeQty(delta) {
      var input = document.getElementById('pack-qty-input');
      if (!input) return;
      var next = (parseInt(input.value, 10) || 1) + delta;
      if (next < 1) next = 1;
      input.value = next;
    }

    function updateVariant() {
      var variantInput = document.getElementById('selected-variant-id');
      var sellingPlanInput = document.getElementById('selected-selling-plan');
      var selectedOption = document.querySelector('.pack-option[aria-checked="true"]');

      if (variantInput) {
        variantInput.value = selectedOption ? selectedOption.getAttribute('data-variant-id') : '';
      }
      if (sellingPlanInput) {
        if (state.frequency === 'subscribe' && state.tier) {
          var tierEl = document.querySelector('.pack-tier[data-tier="' + state.tier + '"]');
          sellingPlanInput.value = tierEl ? (tierEl.getAttribute('data-selling-plan') || '') : '';
        } else {
          sellingPlanInput.value = '';
        }
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      var firstOption = document.querySelector('.pack-option');
      if (firstOption) selectOption(firstOption.getAttribute('data-index'));
      selectFrequency('subscribe');
    });

    return {
      selectOption: selectOption,
      selectFrequency: selectFrequency,
      selectTier: selectTier,
      changeQty: changeQty
    };
  })();
</script>

{% schema %}
{
  "name": "Custom Packaging Selector",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "WÄHL DEINE MENGE" },

    { "type": "header", "content": "Purchase Options" },
    { "type": "text", "id": "options_label", "label": "Options group label (accessibility)", "default": "Purchase options" },
    { "type": "text", "id": "option1_label", "label": "Option 1 Label", "default": "6ER PACK" },
    { "type": "text", "id": "option1_variant_id", "label": "Option 1 Variant ID" },
    { "type": "text", "id": "option2_label", "label": "Option 2 Label", "default": "9ER PACK" },
    { "type": "text", "id": "option2_variant_id", "label": "Option 2 Variant ID" },
    { "type": "text", "id": "option3_label", "label": "Option 3 Label (leave empty for none)" },
    { "type": "text", "id": "option3_variant_id", "label": "Option 3 Variant ID" },

    { "type": "header", "content": "Frequency" },
    { "type": "text", "id": "frequency_label", "label": "Frequency Label", "default": "WÄHLE DEIN ABO" },

    { "type": "text", "id": "subscribe_title", "label": "Subscribe Title", "default": "ABO & SPAREN" },
    { "type": "text", "id": "subscribe_price_original", "label": "Subscribe Original Price (strikethrough)", "default": "CHF 37.90" },
    { "type": "text", "id": "subscribe_price_current", "label": "Subscribe Current Price", "default": "CHF 32.20" },

    { "type": "text", "id": "tier1_title", "label": "Tier 1 Title", "default": "GELEGENTLICHER SNACKER" },
    { "type": "text", "id": "tier1_subtitle", "label": "Tier 1 Subtitle", "default": "Lieferung alle 8 Wochen" },
    { "type": "text", "id": "tier1_price_original", "label": "Tier 1 Original Price", "default": "CHF 37.90" },
    { "type": "text", "id": "tier1_price_current", "label": "Tier 1 Current Price", "default": "CHF 36.00" },
    { "type": "text", "id": "tier1_price_unit", "label": "Tier 1 Per-unit Price", "default": "CHF 3.00/Pack" },
    { "type": "text", "id": "tier1_save_badge", "label": "Tier 1 Save Badge", "default": "SPAR 5%" },
    { "type": "text", "id": "tier1_selling_plan_id", "label": "Tier 1 Selling Plan ID" },

    { "type": "text", "id": "tier2_title", "label": "Tier 2 Title", "default": "ÜBERZEUGTER SNACKER" },
    { "type": "text", "id": "tier2_subtitle", "label": "Tier 2 Subtitle", "default": "Lieferung alle 4 Wochen" },
    { "type": "text", "id": "tier2_price_original", "label": "Tier 2 Original Price", "default": "CHF 37.90" },
    { "type": "text", "id": "tier2_price_current", "label": "Tier 2 Current Price", "default": "CHF 32.20" },
    { "type": "text", "id": "tier2_price_unit", "label": "Tier 2 Per-unit Price", "default": "CHF 2.68/Pack" },
    { "type": "text", "id": "tier2_save_badge", "label": "Tier 2 Save Badge", "default": "SPAR 15%" },
    { "type": "text", "id": "tier2_selling_plan_id", "label": "Tier 2 Selling Plan ID" },

    { "type": "text", "id": "tier3_title", "label": "Tier 3 Title", "default": "VOLL DABEI SNACKER" },
    { "type": "text", "id": "tier3_subtitle", "label": "Tier 3 Subtitle", "default": "Lieferung alle 2 Wochen" },
    { "type": "text", "id": "tier3_price_original", "label": "Tier 3 Original Price", "default": "CHF 37.90" },
