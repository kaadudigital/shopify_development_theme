            </mask>
            <path d="M44.521 5.209a8.256 8.256 0 0 1 2.935-3.69 8.43 8.43 0 0 1 9.103-.352 8.28 8.28 0 0 1 3.218 3.452 8.28 8.28 0 0 1 3.218-3.45 8.43 8.43 0 0 1 9.102.351 8.257 8.257 0 0 1 2.933 3.69 8.256 8.256 0 0 1 2.935-3.69 8.43 8.43 0 0 1 9.103-.352 8.28 8.28 0 0 1 3.218 3.452 8.265 8.265 0 0 1 2.932-3.277A8.427 8.427 0 0 1 101.752 1a8.295 8.295 0 0 1 3.192 3.031A8.302 8.302 0 0 1 108.14.998a8.43 8.43 0 0 1 8.537.344 8.275 8.275 0 0 1 2.934 3.277A8.299 8.299 0 0 1 123.524.8a8.447 8.447 0 0 1 5.472-.584 8.359 8.359 0 0 1 4.65 2.904 8.17 8.17 0 0 1 1.809 5.132c0 .07-.007.144-.007.215a8.39 8.39 0 0 1 3.157-1.542 8.456 8.456 0 0 1 3.52-.12 8.407 8.407 0 0 1 3.257 1.322 8.284 8.284 0 0 1 2.415 2.531 8.138 8.138 0 0 1 .812 6.75 8.216 8.216 0 0 1-1.748 3.02 8.344 8.344 0 0 1-2.853 2.04 8.319 8.319 0 0 1 3.728 3.184 8.158 8.158 0 0 1-.397 9.29 8.336 8.336 0 0 1-3.986 2.864 8.337 8.337 0 0 1 3.986 2.864 8.158 8.158 0 0 1 .397 9.29 8.318 8.318 0 0 1-3.728 3.185 8.35 8.35 0 0 1 2.876 2.06 8.214 8.214 0 0 1 1.748 3.054 8.142 8.142 0 0 1-.893 6.798 8.294 8.294 0 0 1-2.479 2.513 8.453 8.453 0 0 1-6.86 1.06 8.388 8.388 0 0 1-3.139-1.644 8.175 8.175 0 0 1-1.613 6.904 8.357 8.357 0 0 1-4.651 2.906 8.443 8.443 0 0 1-5.473-.585 8.295 8.295 0 0 1-3.913-3.823 8.265 8.265 0 0 1-2.932 3.282 8.427 8.427 0 0 1-8.541.343 8.291 8.291 0 0 1-3.193-3.036 8.28 8.28 0 0 1-3.191 3.036 8.42 8.42 0 0 1-8.537-.343 8.259 8.259 0 0 1-2.93-3.282 8.27 8.27 0 0 1-3.215 3.46 8.421 8.421 0 0 1-9.11-.352 8.247 8.247 0 0 1-2.93-3.699 8.248 8.248 0 0 1-2.931 3.698 8.421 8.421 0 0 1-9.11.353 8.272 8.272 0 0 1-3.214-3.46 8.27 8.27 0 0 1-3.215 3.46 8.421 8.421 0 0 1-9.11-.352 8.247 8.247 0 0 1-2.93-3.699 8.248 8.248 0 0 1-2.931 3.699 8.422 8.422 0 0 1-9.11.353 8.272 8.272 0 0 1-3.215-3.461 8.299 8.299 0 0 1-3.915 3.823 8.449 8.449 0 0 1-5.475.587 8.364 8.364 0 0 1-4.654-2.906 8.177 8.177 0 0 1-1.809-5.135c.003-.552.06-1.102.17-1.643a8.391 8.391 0 0 1-3.154 1.56 8.456 8.456 0 0 1-3.524.136 8.41 8.41 0 0 1-3.266-1.313 8.29 8.29 0 0 1-2.426-2.527 8.142 8.142 0 0 1-.826-6.757 8.217 8.217 0 0 1 1.747-3.025 8.347 8.347 0 0 1 2.856-2.043 8.316 8.316 0 0 1-3.726-3.184 8.159 8.159 0 0 1 .395-9.29 8.34 8.34 0 0 1 3.985-2.865 8.34 8.34 0 0 1-3.985-2.864 8.158 8.158 0 0 1-.396-9.29 8.315 8.315 0 0 1 3.727-3.185 8.346 8.346 0 0 1-2.833-2.026 8.218 8.218 0 0 1-1.744-2.994 8.144 8.144 0 0 1 .76-6.713 8.285 8.285 0 0 1 2.37-2.54 8.407 8.407 0 0 1 3.216-1.358 8.456 8.456 0 0 1 3.498.061 8.398 8.398 0 0 1 3.166 1.47c0-.04-.007-.08-.007-.12a8.18 8.18 0 0 1 1.813-5.13A8.367 8.367 0 0 1 19.88.213a8.452 8.452 0 0 1 5.471.584 8.302 8.302 0 0 1 3.916 3.818 8.28 8.28 0 0 1 3.218-3.452 8.43 8.43 0 0 1 9.103.351 8.256 8.256 0 0 1 2.935 3.69l-.003.005Z" stroke="currentColor" stroke-width="2" mask="url(#pack-qty-cloud-mask-{{ section.id }})"/>
          </svg>
        {%- endif -%}
        <span class="pack-qty__label caption">{{ section.settings.qty_label }}</span>
        <button type="button" class="pack-qty__btn" aria-label="{{ 'products.product.quantity.decrease_html' | t: product: '' | default: 'Decrease quantity' | escape }}" onclick="packSelector.changeQty(-1)">&minus;</button>
        <input type="number" name="quantity" id="pack-qty-input" class="pack-qty__input" value="{{ section.settings.qty_default | default: 1 }}" min="1" inputmode="numeric">
        <button type="button" class="pack-qty__btn" aria-label="{{ 'products.product.quantity.increase_html' | t: product: '' | default: 'Increase quantity' | escape }}" onclick="packSelector.changeQty(1)">+</button>
      </div>

      <button type="submit" class="btn-primary pack-selector__submit">
        {{ section.settings.button_label }}
      </button>
    </form>

    {%- comment -%} Ingredients / Nutrition / Shipping accordion {%- endcomment -%}
    {%- liquid
      assign nutrition_has_content = false
      if section.settings.nutrition_content_type == 'image'
        if section.settings.nutrition_image != blank
          assign nutrition_has_content = true
        endif
      elsif section.settings.nutrition_content != blank
        assign nutrition_has_content = true
      endif
    -%}
    {%- if section.settings.ingredients_content != blank or nutrition_has_content or section.settings.shipping_content != blank -%}
      <div class="pack-accordion">
        {%- if section.settings.ingredients_content != blank -%}
          <details class="pack-accordion__item">
            <summary class="pack-accordion__summary">
              <span class="pack-accordion__label h3">{{ section.settings.ingredients_label }}</span>
              <svg class="pack-accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 4L7 10L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="pack-accordion__panel body-large">{{ section.settings.ingredients_content }}</div>
          </details>
        {%- endif -%}
        {%- if nutrition_has_content -%}
          <details class="pack-accordion__item">
            <summary class="pack-accordion__summary">
              <span class="pack-accordion__label h3">{{ section.settings.nutrition_label }}</span>
              <svg class="pack-accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 4L7 10L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="pack-accordion__panel{% if section.settings.nutrition_content_type != 'image' %} body-large{% endif %}">
              {%- if section.settings.nutrition_content_type == 'image' -%}
                <img
                  src="{{ section.settings.nutrition_image | image_url: width: 800 }}"
                  alt="{{ section.settings.nutrition_image.alt | default: section.settings.nutrition_label | escape }}"
                  width="{{ section.settings.nutrition_image.width }}"
                  height="{{ section.settings.nutrition_image.height }}"
                  loading="lazy"
                  class="pack-accordion__image"
                >
              {%- else -%}
                {{ section.settings.nutrition_content }}
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}
        {%- if section.settings.shipping_content != blank -%}
          <details class="pack-accordion__item">
            <summary class="pack-accordion__summary">
              <span class="pack-accordion__label h3">{{ section.settings.shipping_label }}</span>
              <svg class="pack-accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 4L7 10L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="pack-accordion__panel body-large">{{ section.settings.shipping_content }}</div>
          </details>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  </div>
</div>

{%- if product != blank -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <script type="application/json" id="pack-selector-pricing-{{ section.id }}">
    {
      "onetime": {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {{ variant.price | money | strip_html | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }{%- if has_selling_plans -%},
      "subscriptions": {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {
            {%- for allocation in variant.selling_plan_allocations -%}
              {%- assign tier_save = '' -%}
              {%- if allocation.compare_at_price > allocation.price -%}
                {%- assign tier_discount = allocation.compare_at_price | minus: allocation.price -%}
                {%- assign tier_save_percent = tier_discount | times: 100.0 | divided_by: allocation.compare_at_price | round -%}
                {%- assign tier_save = 'Save ' | append: tier_save_percent | append: '%' -%}
              {%- endif -%}
              "{{ allocation.selling_plan.id }}": {
                "price": {{ allocation.price | money | strip_html | json }},
                "compareAtPrice": {% if allocation.compare_at_price > allocation.price %}{{ allocation.compare_at_price | money | strip_html | json }}{% else %}null{% endif %},
                "save": {% if tier_save != blank %}{{ tier_save | json }}{% else %}null{% endif %}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
      {%- endif -%}
    }
  </script>
{%- endif -%}

