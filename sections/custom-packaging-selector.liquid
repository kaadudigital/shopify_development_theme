{%- liquid
  assign purchase_options = "1,2,3" | split: ","
  assign tiers = "1,2,3" | split: ","
  assign media_indexes = "1,2,3,4,5,6" | split: ","
-%}

<div
  class="pack-selector bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="pack-selector__layout">

    {%- comment -%} Product media / gallery {%- endcomment -%}
    <div class="pack-media">
      <div class="pack-media__main">
        {%- for i in media_indexes -%}
          {%- assign media_key = "gallery_image_" | append: i -%}
          {%- assign media_image = section.settings[media_key] -%}
          {%- if media_image != blank -%}
            <div class="pack-media__mainItem{% if forloop.first %} is-active{% endif %}" data-media-index="{{ i }}">
              <picture>
                <source srcset="{{ media_image | image_url: width: 1200, format: 'webp' }}" type="image/webp">
                <img
                  src="{{ media_image | image_url: width: 1200 }}"
                  alt="{{ media_image.alt | default: section.settings.title | escape }}"
                  width="{{ media_image.width }}"
                  height="{{ media_image.height }}"
                  class="pack-media__mainImg"
                  {%- if forloop.first and section.index == 1 -%}
                    loading="eager" fetchpriority="high"
                  {%- else -%}
                    loading="lazy"
                  {%- endif -%}
                >
              </picture>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="pack-media__thumbs">
        {%- for i in media_indexes -%}
          {%- assign media_key = "gallery_image_" | append: i -%}
          {%- assign media_image = section.settings[media_key] -%}
          {%- if media_image != blank -%}
            <button
              type="button"
              class="pack-media__thumb{% if forloop.first %} is-active{% endif %}"
              data-media-index="{{ i }}"
              aria-label="{{ section.settings.title | escape }} — {{ 'Image' }} {{ forloop.index }}"
              onclick="packSelector.selectMedia('{{ i }}')"
            >
              <img src="{{ media_image | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy">
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  <div class="pack-selector__inner">
    <p class="pack-selector__heading h3">
      {{ section.settings.title }}
    </p>

    {%- comment -%} Purchase options (pack size) {%- endcomment -%}
    <div class="pack-selector__options" role="radiogroup" aria-label="{{ section.settings.options_label | escape }}">
      {%- for i in purchase_options -%}
        {%- assign option_label_key = "option" | append: i | append: "_label" -%}
        {%- assign option_variant_key = "option" | append: i | append: "_variant_id" -%}
        {%- assign option_label = section.settings[option_label_key] -%}
        {%- assign option_variant_id = section.settings[option_variant_key] -%}
        {%- if option_label != blank -%}
          <button
            type="button"
            class="pack-option"
            data-index="{{ i }}"
            data-variant-id="{{ option_variant_id }}"
            role="radio"
            aria-checked="false"
            onclick="packSelector.selectOption('{{ i }}')"
          >
            <span class="pack-option__check" aria-hidden="true"></span>
            <span class="pack-option__label">{{ option_label }}</span>
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Frequency / subscription {%- endcomment -%}
    <p class="pack-selector__subheading caption">{{ section.settings.frequency_label }}</p>

    <div class="pack-frequency">
      <button
        type="button"
        class="pack-subscribe"
        data-frequency="subscribe"
        role="radio"
        aria-checked="false"
        onclick="packSelector.selectFrequency('subscribe')"
      >
        <span class="pack-subscribe__header">
          <span class="pack-subscribe__title-row">
            <span class="pack-subscribe__check" aria-hidden="true"></span>
            <span class="pack-subscribe__title h3">{{ section.settings.subscribe_title }}</span>
          </span>
          <span class="pack-subscribe__price">
            {%- if section.settings.subscribe_price_original != blank -%}
              <span class="pack-subscribe__price-original">{{ section.settings.subscribe_price_original }}</span>
            {%- endif -%}
            <span class="pack-subscribe__price-current">{{ section.settings.subscribe_price_current }}</span>
          </span>
        </span>

        <span class="pack-subscribe__tiers">
          {%- for i in tiers -%}
            {%- assign tier_title_key = "tier" | append: i | append: "_title" -%}
            {%- assign tier_title = section.settings[tier_title_key] -%}
            {%- if tier_title != blank -%}
              {%- assign tier_subtitle_key = "tier" | append: i | append: "_subtitle" -%}
              {%- assign tier_price_original_key = "tier" | append: i | append: "_price_original" -%}
              {%- assign tier_price_current_key = "tier" | append: i | append: "_price_current" -%}
              {%- assign tier_price_unit_key = "tier" | append: i | append: "_price_unit" -%}
              {%- assign tier_save_key = "tier" | append: i | append: "_save_badge" -%}
              {%- assign tier_selling_plan_key = "tier" | append: i | append: "_selling_plan_id" -%}
              {%- assign tier_subtitle = section.settings[tier_subtitle_key] -%}
              {%- assign tier_price_original = section.settings[tier_price_original_key] -%}
              {%- assign tier_price_current = section.settings[tier_price_current_key] -%}
              {%- assign tier_price_unit = section.settings[tier_price_unit_key] -%}
              {%- assign tier_save = section.settings[tier_save_key] -%}
              {%- assign tier_selling_plan = section.settings[tier_selling_plan_key] -%}
              <span
                class="pack-tier"
                data-tier="{{ i }}"
                data-selling-plan="{{ tier_selling_plan }}"
                role="radio"
                aria-checked="false"
                tabindex="0"
                onclick="event.stopPropagation(); packSelector.selectTier('{{ i }}')"
                onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();event.stopPropagation();packSelector.selectTier('{{ i }}');}"
              >
                <span class="pack-tier__info">
                  <span class="pack-tier__title">{{ tier_title }}</span>
                  {%- if tier_subtitle != blank -%}
                    <span class="pack-tier__subtitle caption">{{ tier_subtitle }}</span>
                  {%- endif -%}
                </span>
                <span class="pack-tier__pricing">
                  <span class="pack-tier__price-row">
                    {%- if tier_price_original != blank -%}
                      <span class="pack-tier__price-original">{{ tier_price_original }}</span>
                    {%- endif -%}
                    <span class="pack-tier__price-current">{{ tier_price_current }}</span>
                    {%- if tier_save != blank -%}
                      <span class="pack-tier__badge">{{ tier_save }}</span>
                    {%- endif -%}
                  </span>
                  {%- if tier_price_unit != blank -%}
                    <span class="pack-tier__price-unit caption">{{ tier_price_unit }}</span>
                  {%- endif -%}
                </span>
              </span>
            {%- endif -%}
          {%- endfor -%}
        </span>

        {%- if section.settings.benefit1_text != blank or section.settings.benefit2_text != blank or section.settings.benefit3_text != blank -%}
          <span class="pack-subscribe__benefits">
            {%- for benefit in (1..3) -%}
              {%- assign benefit_text_key = "benefit" | append: benefit | append: "_text" -%}
              {%- assign benefit_text = section.settings[benefit_text_key] -%}
              {%- if benefit_text != blank -%}
                <span class="pack-subscribe__benefit">
                  <svg class="pack-subscribe__benefit-icon" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0L7.4 4.6L12 6L7.4 7.4L6 12L4.6 7.4L0 6L4.6 4.6Z" fill="currentColor"/></svg>
                  {{ benefit_text }}
                </span>
              {%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
      </button>

      <button
        type="button"
        class="pack-onetime"
        data-frequency="onetime"
        role="radio"
        aria-checked="false"
        onclick="packSelector.selectFrequency('onetime')"
      >
        <span class="pack-onetime__row">
          <span class="pack-onetime__title-row">
            <span class="pack-onetime__check" aria-hidden="true"></span>
            <span class="pack-onetime__title h3">{{ section.settings.onetime_title }}</span>
          </span>
          <span class="pack-onetime__price">{{ section.settings.onetime_price }}</span>
        </span>
        {%- if section.settings.onetime_caption != blank -%}
          <span class="pack-onetime__caption caption">{{ section.settings.onetime_caption }}</span>
        {%- endif -%}
      </button>
    </div>

    {%- comment -%} Quantity + Add to cart {%- endcomment -%}
    <form action="/cart/add" method="post" class="pack-selector__form">
      <input type="hidden" name="id" id="selected-variant-id" value="">
      <input type="hidden" name="selling_plan" id="selected-selling-plan" value="">

      <div class="pack-qty pack-qty--{{ section.settings.qty_border_style }}">
        {%- if section.settings.qty_border_style == 'cloud' -%}
          <svg class="pack-qty__frame" viewBox="-2 -8 204 76" preserveAspectRatio="none" aria-hidden="true">
            <path d="M 30 0 Q 47.5 -6 65 0 Q 82.5 6 100 0 Q 117.5 -6 135 0 Q 152.5 6 170 0 C 186.6 0 200 13.4 200 30 C 200 46.6 186.6 60 170 60 Q 152.5 66 135 60 Q 117.5 54 100 60 Q 82.5 66 65 60 Q 47.5 54 30 60 C 13.4 60 0 46.6 0 30 C 0 13.4 13.4 0 30 0 Z" />
          </svg>
        {%- endif -%}
        <span class="pack-qty__label caption">{{ section.settings.qty_label }}</span>
        <button type="button" class="pack-qty__btn" aria-label="{{ 'products.product.quantity.decrease_html' | t: product: '' | default: 'Decrease quantity' | escape }}" onclick="packSelector.changeQty(-1)">&minus;</button>
        <input type="number" name="quantity" id="pack-qty-input" class="pack-qty__input" value="{{ section.settings.qty_default | default: 1 }}" min="1" inputmode="numeric">
        <button type="button" class="pack-qty__btn" aria-label="{{ 'products.product.quantity.increase_html' | t: product: '' | default: 'Increase quantity' | escape }}" onclick="packSelector.changeQty(1)">+</button>
      </div>

      <button type="submit" class="btn-primary pack-selector__submit">
        {{ section.settings.button_label }}
      </button>
    </form>

    {%- comment -%} Ingredients / Nutrition / Shipping accordion {%- endcomment -%}
    {%- if section.settings.ingredients_content != blank or section.settings.nutrition_content != blank or section.settings.shipping_content != blank -%}
      <div class="pack-accordion">
        {%- if section.settings.ingredients_content != blank -%}
          <details class="pack-accordion__item">
            <summary class="pack-accordion__summary">
              <span class="pack-accordion__label h3">{{ section.settings.ingredients_label }}</span>
              <svg class="pack-accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 4L7 10L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="pack-accordion__panel body-large">{{ section.settings.ingredients_content }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.nutrition_content != blank -%}
          <details class="pack-accordion__item">
            <summary class="pack-accordion__summary">
              <span class="pack-accordion__label h3">{{ section.settings.nutrition_label }}</span>
              <svg class="pack-accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 4L7 10L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="pack-accordion__panel body-large">{{ section.settings.nutrition_content }}</div>
          </details>
        {%- endif -%}
        {%- if section.settings.shipping_content != blank -%}
          <details class="pack-accordion__item">
            <summary class="pack-accordion__summary">
              <span class="pack-accordion__label h3">{{ section.settings.shipping_label }}</span>
              <svg class="pack-accordion__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 4L7 10L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="pack-accordion__panel body-large">{{ section.settings.shipping_content }}</div>
          </details>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  </div>
</div>

<style>
  .pack-selector {
    padding: var(--space-6) var(--space-4);
    font-family: var(--font-body);
  }
  .pack-selector__layout {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 769px) {
    .pack-selector__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-8);
      align-items: start;
    }
  }
  .pack-selector__inner {
    max-width: 480px;
    margin: 0 auto;
    width: 100%;
  }
  @media (min-width: 769px) {
    .pack-selector__inner {
      max-width: 640px;
      margin: 0;
    }
  }

  /* Product media */
  .pack-media {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .pack-media__main {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 2px solid var(--color-black);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-cream);
  }
  .pack-media__mainItem {
    display: none;
    position: absolute;
    inset: 0;
  }
  .pack-media__mainItem.is-active {
    display: block;
  }
  .pack-media__mainImg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pack-media__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .pack-media__thumb {
    width: 64px;
    height: 64px;
    padding: 0;
    border: 2px solid var(--color-black);
    border-radius: var(--radius-card);
    overflow: hidden;
    cursor: pointer;
    background: var(--color-cream);
    flex-shrink: 0;
  }
  .pack-media__thumb.is-active {
    border-color: var(--color-red);
    box-shadow: var(--shadow-sm);
  }
  .pack-media__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Accordion */
  .pack-accordion {
    margin-top: var(--space-8);
    border-top: 2px solid var(--color-black);
  }
  .pack-accordion__item {
    border-bottom: 2px solid var(--color-black);
  }
  .pack-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    cursor: pointer;
    list-style: none;
  }
  .pack-accordion__summary::-webkit-details-marker {
    display: none;
  }
  .pack-accordion__label {
    margin: 0;
    color: var(--color-near-black);
  }
  .pack-accordion__icon {
    flex-shrink: 0;
    color: var(--color-near-black);
    transition: transform 0.2s ease-out;
  }
  .pack-accordion__item[open] .pack-accordion__icon {
    transform: rotate(180deg);
  }
  .pack-accordion__panel {
    padding: 0 0 var(--space-4);
    color: var(--color-near-black);
  }
  .pack-selector__heading {
    color: var(--color-near-black);
    margin: 0 0 var(--space-4);
  }
  .pack-selector__subheading {
    color: var(--color-near-black);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-2);
  }

  /* Purchase options */
  .pack-selector__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
  .pack-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    background: var(--color-cream);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition: background 0.15s ease-out;
  }
  .pack-option__check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-black);
    border-radius: 4px;
    background: var(--color-cream);
    position: relative;
  }
  .pack-option[aria-checked="true"] {
    background: var(--color-lime);
  }
  .pack-option[aria-checked="true"] .pack-option__check {
    background: var(--color-black);
  }
  .pack-option[aria-checked="true"] .pack-option__check::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid var(--color-cream);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .pack-option__label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    color: var(--color-near-black);
    text-transform: uppercase;
  }

  /* Frequency block */
  .pack-frequency {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .pack-subscribe {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--color-cream);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    gap: var(--space-4);
    transition: background 0.15s ease-out;
  }
  .pack-subscribe[aria-checked="true"] {
    background: var(--color-yellow);
  }
  .pack-subscribe__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .pack-subscribe__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .pack-subscribe__check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-black);
    border-radius: 4px;
    background: var(--color-cream);
    position: relative;
  }
  .pack-subscribe[aria-checked="true"] .pack-subscribe__check {
    background: var(--color-black);
  }
  .pack-subscribe[aria-checked="true"] .pack-subscribe__check::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid var(--color-cream);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .pack-subscribe__title {
    margin: 0;
    color: var(--color-near-black);
  }
  .pack-subscribe__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 700;
  }
  .pack-subscribe__price-original {
    color: var(--color-mid-grey);
    text-decoration: line-through;
    font-size: 16px;
  }
  .pack-subscribe__price-current {
    color: var(--color-near-black);
    font-size: 20px;
  }

  .pack-subscribe__tiers {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .pack-tier {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    background: var(--color-cream);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    transition: background 0.15s ease-out;
  }
  .pack-subscribe[aria-checked="true"] .pack-tier {
    background: var(--color-yellow);
  }
  .pack-subscribe[aria-checked="true"] .pack-tier[aria-checked="true"] {
    background: var(--color-cream);
  }
  .pack-tier__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pack-tier__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    color: var(--color-near-black);
    text-transform: uppercase;
  }
  .pack-tier__subtitle {
    color: var(--color-near-black);
  }
  .pack-tier__pricing {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }
  .pack-tier__price-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .pack-tier__price-original {
    color: var(--color-mid-grey);
    text-decoration: line-through;
    font-family: var(--font-heading);
    font-size: 13px;
  }
  .pack-tier__price-current {
    color: var(--color-near-black);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
  }
  .pack-tier__badge {
    background: var(--color-pink);
    color: var(--color-black);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11px;
    padding: 2px 10px;
    border-radius: var(--radius-btn);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pack-tier__price-unit {
    color: var(--color-near-black);
  }

  .pack-subscribe__benefits {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .pack-subscribe__benefit {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 14px;
    color: var(--color-near-black);
  }
  .pack-subscribe__benefit-icon {
    flex-shrink: 0;
    color: var(--color-red);
  }

  .pack-onetime {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    background: var(--color-cream);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-card);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
  }
  .pack-onetime[aria-checked="true"] {
    background: var(--color-lime);
  }
  .pack-onetime__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .pack-onetime__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .pack-onetime__check {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-black);
    border-radius: 4px;
    background: var(--color-cream);
    position: relative;
  }
  .pack-onetime[aria-checked="true"] .pack-onetime__check {
    background: var(--color-black);
  }
  .pack-onetime[aria-checked="true"] .pack-onetime__check::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid var(--color-cream);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .pack-onetime__title {
    margin: 0;
    color: var(--color-near-black);
  }
  .pack-onetime__price {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-near-black);
  }
  .pack-onetime__caption {
    color: var(--color-red);
    padding-left: calc(20px + var(--space-3));
  }

  /* Qty + submit */
  .pack-selector__form {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .pack-qty {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
  }
  .pack-qty--dashed {
    border: 2px dashed var(--color-black);
    border-radius: var(--radius-btn);
  }
  .pack-qty--cloud {
    padding: var(--space-3) var(--space-4);
  }
  .pack-qty__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--color-cream);
    stroke: var(--color-black);
    stroke-width: 2;
    pointer-events: none;
  }
  .pack-qty__label,
  .pack-qty__btn,
  .pack-qty__input {
    position: relative;
    z-index: 1;
  }
  .pack-qty__label {
    color: var(--color-near-black);
    text-transform: uppercase;
    margin-right: var(--space-1);
  }
  .pack-qty__btn {
    width: 32px;
    height: 32px;
    min-width: 48px;
    min-height: 32px;
    border: none;
    background: transparent;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-near-black);
    cursor: pointer;
    line-height: 1;
  }
  .pack-qty__input {
    width: 32px;
    border: none;
    background: transparent;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: var(--color-near-black);
    -moz-appearance: textfield;
  }
  .pack-qty__input::-webkit-outer-spin-button,
  .pack-qty__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pack-selector__submit {
    flex: 1 1 auto;
    min-width: 200px;
  }

  @media (max-width: 480px) {
    .pack-selector__form {
      flex-direction: column;
      align-items: stretch;
    }
    .pack-qty {
      justify-content: center;
    }
  }
</style>

<script>
  window.packSelector = (function () {
    var state = { option: null, frequency: null, tier: null };

    function optionButtons() {
      return document.querySelectorAll('.pack-option');
    }

    function selectOption(index) {
      optionButtons().forEach(function (btn) {
        btn.setAttribute('aria-checked', btn.getAttribute('data-index') === index ? 'true' : 'false');
      });
      state.option = index;
      updateVariant();
    }

    function selectFrequency(frequency) {
      var subscribe = document.querySelector('.pack-subscribe');
      var onetime = document.querySelector('.pack-onetime');
      if (subscribe) subscribe.setAttribute('aria-checked', frequency === 'subscribe' ? 'true' : 'false');
      if (onetime) onetime.setAttribute('aria-checked', frequency === 'onetime' ? 'true' : 'false');

      state.frequency = frequency;

      if (frequency === 'subscribe' && !state.tier) {
        var firstTier = document.querySelector('.pack-tier');
        if (firstTier) selectTier(firstTier.getAttribute('data-tier'));
      }
      updateVariant();
    }

    function selectTier(tier) {
      document.querySelectorAll('.pack-tier').forEach(function (el) {
        el.setAttribute('aria-checked', el.getAttribute('data-tier') === tier ? 'true' : 'false');
      });
      state.tier = tier;
      selectFrequency('subscribe');
    }

    function selectMedia(index) {
      document.querySelectorAll('.pack-media__mainItem').forEach(function (el) {
        el.classList.toggle('is-active', el.getAttribute('data-media-index') === index);
      });
      document.querySelectorAll('.pack-media__thumb').forEach(function (el) {
        el.classList.toggle('is-active', el.getAttribute('data-media-index') === index);
      });
    }

    function changeQty(delta) {
      var input = document.getElementById('pack-qty-input');
      if (!input) return;
      var next = (parseInt(input.value, 10) || 1) + delta;
      if (next < 1) next = 1;
      input.value = next;
    }

    function updateVariant() {
      var variantInput = document.getElementById('selected-variant-id');
      var sellingPlanInput = document.getElementById('selected-selling-plan');
      var selectedOption = document.querySelector('.pack-option[aria-checked="true"]');

      if (variantInput) {
        variantInput.value = selectedOption ? selectedOption.getAttribute('data-variant-id') : '';
      }
      if (sellingPlanInput) {
        if (state.frequency === 'subscribe' && state.tier) {
          var tierEl = document.querySelector('.pack-tier[data-tier="' + state.tier + '"]');
          sellingPlanInput.value = tierEl ? (tierEl.getAttribute('data-selling-plan') || '') : '';
        } else {
          sellingPlanInput.value = '';
        }
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      var firstOption = document.querySelector('.pack-option');
      if (firstOption) selectOption(firstOption.getAttribute('data-index'));
      selectFrequency('subscribe');
    });

    return {
      selectOption: selectOption,
      selectFrequency: selectFrequency,
      selectTier: selectTier,
      selectMedia: selectMedia,
      changeQty: changeQty
    };
  })();
</script>

