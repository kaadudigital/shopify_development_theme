{%- comment -%}
  Kaadu product configurator (landing-page mockup, "PRODUKT"): product photo beside the intro (stars, title,
  tagline), the first-order notice, the Einmalig / Im Abo choice, three pack options, the delivery rhythm (Abo only),
  the stepper and the cart button with the running total. DS components: OptionButton (.kd-option), Notice,
  Stepper, cloud button. Styles: "PACK CONFIGURATOR" in assets/base.bundle.css; behaviour: [data-kd-config] in
  assets/kaadu.js.

  Prices: each pack has a one-time price (its variant's price when a product + variant ID are set, else the
  price setting) and a bag count. Abo prices = pack price minus the delivery rhythm's discount (packs can opt out).
  "Spar %" per pack compares the price per bag with the reference price per bag. Totals round to 5 Rappen.
  Subscriptions are frontend-only until selling plans exist: the plan ID setting is sent as selling_plan when set.
{%- endcomment -%}
{%- liquid
  assign product = all_products[section.settings.product]
  assign packs = '1,2,3' | split: ','
  assign default_pack = section.settings.default_pack | default: '2' | plus: 0
  assign default_tier = section.settings.default_tier | default: '2' | plus: 0
  assign default_mode = section.settings.default_mode | default: 'abo'
  assign title = section.settings.title
  if title == blank and product != blank
    assign title = product.title
  endif
  assign image = section.settings.gallery_image_1
  if image == blank and product != blank
    assign image = product.featured_image
  endif
  assign image_mobile = section.settings.image_mobile | default: image
  assign qty = section.settings.qty_default | default: 1
  if qty < 1
    assign qty = 1
  endif
-%}

{%- style -%}
  #{{ section.id }} {
    --kd-pc-bg: {{ section.settings.bg_color_mobile }};
    --kd-pc-fg: {{ section.settings.text_color_mobile }};
    --kd-pc-title: {{ section.settings.title_color }};
    --kd-pc-notice-bg: {{ section.settings.promo_bg_mobile }};
    --kd-pc-notice-title: {{ section.settings.promo_title_color_mobile }};
    --kd-pc-notice-fg: {{ section.settings.promo_text_color_mobile }};
    --kd-pc-notice-btn: {{ section.settings.promo_button_color }};
    --kd-pc-notice-btn-label: {{ section.settings.promo_button_label_color }};
    --kd-pc-opt-bg: {{ section.settings.option_bg }};
    --kd-pc-opt-fg: {{ section.settings.option_text }};
    --kd-pc-opt-on-bg: {{ section.settings.option_active_bg }};
    --kd-pc-opt-on-fg: {{ section.settings.option_active_text }};
    --kd-pc-badge-bg: {{ section.settings.badge_bg }};
    --kd-pc-badge-fg: {{ section.settings.badge_text }};
    --kd-pc-save-bg: {{ section.settings.plan_badge_bg }};
    --kd-pc-save-fg: {{ section.settings.plan_badge_text }};
    --kd-pc-save-on-bg: {{ section.settings.plan_badge_active_bg }};
    --kd-pc-save-on-fg: {{ section.settings.plan_badge_active_text }};
    --kd-pc-stepper: {{ section.settings.stepper_bg }};
    --kd-pc-stepper-fg: {{ section.settings.stepper_text }};
    --kd-pc-cart: {{ section.settings.cart_button_color_mobile }};
    --kd-pc-cart-label: {{ section.settings.cart_button_label_color }};
  }
  @media (min-width: 768px) {
    #{{ section.id }} {
      --kd-pc-bg: {{ section.settings.bg_color }};
      --kd-pc-fg: {{ section.settings.text_color }};
      --kd-pc-notice-bg: {{ section.settings.promo_bg }};
      --kd-pc-notice-title: {{ section.settings.promo_title_color }};
      --kd-pc-notice-fg: {{ section.settings.promo_text_color }};
      --kd-pc-cart: {{ section.settings.cart_button_color }};
    }
  }
{%- endstyle -%}

<section
  id="{{ section.id }}"
  class="kd-pack kd-section relative overflow-hidden"
  data-color-scheme="{{ section.settings.color_scheme }}"
  data-kd-config
>
  <div class="kd-wide kd-pack__row">
    <div class="kd-pack__media">
      {%- if image != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 767.98px)" srcset="{{ image_mobile | image_url: width: 800 }}">
          {%- endif -%}
          {{
            image
            | image_url: width: 1400
            | image_tag:
              class: 'kd-pack__image',
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 1441px) 640px, (min-width: 992px) 560px, 90vw',
              loading: 'lazy',
              alt: section.settings.image_alt
          }}
        </picture>
      {%- endif -%}
    </div>

    <div class="kd-pack__panel">
      {%- if section.settings.show_reviews and section.settings.reviews_text != blank -%}
        <p class="kd-pack__reviews kd-label">
          <span aria-hidden="true" class="kd-pack__stars">★★★★★</span>
          {%- if section.settings.reviews_link != blank -%}
            <a href="{{ section.settings.reviews_link }}">{{ section.settings.reviews_text | escape }}</a>
          {%- else -%}
            <span>{{ section.settings.reviews_text | escape }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if title != blank -%}
        <h2 class="kd-pack__title kd-display-h2-tight">{{ title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.tagline != blank or section.settings.description != blank -%}
        <div class="kd-pack__intro">
          {%- if section.settings.tagline != blank -%}
            <p class="kd-pack__tagline">{{ section.settings.tagline | escape }}</p>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <p class="kd-pack__desc kd-body">{{ section.settings.description | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_promo and section.settings.promo_title != blank -%}
        <div class="kd-notice kd-pack__notice">
          <div class="kd-notice__body">
            <p class="kd-notice__title">{{ section.settings.promo_title | escape }}</p>
            {%- if section.settings.promo_text != blank -%}
              <div class="kd-notice__text">{{ section.settings.promo_text }}</div>
            {%- endif -%}
          </div>
          {%- if section.settings.promo_button_label != blank -%}
            {%- liquid
              assign promo_url = section.settings.promo_button_link
              assign promo_code = section.settings.promo_code | strip
              if promo_url == blank and promo_code != blank
                assign promo_url = promo_code | url_encode | prepend: '/discount/' | append: '?redirect=/cart'
              endif
            -%}
            {%- if promo_url != blank -%}
              {%- render 'kd-button', label: section.settings.promo_button_label, url: promo_url, size: 'sm', class: 'kd-pack__notice-btn' -%}
            {%- else -%}
              {%- comment -%} No link or code yet: the button picks the smallest pack as a one-time trial and moves to the cart button. {%- endcomment -%}
              {%- render 'kd-button', label: section.settings.promo_button_label, size: 'sm', class: 'kd-pack__notice-btn', attrs: 'data-kd-config-trial' -%}
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="kd-options kd-options--2" role="group" aria-label="{{ section.settings.mode_group_label | escape }}" data-kd-config-group="mode">
        <button type="button" class="kd-option" data-value="once" aria-pressed="{% if default_mode == 'once' %}true{% else %}false{% endif %}">
          <span class="kd-option__label">{{ section.settings.mode_once_label | escape }}</span>
          {%- if section.settings.mode_once_sub != blank -%}<span class="kd-option__sub">{{ section.settings.mode_once_sub | escape }}</span>{%- endif -%}
        </button>
        <button type="button" class="kd-option" data-value="abo" aria-pressed="{% if default_mode == 'abo' %}true{% else %}false{% endif %}">
          <span class="kd-option__label">{{ section.settings.mode_abo_label | escape }}</span>
          {%- if section.settings.mode_abo_sub != blank -%}<span class="kd-option__sub">{{ section.settings.mode_abo_sub | escape }}</span>{%- endif -%}
        </button>
      </div>

      {%- if section.settings.options_label != blank -%}
        <p class="kd-group-label" id="{{ section.id }}-packs">{{ section.settings.options_label | escape }}</p>
      {%- endif -%}
      <div class="kd-options kd-options--3 kd-pack__packs" role="group" aria-labelledby="{{ section.id }}-packs" data-kd-config-group="pack">
        {%- for i in packs -%}
          {%- liquid
            assign k_label = 'option' | append: i | append: '_label'
            assign k_variant = 'option' | append: i | append: '_variant_id'
            assign k_free = 'pack' | append: i | append: '_free_shipping'
            assign label = section.settings[k_label]
            assign variant_id = section.settings[k_variant]
            assign n = forloop.index
          -%}
          {%- if label != blank -%}
            <button type="button" class="kd-option kd-pack__pack" data-value="{{ n }}" aria-pressed="{% if n == default_pack %}true{% else %}false{% endif %}">
              {%- if section.settings[k_free] and section.settings.free_shipping_badge != blank -%}
                <span class="kd-badge">{{ section.settings.free_shipping_badge | escape }}</span>
              {%- endif -%}
              <span class="kd-pack__pack-main">
                <span class="kd-option__label">{{ label | escape }}</span>
                <span class="kd-option__price" data-price></span>
              </span>
              <span class="kd-pack__pack-meta">
                <span class="kd-option__meta" data-meta></span>
                <span class="kd-option__was" data-was hidden></span>
              </span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="kd-pack__plans" data-kd-config-plans>
        {%- if section.settings.frequency_label != blank -%}
          <p class="kd-group-label" id="{{ section.id }}-plans">{{ section.settings.frequency_label | escape }}</p>
        {%- endif -%}
        <div class="kd-pack__plan-list" role="group" aria-labelledby="{{ section.id }}-plans" data-kd-config-group="plan">
          {%- for i in packs -%}
            {%- liquid
              assign k_title = 'tier' | append: i | append: '_title'
              assign k_sub = 'tier' | append: i | append: '_subtitle'
              assign k_rec = 'tier' | append: i | append: '_recommended'
              assign n = forloop.index
            -%}
            {%- if section.settings[k_title] != blank -%}
              <button type="button" class="kd-option kd-option--row" data-value="{{ n }}" aria-pressed="{% if n == default_tier %}true{% else %}false{% endif %}">
                <span class="kd-pack__plan-name">
                  <span class="kd-radio" aria-hidden="true"></span>
                  <span class="kd-pack__plan-text">
                    <span class="kd-option__label">{{ section.settings[k_title] | escape }}</span>
                    {%- if section.settings[k_sub] != blank -%}<span class="kd-option__sub">{{ section.settings[k_sub] | escape }}</span>{%- endif -%}
                  </span>
                </span>
                <span class="kd-pack__plan-end">
                  {%- if section.settings[k_rec] and section.settings.recommended_badge != blank -%}
                    <span class="kd-pack__pill kd-pack__pill--rec">{{ section.settings.recommended_badge | escape }}</span>
                  {%- endif -%}
                  <span class="kd-pack__plan-price" data-price></span>
                  <span class="kd-pack__pill kd-pack__pill--save" data-save></span>
                </span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <form action="/cart/add" method="post" class="kd-pack__buy" data-kd-config-form>
        <input type="hidden" name="id" value="">
        <input type="hidden" name="selling_plan" value="" disabled>
        <div class="kd-pack__stepper" role="group" aria-label="{{ section.settings.qty_label | escape }}">
          <svg class="kd-pack__stepper-cloud" aria-hidden="true" focusable="false"><use href="#kd-cloud"></use></svg>
          <button type="button" data-step="-1" aria-label="{{ section.settings.qty_less_label | escape }}">−</button>
          <output aria-live="polite">{{ qty }}</output>
          <input type="hidden" name="quantity" value="{{ qty }}">
          <button type="button" data-step="1" aria-label="{{ section.settings.qty_more_label | escape }}">+</button>
        </div>
        {%- capture cart_label -%}
          <span class="kd-pack__label--mobile">{{ section.settings.button_label_mobile | default: section.settings.button_label | escape }}</span><span class="kd-pack__label--desktop">{{ section.settings.button_label | escape }}</span>&nbsp;·&nbsp;<span data-total></span>
        {%- endcapture -%}
        {%- render 'kd-button', label: cart_label, type: 'submit', size: 'lg', class: 'kd-pack__cart' -%}
      </form>

      <p class="kd-pack__foot" data-foot></p>

      {%- liquid
        assign nutrition_has_content = false
        if section.settings.nutrition_content_type == 'image'
          if section.settings.nutrition_image != blank
            assign nutrition_has_content = true
          endif
        elsif section.settings.nutrition_content != blank
          assign nutrition_has_content = true
        endif
      -%}
      {%- if section.settings.ingredients_content != blank or nutrition_has_content or section.settings.shipping_content != blank -%}
        <div class="kd-pack__details">
          {%- if section.settings.ingredients_content != blank -%}
            <details class="kd-pack__detail">
              <summary class="kd-label-lg">{{ section.settings.ingredients_label | escape }}</summary>
              <div class="kd-pack__detail-body kd-body rte">{{ section.settings.ingredients_content }}</div>
            </details>
          {%- endif -%}
          {%- if nutrition_has_content -%}
            <details class="kd-pack__detail">
              <summary class="kd-label-lg">{{ section.settings.nutrition_label | escape }}</summary>
              <div class="kd-pack__detail-body kd-body rte">
                {%- if section.settings.nutrition_content_type == 'image' -%}
                  {{ section.settings.nutrition_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.nutrition_label }}
                {%- else -%}
                  {{ section.settings.nutrition_content }}
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
          {%- if section.settings.shipping_content != blank -%}
            <details class="kd-pack__detail">
              <summary class="kd-label-lg">{{ section.settings.shipping_label | escape }}</summary>
              <div class="kd-pack__detail-body kd-body rte">{{ section.settings.shipping_content }}</div>
            </details>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Data for assets/kaadu.js: packs (bags, one-time price in CHF, variant, Abo discount on/off, free shipping) and plans. {%- endcomment -%}
  <script type="application/json" data-kd-config-data>
    {
      "mode": {{ default_mode | json }},
      "pack": {{ default_pack }},
      "plan": {{ default_tier }},
      "currency": {{ section.settings.currency_prefix | default: 'CHF' | json }},
      "reference": {{ section.settings.reference_price | default: '4.45' | json }},
      "perBag": {{ section.settings.per_bag_text | json }},
      "save": {{ section.settings.save_text | json }},
      "was": {{ section.settings.was_text | json }},
      "shipFree": {{ section.settings.shipping_free_text | json }},
      "shipPaid": {{ section.settings.shipping_paid_text | json }},
      "footExtra": {{ section.settings.footnote_extra | json }},
      "packs": [
        {%- for i in packs -%}
          {%- liquid
            assign k_label = 'option' | append: i | append: '_label'
            assign k_variant = 'option' | append: i | append: '_variant_id'
            assign k_bags = 'pack' | append: i | append: '_bags'
            assign k_price = 'pack' | append: i | append: '_price'
            assign k_disc = 'pack' | append: i | append: '_abo_discount'
            assign k_free = 'pack' | append: i | append: '_free_shipping'
            assign variant_id = section.settings[k_variant] | strip
            assign price = section.settings[k_price] | default: '0'
            if product != blank and variant_id != blank
              for v in product.variants
                assign vid = v.id | append: ''
                if vid == variant_id
                  assign price = v.price | divided_by: 100.0
                endif
              endfor
            endif
          -%}
          {%- if section.settings[k_label] != blank -%}
            {%- if pack_sep -%},{%- endif -%}{%- assign pack_sep = true -%}
            { "n": {{ forloop.index }}, "bags": {{ section.settings[k_bags] | default: 1 }}, "price": {{ price | json }}, "variant": {{ variant_id | json }}, "aboDiscount": {{ section.settings[k_disc] | json }}, "freeShip": {{ section.settings[k_free] | json }} }
          {%- endif -%}
        {%- endfor -%}
      ],
      "plans": [
        {%- for i in packs -%}
          {%- liquid
            assign k_title = 'tier' | append: i | append: '_title'
            assign k_disc = 'tier' | append: i | append: '_discount'
            assign k_plan = 'tier' | append: i | append: '_selling_plan_id'
          -%}
          {%- if section.settings[k_title] != blank -%}
            {%- if plan_sep -%},{%- endif -%}{%- assign plan_sep = true -%}
            { "n": {{ forloop.index }}, "discount": {{ section.settings[k_disc] | default: 0 }}, "sellingPlan": {{ section.settings[k_plan] | strip | json }} }
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Custom Packaging Selector",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product",
      "info": "When a product and variant IDs are set, pack prices come from the variants; otherwise from the price fields below."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "When set, purchase options, prices, subscription tiers and gallery images are pulled live from this product's variants, selling plans and media — the fields below are used only as a fallback when no product is selected."
    },
    {
      "type": "image_picker",
      "id": "gallery_image_1",
      "label": "Product photo",
      "info": "Packshot, ideally on a transparent background. Empty = the product's main image."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Product photo – mobile",
      "info": "Optional; below 768px."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo alt text",
      "default": "Kaadu Ananas Crunchys, Beutel mit Ananasstücken"
    },
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show stars and reviews link",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_text",
      "label": "Reviews text",
      "default": "[Anzahl] Bewertungen"
    },
    {
      "type": "url",
      "id": "reviews_link",
      "label": "Reviews link"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ananas Crunchys",
      "info": "Empty = the product title."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "100 % Frucht. 0 % Ausbeutung."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Short description",
      "default": "Nur Ananas, gefriergetrocknet. Ohne Zusätze, ohne Schwefel, ohne Zuckerzusatz."
    },
    {
      "type": "header",
      "content": "First-order notice"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show the notice",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Title",
      "default": "Erste Bestellung: 1 Beutel gratis"
    },
    {
      "type": "richtext",
      "id": "promo_text",
      "label": "Text",
      "default": "<p>Du zahlst nur <strong>CHF 3.00 Versand.</strong> Danach CHF 4.45 pro Beutel. Code <strong>[CODE]</strong>.</p>"
    },
    {
      "type": "text",
      "id": "promo_button_label",
      "label": "Button label",
      "default": "Gratis probieren"
    },
    {
      "type": "url",
      "id": "promo_button_link",
      "label": "Button link",
      "info": "Optional. Without a link the button uses the discount code below; without either it selects the first pack as a one-time purchase and jumps to the cart button."
    },
    {
      "type": "text",
      "id": "promo_code",
      "label": "Discount code",
      "info": "Shopify discount code for the first order. The button then applies it and opens the cart (/discount/CODE?redirect=/cart). Also replace [CODE] in the text above."
    },
    {
      "type": "header",
      "content": "Purchase type"
    },
    {
      "type": "text",
      "id": "mode_group_label",
      "label": "Group label (screen readers)",
      "default": "Kaufart"
    },
    {
      "type": "text",
      "id": "mode_once_label",
      "label": "One-time",
      "default": "Einmalig"
    },
    {
      "type": "text",
      "id": "mode_once_sub",
      "label": "One-time – line 2",
      "default": "Ohne Abo, ohne Bindung"
    },
    {
      "type": "text",
      "id": "mode_abo_label",
      "label": "Subscription",
      "default": "Im Abo"
    },
    {
      "type": "text",
      "id": "mode_abo_sub",
      "label": "Subscription – line 2",
      "default": "Bis 20 % sparen, keine Lieferkosten"
    },
    {
      "type": "select",
      "id": "default_mode",
      "label": "Selected at start",
      "default": "abo",
      "options": [
        {
          "value": "abo",
          "label": "Im Abo"
        },
        {
          "value": "once",
          "label": "Einmalig"
        }
      ]
    },
    {
      "type": "header",
      "content": "Packs",
      "info": "Up to three; a pack without a label is hidden."
    },
    {
      "type": "text",
      "id": "options_label",
      "label": "Group label",
      "default": "Packungsgrösse"
    },
    {
      "type": "text",
      "id": "reference_price",
      "label": "Reference price per bag (CHF)",
      "default": "4.45",
      "info": "'Spar %' on each pack compares its price per bag with this."
    },
    {
      "type": "text",
      "id": "free_shipping_badge",
      "label": "Free-shipping badge",
      "default": "Gratis Versand"
    },
    {
      "type": "select",
      "id": "default_pack",
      "label": "Selected at start",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "Pack 1"
        },
        {
          "value": "2",
          "label": "Pack 2"
        },
        {
          "value": "3",
          "label": "Pack 3"
        }
      ]
    },
    {
      "type": "header",
      "content": "Pack 1"
    },
    {
      "type": "text",
      "id": "option1_label",
      "label": "Label",
      "default": "3er Pack"
    },
    {
      "type": "text",
      "id": "option1_variant_id",
      "label": "Variant ID",
      "info": "Numeric ID of the product variant this pack adds to the cart."
    },
    {
      "type": "number",
      "id": "pack1_bags",
      "label": "Bags in the pack",
      "default": 3
    },
    {
      "type": "text",
      "id": "pack1_price",
