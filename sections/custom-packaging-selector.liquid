{%- liquid
  assign product = all_products[section.settings.product]
  assign purchase_options = "1,2,3" | split: ","
  assign tiers = "1,2,3" | split: ","
  assign media_indexes = "1,2,3,4,5,6" | split: ","

  assign default_variant = blank
  assign has_selling_plans = false
  if product != blank
    assign default_variant = product.selected_or_first_available_variant
    if default_variant != blank and default_variant.selling_plan_allocations.size > 0
      assign has_selling_plans = true
    endif
  endif

  # 'default' (plain square) and 'custom' (merchant-uploaded image) are this
  # section's own keywords. Anything else is a shape-defs silhouette, applied to
  # the arrow as a clip path.
  assign nav_shape_style = section.settings.nav_shape_style | default: 'default'
  assign nav_shape_image = section.settings.nav_shape_image
  assign nav_shape_keywords = 'default,custom' | split: ','
  assign nav_shape_clip = ''
  unless nav_shape_keywords contains nav_shape_style
    assign nav_shape_clip = nav_shape_style
    assign nav_shape_style = 'shaped'
  endunless
  if nav_shape_style == 'custom' and nav_shape_image == blank
    assign nav_shape_style = 'default'
  endif
  assign nav_shape_id = section.id | append: '-navshape'

  # Clip-path shapes for the product media and the radio ticks. `shape-defs`
  # ignores anything containing 'default', so that doubles as the "no shape" state.
  assign image_shape = section.settings.image_shape | default: 'default'
  assign check_shape = section.settings.check_shape | default: 'default'
  assign image_shape_id = 'packimg-' | append: section.id
  assign check_shape_id = 'packcheck-' | append: section.id

  assign has_image_shape = false
  unless image_shape contains 'default' or image_shape == blank
    assign has_image_shape = true
  endunless

  assign has_check_shape = false
  unless check_shape contains 'default' or check_shape == blank
    assign has_check_shape = true
  endunless

  assign benefit_icon_style = section.settings.benefit_icon_style | default: 'star'
  assign benefit_icon_size = section.settings.benefit_icon_size | default: 12
-%}

<div
  id="{{ section.id }}"
  class="pack-selector bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section.settings.color_scheme }}"
  data-image-shape="{% if has_image_shape %}shaped{% else %}default{% endif %}"
  data-check-shape="{% if has_check_shape %}shaped{% else %}default{% endif %}"
>
  {%- if has_image_shape -%}
    {%- render 'shape-defs', shape: image_shape, shape_id: image_shape_id, index: section.index -%}
  {%- endif -%}
  {%- if has_check_shape -%}
    {%- render 'shape-defs', shape: check_shape, shape_id: check_shape_id, index: section.index -%}
  {%- endif -%}
  {%- style -%}
    #{{ section.id }} {
      --pack-benefit-icon-size: {{ benefit_icon_size }}px;
      {%- if has_image_shape %}
      --pack-img-clip: url(#clip-{{ image_shape_id }});
      {%- endif %}
      {%- if has_check_shape %}
      --pack-check-clip: url(#clip-{{ check_shape_id }});
      {%- endif %}
    }
  {%- endstyle -%}
  {%- if nav_shape_style == 'custom' -%}
    {%- style -%}
      #{{ section.id }} {
        --nav-shape: url('{{ nav_shape_image | image_url: width: 200 }}');
      }
    {%- endstyle -%}
  {%- endif -%}
  {%- if nav_shape_clip != blank -%}
    {%- render 'shape-defs', shape: nav_shape_clip, shape_id: nav_shape_id, index: section.index -%}
    {%- style -%}
      #{{ section.id }} {
        --nav-clip: url(#clip-{{ nav_shape_id }});
      }
    {%- endstyle -%}
  {%- endif -%}
  <div class="pack-selector__layout">

    {%- comment -%} Product media / gallery {%- endcomment -%}
    {%- assign product_image_media = product.media | where: 'media_type', 'image' -%}
    <div class="pack-media">
      {%- if product != blank and product_image_media.size > 0 -%}
        <div class="pack-media__main" data-nav-shape="{{ nav_shape_style }}">
          {%- for media in product_image_media -%}
            <div class="pack-media__mainItem{% if forloop.first %} is-active{% endif %}" data-media-index="{{ media.id }}">
              <picture>
                <source srcset="{{ media | image_url: width: 1200, format: 'webp' }}" type="image/webp">
                <img
                  src="{{ media | image_url: width: 1200 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  class="pack-media__mainImg"
                  {%- if forloop.first and section.index == 1 -%}
                    loading="eager" fetchpriority="high"
                  {%- else -%}
                    loading="lazy"
                  {%- endif -%}
                >
              </picture>
            </div>
          {%- endfor -%}
          {%- if product_image_media.size > 1 -%}
            <button type="button" class="pack-media__nav pack-media__nav--prev" aria-label="{{ 'Previous image' | escape }}" onclick="packSelector.navigateMedia(-1)">
              <svg width="18" height="17" viewBox="0 0 18 17" fill="none" aria-hidden="true"><path d="M16.577 9.806h1.062V7.68h-1.062v2.126zM.954 7.992a1.001 1.001 0 0 0 0 1.502l6.76 6.76a1.001 1.001 0 1 0 1.503-1.502L3.208 8.743l6.009-6.01A1.001 1.001 0 1 0 7.714 1.23L.954 7.993zM16.577 7.68H1.705v2.126h14.872V7.68z" fill="currentColor"/></svg>
            </button>
            <button type="button" class="pack-media__nav pack-media__nav--next" aria-label="{{ 'Next image' | escape }}" onclick="packSelector.navigateMedia(1)">
              <svg width="18" height="17" viewBox="0 0 18 17" fill="none" aria-hidden="true"><path d="M1.75 7.46H.687v2.125H1.75V7.46zm15.622 1.813a1.001 1.001 0 0 0 0-1.502L10.612 1.01a1.001 1.001 0 1 0-1.502 1.502l6.009 6.01-6.009 6.01a1.001 1.001 0 1 0 1.502 1.502l6.76-6.76zM1.75 9.584h14.871V7.46H1.75v2.126z" fill="currentColor"/></svg>
            </button>
          {%- endif -%}
        </div>

        <div class="pack-media__thumbs">
          {%- for media in product_image_media -%}
            <button
              type="button"
              class="pack-media__thumb{% if forloop.first %} is-active{% endif %}"
              data-media-index="{{ media.id }}"
              aria-label="{{ product.title | escape }} — {{ 'Image' }} {{ forloop.index }}"
              onclick="packSelector.selectMedia('{{ media.id }}')"
            >
              <img src="{{ media | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- else -%}
        {%- assign manual_media_count = 0 -%}
        {%- for i in media_indexes -%}
          {%- assign media_key = "gallery_image_" | append: i -%}
          {%- assign media_image = section.settings[media_key] -%}
          {%- if media_image != blank -%}
            {%- assign manual_media_count = manual_media_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="pack-media__main" data-nav-shape="{{ nav_shape_style }}">
          {%- for i in media_indexes -%}
            {%- assign media_key = "gallery_image_" | append: i -%}
            {%- assign media_image = section.settings[media_key] -%}
            {%- if media_image != blank -%}
              <div class="pack-media__mainItem{% if forloop.first %} is-active{% endif %}" data-media-index="{{ i }}">
                <picture>
                  <source srcset="{{ media_image | image_url: width: 1200, format: 'webp' }}" type="image/webp">
                  <img
                    src="{{ media_image | image_url: width: 1200 }}"
                    alt="{{ media_image.alt | default: section.settings.title | escape }}"
                    width="{{ media_image.width }}"
                    height="{{ media_image.height }}"
                    class="pack-media__mainImg"
                    {%- if forloop.first and section.index == 1 -%}
                      loading="eager" fetchpriority="high"
                    {%- else -%}
                      loading="lazy"
                    {%- endif -%}
                  >
                </picture>
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if manual_media_count > 1 -%}
            <button type="button" class="pack-media__nav pack-media__nav--prev" aria-label="{{ 'Previous image' | escape }}" onclick="packSelector.navigateMedia(-1)">
              <svg width="18" height="17" viewBox="0 0 18 17" fill="none" aria-hidden="true"><path d="M16.577 9.806h1.062V7.68h-1.062v2.126zM.954 7.992a1.001 1.001 0 0 0 0 1.502l6.76 6.76a1.001 1.001 0 1 0 1.503-1.502L3.208 8.743l6.009-6.01A1.001 1.001 0 1 0 7.714 1.23L.954 7.993zM16.577 7.68H1.705v2.126h14.872V7.68z" fill="currentColor"/></svg>
            </button>
            <button type="button" class="pack-media__nav pack-media__nav--next" aria-label="{{ 'Next image' | escape }}" onclick="packSelector.navigateMedia(1)">
              <svg width="18" height="17" viewBox="0 0 18 17" fill="none" aria-hidden="true"><path d="M1.75 7.46H.687v2.125H1.75V7.46zm15.622 1.813a1.001 1.001 0 0 0 0-1.502L10.612 1.01a1.001 1.001 0 1 0-1.502 1.502l6.009 6.01-6.009 6.01a1.001 1.001 0 1 0 1.502 1.502l6.76-6.76zM1.75 9.584h14.871V7.46H1.75v2.126z" fill="currentColor"/></svg>
            </button>
          {%- endif -%}
        </div>

        <div class="pack-media__thumbs">
          {%- for i in media_indexes -%}
            {%- assign media_key = "gallery_image_" | append: i -%}
            {%- assign media_image = section.settings[media_key] -%}
            {%- if media_image != blank -%}
              <button
                type="button"
                class="pack-media__thumb{% if forloop.first %} is-active{% endif %}"
                data-media-index="{{ i }}"
                aria-label="{{ section.settings.title | escape }} — {{ 'Image' }} {{ forloop.index }}"
                onclick="packSelector.selectMedia('{{ i }}')"
              >
                <img src="{{ media_image | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy">
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  <div class="pack-selector__inner">
    <p class="pack-selector__heading h3">
      {{ section.settings.title }}
    </p>

    {%- comment -%} Purchase options (pack size) {%- endcomment -%}
    <div class="pack-selector__options" role="radiogroup" aria-label="{{ section.settings.options_label | escape }}">
      {%- if product != blank and product.variants.size > 0 -%}
        {%- for variant in product.variants -%}
          <button
            type="button"
            class="pack-option"
            data-index="{{ variant.id }}"
            data-variant-id="{{ variant.id }}"
            role="radio"
            aria-checked="false"
            {% unless variant.available %}disabled{% endunless %}
            onclick="packSelector.selectOption('{{ variant.id }}')"
          >
            <span class="pack-option__check" aria-hidden="true"></span>
            <span class="pack-option__label btn-label">{{ variant.title }}</span>
          </button>
        {%- endfor -%}
      {%- else -%}
        {%- for i in purchase_options -%}
          {%- assign option_label_key = "option" | append: i | append: "_label" -%}
          {%- assign option_variant_key = "option" | append: i | append: "_variant_id" -%}
          {%- assign option_label = section.settings[option_label_key] -%}
          {%- assign option_variant_id = section.settings[option_variant_key] -%}
          {%- if option_label != blank -%}
            <button
              type="button"
              class="pack-option"
              data-index="{{ i }}"
              data-variant-id="{{ option_variant_id }}"
              role="radio"
              aria-checked="false"
              onclick="packSelector.selectOption('{{ i }}')"
            >
              <span class="pack-option__check" aria-hidden="true"></span>
              <span class="pack-option__label btn-label">{{ option_label }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} Frequency / subscription {%- endcomment -%}
    <p class="pack-selector__heading h3">{{ section.settings.frequency_label }}</p>

    <div class="pack-frequency">
      <button
        type="button"
        class="pack-subscribe"
        data-frequency="subscribe"
        role="radio"
        aria-checked="false"
        onclick="packSelector.selectFrequency('subscribe')"
      >
        {%- if has_selling_plans -%}
          {%- assign first_allocation = default_variant.selling_plan_allocations.first -%}
          <span class="pack-subscribe__header">
            <span class="pack-subscribe__title-row">
              <span class="pack-subscribe__check" aria-hidden="true"></span>
              <span class="pack-subscribe__title h3">{{ section.settings.subscribe_title }}</span>
            </span>
            <span class="pack-subscribe__price">
              {%- if first_allocation.compare_at_price > first_allocation.price -%}
                <span class="pack-subscribe__price-original">{{ first_allocation.compare_at_price | money }}</span>
              {%- endif -%}
              <span class="pack-subscribe__price-current">{{ first_allocation.price | money }}</span>
            </span>
          </span>

          <span class="pack-subscribe__tiers">
            {%- for allocation in default_variant.selling_plan_allocations -%}
              {%- assign tier_save = '' -%}
              {%- if allocation.compare_at_price > allocation.price -%}
                {%- assign tier_discount = allocation.compare_at_price | minus: allocation.price -%}
                {%- assign tier_save_percent = tier_discount | times: 100.0 | divided_by: allocation.compare_at_price | round -%}
                {%- assign tier_save = 'Save ' | append: tier_save_percent | append: '%' -%}
              {%- endif -%}
              <span
                class="pack-tier"
                data-tier="{{ allocation.selling_plan.id }}"
                data-selling-plan="{{ allocation.selling_plan.id }}"
                role="radio"
                aria-checked="false"
                tabindex="0"
                onclick="event.stopPropagation(); packSelector.selectTier('{{ allocation.selling_plan.id }}')"
                onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();event.stopPropagation();packSelector.selectTier('{{ allocation.selling_plan.id }}');}"
              >
                <span class="pack-tier__info">
                  <span class="pack-tier__title btn-label">{{ allocation.selling_plan.name }}</span>
                  {%- if allocation.selling_plan.description != blank -%}
                    <span class="pack-tier__subtitle caption">{{ allocation.selling_plan.description }}</span>
                  {%- endif -%}
                </span>
                <span class="pack-tier__pricing">
                  <span class="pack-tier__price-row">
                    {%- if allocation.compare_at_price > allocation.price -%}
                      <span class="pack-tier__price-original">{{ allocation.compare_at_price | money }}</span>
                    {%- endif -%}
                    <span class="pack-tier__price-current">{{ allocation.price | money }}</span>
                    {%- if tier_save != blank -%}
                      <span class="pack-tier__badge">{{ tier_save }}</span>
                    {%- endif -%}
                  </span>
                </span>
              </span>
            {%- endfor -%}
          </span>
        {%- else -%}
          <span class="pack-subscribe__header">
            <span class="pack-subscribe__title-row">
              <span class="pack-subscribe__check" aria-hidden="true"></span>
              <span class="pack-subscribe__title h3">{{ section.settings.subscribe_title }}</span>
            </span>
            <span class="pack-subscribe__price">
              {%- if section.settings.tier1_price_original != blank -%}
                <span class="pack-subscribe__price-original">{{ section.settings.tier1_price_original }}</span>
              {%- endif -%}
              <span class="pack-subscribe__price-current">{{ section.settings.tier1_price_current }}</span>
            </span>
          </span>

          <span class="pack-subscribe__tiers">
            {%- for i in tiers -%}
              {%- assign tier_title_key = "tier" | append: i | append: "_title" -%}
              {%- assign tier_title = section.settings[tier_title_key] -%}
              {%- if tier_title != blank -%}
                {%- assign tier_subtitle_key = "tier" | append: i | append: "_subtitle" -%}
                {%- assign tier_price_original_key = "tier" | append: i | append: "_price_original" -%}
                {%- assign tier_price_current_key = "tier" | append: i | append: "_price_current" -%}
                {%- assign tier_price_unit_key = "tier" | append: i | append: "_price_unit" -%}
                {%- assign tier_save_key = "tier" | append: i | append: "_save_badge" -%}
                {%- assign tier_selling_plan_key = "tier" | append: i | append: "_selling_plan_id" -%}
                {%- assign tier_subtitle = section.settings[tier_subtitle_key] -%}
                {%- assign tier_price_original = section.settings[tier_price_original_key] -%}
                {%- assign tier_price_current = section.settings[tier_price_current_key] -%}
                {%- assign tier_price_unit = section.settings[tier_price_unit_key] -%}
                {%- assign tier_save = section.settings[tier_save_key] -%}
                {%- assign tier_selling_plan = section.settings[tier_selling_plan_key] -%}
                <span
                  class="pack-tier"
                  data-tier="{{ i }}"
                  data-selling-plan="{{ tier_selling_plan }}"
                  role="radio"
                  aria-checked="false"
                  tabindex="0"
                  onclick="event.stopPropagation(); packSelector.selectTier('{{ i }}')"
                  onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();event.stopPropagation();packSelector.selectTier('{{ i }}');}"
                >
                  <span class="pack-tier__info">
                    <span class="pack-tier__title btn-label">{{ tier_title }}</span>
                    {%- if tier_subtitle != blank -%}
                      <span class="pack-tier__subtitle caption">{{ tier_subtitle }}</span>
                    {%- endif -%}
                  </span>
                  <span class="pack-tier__pricing">
                    <span class="pack-tier__price-row">
                      {%- if tier_price_original != blank -%}
                        <span class="pack-tier__price-original">{{ tier_price_original }}</span>
                      {%- endif -%}
                      <span class="pack-tier__price-current">{{ tier_price_current }}</span>
                      {%- if tier_save != blank -%}
                        <span class="pack-tier__badge">{{ tier_save }}</span>
                      {%- endif -%}
                    </span>
                    {%- if tier_price_unit != blank -%}
                      <span class="pack-tier__price-unit caption">{{ tier_price_unit }}</span>
                    {%- endif -%}
                  </span>
                </span>
              {%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}

        {%- if section.settings.benefit1_text != blank or section.settings.benefit2_text != blank or section.settings.benefit3_text != blank -%}
          <span class="pack-subscribe__benefits">
            {%- for benefit in (1..3) -%}
              {%- assign benefit_text_key = "benefit" | append: benefit | append: "_text" -%}
              {%- assign benefit_text = section.settings[benefit_text_key] -%}
              {%- assign benefit_icon_svg_key = "benefit" | append: benefit | append: "_icon_svg" -%}
              {%- assign benefit_icon_image_key = "benefit" | append: benefit | append: "_icon_image" -%}
              {%- if benefit_text != blank -%}
                <span class="pack-subscribe__benefit">
                  {%- render 'pack-benefit-icon',
                    style: benefit_icon_style,
                    svg_code: section.settings[benefit_icon_svg_key],
                    icon_image: section.settings[benefit_icon_image_key],
                    fallback_svg_code: section.settings.benefit_icon_svg,
                    fallback_icon_image: section.settings.benefit_icon_image,
                    size: benefit_icon_size
                  -%}
                  {{ benefit_text }}
                </span>
              {%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
      </button>

      <button
        type="button"
        class="pack-onetime"
        data-frequency="onetime"
        role="radio"
        aria-checked="false"
        onclick="packSelector.selectFrequency('onetime')"
      >
        <span class="pack-onetime__row">
          <span class="pack-onetime__title-row">
            <span class="pack-onetime__check" aria-hidden="true"></span>
            <span class="pack-onetime__title h3">{{ section.settings.onetime_title }}</span>
          </span>
          <span class="pack-onetime__price">
            {%- if default_variant != blank -%}
              {{ default_variant.price | money }}
            {%- else -%}
              {{ section.settings.onetime_price }}
            {%- endif -%}
          </span>
        </span>
        {%- if section.settings.onetime_caption != blank -%}
          <span class="pack-onetime__caption caption">{{ section.settings.onetime_caption }}</span>
        {%- endif -%}
      </button>
    </div>

    {%- comment -%} Quantity + Add to cart {%- endcomment -%}
    <form action="/cart/add" method="post" class="pack-selector__form">
      <input type="hidden" name="id" id="selected-variant-id" value="">
      <input type="hidden" name="selling_plan" id="selected-selling-plan" value="">

      {%- liquid
        assign qty_shape_desktop = section.settings.qty_border_style_desktop | default: 'cloud'
        assign qty_shape_mobile = section.settings.qty_border_style_mobile | default: 'dashed'

        assign qty_custom_image_desktop = section.settings.qty_shape_image_desktop
        assign qty_custom_image_mobile = section.settings.qty_shape_image_mobile

        # 'dashed', 'cloud' and 'custom' are the stepper's own frame styles;
        # anything else is a shape-defs silhouette. The stepper is a wide bar,
        # so a shape is drawn as an outline frame behind the controls rather
        # than clipped — clipping a 1:1 silhouette to a bar would cut the
        # buttons off at the points, the same reason the uploaded-image option
        # already paints a stretched background instead.
        assign qty_shape_keywords = 'dashed,cloud,custom' | split: ','

        assign qty_shape_clip_desktop = ''
        unless qty_shape_keywords contains qty_shape_desktop
          assign qty_shape_clip_desktop = qty_shape_desktop
          assign qty_shape_desktop = 'shaped'
        endunless

        assign qty_shape_clip_mobile = ''
        unless qty_shape_keywords contains qty_shape_mobile
          assign qty_shape_clip_mobile = qty_shape_mobile
          assign qty_shape_mobile = 'shaped'
        endunless

        assign qty_shape_id_desktop = section.id | append: '-qtyshaped'
        assign qty_shape_id_mobile = section.id | append: '-qtyshapem'

        if qty_shape_desktop == 'custom' and qty_custom_image_desktop == blank
          assign qty_shape_desktop = 'dashed'
        endif
        if qty_shape_mobile == 'custom' and qty_custom_image_mobile == blank
          assign qty_shape_mobile = 'dashed'
        endif
      -%}
      {%- if qty_shape_clip_desktop != blank -%}
        {%- render 'shape-defs', shape: qty_shape_clip_desktop, shape_id: qty_shape_id_desktop, index: section.index -%}
      {%- endif -%}
      {%- if qty_shape_clip_mobile != blank -%}
        {%- render 'shape-defs', shape: qty_shape_clip_mobile, shape_id: qty_shape_id_mobile, index: section.index -%}
      {%- endif -%}
      {%- if qty_shape_desktop == 'custom' or qty_shape_mobile == 'custom' -%}
        {%- style -%}
          #{{ section.id }} {
            {%- if qty_shape_desktop == 'custom' -%}
              --qty-shape-desktop: url('{{ qty_custom_image_desktop | image_url: width: 400 }}');
            {%- endif -%}
            {%- if qty_shape_mobile == 'custom' -%}
              --qty-shape-mobile: url('{{ qty_custom_image_mobile | image_url: width: 400 }}');
            {%- endif -%}
          }
        {%- endstyle -%}
      {%- endif -%}
      <div class="pack-qty" data-shape-desktop="{{ qty_shape_desktop }}" data-shape-mobile="{{ qty_shape_mobile }}">
        {%- if qty_shape_desktop == 'cloud' or qty_shape_mobile == 'cloud' -%}
          <svg class="pack-qty__frame pack-qty__frame--cloud" viewBox="0 0 150 78" preserveAspectRatio="xMidYMid meet" fill="none" aria-hidden="true">
            <mask id="pack-qty-cloud-mask-{{ section.id }}" fill="#fff">
