{%- comment -%}
  Kaadu — Custom Distribution Section
  A stacked list of clickable option cards (heading + body copy + arrow),
  each on its own brand-colour background. See Figma node 322:203.
{%- endcomment -%}

<section
  class="kaadu-distribution bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="kaadu-distribution__container">
    {%- if section.settings.title != blank -%}
      <h2 class="kaadu-distribution__title h3">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="kaadu-distribution__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'option_link' -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="kaadu-distribution__item bg-{{ block.settings.background }}{% if block.settings.show_border %} kaadu-distribution__item--bordered{% endif %}{% if block.settings.rounded_corners %} kaadu-distribution__item--rounded{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="kaadu-distribution__item-row">
              <h3 class="kaadu-distribution__item-heading btn-label">{{ block.settings.heading | escape }}</h3>
              <span class="kaadu-distribution__item-icon text-red">
                {%- render 'kaadu-icon-arrow-right' -%}
              </span>
            </div>
            {%- if block.settings.text != blank -%}
              <p class="kaadu-distribution__item-text body">{{ block.settings.text }}</p>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- style -%}
    #shopify-section-{{ section.id }} .kaadu-distribution {
      padding: var(--section-padding-v) 0;
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__container {
      max-width: 480px;
      margin-inline: auto;
      padding-inline: var(--space-4);
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__title {
      margin: 0 0 var(--space-6);
      color: var(--color-black);
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__item {
      display: block;
      border: none;
      border-radius: 0;
      box-shadow: var(--shadow-md);
      padding: var(--space-6);
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__item--bordered {
      border: 2px solid var(--color-black);
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__item--rounded {
      border-radius: var(--radius-card);
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__item:hover,
    #shopify-section-{{ section.id }} .kaadu-distribution__item:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0px 6px 6px 0px rgba(0, 0, 0, 0.25);
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__item:active {
      transform: translateY(0);
      box-shadow: var(--shadow-sm);
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__item:focus-visible {
      outline: 2px solid var(--color-violet);
      outline-offset: 2px;
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__item-heading {
      margin: 0;
      color: var(--color-black);
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__item-icon {
      display: inline-flex;
      flex-shrink: 0;
    }

    #shopify-section-{{ section.id }} .kaadu-distribution__item-text {
      margin: var(--space-3) 0 0;
      color: var(--color-black);
    }

    @media (min-width: 769px) {
      #shopify-section-{{ section.id }} .kaadu-distribution__container {
        /* Matches custom-packaging-selector.liquid's .pack-selector__inner desktop width */
        max-width: 874px;
        padding-inline: var(--space-6);
      }

      #shopify-section-{{ section.id }} .kaadu-distribution__list {
        gap: var(--space-6);
      }
    }
  {%- endstyle -%}
</section>

{% schema %}
{
  "name": "Distribution Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Tiefer eintauchen",
      "info": "Rendered in H3 — Subheading style"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme1"
    }
  ],
  "blocks": [
    {
      "type": "option_link",
      "name": "Option link",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Option heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Add a short description for this option."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "background",
          "label": "Background color",
          "options": [
            { "value": "lime", "label": "Lime" },
            { "value": "sky", "label": "Sky" },
            { "value": "yellow", "label": "Yellow" },
            { "value": "pink", "label": "Pink" },
            { "value": "orange", "label": "Orange" },
            { "value": "violet", "label": "Violet" },
            { "value": "red", "label": "Red" },
            { "value": "cream", "label": "Cream" }
          ],
          "default": "lime"
        },
        {
          "type": "header",
          "content": "Border"
        },
        {
          "type": "checkbox",
          "id": "show_border",
          "label": "Show border",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "rounded_corners",
          "label": "Rounded corners",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Distribution Section",
      "settings": {
        "title": "Tiefer eintauchen"
      },
      "blocks": [
        {
          "type": "option_link",
          "settings": {
            "heading": "Wieso machen wir das?",
            "text": "Die kaputte Lieferkette, vier Mechanismen der Ausbeutung — und wie unsere Crunchys alles verändern.",
            "background": "lime"
          }
        },
        {
          "type": "option_link",
          "settings": {
            "heading": "Transparenz",
            "text": "Alle Zahlen: Löhne, Preise, Reports, Audits. Jeder kann von Transparenz reden — wir legen sie offen.",
            "background": "sky"
          }
        },
        {
          "type": "option_link",
          "settings": {
            "heading": "Über uns",
            "text": "Wie ein Familienbesuch in Vazhakulam 2022 zum Modell für eine neue Art von Handel wurde.",
            "background": "yellow"
          }
        },
        {
          "type": "option_link",
          "settings": {
            "heading": "Ananas Crunchys",
            "text": "Nachschub sichern — einzeln, im Bundle oder im Crunch-Abo mit 10% Rabatt.",
            "background": "pink"
          }
        }
      ]
    }
  ]
}
{% endschema %}
