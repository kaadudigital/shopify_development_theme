{%- liquid
  assign richtext_blocks = section.blocks | where: 'type', 'richtext'
-%}

{%- style -%}
  #ktat-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #ktat-{{ section.id }} .ktat-section__header {
    text-align: {{ section.settings.heading_alignment }};
  }
  {%- if section.settings.heading_alignment == 'center' -%}
    #ktat-{{ section.id }} .ktat-section__body-text {
      margin-left: auto;
      margin-right: auto;
    }
  {%- elsif section.settings.heading_alignment == 'right' -%}
    #ktat-{{ section.id }} .ktat-section__body-text {
      margin-left: auto;
    }
  {%- endif -%}
{%- endstyle -%}

<section
  class="ktat-section {{ section.settings.bg_class }}"
  id="ktat-{{ section.id }}"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="relative z-10 mx-auto max-w-site px-section">

    <div class="ktat-section__header">
      {%- if section.settings.title != blank -%}
        <h2 class="h2 font-subheading heading-style {{ settings.heading_drop_shadow_style }} break-words">
          {{ section.settings.title | escape | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' }}
        </h2>
      {%- endif -%}
      {%- if section.settings.body_text != blank -%}
        <div class="rte body ktat-section__body-text">
          {{ section.settings.body_text }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} 3-column layout: left text | center image | right text {%- endcomment -%}
    <div class="ktat-section__grid">

      <div class="ktat-section__col ktat-section__col--left">
        {%- for block in richtext_blocks limit: 3 -%}
          <div class="ktat-section__block" {{ block.shopify_attributes }} style="text-align: {{ block.settings.text_alignment }};">
            {%- if block.settings.heading != blank -%}
              <h3 class="h3 ktat-section__block-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.body_text != blank -%}
              <div class="rte body">{{ block.settings.body_text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <div class="ktat-section__col ktat-section__col--image">
        {%- if section.settings.main_image != blank -%}
          <img
            src="{{ section.settings.main_image | image_url: width: 800 }}"
            alt="{{ section.settings.main_image.alt | escape }}"
            width="{{ section.settings.main_image.width }}"
            height="{{ section.settings.main_image.height }}"
            class="ktat-section__image"
            loading="lazy"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'ktat-section__image ktat-section__image--placeholder' }}
        {%- endif -%}
      </div>

      <div class="ktat-section__col ktat-section__col--right">
        {%- for block in richtext_blocks offset: 3 -%}
          <div class="ktat-section__block" {{ block.shopify_attributes }} style="text-align: {{ block.settings.text_alignment }};">
            {%- if block.settings.heading != blank -%}
              <h3 class="h3 ktat-section__block-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.body_text != blank -%}
              <div class="rte body">{{ block.settings.body_text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    </div>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="ktat-section__btn-wrap">
        <a href="{{ section.settings.button_link }}" class="inline-block custom-btn">
          <span class="push-btn__surface btn-secondary btn-label">{{ section.settings.button_label }}</span>
        </a>
      </div>
    {%- endif -%}

  </div>

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}

</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

<style>
  .ktat-section__header {
    margin-bottom: var(--space-8);
  }

  .ktat-section__body-text {
    margin-top: var(--space-4);
    max-width: 640px;
  }

  /* Mobile: flex column, image rendered first */
  .ktat-section__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .ktat-section__col--image {
    order: -1;
  }

  .ktat-section__col--left,
  .ktat-section__col--right {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Desktop: 3-column grid, image in centre */
  @media (min-width: 769px) {
    .ktat-section__grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr 1fr;
      align-items: center;
      gap: var(--space-8);
    }
    .ktat-section__col--left  { order: 1; }
    .ktat-section__col--image { order: 2; }
    .ktat-section__col--right { order: 3; }
  }

  .ktat-section__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-card);
    object-fit: cover;
  }

  .ktat-section__image--placeholder {
    aspect-ratio: 3 / 4;
    background-color: var(--color-light-grey);
  }

  .ktat-section__block-heading {
    margin-bottom: var(--space-2);
  }

  .ktat-section__btn-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
  }
</style>

