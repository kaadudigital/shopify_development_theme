{%- liquid
  assign video = section.settings.video
  assign crop = section.settings.crop
  assign crop_desktop = section.settings.crop_desktop

  case crop
    when 'vertical'
      assign container_class = 'aspect-w-9 aspect-h-16'
    when 'four-three'
      assign container_class = 'aspect-w-4 aspect-h-3'
    when 'square'
      assign container_class = 'aspect-w-1 aspect-h-1'
    when 'widescreen'
      assign container_class = 'aspect-w-16 aspect-h-9'
    when 'full-screen'
      assign container_class = 'h-screen first-section:h-screen-less-header-group'
    when 'natural'
      assign container_class = 'aspect-[1_/_var(--custom-aspect-h)] w-full'
  endcase

  if crop_desktop == crop
    assign crop_desktop = 'same'
  endif

  case crop_desktop
    when 'four-three'
      assign container_class = container_class | append: ' lg:h-auto lg:aspect-w-4 lg:aspect-h-3'
    when 'widescreen'
      assign container_class = container_class | append: ' lg:h-auto lg:aspect-w-16 lg:aspect-h-9'
    when 'cinematic'
      assign container_class = container_class | append: ' lg:h-auto lg:aspect-w-2.35 lg:aspect-h-1'
    when 'full-screen'
      assign container_class = container_class | append: ' lg:aspect-auto lg:h-screen lg:first-section:h-screen-less-header-group'
    when 'natural'
      assign container_class = container_class | append: ' lg:aspect-[1_/_var(--custom-aspect-h)] lg:h-auto'
    when 'two-one'
      assign container_class = container_class | append: ' kd-video__frame--two-one'
  endcase

  # «Page hero» layout: bottom-left content in the DS hero type (display-hero h1, lead) over the card fade
  assign is_hero = false
  if section.settings.layout == 'hero'
    assign is_hero = true
  endif

  # Black bars baked into the video: crop video_trim % off its top and bottom
  assign trim = section.settings.video_trim | default: 0
  assign trim_factor = 100 | minus: trim | minus: trim | times: 0.01

  if crop == 'natural' or crop_desktop == 'natural'
    if video != blank
      assign custom_aspect_h = video.sources[0].height | times: 1.00000000 | divided_by: video.sources[0].width
    else
      assign custom_aspect_h = 0.5625
    endif
    assign custom_aspect_h = custom_aspect_h | times: trim_factor
  endif

  assign video_size_class = 'absolute inset-0 w-full h-full object-cover'
  if section.settings.style == 'inset'
    assign video_size_class = video_size_class | append: ' media__styled-element'
  endif

  assign content_class = 'grid absolute inset-0 w-full h-full'
  assign content_inset_class = 'max-w-site py-5 px-section mx-auto'
  assign card_container_class = 'card'
  assign card_content_class = 'card__surface py-5 lg:py-8 px-5 lg:px-8'

  case section.settings.text_align
    when 'text-left'
      assign content_align = 'justify-start'
    when 'text-center'
      assign content_align = 'justify-center'
    when 'text-right'
      assign content_align = 'justify-end'
  endcase
-%}

{%- liquid
  assign cta_text_mobile_display = section.settings.cta_text_mobile | default: section.settings.cta_text
-%}

{%- comment -%}
  Kaadu video band: the video under a dark gradient (or a solid overlay colour), centred kicker,
  title, text and a cloud button. Colours follow the landing-page mockup by default (paper kicker,
  red title with a light outline shadow, purple cloud with a paper label) and are settings.
  Optional button artwork replaces the cloud. Styles: "VIDEO BAND" in assets/base.bundle.css.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --kd-video-kicker: {{ section.settings.kicker_color | default: '#FFFFF5' }};
    --kd-video-title: {{ section.settings.title_color | default: '#AC0300' }};
    --kd-video-shadow: {{ section.settings.title_shadow_color | default: '#FFFFF5' }};
    --kd-video-shadow-m: {{ section.settings.title_shadow_color_mobile | default: '#AEFF64' }};
    --kd-video-text: {{ section.settings.text_color | default: '#FFFFF5' }};
    --kd-video-btn: {{ section.settings.button_color | default: '#542A76' }};
    --kd-video-btn-label: {{ section.settings.button_label_color | default: '#FFFFF5' }};
    --kd-video-btn-gap: var(--{{ section.settings.button_space_mobile | default: 'space-8' }});
    {%- assign overlay_alpha = section.settings.overlay_opacity | times: 0.01 %}
    --kd-video-overlay: {{ section.settings.overlay_color | default: '#000000' | color_modify: 'alpha', overlay_alpha }};
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} { --kd-video-btn-gap: var(--{{ section.settings.button_space_desktop | default: 'space-10' }}); }
  }
  {%- if trim > 0 %}
  #shopify-section-{{ section.id }} .banner-section-content--h {
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} video {
    top: {{ trim | times: 100.0 | divided_by: trim_factor | divided_by: 100 | prepend: '-' }}%;
    bottom: auto;
    height: {{ 100.0 | divided_by: trim_factor }}%;
  }
  {%- endif %}
  {%- if section.settings.use_button_art and section.settings.button2_image != blank %}
  #shopify-section-{{ section.id }} .kd-video__actions .kd-btn--art {
    --kd-art-w: {{ section.settings.button2_width_desktop | default: 200 }}px;
    --kd-art-ratio: {{ section.settings.button2_image.aspect_ratio }};
    --kd-art-color: {{ section.settings.button_text_color_desktop | default: '#ffffff' }};
    --kd-art-w-m: {{ section.settings.button2_width_mobile | default: 150 }}px;
    --kd-art-ratio-m: {{ section.settings.button2_image_mobile.aspect_ratio | default: section.settings.button2_image.aspect_ratio }};
    --kd-art-color-m: {{ section.settings.button_text_color_mobile | default: section.settings.button_text_color_desktop | default: '#ffffff' }};
  }
  {%- endif %}
{%- endstyle -%}

<section
  class="kd-video{% if is_hero %} kd-video--hero{% endif %}{% unless section.settings.title_shadow %} kd-video--no-shadow{% endunless %} grid bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %} {% unless section.settings.style == 'inset' %}full-bleed-section{% endunless %} relative overflow-hidden"
  data-color-scheme="{{ section.settings.color_scheme }}"
  {% unless section.settings.scroll_motion %} data-kd-motion="off"{% endunless %}
>
  <div class="section-content {% if section.settings.style == 'inset' %}py-section-vertical-spacing{% endif %}">
    <data-island
      id="video-{{ section.id }}"
      x-data="Video('inline', 'autoplay')"
      class="relative z-10 h-full lg:bg-transparent"
      x-intersect:enter.margin.25%.0px.75%.0px="play"
      x-intersect:leave.margin.25%.0px.75%.0px="pause"
      on="before:visible"
    >
      {%- if section.settings.cta_url != blank and section.settings.cta_text == blank -%}
        <a href="{{ section.settings.cta_url }}" class="absolute inset-0 z-20"></a>
      {%- endif -%}

      <div
        class="kd-video__layer px-section py-section-vertical-spacing {{ content_class }} z-20 text-scheme-text {{ section.settings.place_content }} {{ section.settings.text_align }} {% if section.settings.style == 'inset' %}max-w-site mx-auto{% endif %}"
      >
        {%- capture content -%}
          {% if section.settings.eyebrow != blank %}
            <p class="kd-video__kicker {% if is_hero %}kd-strong{% else %}kd-label-lg{% endif %}">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.title != blank %}
            <{{ section.settings.heading_tag }} class="kd-video__title {% if is_hero %}kd-display-hero{% else %}kd-display-h2{% endif %}">
              {{- section.settings.title -}}
            </{{ section.settings.heading_tag }}>
          {% endif %}
          {% if section.settings.richtext != blank %}
            <div class="kd-video__text rte {% if is_hero %}kd-lead{% else %}kd-body-lg{% endif %}">
              {{ section.settings.richtext }}
            </div>
          {% endif %}
          {% if section.settings.cta_url != blank and section.settings.cta_text != blank %}
            {%- capture cta_label -%}
              {%- if section.settings.show_play_icon -%}
                <svg class="kd-video__play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4l14 8-14 8z" fill="currentColor"/></svg>
              {%- endif -%}
              <span class="kd-video__label--mobile">{{ cta_text_mobile_display | escape }}</span><span class="kd-video__label--desktop">{{ section.settings.cta_text | escape }}</span>
            {%- endcapture -%}
            <div class="kd-video__actions">
              {%- if section.settings.use_button_art and section.settings.button2_image != blank -%}
                {%- render 'kd-button', label: cta_label, url: section.settings.cta_url, size: 'md', art: section.settings.button2_image, art_mobile: section.settings.button2_image_mobile -%}
              {%- else -%}
                {%- render 'kd-button', label: cta_label, url: section.settings.cta_url, size: 'md' -%}
              {%- endif -%}
            </div>
          {% endif %}
        {%- endcapture -%}

        <div class="flex {{ content_align }} {% if section.settings.style == 'inset' %}{{ content_inset_class }}{% endif %}">
          <div class="kd-video__content {% if section.settings.display_on_card == true %}{{ card_container_class }}{% endif %}">
            <div class="break-words {% if section.settings.display_on_card == true %}{{ card_content_class }}{% endif %}">
              {{ content }}
            </div>
          </div>
        </div>
      </div>

      <div class="{% if section.settings.style == 'inset' %}max-w-site px-section mx-auto{% else %}bg-scheme-text/80{% endif %}">
        <div
          class="{{ container_class }}{% if section.settings.style == 'inset' %} media media--css-only{% else %} relative{% endif %} banner-section-content--h"
          {% if custom_aspect_h %}
            style="--custom-aspect-h: {{ custom_aspect_h }}"
          {% endif %}
        >
          <data-island
            class="contents"
            x-data="HTMLVideo"
            @play="play"
            @pause="pause"
            on="before:visible"
          >
            {% if video != blank %}
              {{
                video
                | video_tag:
                  class: video_size_class,
                  image_size: '2000x',
                  loading: 'lazy',
                  controls: false,
                  autoplay: true,
                  muted: true,
                  loop: true,
                  playsinline: true,
                  x-ref: 'video'
              }}
            {% else %}
              <video x-ref="video" autoplay playsinline muted class="{{ video_size_class }}">
                <source src="{{ 'placeholder-video.mp4' | asset_url }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            {% endif %}

            {%- if section.settings.enable_overlay -%}
              <div class="kd-video__overlay{% if section.settings.overlay_style == 'solid' %} kd-video__overlay--solid{% endif %}" aria-hidden="true"></div>
            {%- endif -%}
          </data-island>
        </div>
      </div>
    </data-island>
  </div>
  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  assign no_padding = true

  if section.settings.style == 'inset'
    assign no_padding = false
  endif

  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor

  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider, no_padding: no_padding
  endfor
-%}

