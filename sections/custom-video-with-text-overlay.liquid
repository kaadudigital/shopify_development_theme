{%- liquid
  assign video = section.settings.video
  assign crop = section.settings.crop
  assign crop_desktop = section.settings.crop_desktop

  case crop
    when 'vertical'
      assign container_class = 'aspect-w-9 aspect-h-16'
    when 'four-three'
      assign container_class = 'aspect-w-4 aspect-h-3'
    when 'square'
      assign container_class = 'aspect-w-1 aspect-h-1'
    when 'widescreen'
      assign container_class = 'aspect-w-16 aspect-h-9'
    when 'full-screen'
      assign container_class = 'h-screen first-section:h-screen-less-header-group'
    when 'natural'
      assign container_class = 'aspect-[1_/_var(--custom-aspect-h)] w-full'
  endcase

  if crop_desktop == crop
    assign crop_desktop = 'same'
  endif

  case crop_desktop
    when 'four-three'
      assign container_class = container_class | append: ' lg:h-auto lg:aspect-w-4 lg:aspect-h-3'
    when 'widescreen'
      assign container_class = container_class | append: ' lg:h-auto lg:aspect-w-16 lg:aspect-h-9'
    when 'cinematic'
      assign container_class = container_class | append: ' lg:h-auto lg:aspect-w-2.35 lg:aspect-h-1'
    when 'full-screen'
      assign container_class = container_class | append: ' lg:aspect-auto lg:h-screen lg:first-section:h-screen-less-header-group'
    when 'natural'
      assign container_class = container_class | append: ' lg:aspect-[1_/_var(--custom-aspect-h)] lg:h-auto'
  endcase

  if crop == 'natural' or crop_desktop == 'natural'
    if video != blank
      assign custom_aspect_h = video.sources[0].height | times: 1.00000000 | divided_by: video.sources[0].width
    else
      assign custom_aspect_h = 0.5625
    endif
  endif

  assign video_size_class = 'absolute inset-0 w-full h-full object-cover'
  if section.settings.style == 'inset'
    assign video_size_class = video_size_class | append: ' media__styled-element'
  endif

  if section.settings.heading_tag == 'h1'
    assign content_max_width = 'max-w-xl'
  else
    assign content_max_width = 'max-w-lg'
  endif

  assign content_class = 'grid absolute inset-0 w-full h-full'
  assign content_inset_class = 'max-w-site py-5 px-section mx-auto'
  assign card_container_class = 'card'
  assign card_content_class = 'card__surface py-5 lg:py-8 px-5 lg:px-8'

  case section.settings.text_align
    when 'text-left'
      assign content_align = 'justify-start'
    when 'text-center'
      assign content_align = 'justify-center'
    when 'text-right'
      assign content_align = 'justify-end'
  endcase
-%}

{%- liquid
  # Shape-button sources, mirroring snippets/image-with-text-custom.liquid:
  # the mobile image falls back to the desktop one so the aspect ratio is
  # always taken from an image that actually renders.
  assign mobile_button_source = section.settings.button2_image_mobile | default: section.settings.button2_image

  assign cta_text_mobile_display = section.settings.cta_text_mobile
  if cta_text_mobile_display == blank
    assign cta_text_mobile_display = section.settings.cta_text
  endif
-%}

{%- style -%}
  /* Scoped to #shopify-section-{{ section.id }}, the wrapper Shopify renders
     around the section. This block previously used a bare `#{{ section.id }}`,
     which matches no element — no tag here carries that id — so the overlay
     colour and opacity never applied and "Enable video overlay" had no
     visible effect at all. */
  #shopify-section-{{ section.id }} .kaadu-video-overlay {
    position: absolute;
    inset: 0;
    z-index: 15;
    pointer-events: none;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  /* Vertical rhythm per Kaadu Typography & Spacing Docs: overline → headline
     is 16px. The eyebrow takes its colour from the section's colour scheme so
     it follows the scheme selector like the rest of the section. */
  #shopify-section-{{ section.id }} .kaadu-vto__eyebrow {
    margin: 0 0 var(--space-4);
    color: rgb(var(--color-scheme-eyebrow-text));
  }

  {%- if section.settings.button2_image != blank -%}
    /* Custom blob/shape button — same treatment as the one in
       snippets/image-with-text-custom.liquid: the label sits on a merchant
       supplied button image rather than a pill surface, with its own image,
       width, label and colour per breakpoint. Height comes from the source
       image's real aspect ratio so the artwork is never stretched. The
       markup falls back to .btn-primary when no image is set, so the CTA is
       never invisible. 490px is the reference's breakpoint — image, width,
       label and type all flip together there. */
    #shopify-section-{{ section.id }} .kaadu-vto__btn {
      position: relative;
      /* inline-flex, not flex: the button has a fixed pixel width, and the
         section's Text alignment setting positions it via `text-align` on an
         ancestor. A block-level flex box ignores text-align and would pin
         itself to the left edge; inline-level means it follows left / centre /
         right like the .btn-primary fallback does. */
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      cursor: pointer;
      background-color: transparent;
      background-image: url('{{ section.settings.button2_image | image_url: width: 800 }}');
      background-size: contain;
      background-position: center;
      background-repeat: no-repeat;
      transition: transform 0.2s ease-out;
      width: {{ section.settings.button2_width_desktop }}px;
      max-width: 100%;
      aspect-ratio: {{ section.settings.button2_image.aspect_ratio }};
    }
    #shopify-section-{{ section.id }} .kaadu-vto__btn:hover {
      transform: translateY(-2px);
    }
    #shopify-section-{{ section.id }} .kaadu-vto__btn-text {
      color: {{ section.settings.button_text_color_desktop }};
      font-family: var(--font-display);
      font-weight: 400;
      font-size: 20px;
      line-height: 24px;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      padding: 0 var(--space-6);
    }

    @media (max-width: 490px) {
      #shopify-section-{{ section.id }} .kaadu-vto__btn {
        width: {{ section.settings.button2_width_mobile }}px;
        aspect-ratio: {{ mobile_button_source.aspect_ratio }};
        {%- if section.settings.button2_image_mobile != blank %}
          background-image: url('{{ section.settings.button2_image_mobile | image_url: width: 600 }}');
        {%- endif %}
      }
      #shopify-section-{{ section.id }} .kaadu-vto__btn-text {
        color: {{ section.settings.button_text_color_mobile }};
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 16px;
        line-height: 24px;
        letter-spacing: 0;
        text-align: center;
      }
    }

    /* Label swap shares the 490px breakpoint with the button rules above. */
    #shopify-section-{{ section.id }} .kaadu-vto__label--mobile {
      display: none;
    }
    #shopify-section-{{ section.id }} .kaadu-vto__label--desktop {
      display: inline;
    }
    @media (max-width: 490px) {
      #shopify-section-{{ section.id }} .kaadu-vto__label--mobile {
        display: inline;
      }
      #shopify-section-{{ section.id }} .kaadu-vto__label--desktop {
        display: none;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<section
  class="grid bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %} {% unless section.settings.style == 'inset' %}full-bleed-section{% endunless %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="section-content {% if section.settings.style == 'inset' %}py-section-vertical-spacing{% endif %}">
    <data-island
      id="video-{{ section.id }}"
      x-data="Video('inline', 'autoplay')"
      class="relative z-10 h-full lg:bg-transparent"
      x-intersect:enter.margin.25%.0px.75%.0px="play"
      x-intersect:leave.margin.25%.0px.75%.0px="pause"
      on="before:visible"
    >
      {%- if section.settings.cta_url != blank and section.settings.cta_text == blank -%}
        <a href="{{ section.settings.cta_url }}" class="absolute inset-0 z-20"></a>
      {%- endif -%}

      <div
        class="px-section py-section-vertical-spacing {{ content_class }} z-20 text-scheme-text {{ section.settings.place_content }} {{ section.settings.text_align }} {% if section.settings.style == 'inset' %}max-w-site mx-auto{% endif %}"
      >
        {%- capture content -%}
          {% if section.settings.eyebrow != blank %}
            <p class="kaadu-vto__eyebrow h3 break-words">
              {{ section.settings.eyebrow | escape }}
            </p>
          {% endif %}
          {% if section.settings.title != blank %}
            <{{ section.settings.heading_tag }} class="{{ section.settings.heading_tag }}">
              {{ section.settings.title }}
            </{{ section.settings.heading_tag }}>
          {% endif %}
          {% if section.settings.richtext != blank %}
            <div class="rte body mt-4">
              {{ section.settings.richtext }}
            </div>
          {% endif %}
          {% if section.settings.cta_url != blank and section.settings.cta_text != blank %}
            <div class="relative z-10 mt-6">
              {%- if section.settings.button2_image != blank -%}
                {%- comment -%}
                  A single <a> carries the button styling. The reference nests a
                  <button> inside the <a>, which is invalid HTML (interactive
                  content inside a link) — this renders identically without it.
                {%- endcomment -%}
                <a class="kaadu-vto__btn" href="{{ section.settings.cta_url }}">
                  <span class="kaadu-vto__btn-text">
                    <span class="kaadu-vto__label--mobile">{{ cta_text_mobile_display }}</span><span class="kaadu-vto__label--desktop">{{ section.settings.cta_text }}</span>
                  </span>
                </a>
              {%- else -%}
                <a class="btn-primary inline-block" href="{{ section.settings.cta_url }}">
                  {{ section.settings.cta_text }}
                </a>
              {%- endif -%}
            </div>
          {% endif %}
        {%- endcapture -%}

        <div class="flex {{ content_align }} {% if section.settings.style == 'inset' %}{{ content_inset_class }}{% endif %}">
          <div class="{% if section.settings.display_on_card == true %}{{ card_container_class }}{% endif %} {{ content_max_width }} text-scheme-text">
            <div class="break-words {% if section.settings.display_on_card == true %}{{ card_content_class }}{% endif %}">
              {{ content }}
            </div>
          </div>
        </div>
      </div>

      <div class="{% if section.settings.style == 'inset' %}max-w-site px-5 lg:px-10 mx-auto{% else %}bg-scheme-text/80{% endif %}">
        <div
          class="{{ container_class }}{% if section.settings.style == 'inset' %} media media--css-only{% else %} relative{% endif %} banner-section-content--h"
          {% if custom_aspect_h %}
            style="--custom-aspect-h: {{ custom_aspect_h }}"
          {% endif %}
        >
          <data-island
            class="contents"
            x-data="HTMLVideo"
            @play="play"
            @pause="pause"
            on="before:visible"
          >
            {% if video != blank %}
              {{
                video
                | video_tag:
                  class: video_size_class,
                  image_size: '2000x',
                  loading: 'lazy',
                  controls: false,
                  autoplay: true,
                  muted: true,
                  loop: true,
                  playsinline: true,
                  x-ref: 'video'
              }}
            {% else %}
              <video x-ref="video" autoplay playsinline muted class="{{ video_size_class }}">
                <source src="{{ 'placeholder-video.mp4' | asset_url }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            {% endif %}

            {%- if section.settings.enable_overlay -%}
              <div class="kaadu-video-overlay" aria-hidden="true"></div>
            {%- endif -%}
          </data-island>
        </div>
      </div>
    </data-island>
  </div>
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  assign no_padding = true

  if section.settings.style == 'inset'
    assign no_padding = false
  endif

  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor

  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider, no_padding: no_padding
  endfor
-%}

{% schema %}
{
  "name": "Custom Video Text Overlay",
  "class": "banner-section",
  "settings": [
    {
      "type": "header",
      "content": "t:common.settings.header_video"
    },
    {
      "id": "video",
      "type": "video",
      "label": "t:common.settings.video"
    },
    {
      "type": "header",
      "content": "t:sections.video_with_text_overlay.settings.header_aspect_ratio"
    },
    {
      "type": "select",
      "id": "crop",
      "label": "t:common.settings.aspect_ratio__mobile.label",
      "options": [
        { "value": "natural", "label": "t:common.options.natural.label" },
        { "value": "vertical", "label": "t:common.options.vertical_9_16.label" },
        { "value": "square", "label": "t:common.options.square_1_1.label" },
        { "value": "four-three", "label": "t:common.options.standard_4_3.label" },
        { "value": "widescreen", "label": "t:common.options.widescreen_16_9.label" },
        { "value": "full-screen", "label": "t:common.options.full_screen.label" }
      ],
      "default": "vertical"
    },
    {
      "type": "select",
      "id": "crop_desktop",
      "label": "t:sections.video_with_text_overlay.settings.crop_desktop.label",
      "options": [
        { "value": "natural", "label": "t:common.options.natural.label" },
        { "value": "four-three", "label": "t:common.options.standard_4_3.label" },
        { "value": "widescreen", "label": "t:common.options.widescreen_16_9.label" },
        { "value": "cinematic", "label": "t:common.options.extra_wide_235_1.label" },
        { "value": "full-screen", "label": "t:common.options.full_screen.label" }
      ],
      "default": "widescreen"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable video overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:common.settings.header_layout"
    },
    {
      "type": "checkbox",
      "id": "display_on_card",
      "label": "t:common.settings.display_on_card.label",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:common.settings.style.label",
      "default": "full",
      "options": [
        { "value": "inset", "label": "t:common.options.inset.label" },
        { "value": "full", "label": "t:common.options.full_width.label" }
      ]
    },
    {
      "type": "select",
      "id": "place_content",
      "label": "t:common.settings.place_content.label",
      "options": [
        { "value": "place-content-start-start", "label": "t:common.options.top_left.label" },
        { "value": "place-content-start-center", "label": "t:common.options.top_center.label" },
        { "value": "place-content-start-end", "label": "t:common.options.top_right.label" },
        { "value": "place-content-center-start", "label": "t:common.options.middle_left.label" },
        { "value": "place-content-center-center", "label": "t:common.options.middle_center.label" },
        { "value": "place-content-center-end", "label": "t:common.options.middle_right.label" },
        { "value": "place-content-end-start", "label": "t:common.options.bottom_left.label" },
        { "value": "place-content-end-center", "label": "t:common.options.bottom_center.label" },
        { "value": "place-content-end-end", "label": "t:common.options.bottom_right.label" }
      ],
      "default": "place-content-center-center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:common.settings.text_align.label",
      "options": [
        { "value": "text-left", "label": "t:common.options.left.label" },
        { "value": "text-center", "label": "t:common.options.center.label" },
        { "value": "text-right", "label": "t:common.options.right.label" }
      ],
      "default": "text-center"
    },
    {
      "type": "header",
      "content": "t:common.settings.header_content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Short overline above the title (H3 — Subheading style). Uses the colour scheme's eyebrow colour."
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Video with text overlay"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Title style",
      "info": "H1 — Display Headline should only be used once per page (the hero). Use H2 — Section Headline elsewhere.",
      "options": [
        { "value": "h1", "label": "H1 — Display Headline" },
        { "value": "h2", "label": "H2 — Section Headline" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "richtext",
      "label": "Body text",
      "info": "Rendered in the Body Default style."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:common.settings.cta_url.label"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:common.settings.cta_text.label",
      "default": "Shop Now"
    },
    {
      "type": "text",
      "id": "cta_text_mobile",
      "label": "Button label (Mobile)",
      "info": "Leave empty to reuse the desktop label."
    },
    {
      "type": "header",
      "content": "Custom image button"
    },
    {
      "type": "paragraph",
      "content": "Pick a button image to replace the default pill button. The button's height follows the image's own aspect ratio. Without an image the CTA falls back to the standard pill."
    },
    {
      "type": "image_picker",
      "id": "button2_image",
      "label": "Button image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "button2_image_mobile",
      "label": "Button image (Mobile)",
      "info": "Leave empty to reuse the desktop image."
    },
