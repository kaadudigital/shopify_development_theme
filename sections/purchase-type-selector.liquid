<div class="purchase-selector" style="background: #f9c6d0;">
  <div class="purchase-selector__inner">
    <p class="purchase-selector__heading h3">
      {{ section.settings.title }}
    </p>

    <div
      class="purchase-option"
      data-option="1"
      onclick="selectPurchase(1)"
      style="
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #e8f542;
        border: 2px solid #e8f542;
        border-radius: 14px;
        padding: 16px;
        cursor: pointer;
        margin-bottom: 10px;
        transition: background 0.2s;
      "
    >
      <div class="radio-dot" style="
        width: 20px; height: 20px; border-radius: 50%;
        border: 2px solid #cc0000; background: #fff;
        flex-shrink: 0; margin-top: 2px; display: flex;
        align-items: center; justify-content: center;
      ">
        <div style="width: 10px; height: 10px; border-radius: 50%; background: #cc0000;"></div>
      </div>
      <div>
        <div style="font-size: 14px; font-weight: 800; color: #222; text-transform: uppercase;">
          {{ section.settings.option1_title }}
        </div>
        <div style="font-size: 12px; color: #444; margin-top: 4px;">
          {{ section.settings.option1_subtitle }}
        </div>
      </div>
    </div>

    <div
      class="purchase-option"
      data-option="2"
      onclick="selectPurchase(2)"
      style="
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #fff;
        border: 2px solid #ddd;
        border-radius: 14px;
        padding: 16px;
        cursor: pointer;
        transition: background 0.2s;
      "
    >
      <div class="radio-dot" style="
        width: 20px; height: 20px; border-radius: 50%;
        border: 2px solid #aaa; background: #fff;
        flex-shrink: 0; margin-top: 2px;
      "></div>
      <div>
        <div style="font-size: 14px; font-weight: 800; color: #222; text-transform: uppercase;">
          {{ section.settings.option2_title }}
        </div>
        <div style="font-size: 12px; color: #444; margin-top: 4px;">
          {{ section.settings.option2_subtitle }}
        </div>
      </div>
    </div>

    <!-- TODO: Add your cart form here or in a separate section below these two -->
    <form action="/cart/add" method="post" class="purchase-selector__form">
      <input type="hidden" name="id" id="selected-variant-id" value="22222222222">
      <input type="hidden" name="selling_plan" id="selected-selling-plan" value="">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="purchase-selector__submit">
        <span class="purchase-selector__submit-text">{{ section.settings.button_label }}</span>
      </button>
    </form>
  </div>
</div>

<style>
  .purchase-selector__inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .purchase-selector__heading {
    color: var(--color-near-black);
    margin: 0 0 var(--space-3);
  }
  .purchase-selector__form {
    margin-top: 16px;
  }
  .purchase-selector__submit {
    width: 100%;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease-out;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    {%- if section.settings.button_image != blank -%}
      background-image: url('{{ section.settings.button_image | image_url: width: 800 }}');
      aspect-ratio: {{ section.settings.button_image.aspect_ratio }};
    {%- else -%}
      background: var(--color-lime);
      border-radius: var(--radius-btn);
    {%- endif -%}
  }
  .purchase-selector__submit:hover {
    transform: translateY(-2px);
  }
  {%- if section.settings.button_image_mobile != blank -%}
    @media (max-width: 490px) {
      .purchase-selector__submit {
        background-image: url('{{ section.settings.button_image_mobile | image_url: width: 600 }}');
        aspect-ratio: {{ section.settings.button_image_mobile.aspect_ratio }};
      }
    }
  {%- endif -%}
  .purchase-selector__submit-text {
    color: {{ section.settings.button_text_color_desktop | default: '#222222' }};
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 400;
    line-height: 24px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 0 var(--space-6);
  }
  @media (min-width: 491px) {
    .purchase-selector__submit-text {
      padding-top: {{ section.settings.button_padding_topbottom | default: 16 }}px;
      padding-bottom: {{ section.settings.button_padding_topbottom | default: 16 }}px;
    }
  }
  @media (max-width: 490px) {
    .purchase-selector__submit-text {
      color: {{ section.settings.button_text_color_mobile | default: '#222222' }};
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 16px;
      line-height: 24px;
      letter-spacing: 0;
      text-align: center;
    }
  }
</style>

<script>
  // TODO: Replace this dummy selling plan ID with your real selling plan ID from your subscription app
  var subscriptionSellingPlanId = '99999999999';

  function selectPurchase(option) {
    document.querySelectorAll('.purchase-option').forEach(function(el) {
      el.style.background = '#fff';
      el.style.borderColor = '#ddd';
      var dot = el.querySelector('.radio-dot');
      dot.style.borderColor = '#aaa';
      dot.innerHTML = '';
    });

    var selected = document.querySelector('.purchase-option[data-option="' + option + '"]');
    if (selected) {
      selected.style.background = '#e8f542';
      selected.style.borderColor = '#e8f542';
      var dot = selected.querySelector('.radio-dot');
      dot.style.borderColor = '#cc0000';
      dot.innerHTML = '<div style="width:10px;height:10px;border-radius:50%;background:#cc0000;margin:auto;margin-top:3px;"></div>';
    }

    var sellingPlanInput = document.getElementById('selected-selling-plan');
    if (sellingPlanInput) {
      sellingPlanInput.value = (option === 2) ? subscriptionSellingPlanId : '';
    }
  }

  document.addEventListener('DOMContentLoaded', function() { selectPurchase(1); });
</script>

{% schema %}
{
  "name": "Purchase Type Selector",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "EINMALIG ODER IM ABO" },
    { "type": "text", "id": "option1_title", "label": "Option 1 Title", "default": "EINMALIG KAUFEN" },
    { "type": "text", "id": "option1_subtitle", "label": "Option 1 Subtitle", "default": "Ohne Verpflichtung, jederzeit nachbestellen." },
    { "type": "text", "id": "option2_title", "label": "Option 2 Title", "default": "CRUNCH-ABO — SPAR 10%" },
    { "type": "text", "id": "option2_subtitle", "label": "Option 2 Subtitle", "default": "Lieferung alle 4 oder 8 Wochen · gratis Versand · jederzeit pausierbar oder kündbar." },
    { "type": "header", "content": "Submit Button" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "IN DEN WARENKORB" },
    { "type": "image_picker", "id": "button_image", "label": "Button Image (desktop)", "info": "Optional. Falls back to a lime pill button when empty." },
    { "type": "image_picker", "id": "button_image_mobile", "label": "Button Image (mobile)", "info": "Optional. Falls back to the desktop image when empty." },
    { "type": "color", "id": "button_text_color_desktop", "label": "Button Text Color (desktop)", "default": "#222222" },
    { "type": "color", "id": "button_text_color_mobile", "label": "Button Text Color (mobile)", "default": "#222222" },
    { "type": "range", "id": "button_padding_topbottom", "label": "Button Vertical Padding (desktop)", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Purchase Type Selector" }]
}
{% endschema %}
