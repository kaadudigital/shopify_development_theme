{%- comment -%}
  Kaadu comparison slider ("Kaadu > Andere"), as in the landing-page mockup. Two full-size layers; the Kaadu layer is
  revealed with a clip-path driven by --kd-pos behind a 2px edge. A native range input drives it, so it works with
  keyboard and touch. Each layer: its photo covers the whole frame, label on top, list at the bottom. While nobody
  touches it the handle rocks slowly a few px back and forth (data-rock-*), to show that it can be moved. Mobile has its own kicker, heading
  and footnote, rows can be hidden there, and info cards ("note" blocks) sit under the slider.
  Colours are section settings (--kd-cmp-*); with «Use the colours below» off everything follows the colour scheme.
  Styles: "COMPARISON" in assets/base.bundle.css; behaviour: [data-kd-compare] in assets/kaadu.js.
{%- endcomment -%}
{%- liquid
  assign rows = section.blocks | where: 'type', 'row'
  assign notes = section.blocks | where: 'type', 'note'
  assign start = section.settings.start_position | default: 55
  assign kicker_m = section.settings.mobile_kicker | default: section.settings.kicker
  assign heading_m = section.settings.mobile_heading | default: section.settings.heading
  assign footnote_m = section.settings.mobile_footnote | default: section.settings.footnote
-%}

{%- style -%}
  #{{ section.id }} {
    {%- comment -%} Only when "Use the colours below" is on; unset, the CSS falls back to the colour scheme. {%- endcomment -%}
    {%- if section.settings.use_custom_colors -%}
      {%- liquid
        assign cmp_colors = 'bg:background_color,kicker:kicker_color,heading:heading_color,note:note_color,kaadu-bg:kaadu_bg_color,kaadu-text:kaadu_text_color,other-bg:other_bg_color,other-text:other_text_color,pill-bg:pill_bg_color,pill-text:pill_text_color,handle:handle_color,handle-arrow:handle_arrow_color,card:card_color,card-text:card_text_color' | split: ','
      -%}
      {%- for pair in cmp_colors -%}
        {%- assign kv = pair | split: ':' -%}
        {%- assign value = section.settings[kv[1]] -%}
        {%- if value != blank %}
    --kd-cmp-{{ kv[0] }}: {{ value }};
        {%- endif -%}
      {%- endfor %}
    {%- endif %}
  }
{%- endstyle -%}

<section
  id="{{ section.id }}"
  class="kd-compare-section relative overflow-hidden bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="kd-section kd-compare-section__inner">
    <div class="kd-heading kd-heading--center">
      {%- if section.settings.kicker != blank or kicker_m != blank -%}
        <p class="kd-heading__kicker kd-label kd-compare-section__kicker">
          {%- if section.settings.kicker != blank -%}<span class="kd-compare-section__d">{{ section.settings.kicker | escape }}</span>{%- endif -%}
          {%- if kicker_m != blank -%}<span class="kd-compare-section__m">{{ kicker_m | escape }}</span>{%- endif -%}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank or heading_m != blank -%}
        <h2 class="kd-heading__title kd-display-h2-tight">
          {%- if section.settings.heading != blank -%}<span class="kd-compare-section__d">{{ section.settings.heading | escape }}</span>{%- endif -%}
          {%- if heading_m != blank -%}<span class="kd-compare-section__m">{{ heading_m | escape }}</span>{%- endif -%}
        </h2>
      {%- endif -%}
    </div>

    <div
      class="kd-compare"
      data-kd-compare
      data-rock="{{ section.settings.rock_enabled }}"
      data-rock-distance="{{ section.settings.rock_distance }}"
      data-rock-speed="{{ section.settings.rock_speed | times: 1000 }}"
      data-rock-delay="{{ section.settings.rock_delay | times: 1000 }}"
      style="--kd-pos: {{ start }}%; --kd-cmp-shade: {{ section.settings.photo_shade | divided_by: 100.0 }};"
    >
      {%- comment -%} Base layer: "Der Rest" (right side) {%- endcomment -%}
      <div class="kd-compare__layer kd-compare__layer--other">
        <div class="kd-compare__col kd-compare__col--other">
          {%- if section.settings.other_label != blank -%}
            <p class="kd-compare__pill kd-tag">{{ section.settings.other_label | escape }}</p>
          {%- endif -%}
          <div class="kd-compare__media">
            {%- if section.settings.other_image != blank -%}
              {{ section.settings.other_image | image_url: width: 2200 | image_tag: class: 'kd-compare__photo', loading: 'lazy', widths: '600, 900, 1200, 1600, 2200', sizes: '(min-width: 1441px) 77vw, (min-width: 1200px) 1100px, calc(100vw - 40px)' }}
            {%- endif -%}
          </div>
          <ul class="kd-compare__list">
            {%- for row in rows -%}
              {%- if row.settings.other_text != blank -%}
                <li class="kd-strong-md{% unless row.settings.show_on_mobile %} kd-compare__row--desktop{% endunless %}"><span>{{ row.settings.other_text | escape }}</span> <span class="kd-compare__mark" aria-hidden="true">&#10005;</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

      {%- comment -%} Top layer: Kaadu (left side), clipped at --kd-pos {%- endcomment -%}
      <div class="kd-compare__layer kd-compare__layer--kaadu">
        <div class="kd-compare__col kd-compare__col--kaadu">
          {%- if section.settings.kaadu_logo != blank -%}
            {{ section.settings.kaadu_logo | image_url: width: 300 | image_tag: class: 'kd-compare__logo', alt: section.settings.kaadu_label, loading: 'lazy' }}
          {%- elsif section.settings.kaadu_label != blank -%}
            <p class="kd-compare__pill kd-tag">{{ section.settings.kaadu_label | escape }}</p>
          {%- endif -%}
          <div class="kd-compare__media">
            {%- if section.settings.kaadu_image != blank -%}
              {{ section.settings.kaadu_image | image_url: width: 2200 | image_tag: class: 'kd-compare__photo', loading: 'lazy', widths: '600, 900, 1200, 1600, 2200', sizes: '(min-width: 1441px) 77vw, (min-width: 1200px) 1100px, calc(100vw - 40px)' }}
            {%- endif -%}
          </div>
          <ul class="kd-compare__list">
            {%- for row in rows -%}
              {%- if row.settings.kaadu_text != blank -%}
                <li class="kd-strong-md{% unless row.settings.show_on_mobile %} kd-compare__row--desktop{% endunless %}"><span class="kd-compare__mark" aria-hidden="true">&#10003;</span> <span>{{ row.settings.kaadu_text | escape }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

      <div class="kd-compare__edge" aria-hidden="true"><span class="kd-compare__handle">&#8596;</span></div>
      <label class="kd-sr" for="kd-compare-{{ section.id }}">{{ section.settings.slider_label | escape }}</label>
      <input
        class="kd-compare__range"
        type="range"
        id="kd-compare-{{ section.id }}"
        min="4"
        max="96"
        step="1"
        value="{{ start }}"
      >
    </div>

    {%- comment -%} Screen readers get the comparison as a plain list {%- endcomment -%}
    <table class="kd-sr">
      <caption>{{ section.settings.heading | escape }}</caption>
      <tr><th scope="col">{{ section.settings.kaadu_label | escape }}</th><th scope="col">{{ section.settings.other_label | escape }}</th></tr>
      {%- for row in rows -%}
        <tr><td>{{ row.settings.kaadu_text | escape }}</td><td>{{ row.settings.other_text | escape }}</td></tr>
      {%- endfor -%}
    </table>

    {%- if notes.size > 0 -%}
      <div class="kd-compare-section__notes">
        {%- for note in notes -%}
          <div class="kd-compare-section__card kd-compare-section__card--{{ note.settings.show_on }}" {{ note.shopify_attributes }}>
            {%- if note.settings.title != blank -%}<strong>{{ note.settings.title | escape }}</strong> {% endif -%}
            {{- note.settings.text | escape -}}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank or footnote_m != blank -%}
      <div class="kd-compare-section__note kd-body-sm">
        {%- if section.settings.footnote != blank -%}<div class="kd-compare-section__d">{{ section.settings.footnote }}</div>{%- endif -%}
        {%- if footnote_m != blank -%}<div class="kd-compare-section__m">{{ footnote_m }}</div>{%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

{% schema %}
{
  "name": "Kaadu comparison slider",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Kaadu > Andere"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wir sind einfach besser."
    },
    {
      "type": "text",
      "id": "mobile_kicker",
      "label": "Kicker on mobile",
      "info": "Below 768px. Empty: same as desktop."
    },
    {
      "type": "text",
      "id": "mobile_heading",
      "label": "Heading on mobile",
      "info": "Below 768px. Empty: same as desktop."
    },
    {
      "type": "header",
      "content": "Kaadu side (left)"
    },
    {
      "type": "text",
      "id": "kaadu_label",
      "label": "Label",
      "default": "Kaadu"
    },
    {
      "type": "image_picker",
      "id": "kaadu_logo",
      "label": "Logo",
      "info": "Full-colour logo; shown instead of the label (DS: logo on lime at full colour)."
    },
    {
      "type": "image_picker",
      "id": "kaadu_image",
      "label": "Photo"
    },
    {
      "type": "header",
      "content": "Other side (right)"
    },
    {
      "type": "text",
      "id": "other_label",
      "label": "Label",
      "default": "Der Rest"
    },
    {
      "type": "image_picker",
      "id": "other_image",
      "label": "Photo"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "start_position",
      "label": "Start position",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "text",
      "id": "slider_label",
      "label": "Slider label (screen readers)",
      "default": "Vergleich verschieben"
    },
    {
      "type": "checkbox",
      "id": "rock_enabled",
      "label": "Rock the slider while nobody touches it",
      "info": "The handle sways gently back and forth to show it can be moved. Stops while the visitor hovers, drags or focuses it; never runs with reduced motion.",
      "default": true
    },
    {
      "type": "range",
      "id": "rock_distance",
      "label": "Rock distance (each way)",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "rock_speed",
      "label": "One back-and-forth takes",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "range",
      "id": "photo_shade",
      "label": "Darken photos",
      "info": "Helps the label and list stay readable on busy photos.",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "rock_delay",
      "label": "Start rocking after",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 2
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "richtext",
      "id": "mobile_footnote",
      "label": "Footnote on mobile",
      "info": "Below 768px. Empty: same as desktop."
    },
    {
      "type": "header",
