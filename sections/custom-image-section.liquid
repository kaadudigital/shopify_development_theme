{%- liquid
  assign preload = false
  if section.index == 1
    assign preload = true
  endif

  # "kd_row" = Kaadu DS flowing row (image beside a centred text column).
  # "freeform" = legacy absolutely-positioned composition (x/y % per element).
  assign is_row = false
  if section.settings.layout == 'kd_row'
    assign is_row = true
  endif

  case section.settings.heading_style
    when 'mega-heading'
      assign kd_heading_class = 'kd-display-crunchys'
    when 'h1'
      assign kd_heading_class = 'kd-display-hero'
    when 'h3'
      assign kd_heading_class = 'kd-display-h2-tight'
    else
      assign kd_heading_class = 'kd-display-h2'
  endcase

  assign kd_button_variant = 'red'
  if section.settings.button_style == 'btn-primary'
    assign kd_button_variant = 'primary'
  endif
-%}

{%- if is_row -%}
{% style %}
  /* Row layout: only the heading / sub-heading sticker placement is setting-driven. */
  .section-{{ section.id }} .hero-heading-wrap,
  .section-{{ section.id }} .hero-subheading-wrap {
    position: relative;
    display: inline-block;
  }
  .section-{{ section.id }} .hero-heading-sticker,
  .section-{{ section.id }} .hero-subheading-sticker {
    position: absolute;
    height: auto;
    pointer-events: none;
    z-index: 4;
  }
  .section-{{ section.id }} .hero-heading-sticker {
    left: {{ section.settings.heading_sticker_x_desktop }}%;
    top: {{ section.settings.heading_sticker_y_desktop }}%;
    width: {{ section.settings.heading_sticker_width_desktop }}px;
    transform: translate(-50%, -50%) rotate({{ section.settings.heading_sticker_rotate }}deg);
  }
  .section-{{ section.id }} .hero-subheading-sticker {
    left: {{ section.settings.subheading_sticker_x_desktop }}%;
    top: {{ section.settings.subheading_sticker_y_desktop }}%;
    width: {{ section.settings.subheading_sticker_width_desktop }}px;
    transform: translate(-50%, -50%) rotate({{ section.settings.subheading_sticker_rotate }}deg);
  }
  .section-{{ section.id }} .hero-subheading-sticker--2 {
    left: {{ section.settings.subheading_sticker_2_x_desktop }}%;
    top: {{ section.settings.subheading_sticker_2_y_desktop }}%;
    width: {{ section.settings.subheading_sticker_2_width_desktop }}px;
    transform: translate(-50%, -50%) rotate({{ section.settings.subheading_sticker_2_rotate }}deg);
  }
  @media (max-width: 767.98px) {
    .section-{{ section.id }} .hero-heading-sticker {
      left: {{ section.settings.heading_sticker_x_mobile }}%;
      top: {{ section.settings.heading_sticker_y_mobile }}%;
      width: {{ section.settings.heading_sticker_width_mobile }}px;
    }
    .section-{{ section.id }} .hero-subheading-sticker {
      left: {{ section.settings.subheading_sticker_x_mobile }}%;
      top: {{ section.settings.subheading_sticker_y_mobile }}%;
      width: {{ section.settings.subheading_sticker_width_mobile }}px;
    }
    .section-{{ section.id }} .hero-subheading-sticker--2 {
      left: {{ section.settings.subheading_sticker_2_x_mobile }}%;
      top: {{ section.settings.subheading_sticker_2_y_mobile }}%;
      width: {{ section.settings.subheading_sticker_2_width_mobile }}px;
    }
    {%- unless section.settings.heading_sticker_show_mobile %}
    .section-{{ section.id }} .hero-heading-sticker { display: none; }
    {% endunless -%}
    {%- unless section.settings.subheading_sticker_show_mobile %}
    .section-{{ section.id }} .hero-subheading-sticker:not(.hero-subheading-sticker--2) { display: none; }
    {% endunless -%}
    {%- unless section.settings.subheading_sticker_2_show_mobile %}
    .section-{{ section.id }} .hero-subheading-sticker--2 { display: none; }
    {% endunless -%}
  }

  /* Per screen size (m <768, t 768–1199, d 1200–1799, xl ≥1800): image rotation, an optional
     free canvas (image + text placed by X/Y % on a stage of fixed height) and an optional custom
     button position anywhere in the section. The text group is a grid item, not positioned, so the
     button's containing block stays the stage in both layouts. */
  .section-{{ section.id }} .kd-is .kd-is__row { position: relative; }
  {%- assign kd_bps = 'm,t,d,xl' | split: ',' -%}
  {%- for bp in kd_bps -%}
    {%- liquid
      case bp
        when 'm'
          assign mq = '(max-width: 767.98px)'
        when 't'
          assign mq = '(min-width: 768px) and (max-width: 1199.98px)'
        when 'd'
          assign mq = '(min-width: 1200px) and (max-width: 1799.98px)'
        else
          assign mq = '(min-width: 1800px)'
      endcase
      assign k_rot = 'image_rotate_' | append: bp
      assign k_on = 'canvas_' | append: bp
      assign k_h = 'canvas_height_' | append: bp
      assign k_ix = 'canvas_image_x_' | append: bp
      assign k_iy = 'canvas_image_y_' | append: bp
      assign k_iw = 'canvas_image_w_' | append: bp
      assign k_tx = 'canvas_text_x_' | append: bp
      assign k_ty = 'canvas_text_y_' | append: bp
      assign k_bp = 'button_position_' | append: bp
      assign k_bx = 'button_x_' | append: bp
      assign k_by = 'button_y_' | append: bp
      assign rot = section.settings[k_rot] | default: 0
    -%}
  @media {{ mq }} {
    .section-{{ section.id }} .kd-is__media { transform: rotate({{ rot }}deg); }
    {%- if section.settings[k_on] %}
    .section-{{ section.id }} .kd-is .kd-is__row {
      display: grid;
      height: {{ section.settings[k_h] }}px;
      grid-template-columns: {{ section.settings[k_tx] }}% 0 1fr;
      grid-template-rows: {{ section.settings[k_ty] }}% 0 1fr;
      grid-template-areas: none;
      gap: 0;
    }
    .section-{{ section.id }} .kd-is .kd-is__media {
      position: absolute;
      left: {{ section.settings[k_ix] }}%;
      top: {{ section.settings[k_iy] }}%;
      width: {{ section.settings[k_iw] }}%;
      max-width: none;
      z-index: {% if section.settings.canvas_image_front %}3{% else %}0{% endif %};
      transform: translate(-50%, -50%) rotate({{ rot }}deg);
    }
    /* A 0 × 0 grid cell at the text X/Y; centred items overflow it evenly, so the text centres on that point. */
    .section-{{ section.id }} .kd-is .kd-is__text-group {
      grid-area: 2 / 2;
      justify-self: center;
      align-self: center;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-6);
      width: max-content;
      max-width: min(90vw, 900px);
    }
    {%- endif -%}
    {%- if section.settings[k_bp] == 'custom' %}
    .section-{{ section.id }} .kd-is .kd-is__button {
      position: absolute;
      left: {{ section.settings[k_bx] }}%;
      top: {{ section.settings[k_by] }}%;
      transform: translate(-50%, -50%);
      z-index: 4;
    }
    {%- endif %}
  }
  {%- endfor %}
{% endstyle %}
{%- else -%}
{% style %}
  .section-{{ section.id }} {
    position: relative;
    overflow: hidden;
    min-height: {{ section.settings.section_height_desktop }}px;
  }

  /* Positioning container capped at the design-system content max (1800px).
     The image and cards anchor their % coordinates to this box instead
     of the viewport, so the layout stops spreading on wide displays
     while the section background stays full-bleed. */
  .section-{{ section.id }} .kaadu-is__container {
    position: relative;
    max-width: var(--container-max);
    margin-inline: auto;
    min-height: inherit;
  }

  .section-{{ section.id }} .hero-bg-image {
    position: absolute;
    left: {{ section.settings.image_x_desktop }}%;
    top: {{ section.settings.image_y_desktop }}%;
    width: {{ section.settings.image_width_desktop }}px;
    height: auto;
    z-index: 5;
    transform: translate(-50%, -50%);
  }

  .section-{{ section.id }} .hero-header-card {
    position: absolute;
    left: {{ section.settings.header_x_desktop }}%;
    top: {{ section.settings.header_y_desktop }}%;
    transform: translate(-50%, -50%);
    z-index: 2;
    max-width: 90%;
  }

  .section-{{ section.id }} .hero-heading-wrap {
    position: relative;
    display: inline-block;
  }

  .section-{{ section.id }} .hero-heading-sticker {
    position: absolute;
    left: {{ section.settings.heading_sticker_x_desktop }}%;
    top: {{ section.settings.heading_sticker_y_desktop }}%;
    width: {{ section.settings.heading_sticker_width_desktop }}px;
    height: auto;
    transform: translate(-50%, -50%) rotate({{ section.settings.heading_sticker_rotate }}deg);
    pointer-events: none;
    z-index: 4;
  }

  .section-{{ section.id }} .hero-subheading-card {
    position: absolute;
    left: {{ section.settings.subheading_x_desktop }}%;
    top: {{ section.settings.subheading_y_desktop }}%;
    transform: translate(-50%, -50%);
    z-index: 2;
    max-width: 90%;
  }

  .section-{{ section.id }} .hero-subheading-wrap {
    position: relative;
    display: inline-block;
  }

  .section-{{ section.id }} .hero-subheading-sticker {
    position: absolute;
    left: {{ section.settings.subheading_sticker_x_desktop }}%;
    top: {{ section.settings.subheading_sticker_y_desktop }}%;
    width: {{ section.settings.subheading_sticker_width_desktop }}px;
    height: auto;
    transform: translate(-50%, -50%) rotate({{ section.settings.subheading_sticker_rotate }}deg);
    pointer-events: none;
    z-index: 4;
  }

  .section-{{ section.id }} .hero-subheading-sticker--2 {
    left: {{ section.settings.subheading_sticker_2_x_desktop }}%;
    top: {{ section.settings.subheading_sticker_2_y_desktop }}%;
    width: {{ section.settings.subheading_sticker_2_width_desktop }}px;
    transform: translate(-50%, -50%) rotate({{ section.settings.subheading_sticker_2_rotate }}deg);
  }

  .section-{{ section.id }} .hero-body-card {
    position: absolute;
    left: {{ section.settings.body_x_desktop }}%;
    top: {{ section.settings.body_y_desktop }}%;
    transform: translate(-50%, -50%);
    z-index: 2;
    max-width: 90%;
  }

  @media (max-width: 768px) {
    .section-{{ section.id }} {
      min-height: {{ section.settings.section_height_mobile }}px;
    }

    .section-{{ section.id }} .hero-bg-image {
      left: {{ section.settings.image_x_mobile }}%;
      top: {{ section.settings.image_y_mobile }}%;
      width: {{ section.settings.image_width_mobile }}px;
      max-width: none;
    }

    .section-{{ section.id }} .hero-header-card {
      left: {{ section.settings.header_x_mobile }}%;
      top: {{ section.settings.header_y_mobile }}%;
    }

    .section-{{ section.id }} .hero-heading-sticker {
      left: {{ section.settings.heading_sticker_x_mobile }}%;
      top: {{ section.settings.heading_sticker_y_mobile }}%;
      width: {{ section.settings.heading_sticker_width_mobile }}px;
    }

    .section-{{ section.id }} .hero-subheading-sticker {
      left: {{ section.settings.subheading_sticker_x_mobile }}%;
      top: {{ section.settings.subheading_sticker_y_mobile }}%;
      width: {{ section.settings.subheading_sticker_width_mobile }}px;
    }

    .section-{{ section.id }} .hero-subheading-sticker--2 {
      left: {{ section.settings.subheading_sticker_2_x_mobile }}%;
      top: {{ section.settings.subheading_sticker_2_y_mobile }}%;
      width: {{ section.settings.subheading_sticker_2_width_mobile }}px;
    }

    {%- unless section.settings.heading_sticker_show_mobile %}
    .section-{{ section.id }} .hero-heading-sticker {
      display: none;
    }
    {% endunless -%}

    {%- unless section.settings.subheading_sticker_show_mobile %}
    .section-{{ section.id }} .hero-subheading-sticker:not(.hero-subheading-sticker--2) {
      display: none;
    }
    {% endunless -%}

    {%- unless section.settings.subheading_sticker_2_show_mobile %}
    .section-{{ section.id }} .hero-subheading-sticker--2 {
      display: none;
    }
    {% endunless -%}

    .section-{{ section.id }} .hero-body-card {
      left: {{ section.settings.body_x_mobile }}%;
      top: {{ section.settings.body_y_mobile }}%;
    }

    .section-{{ section.id }} .hero-subheading-card {
      left: {{ section.settings.subheading_x_mobile }}%;
      top: {{ section.settings.subheading_y_mobile }}%;
    }
  }

  @media (max-width: 490px) {
    .section-{{ section.id }} .hero-header-card,
    .section-{{ section.id }} .hero-subheading-card {
      width: 90%;
    }
  }
{% endstyle %}
{%- endif -%}

<section
  class="section-{{ section.id }} bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %} relative overflow-hidden"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  {%- if is_row -%}
    {%- liquid
      assign row_image = section.settings.background_image | default: section.settings.background_image_mobile
      assign quote_mode = false
      if section.settings.heading == blank and section.settings.subheading != blank
        assign quote_mode = true
      endif
    -%}
    <div class="kd-is kd-section kd-is--image-{{ section.settings.row_image_position | default: 'left' }}{% if row_image == blank %} kd-is--no-image{% endif %}{% if quote_mode %} kd-is--quote{% endif %}{% unless section.settings.image_shadow %} kd-is--flat{% endunless %}">
      <div class="kd-wide kd-is__row">
        {%- if row_image != blank -%}
          <div class="kd-is__media">
            {{
              row_image
              | image_url: width: 1200
              | image_tag:
                class: 'kd-is__image',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 1200px) 560px, (min-width: 768px) 45vw, 100vw',
                loading: 'lazy'
            }}
          </div>
        {%- endif -%}

        <div class="kd-is__text-group">
        {%- if section.settings.heading != blank -%}
          <div class="kd-is__head">
            <div class="hero-heading-wrap">
              <{{ section.settings.heading_tag }} class="kd-is__title {{ kd_heading_class }}">
                {{- section.settings.heading | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' -}}
              </{{ section.settings.heading_tag }}>
              {%- if section.settings.heading_sticker_image != blank -%}
                {{ section.settings.heading_sticker_image | image_url: width: 600 | image_tag: class: 'hero-heading-sticker', alt: '', loading: 'lazy' }}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="kd-is__body">
          {%- if section.settings.subheading != blank -%}
            <div class="hero-subheading-wrap">
              {%- if quote_mode -%}
                <figure class="kd-is__figure">
                  <blockquote class="kd-is__quote kd-display-quote">
                    {{- section.settings.subheading | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' -}}
                  </blockquote>
                  {%- if section.settings.quote_cite != blank -%}
                    <figcaption><cite class="kd-is__cite kd-tag">{{ section.settings.quote_cite | escape }}</cite></figcaption>
                  {%- endif -%}
                </figure>
              {%- else -%}
                <p class="kd-is__subheading kd-body-lg">
                  {{- section.settings.subheading | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' -}}
                </p>
              {%- endif -%}
              {%- if section.settings.subheading_sticker_image != blank -%}
                {{ section.settings.subheading_sticker_image | image_url: width: 600 | image_tag: class: 'hero-subheading-sticker', alt: '', loading: 'lazy' }}
              {%- endif -%}
              {%- if section.settings.subheading_sticker_2_image != blank -%}
                {{ section.settings.subheading_sticker_2_image | image_url: width: 600 | image_tag: class: 'hero-subheading-sticker hero-subheading-sticker--2', alt: '', loading: 'lazy' }}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.body_text != blank -%}
            <div class="kd-is__text rte kd-body-lg">{{ section.settings.body_text }}</div>
          {%- endif -%}

          {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
            <div class="kd-is__button">
              {%- render 'kd-button', label: section.settings.button_label, url: section.settings.button_link, variant: kd_button_variant -%}
            </div>
          {%- endif -%}
        </div>
        </div>
      </div>
    </div>
  {%- else -%}
  <div class="kaadu-is__container">
  {%- if section.settings.background_image != blank or section.settings.background_image_mobile != blank -%}
    {%- assign desktop_image = section.settings.background_image -%}
    {%- assign mobile_image = section.settings.background_image_mobile | default: desktop_image -%}
    {%- if desktop_image == blank -%}
      {%- assign desktop_image = mobile_image -%}
    {%- endif -%}
    <picture>
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 768px)"
          srcset="{{ mobile_image | image_url: width: 800, format: 'webp' }}"
          type="image/webp"
        >
        <source
          media="(max-width: 768px)"
          srcset="{{ mobile_image | image_url: width: 800 }}"
        >
      {%- endif -%}
      <source
        srcset="{{ desktop_image | image_url: width: section.settings.image_width_desktop, format: 'webp' }}"
        type="image/webp"
      >
      <img
        class="hero-bg-image"
        src="{{ desktop_image | image_url: width: section.settings.image_width_desktop }}"
        alt="{{ desktop_image.alt | escape }}"
        width="{{ desktop_image.width }}"
        height="{{ desktop_image.height }}"
        {% if preload %}
          loading="eager" fetchpriority="high"
        {% else %}
          loading="lazy"
        {% endif %}
      >
    </picture>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <div class="hero-header-card {% if section.settings.header_display_on_card %}bg-scheme-card text-scheme-card-text rounded p-4{% endif %} {{ section.settings.text_alignment_header }}">
      <div class="hero-heading-wrap">
        <{{ section.settings.heading_tag }} class="{{ section.settings.heading_style }}">
          {{ section.settings.heading | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' }}
        </{{ section.settings.heading_tag }}>
        {%- if section.settings.heading_sticker_image != blank -%}
          <img
            class="hero-heading-sticker"
            src="{{ section.settings.heading_sticker_image | image_url: width: 600 }}"
            alt="{{ section.settings.heading_sticker_image.alt | escape }}"
            width="{{ section.settings.heading_sticker_image.width }}"
            height="{{ section.settings.heading_sticker_image.height }}"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.subheading != blank -%}
    <div class="hero-subheading-card {% if section.settings.subheading_display_on_card %}bg-scheme-card text-scheme-card-text rounded p-4{% endif %} {{ section.settings.text_alignment_header }}">
      <div class="hero-subheading-wrap">
        <p class="h4-subsection-heading">
          {{ section.settings.subheading | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' }}
        </p>
        {%- if section.settings.subheading_sticker_image != blank -%}
          <img
            class="hero-subheading-sticker"
            src="{{ section.settings.subheading_sticker_image | image_url: width: 600 }}"
            alt="{{ section.settings.subheading_sticker_image.alt | escape }}"
            width="{{ section.settings.subheading_sticker_image.width }}"
            height="{{ section.settings.subheading_sticker_image.height }}"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.subheading_sticker_2_image != blank -%}
          <img
            class="hero-subheading-sticker hero-subheading-sticker--2"
            src="{{ section.settings.subheading_sticker_2_image | image_url: width: 600 }}"
            alt="{{ section.settings.subheading_sticker_2_image.alt | escape }}"
            width="{{ section.settings.subheading_sticker_2_image.width }}"
            height="{{ section.settings.subheading_sticker_2_image.height }}"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.body_text != blank or section.settings.button_label != blank -%}
    <div class="hero-body-card {% if section.settings.body_display_on_card %}bg-scheme-card text-scheme-card-text rounded p-4{% endif %} {{ section.settings.text_alignment }}">
      {%- if section.settings.body_text != blank -%}
        <div class="rte body-large">{{ section.settings.body_text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="{{ section.settings.button_style }} mt-4">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
  </div>

  {%- endif -%}

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

{% schema %}
{
  "name": "Custom Sticker Heading",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "kd_row",
          "label": "Design system row"
        },
        {
          "value": "freeform",
          "label": "Free-form (legacy)"
        }
      ],
      "default": "freeform",
      "info": "Design system row: image beside a centred text column that reflows on every screen; each screen size can switch to a free canvas under \"Image & button placement\". The legacy position, size and height settings further down only apply to Free-form, except the sticker settings. If there is no heading, the sub-heading is shown as a pull quote."
    },
    {
      "type": "select",
      "id": "row_image_position",
      "label": "Image position (design system row)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "quote_cite",
      "label": "Quote attribution (design system row)",
      "info": "Shown as a pill under the pull quote, e.g. [NAME], Verarbeitung in Vadacode. No names without consent (DS)."
    },
    {
      "type": "header",
      "content": "Image & button placement",
      "info": "Design system row only. Set each screen size separately so the image and the heading meet the way you want. The free canvas places the image and the text block by X/Y (% of the section, measured to their centre) on a stage of fixed height."
    },
    {
      "type": "checkbox",
      "id": "image_shadow",
      "label": "Image shadow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "canvas_image_front",
      "label": "Free canvas: image in front of the text",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "image_rotate_m",
      "label": "Image rotation",
      "min": -45,
      "max": 45,
      "step": 1,
      "unit": "°",
      "default": 0
    },
