{%- comment -%}
  Kaadu — Problem / Stakeholder Section
  "Wer profitiert von Kaadu?" — an accessible tab component. Each stakeholder
  is a repeatable block (label doubles as the tab button + panel heading);
  clicking a tab swaps the panel below (image, copy, lime highlight box).
  See Figma node 322:203.
{%- endcomment -%}

<section
  class="kaadu-problem relative overflow-hidden bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="kaadu-problem__container relative z-10">

    {%- if section.settings.eyebrow_tag != blank -%}
      <span class="kaadu-problem__eyebrow-tag caption bg-scheme-accent-1 text-scheme-accent-1-contrast">{{ section.settings.eyebrow_tag | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="kaadu-problem__heading h2">
        {{ section.settings.heading | escape | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' }}
      </h2>
    {%- endif -%}

    {%- if section.settings.intro_text != blank -%}
      <div class="kaadu-problem__intro rte body-large">{{ section.settings.intro_text }}</div>
    {%- endif -%}

    {%- assign stakeholders = section.blocks | where: 'type', 'stakeholder' -%}

    {%- if stakeholders.size > 0 -%}
      <div
        class="kaadu-problem__tabs"
        role="tablist"
        aria-label="{{ 'sections.kaadu_problem.tablist_label' | t: default: 'Zielgruppe auswählen' }}"
      >
        {%- for block in stakeholders -%}
          <button
            type="button"
            id="{{ section.id }}-tab-{{ block.id }}"
            class="kaadu-problem__tab btn-label"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="{{ section.id }}-panel-{{ block.id }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-kaadu-problem-tab
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label | escape }}
          </button>
        {%- endfor -%}
      </div>

      <div class="kaadu-problem__panels" aria-live="polite">
        {%- for block in stakeholders -%}
          <div
            id="{{ section.id }}-panel-{{ block.id }}"
            class="kaadu-problem__panel{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="{{ section.id }}-tab-{{ block.id }}"
            {% unless forloop.first %}hidden{% endunless %}
            data-kaadu-problem-panel
            {{ block.shopify_attributes }}
          >
            <div class="kaadu-problem__media">
              <div class="kaadu-problem__frame">
                {%- if block.settings.image != blank -%}
                  {%- assign image_alt_text = block.settings.image_alt | default: block.settings.label | escape -%}
                  <picture>
                    {%- if block.settings.image_mobile != blank -%}
                      <source
                        media="(max-width: 768px)"
                        srcset="{{ block.settings.image_mobile | image_url: width: 800 }}"
                      >
                    {%- endif -%}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'kaadu-problem__img',
                        loading: 'lazy',
                        alt: image_alt_text,
                        width: block.settings.image.width,
                        height: block.settings.image.height,
                        sizes: '(min-width: 769px) 500px, 90vw'
                    }}
                  </picture>
                {%- else -%}
                  <div class="kaadu-problem__img-placeholder" aria-hidden="true"></div>
                {%- endif -%}

                {%- if block.settings.sticker_image != blank -%}
                  {%- assign sticker_alt_text = block.settings.sticker_alt | escape -%}
                  {%- capture sticker_style -%}
                    --kaadu-problem-sticker-width: {{ block.settings.sticker_width }}px; --kaadu-problem-sticker-rotate: {{ block.settings.sticker_rotate }}deg;
                  {%- endcapture -%}
                  {{
                    block.settings.sticker_image
                    | image_url: width: 400
                    | image_tag:
                      class: 'kaadu-problem__sticker',
                      loading: 'lazy',
                      alt: sticker_alt_text,
                      width: block.settings.sticker_image.width,
                      height: block.settings.sticker_image.height,
                      style: sticker_style
                  }}
                {%- endif -%}
              </div>
            </div>

            <div class="kaadu-problem__content">
              {%- if block.settings.eyebrow != blank -%}
                <p class="kaadu-problem__panel-eyebrow btn-label">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}

              <h3 class="kaadu-problem__panel-heading h4-subsection-heading">{{ block.settings.label | escape }}</h3>

              {%- if block.settings.body_text != blank -%}
                <div class="kaadu-problem__panel-body rte body">{{ block.settings.body_text }}</div>
              {%- endif -%}

              {%- if block.settings.highlight_text != blank -%}
                <div
                  class="kaadu-problem__highlight bg-scheme-background text-scheme-text"
                  data-color-scheme="{{ section.settings.highlight_color_scheme }}"
                >
                  <div class="kaadu-problem__highlight-text rte body-large">{{ block.settings.highlight_text }}</div>
                </div>
              {%- endif -%}

              {%- if block.settings.disclaimer_text != blank -%}
                <p class="kaadu-problem__disclaimer caption">{{ block.settings.disclaimer_text | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- style -%}
    #shopify-section-{{ section.id }} .kaadu-problem__container {
      max-width: var(--container-max);
      margin-inline: auto;
      padding-block: var(--section-padding-v);
      padding-inline: var(--space-4);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__eyebrow-tag {
      display: inline-block;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      padding: var(--space-1) var(--space-3);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__heading {
      margin: var(--space-4) 0 0;
    }

    #shopify-section-{{ section.id }} .kaadu-problem__intro {
      margin-top: var(--space-4);
      max-width: 640px;
    }

    #shopify-section-{{ section.id }} .kaadu-problem__tabs {
      margin-top: var(--space-6);
      display: flex;
      flex-wrap: nowrap;
      gap: var(--space-3);
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: var(--space-1);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__tabs::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .kaadu-problem__tab {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      flex: 0 0 auto;
      scroll-snap-align: start;
      min-width: 0;
      max-width: 100%;
      overflow-wrap: anywhere;
      white-space: nowrap;
      background-color: rgb(var(--color-scheme-text-contrast));
      color: rgb(var(--color-scheme-text));
      border: 2px solid rgb(var(--color-scheme-text));
      border-radius: var(--radius-btn);
      box-shadow: var(--shadow-md);
      padding: var(--space-3) var(--space-4);
      cursor: pointer;
      transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
    }

    #shopify-section-{{ section.id }} .kaadu-problem__tab[aria-selected="true"] {
      background-color: rgb(var(--color-scheme-accent-1));
      color: rgb(var(--color-scheme-accent-1-contrast));
      border-color: rgb(var(--color-scheme-accent-1));
    }

    #shopify-section-{{ section.id }} .kaadu-problem__tab:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__tab:active {
      transform: translateY(0);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__tab:focus-visible {
      outline: 2px solid var(--color-violet);
      outline-offset: 2px;
    }

    #shopify-section-{{ section.id }} .kaadu-problem__panels {
      margin-top: var(--legacy-space-8);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__panel {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__panel[hidden] {
      display: none;
    }

    #shopify-section-{{ section.id }} .kaadu-problem__frame {
      position: relative;
      background-color: var(--color-cream);
      box-shadow: var(--space-2) var(--space-2) 0 0 rgb(var(--color-scheme-text));
      aspect-ratio: 4 / 3;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .kaadu-problem__img,
    #shopify-section-{{ section.id }} .kaadu-problem__img-placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      background-color: var(--color-light-grey);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__sticker {
      position: absolute;
      right: var(--space-4);
      bottom: var(--space-4);
      width: var(--kaadu-problem-sticker-width, 140px);
      max-width: 42%;
      height: auto;
      object-fit: contain;
      transform: rotate(var(--kaadu-problem-sticker-rotate, -10deg));
    }

    #shopify-section-{{ section.id }} .kaadu-problem__panel-eyebrow {
      margin: 0 0 var(--space-2);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__panel-heading {
      margin: 0;
    }

    #shopify-section-{{ section.id }} .kaadu-problem__panel-body {
      margin-top: var(--space-4);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__highlight {
      margin-top: var(--space-6);
      padding: var(--space-4) var(--space-6);
    }

    #shopify-section-{{ section.id }} .kaadu-problem__highlight-text {
      font-weight: 700;
    }

    #shopify-section-{{ section.id }} .kaadu-problem__disclaimer {
      margin-top: var(--space-3);
    }

    @media (min-width: 769px) {
      #shopify-section-{{ section.id }} .kaadu-problem__container {
        padding-inline: var(--space-6);
      }

      #shopify-section-{{ section.id }} .kaadu-problem__tabs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-4);
        max-width: 700px;
        overflow-x: visible;
        scroll-snap-type: none;
        padding-bottom: 0;
      }

      #shopify-section-{{ section.id }} .kaadu-problem__tab {
        flex: initial;
        white-space: normal;
      }

      #shopify-section-{{ section.id }} .kaadu-problem__panels {
        margin-top: var(--legacy-space-12);
      }

      #shopify-section-{{ section.id }} .kaadu-problem__panel {
        grid-template-columns: minmax(280px, 420px) 1fr;
        gap: var(--legacy-space-12);
        align-items: start;
      }

      #shopify-section-{{ section.id }} .kaadu-problem__frame {
        aspect-ratio: 4 / 5;
      }
    }
  {%- endstyle -%}
  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

<script>
  (function () {
    if (window.kaaduProblemTabsInit) return;
    window.kaaduProblemTabsInit = true;

    function activate(root, index, moveFocus) {
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-kaadu-problem-tab]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-kaadu-problem-panel]'));

      tabs.forEach(function (tab, i) {
        var isActive = i === index;
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive && moveFocus) tab.focus();
      });
      panels.forEach(function (panel, i) {
        var isActive = i === index;
        panel.classList.toggle('is-active', isActive);
        if (isActive) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    }

    // Event delegation on document: survives Shopify theme-editor re-renders,
    // which replace a section's DOM via AJAX without re-running its inline script tag.
    document.addEventListener('click', function (e) {
      var tab = e.target.closest && e.target.closest('[data-kaadu-problem-tab]');
      if (!tab) return;
      var root = tab.closest('.kaadu-problem');
      if (!root) return;
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-kaadu-problem-tab]'));
      var index = tabs.indexOf(tab);
      if (index === -1) return;
      activate(root, index, false);
    });

    document.addEventListener('keydown', function (e) {
      var tab = e.target.closest && e.target.closest('[data-kaadu-problem-tab]');
      if (!tab) return;
      var root = tab.closest('.kaadu-problem');
      if (!root) return;
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-kaadu-problem-tab]'));
      var index = tabs.indexOf(tab);
      if (index === -1) return;

      var newIndex = null;
      if (e.key === 'ArrowRight') newIndex = (index + 1) % tabs.length;
      if (e.key === 'ArrowLeft') newIndex = (index - 1 + tabs.length) % tabs.length;
      if (e.key === 'Home') newIndex = 0;
      if (e.key === 'End') newIndex = tabs.length - 1;

      if (newIndex !== null) {
        e.preventDefault();
        activate(root, newIndex, true);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Problem Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_tag",
      "label": "Eyebrow tag",
      "default": "SNACK LIKE YOU GIVE A DAMN",
      "info": "Small pill label above the heading. Color follows the section's color scheme accent."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wer profitiert[br]von Kaadu?",
      "info": "Use [br] for a line break and [nbsp] for a non-breaking space."
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text",
      "default": "<p>Von der Ananasfarm bis in die Packung: Kaadu funktioniert nur, weil alle fair beteiligt sind — in Vazhakulam, Kerala.</p>"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme1",
      "info": "Also styles the heading, panel eyebrow/heading, image shadow (text color), and tabs — active via accent, inactive via text."
    },
    {
      "type": "color_scheme",
      "id": "highlight_color_scheme",
      "label": "Highlight box color scheme",
      "default": "scheme5",
      "info": "Background and text for the bold statement box in each panel."
    }
  ],
  "blocks": [
    {
      "type": "stakeholder",
      "name": "Stakeholder",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Stakeholder",
          "info": "Used as both the tab button text and the panel heading."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Panel eyebrow",
          "info": "Small label above the panel heading, e.g. \"Im Betrieb\". Color follows the section's color scheme."
        },
        {
          "type": "richtext",
          "id": "body_text",
          "label": "Body text"
        },
        {
          "type": "richtext",
          "id": "highlight_text",
          "label": "Highlight box text",
          "info": "Bold statement, e.g. key benefits. Background/text color set by the Highlight box color scheme above."
        },
        {
          "type": "text",
          "id": "disclaimer_text",
          "label": "Disclaimer / footnote"
        },
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (mobile)",
          "info": "Optional. Shown on screens ≤ 768px. Falls back to the desktop image when not set."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Falls back to the label if left blank."
        },
        {
