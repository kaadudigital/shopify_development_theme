{%- comment -%}
  Kaadu «Produktvergleich» (product page mockup): kicker + h2 beside an intro, then a ✓ / ✕ table with a label
  column and 2–4 product columns (header text or image, e.g. the Kaadu logo; one column highlighted), and a
  footnote. Styles: "COMPARISON TABLE" in assets/base.bundle.css. Colours follow the colour scheme unless
  «Use the colours below» is on (mockup: pink ground, paper cells, lime Kaadu column, purple lines and ink).
  Stickers, background shapes/patterns and shape dividers stay as blocks.
{%- endcomment -%}
{%- liquid
  assign columns = '1,2' | split: ','
  if section.settings.enable_column_3
    assign columns = columns | push: '3'
  endif
  if section.settings.enable_column_4
    assign columns = columns | push: '4'
  endif
  assign col_count = columns.size
  assign rows = section.blocks | where: 'type', 'row'
-%}

{%- style -%}
  #{{ section.id }} {
    --kd-ct-cols: {{ col_count }};
    --icon-thickness: {{ section.settings.icon_thickness }};
    {%- if section.settings.highlighted_column_color == 'accent-2' %}
    --kd-ct-hl-scheme: var(--color-scheme-accent-2);
    --kd-ct-hl-scheme-fg: var(--color-scheme-accent-2-contrast);
    {%- endif %}
    {%- if section.settings.use_custom_colors %}
    --kd-ct-bg: {{ section.settings.bg_color }};
    --kd-ct-kicker: {{ section.settings.kicker_color }};
    --kd-ct-heading: {{ section.settings.heading_color }};
    --kd-ct-text: {{ section.settings.text_color }};
    --kd-ct-cell: {{ section.settings.cell_color }};
    --kd-ct-ink: {{ section.settings.table_text_color }};
    --kd-ct-line: {{ section.settings.line_color }};
    --kd-ct-hl: {{ section.settings.highlight_color }};
    --kd-ct-hl-fg: {{ section.settings.highlight_text_color }};
    --kd-ct-note: {{ section.settings.footnote_color }};
    {%- endif %}
  }
{%- endstyle -%}

<section
  id="{{ section.id }}"
  class="kd-ctable kd-section relative overflow-hidden{% if section.settings.use_gradient_background and section.settings.use_custom_colors == false %} bg-scheme-gradient{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"{% unless section.settings.scroll_motion %} data-kd-motion="off"{% endunless %}
>
  <div class="kd-ctable__inner kd-wide relative z-10">
    {%- if section.settings.kicker != blank or section.settings.title != blank or section.settings.intro != blank -%}
      <div class="kd-ctable__head">
        <div class="kd-heading">
          {%- if section.settings.kicker != blank -%}
            <p class="kd-heading__kicker kd-label kd-ctable__kicker">{{ section.settings.kicker | escape }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="kd-heading__title kd-display-h2 kd-ctable__title">{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.intro != blank -%}
          <div class="kd-ctable__intro kd-body-lg">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="kd-ctable__frame{% if section.settings.display_on_card %} kd-ctable__frame--card{% endif %} {{ section.settings.max_width }}">
      {%- if section.settings.show_scroll_left_to_right_on_mobile and col_count > 2 -%}
        <p class="kd-ctable__hint kd-label-sm" aria-hidden="true">← {{ 'general.accessibility.scroll_left_to_right' | t }} →</p>
      {%- endif -%}
      <div class="kd-ctable__scroll">
        <table class="kd-ctable__table{% if col_count > 2 %} kd-ctable__table--wide{% endif %}">
          <thead>
            <tr>
              <td class="kd-ctable__corner"></td>
              {%- for c in columns -%}
                {%- liquid
                  assign k_title = 'column_' | append: c | append: '_title'
                  assign k_image = 'column_' | append: c | append: '_image'
                -%}
                <th scope="col" class="kd-ctable__col{% if section.settings.highlighted_column == c %} kd-ctable__hl{% endif %}">
                  {%- if section.settings[k_image] != blank -%}
                    {{ section.settings[k_image] | image_url: width: 400 | image_tag: class: 'kd-ctable__logo', widths: '200, 300, 400', sizes: '200px', loading: 'lazy', alt: section.settings[k_title] }}
                  {%- else -%}
                    <span class="kd-display-drawer">{{ section.settings[k_title] | escape }}</span>
                  {%- endif -%}
                </th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for row in rows -%}
              <tr {{ row.shopify_attributes }}>
                <th scope="row" class="kd-ctable__label kd-label-lg">{{ row.settings.title | escape }}</th>
                {%- for c in columns -%}
                  {%- liquid
                    assign k_icon = 'column_' | append: c | append: '_icon'
                    assign k_text = 'column_' | append: c | append: '_text'
                    assign k_title = 'column_' | append: c | append: '_title'
                    assign icon = row.settings[k_icon]
                  -%}
                  <td class="kd-ctable__cell{% if section.settings.highlighted_column == c %} kd-ctable__hl{% endif %}">
                    {%- if icon != blank -%}
                      <span class="kd-ctable__icon{% if section.settings.show_border %} kd-ctable__icon--ring{% endif %}{% unless section.settings.use_custom_colors %} {{ section.settings.background_color }}{% endunless %}">
                        {%- render 'theme-icon', icon: icon -%}
                      </span>
                      <span class="sr-only">
                        {{- section.settings[k_title] | escape }}:
                        {% case icon %}{% when 'check_mark', 'like' %}ja{% when 'check_close', 'thumbs_down' %}nein{% endcase -%}
                      </span>
                    {%- endif -%}
                    {%- if row.settings[k_text] != blank -%}
                      <span class="kd-ctable__text">{{ row.settings[k_text] }}</span>
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>

    {%- if section.settings.footnote != blank -%}
      <div class="kd-ctable__note">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

