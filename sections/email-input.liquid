{%- comment -%}
  Kaadu DS join section (EmailForm): kicker, Fagies h2, optional image, intro, then the 560px form —
  56px pill input (paper, 1px purple border) beside a red cloud button. Colours follow the colour scheme
  (DS: the join section sits on lime). Styles: "JOIN" in assets/base.bundle.css.
  No longer used: bg_class, input_square, button_image*, button_text_color, button_image_width*.
{%- endcomment -%}
<section
  class="kd-join email-signup-section bg-scheme-background text-scheme-text{% if section.settings.padding_top == 'none' %} kd-join--tight-top{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
  id="section-{{ section.id }}"
>
  <div class="kd-section kd-join__inner">
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="kd-heading kd-heading--center">
        {%- if section.settings.kicker != blank -%}
          <p class="kd-heading__kicker kd-label-lg">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="kd-heading__title kd-display-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 400 | image_tag: class: 'kd-join__image', loading: 'lazy', alt: section.settings.image.alt }}
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="kd-join__text kd-body-lg">{{ section.settings.text }}</div>
    {%- endif -%}

    <form
      method="post"
      action="/contact#contact_form"
      accept-charset="UTF-8"
      class="contact-form email-signup-form kd-form"
      id="contact_form"
    >
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="contact[tags]" value="waitlist">
      <input type="hidden" name="utf8" value="✓">

      <label class="kd-sr" for="Email">{{ section.settings.placeholder_text | default: 'E-Mail' | escape }}</label>
      <input
        type="email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder_text | escape }}"
        id="Email"
        class="kd-input email-signup-input"
        autocomplete="email"
        required
      >
      {%- render 'kd-button', label: section.settings.button_text, type: 'submit', variant: 'red', size: 'md', class: 'email-signup-submit' -%}
    </form>
    <div class="email-signup-message kd-error" role="alert" hidden></div>

    {%- if section.settings.subtitle != blank -%}
      <p class="kd-join__subtitle kd-body-sm">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

<script>
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('customer_posted') === 'true') {
    const pathParts = window.location.pathname.split('/');
    pathParts[pathParts.length - 1] = 'waitlist-success';
    window.location.replace(pathParts.join('/'));
  }

  document.addEventListener('DOMContentLoaded', function () {
    const form = document.querySelector('.email-signup-form');
    if (!form) return;
    const btn = form.querySelector('.email-signup-submit');
    form.addEventListener('submit', function () {
      btn.classList.add('is-loading');
      btn.disabled = true;
    });
  });
</script>

