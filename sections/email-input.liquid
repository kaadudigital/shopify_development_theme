{%- comment -%}
  Kaadu DS join section (EmailForm): kicker, Fagies h2, optional image, intro, then the 560px form — 56px pill input
  beside a cloud button (or the button artwork, if set). Colours: «Use the colours below» (mockup: lime ground, ink kicker
  and text, red heading and cloud), else the colour scheme. Styles: "JOIN" in assets/base.bundle.css.
  After signing up: an inline success pill (Shopify customer form, ?customer_posted=true) or a redirect to a page.
  Not used: bg_class (the colour scheme / colour settings replace it).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign after = s.after_signup | default: 'page'
  assign join_classes = 'kd-join email-signup-section bg-scheme-background text-scheme-text'
  if s.padding_top == 'none'
    assign join_classes = join_classes | append: ' kd-join--tight-top'
  endif
  if s.input_square
    assign join_classes = join_classes | append: ' kd-join--square'
  endif
  if s.hide_image_mobile
    assign join_classes = join_classes | append: ' kd-join--m-noimg'
  endif
  if s.button_image != blank or s.button_image_mobile != blank
    assign join_classes = join_classes | append: ' kd-join--art'
  endif
  # Mobile label: with artwork only the mobile label (blank = icon only, as before the redesign); without artwork it falls back to the label.
  assign label_m = s.button_text_mobile
  if s.button_image == blank and s.button_image_mobile == blank
    assign label_m = s.button_text_mobile | default: s.button_text
  endif
-%}

{%- style -%}
  #section-{{ section.id }} {
    {%- comment -%} Section colours only when "Use the colours below" is on; otherwise every --kd-join-* is unset and the
      CSS falls back to the colour scheme. {%- endcomment -%}
    {%- if s.use_custom_colors -%}
      {%- liquid
        assign join_colors = 'bg:background_color,kicker:kicker_color,heading:heading_color,text:text_color,input-bg:input_bg_color,input:input_text_color,btn:button_color,btn-label:button_label_color,success-bg:success_bg_color,success:success_text_color,error:error_color' | split: ','
      -%}
      {%- for pair in join_colors -%}
        {%- assign kv = pair | split: ':' -%}
        {%- assign value = s[kv[1]] -%}
        {%- if value != blank %}
    --kd-join-{{ kv[0] }}: {{ value }};
        {%- endif -%}
      {%- endfor %}
    {%- endif %}
  }
  #section-{{ section.id }} {
    --kd-join-img-w-m: {{ s.image_width_mobile | default: 200 }}px;
    --kd-join-img-w: {{ s.image_width | default: 200 }}px;
  }
  {%- if s.button_image != blank or s.button_image_mobile != blank %}
  #section-{{ section.id }} .kd-btn--art {
    --kd-art-w: {{ s.button_image_width | default: 200 }}px;
    --kd-art-ratio: {{ s.button_image.aspect_ratio | default: s.button_image_mobile.aspect_ratio | default: 3 }};
    --kd-art-color: {{ s.button_text_color | default: 'inherit' }};
    --kd-art-w-m: {{ s.button_image_width_mobile | default: 160 }}px;
    --kd-art-ratio-m: {{ s.button_image_mobile.aspect_ratio | default: s.button_image.aspect_ratio | default: 3 }};
  }
  {%- endif %}
{%- endstyle -%}

<section class="{{ join_classes }}" data-color-scheme="{{ s.color_scheme }}"{% unless section.settings.scroll_motion %} data-kd-motion="off"{% endunless %} id="section-{{ section.id }}">
  <div class="kd-section kd-join__inner">
    {%- if s.kicker != blank or s.heading != blank -%}
      <div class="kd-heading kd-heading--center">
        {%- if s.kicker != blank -%}
          <p class="kd-heading__kicker kd-label-lg">{{ s.kicker | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="kd-heading__title kd-display-h2">{{ s.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.image != blank -%}
      {%- liquid
        assign img_w_m = s.image_width_mobile | default: 200
        assign img_w_d = s.image_width | default: 200
        assign img_max = img_w_m | at_least: img_w_d | times: 2 | at_most: s.image.width
        assign img_widths = img_w_m | append: ',' | append: img_w_d | append: ',' | append: img_max
        assign img_sizes = '(min-width: 768px) ' | append: img_w_d | append: 'px, ' | append: img_w_m | append: 'px'
      -%}
      {{ s.image | image_url: width: img_max | image_tag: class: 'kd-join__image', loading: 'lazy', alt: s.image.alt, widths: img_widths, sizes: img_sizes }}
    {%- endif -%}

    {%- if s.text != blank -%}
      {%- if s.text_mobile != blank -%}
        <div class="kd-join__text kd-join__text--m kd-body-lg">{{ s.text_mobile }}</div>
        <div class="kd-join__text kd-join__text--d kd-body-lg">{{ s.text }}</div>
      {%- else -%}
        <div class="kd-join__text kd-body-lg">{{ s.text }}</div>
      {%- endif -%}
    {%- endif -%}

    {%- form 'customer', id: 'kd-join-form', class: 'contact-form email-signup-form kd-form' -%}
      {%- if form.posted_successfully? -%}
        {%- if after == 'message' -%}
          <p class="kd-success kd-join__success" role="status" tabindex="-1">
            {%- if s.success_text_mobile != blank -%}
              <span class="kd-join__m">{{ s.success_text_mobile | escape }}</span><span class="kd-join__d">{{ s.success_text | escape }}</span>
            {%- else -%}
              {{ s.success_text | escape }}
            {%- endif -%}
          </p>
        {%- else -%}
          <script>
            {%- comment -%} Old behaviour: go to the success page (setting, else …/waitlist-success next to this page). {%- endcomment -%}
            (function () {
              var target = {{ s.success_page | json }};
              if (!target) {
                var parts = window.location.pathname.split('/');
                parts[parts.length - 1] = 'waitlist-success';
                target = parts.join('/');
                if (target === '/waitlist-success') target = '/pages/waitlist-success';
              }
              window.location.replace(target);
            })();
          </script>
        {%- endif -%}
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="waitlist">
        <label class="kd-sr" for="Email-{{ section.id }}">{{ s.placeholder_text | default: 'E-Mail' | escape }}</label>
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ s.placeholder_text | escape }}"
          id="Email-{{ section.id }}"
          class="kd-input email-signup-input"
          autocomplete="email"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="Email-error-{{ section.id }}"{% endif %}
        >
        {%- capture btn_label -%}
          {%- if label_m != s.button_text -%}
            <span class="kd-join__m">{{ label_m | escape }}</span><span class="kd-join__d">{{ s.button_text | escape }}</span>
          {%- else -%}
            {{ s.button_text | escape }}
          {%- endif -%}
        {%- endcapture -%}
        {%- capture btn_attrs -%}aria-label="{{ s.button_text | escape }}"{%- endcapture -%}
        {%- render 'kd-button', label: btn_label, type: 'submit', size: 'md', class: 'email-signup-submit kd-join__button', attrs: btn_attrs, art: s.button_image, art_mobile: s.button_image_mobile -%}
      {%- endif -%}
    {%- endform -%}
    {%- if form.errors -%}
      <p class="kd-error kd-join__error" id="Email-error-{{ section.id }}" role="alert">{{ s.error_text | default: 'Das ist keine E-Mail-Adresse. Nochmal.' | escape }}</p>
    {%- endif -%}

    {%- if s.subtitle != blank -%}
      <p class="kd-join__subtitle kd-body-sm">{{ s.subtitle }}</p>
    {%- endif -%}
  </div>

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: s.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.getElementById('section-{{ section.id }}');
    if (!section) return;
    var success = section.querySelector('.kd-join__success');
    if (success) {
      success.scrollIntoView({ block: 'center' });
      success.focus({ preventScroll: true });
    }
    var form = section.querySelector('.email-signup-form');
    if (!form) return;
    var btn = form.querySelector('.email-signup-submit');
    form.addEventListener('submit', function () {
      if (!btn) return;
      btn.classList.add('is-loading');
      btn.disabled = true;
    });
  });
</script>

