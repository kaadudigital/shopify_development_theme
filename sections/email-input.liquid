  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bleib auf dem Laufenden"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "20% Rabatt auf deine erste Bestellung"
    },
    {
