{%- assign btn_text_mob = section.settings.button_text_mobile -%}

{%- style -%}
  #shopify-section-{{ section.id }} .email-signup-section {
    position: relative;
    overflow: hidden;
    padding-block-start: {%- if section.settings.padding_top == 'none' -%}0{%- elsif section.settings.padding_top == 'small' -%}var(--space-4){%- else -%}var(--space-8){%- endif -%};
    padding-block-end: var(--space-8);
    padding-inline: var(--space-4);
  }
  #shopify-section-{{ section.id }} .email-signup-container {
    max-width: var(--container-max);
    margin-inline: auto;
  }
  #shopify-section-{{ section.id }} .email-signup-heading {
    text-align: center;
    margin: 0 0 var(--space-6);
  }
  #shopify-section-{{ section.id }} .email-signup-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    max-width: 600px;
    margin-inline: auto;
  }
  #shopify-section-{{ section.id }} .email-signup-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 56px;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-cream);
    color: var(--color-near-black);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-btn);
    outline: none;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease-out, box-shadow 0.15s ease-out;
  }
  #shopify-section-{{ section.id }} .email-signup-input::placeholder {
    color: var(--color-mid-grey);
  }
  #shopify-section-{{ section.id }} .email-signup-input:focus-visible {
    border-color: var(--color-violet);
    outline: 3px solid var(--color-cream);
    outline-offset: 2px;
  }

  /* --- Submit: SVG burst (default, no image set) --- */
  #shopify-section-{{ section.id }} .email-signup-submit {
    flex: 0 0 auto;
    width: 64px;
    aspect-ratio: 78 / 73;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: transform 0.15s ease-out;
  }
  #shopify-section-{{ section.id }} .email-signup-submit:hover {
    transform: translateY(-2px) scale(1.05);
  }
  #shopify-section-{{ section.id }} .email-signup-submit:active {
    transform: translateY(0) scale(1);
  }
  #shopify-section-{{ section.id }} .email-signup-submit:focus-visible {
    outline: 3px solid var(--color-cream);
    outline-offset: 4px;
    border-radius: 50%;
  }
  #shopify-section-{{ section.id }} .email-signup-submit__burst {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(var(--shadow-sm));
  }
  #shopify-section-{{ section.id }} .email-signup-submit__spinner {
    display: none;
    transform-box: fill-box;
    transform-origin: center;
  }
  #shopify-section-{{ section.id }} .email-signup-submit.is-loading {
    pointer-events: none;
    cursor: default;
  }
  #shopify-section-{{ section.id }} .email-signup-submit.is-loading .email-signup-submit__arrow {
    display: none;
  }
  #shopify-section-{{ section.id }} .email-signup-submit.is-loading .email-signup-submit__spinner {
    display: block;
    animation: es-spin 0.75s linear infinite;
  }
  @keyframes es-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  /* --- Submit: custom image mode --- */
  #shopify-section-{{ section.id }} .email-signup-submit--image {
    position: relative;
    width: auto;
    aspect-ratio: unset;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .email-signup-submit__bg {
    display: block;
    max-height: 56px;
    max-width: 200px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .email-signup-submit__label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    padding-inline: {{ section.settings.button_label_padding }}px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 20px;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .email-signup-submit__label--mobile {
    display: none;
  }

  {%- if btn_text_mob != blank -%}
    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} .email-signup-submit__label--desktop { display: none; }
      #shopify-section-{{ section.id }} .email-signup-submit__label--mobile { display: flex; }
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .email-signup-subtitle {
    text-align: center;
    margin: var(--space-6) 0 0;
  }
  #shopify-section-{{ section.id }} .email-signup-message {
    text-align: center;
    margin-top: var(--space-4);
  }

  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} .email-signup-section {
      padding-block-start: {%- if section.settings.padding_top == 'none' -%}0{%- elsif section.settings.padding_top == 'small' -%}var(--space-8){%- else -%}var(--section-padding-v){%- endif -%};
      padding-block-end: var(--section-padding-v);
      padding-inline: var(--space-6);
    }
    #shopify-section-{{ section.id }} .email-signup-heading {
      margin-bottom: var(--space-8);
    }
    #shopify-section-{{ section.id }} .email-signup-input {
      height: 64px;
      padding: var(--space-4) var(--space-8);
    }
    #shopify-section-{{ section.id }} .email-signup-wrapper {
      gap: var(--space-6);
    }
    #shopify-section-{{ section.id }} .email-signup-submit {
      width: 80px;
    }
    #shopify-section-{{ section.id }} .email-signup-submit__bg {
      max-height: 64px;
      max-width: 240px;
    }
  }
{%- endstyle -%}

<section class="email-signup-section {{ section.settings.bg_class }}" id="section-{{ section.id }}">
  <div class="email-signup-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="email-signup-heading h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <form
      method="post"
      action="/contact#contact_form"
      accept-charset="UTF-8"
      class="contact-form email-signup-form"
      id="contact_form"
    >
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="contact[tags]" value="waitlist">
      <input type="hidden" name="utf8" value="✓">

      <div class="email-signup-wrapper">
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder_text }}"
          id="Email"
          class="email-signup-input body"
          required
        >

        <button
          type="submit"
          class="email-signup-submit{% if section.settings.button_image != blank %} email-signup-submit--image{% endif %}"
          aria-label="{{ section.settings.button_text | default: 'Abonnieren' | escape }}"
        >
          {%- if section.settings.button_image != blank -%}
            <picture>
              {%- if section.settings.button_image_mobile != blank -%}
                <source
                  media="(max-width: 768px)"
                  srcset="{{ section.settings.button_image_mobile | image_url: width: 280 }}"
                >
              {%- endif -%}
              <img
                src="{{ section.settings.button_image | image_url: width: 480 }}"
                alt=""
                aria-hidden="true"
                loading="lazy"
                class="email-signup-submit__bg"
              >
            </picture>
            {%- if section.settings.button_text != blank -%}
              <span class="email-signup-submit__label" aria-hidden="true">
                <span class="email-signup-submit__label--desktop">{{ section.settings.button_text }}</span>
                {%- if btn_text_mob != blank -%}
                  <span class="email-signup-submit__label--mobile">{{ btn_text_mob }}</span>
                {%- endif -%}
              </span>
            {%- endif -%}
          {%- else -%}
            <svg class="email-signup-submit__burst" viewBox="0 0 78 73" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
              <path
                d="M77.4617 33.3842C77.717 36.9325 67.6423 39.4471 66.7504 42.7188C65.8352 46.0756 73.2364 53.3107 71.2989 56.1732C69.3735 59.0178 59.8399 54.8969 57.0897 57.0507C54.4081 59.1509 56.1888 69.3978 52.896 70.6516C49.7463 71.8509 44.2411 63.0567 40.685 63.314C37.1289 63.5714 32.9397 73.0673 29.6509 72.334C26.2127 71.5673 26.5081 61.1701 23.5536 59.4779C20.5236 57.7424 11.6786 63.1934 9.36597 60.6555C7.03879 58.1017 13.3276 49.8758 11.9414 46.6856C10.5903 43.5763 0.260099 42.5384 0.00480744 38.9902C-0.250484 35.4419 9.82414 32.9272 10.7161 29.6555C11.6312 26.2988 4.23007 19.0637 6.16757 16.2012C8.09298 13.3566 17.6266 17.4775 20.3768 15.3236C23.0584 13.2235 21.2777 2.97659 24.5705 1.72278C27.7202 0.523441 33.2254 9.31768 36.7815 9.06031C40.3376 8.80294 44.5268 -0.69294 47.8156 0.0404044C51.2538 0.807061 50.9584 11.2042 53.9129 12.8965C56.9429 14.632 65.7878 9.18094 68.1005 11.7188C70.4277 14.2726 64.1389 22.4985 65.5251 25.6887C66.8762 28.7981 77.2064 29.836 77.4617 33.3842Z"
                fill="var(--color-lime)"
              />
              <path
                class="email-signup-submit__arrow"
                d="M 24 36.5 L 50 36.5 M 42 28 L 53 36.5 L 42 45"
                stroke="var(--color-violet)"
                stroke-width="5.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                fill="none"
              />
              <circle
                class="email-signup-submit__spinner"
                cx="39"
                cy="36.5"
                r="11"
                fill="none"
                stroke="var(--color-violet)"
                stroke-width="5.5"
                stroke-linecap="round"
                stroke-dasharray="52 17"
              />
            </svg>
          {%- endif -%}
        </button>
      </div>

      <div class="email-signup-message caption" hidden></div>
    </form>

    {%- if section.settings.subtitle != blank -%}
      <p class="email-signup-subtitle caption">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

<script>
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('customer_posted') === 'true') {
    const pathParts = window.location.pathname.split('/');
    pathParts[pathParts.length - 1] = 'waitlist-success';
    window.location.replace(pathParts.join('/'));
  }

  document.addEventListener('DOMContentLoaded', function () {
    const form = document.querySelector('.email-signup-form');
    if (!form) return;
    const btn = form.querySelector('.email-signup-submit');
    form.addEventListener('submit', function () {
      btn.classList.add('is-loading');
      btn.disabled = true;
    });
  });
</script>

{% schema %}
{
