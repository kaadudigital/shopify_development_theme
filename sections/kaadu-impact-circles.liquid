{%- comment -%}
  Kaadu — Wirkungskreis (impact circles). Promise mockup «Ein Beutel wirkt für eine ganze Region».

  Heading row (kicker + Fagies h2 left, lead right), then the rings diagram beside a numbered list. Each «ring»
  block is one ring of the diagram (innermost first), its label on the ring, a cloud-shaped photo marker placed on
  the diagram in % (block settings) and one list row (title, text, fact). The centre holds the logo. Ring colours
  and the list's inks are settings with the mockup values as defaults (the mockup's yellow ring is not a DS token:
  proposed). Up to five rings; the geometry (700 viewBox, 48px per ring) follows the mockup.
  Styles: "IMPACT CIRCLES" in assets/base.bundle.css; the photo marker is snippets/kd-cloud-photo.liquid.
{%- endcomment -%}
{%- liquid
  assign rings = section.blocks | where: 'type', 'ring'
  assign ring_count = rings.size
  if ring_count > 5
    assign ring_count = 5
  endif
  assign ring_step = 48
  assign center_r = 70
  assign outer_r = ring_step | times: ring_count | plus: center_r | plus: 30
  assign outer_label_r = outer_r | minus: 2

  capture diagram_alt
    echo section.settings.diagram_alt
    if section.settings.diagram_alt == blank
      echo section.settings.heading | strip_html
      echo ': '
      for ring in rings limit: 5
        echo ring.settings.title | escape
        unless forloop.last
          echo ', '
        endunless
      endfor
    endif
  endcapture
-%}

{%- style -%}
  #{{ section.id }} {
    {%- if section.settings.use_custom_colors %}
    --kd-ic-bg: {{ section.settings.background_color }};
    --kd-ic-kicker: {{ section.settings.kicker_color }};
    --kd-ic-heading: {{ section.settings.heading_color }};
    {%- endif %}
    --kd-ic-text: {{ section.settings.text_color }};
    --kd-ic-list-title: {{ section.settings.list_title_color }};
    --kd-ic-fact: {{ section.settings.fact_color }};
    --kd-ic-outer: {{ section.settings.outer_color }};
    --kd-ic-ring-stroke: {{ section.settings.ring_stroke_color }};
    --kd-ic-center: {{ section.settings.center_color }};
    --kd-ic-center-stroke: {{ section.settings.center_stroke_color }};
  }
  {%- for ring in rings limit: 5 %}
  #{{ section.id }} .kd-ic__ring--{{ ring.id }} { fill: {{ ring.settings.ring_color }}; }
  #{{ section.id }} .kd-ic__label--{{ ring.id }} { fill: {{ ring.settings.label_color }}; }
  #{{ section.id }} .kd-ic__marker--{{ ring.id }} { --kd-ic-x: {{ ring.settings.marker_x }}%; --kd-ic-y: {{ ring.settings.marker_y }}%; }
  {%- endfor %}
{%- endstyle -%}

<section
  id="{{ section.id }}"
  class="kd-ic kd-ic-band kd-section bg-scheme-background text-scheme-text"
  data-color-scheme="{{ section.settings.color_scheme }}"
  {% unless section.settings.scroll_motion %}data-kd-motion="off"{% endunless %}
>
  <div class="kd-wide kd-ic__inner">
    {%- if section.settings.kicker != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="kd-ic__head">
        <div class="kd-heading">
          {%- if section.settings.kicker != blank -%}
            <p class="kd-heading__kicker kd-ic__kicker kd-label">{{ section.settings.kicker | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="kd-heading__title kd-ic__title kd-display-h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}
          <div class="kd-ic__lead kd-body-lg rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if ring_count > 0 -%}
      <div class="kd-ic__row kd-ic__row-list">
        <div class="kd-ic__diagram">
          <svg class="kd-ic__svg" viewBox="0 0 700 700" role="img" aria-label="{{ diagram_alt | strip | escape }}">
            <defs>
              {%- for ring in rings limit: 5 -%}
                {%- assign r = ring_step | times: forloop.index | plus: center_r | minus: 19 -%}
                <path id="kd-ic-{{ section.id }}-r{{ forloop.index }}" d="M {{ 350 | minus: r }} 350 A {{ r }} {{ r }} 0 0 1 {{ 350 | plus: r }} 350"></path>
              {%- endfor -%}
              <path id="kd-ic-{{ section.id }}-out" d="M {{ 350 | minus: outer_label_r }} 350 A {{ outer_label_r }} {{ outer_label_r }} 0 0 1 {{ 350 | plus: outer_label_r }} 350"></path>
            </defs>
            <circle class="kd-ic__dash" cx="350" cy="350" r="{{ outer_r }}"></circle>
            {%- for ring in rings reversed -%}
              {%- if forloop.index0 < 5 -%}
                {%- assign ring_index = ring_count | minus: forloop.index0 -%}
                {%- assign r = ring_step | times: ring_index | plus: center_r -%}
                <circle class="kd-ic__ring kd-ic__ring--{{ ring.id }}" cx="350" cy="350" r="{{ r }}"></circle>
              {%- endif -%}
            {%- endfor -%}
            <circle class="kd-ic__center" cx="350" cy="350" r="{{ center_r }}"></circle>
            {%- for ring in rings limit: 5 -%}
              <text class="kd-ic__label kd-ic__label--{{ ring.id }}" text-anchor="middle"><textPath href="#kd-ic-{{ section.id }}-r{{ forloop.index }}" startOffset="50%">{{ ring.settings.label | default: ring.settings.title | escape }}</textPath></text>
            {%- endfor -%}
            {%- if section.settings.outer_label != blank -%}
              <text class="kd-ic__label kd-ic__label--outer" text-anchor="middle" dy="-8"><textPath href="#kd-ic-{{ section.id }}-out" startOffset="50%">{{ section.settings.outer_label | escape }}</textPath></text>
            {%- endif -%}
            {%- if section.settings.center_image != blank -%}
              {%- assign img_w = 128 -%}
              {%- assign img_h = img_w | divided_by: section.settings.center_image.aspect_ratio -%}
              {%- assign img_x = 350 | minus: 64 -%}
              {%- assign img_y = img_h | divided_by: 2.0 | times: -1 | plus: 350 -%}
              <image href="{{ section.settings.center_image | image_url: width: 300 }}" x="{{ img_x }}" y="{{ img_y }}" width="{{ img_w }}" height="{{ img_h }}" preserveAspectRatio="xMidYMid meet"><title>{{ section.settings.center_image.alt | default: shop.name | escape }}</title></image>
            {%- endif -%}
          </svg>
          {%- for ring in rings limit: 5 -%}
            <div class="kd-ic__marker kd-ic__marker--{{ ring.id }}">
              {%- render 'kd-cloud-photo', image: ring.settings.image, number: forloop.index, size: 'lg', label: section.settings.photo_placeholder -%}
            </div>
          {%- endfor -%}
        </div>

        <ol class="kd-ic__list">
          {%- for ring in rings limit: 5 -%}
            <li class="kd-ic__item" {{ ring.shopify_attributes }}>
              {%- render 'kd-cloud-photo', image: ring.settings.image, number: forloop.index, label: section.settings.photo_placeholder, sizes: '76px' -%}
              <div class="kd-ic__item-body">
                {%- if ring.settings.title != blank -%}
                  <h3 class="kd-ic__item-title kd-strong">{{ ring.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if ring.settings.text != blank -%}
                  <div class="kd-ic__item-text kd-body rte">{{ ring.settings.text }}</div>
                {%- endif -%}
                {%- if ring.settings.fact != blank -%}
                  <p class="kd-ic__fact"><span class="kd-ic__dot" aria-hidden="true"></span><span>{{ ring.settings.fact | escape }}</span></p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}
  </div>

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

