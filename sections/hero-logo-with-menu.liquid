{%- liquid
  assign logo = section.settings.logo | default: settings.logo
  assign enable_overlay = false

  if enable_overlay
    assign mobile_offset = section.settings.overlay_offset | times: 0.5
    assign desktop_offset = section.settings.overlay_offset
  endif

  case section.location
    when 'header'
      assign border_classes = 'border-b-section border-section-border'
    when 'footer'
      assign border_classes = 'border-t-section border-section-border'
  endcase

  # Count menu items from settings
  assign menu_count = 0
  for i in (1..10)
    assign label_key = 'menu_item_' | append: i | append: '_label'
    assign label = section.settings[label_key]
    if label != blank
      assign menu_count = menu_count | plus: 1
    endif
  endfor

  assign account_url = section.settings.account_link | default: routes.account_url
-%}

{%- style -%}
      /* ========================================
         BUTTON STYLES
         ======================================== */
      .custom-menu-button,
      .custom-shop-button,
      .custom-cart-button {
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        border: none;
        cursor: pointer;
        transition: transform 0.3s ease;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .custom-menu-button {
        background-image: url('{{ section.settings.menu_button_image | img_url: 'master' }}');
        transform: rotate(-3.94deg);
      }

      .custom-menu-button:hover {
        transform: rotate(1.2deg);
      }

      .custom-shop-button {
        background-image: url('{{ section.settings.shop_button_image | img_url: 'master' }}');
        transform: rotate(6.14deg);
      }

      .custom-shop-button:hover,
      .custom-cart-button:hover {
        transform: rotate(1deg);
      }

      .custom-cart-button {
        background-image: url('{{ section.settings.cart_icon_image | img_url: 'master' }}');
        transform: rotate(-9.53deg);
        padding: var(--space-6);
      }

      .custom-menu-button-text,
      .custom-shop-button-text {
        color: var(--color-red);
        font-family: var(--font-display);
        font-size: 24px;
        line-height: 32px;
        font-weight: 400;
        padding: var(--space-4) var(--space-6);
      }

      /* Menu button text container for animation */
    .menu-text-wrapper {
      position: relative;
      overflow: hidden;
      height: 1.2em;
      display: block;
      min-width: 80px;
    }

    .menu-text-wrapper .menu-text,
    .menu-text-wrapper .close-text {
      display: block;
      transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1),
                  opacity 0.4s cubic-bezier(0.76, 0, 0.24, 1);
    }

    /* Initial state - MENU visible, CLOSE below */
    .menu-text-wrapper .close-text {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
    }

    /* Active state - MENU goes up and fades, CLOSE comes in and fades in */
    .custom-menu-button.active .menu-text {
      transform: translateY(-100%);
      opacity: 0;
    }

    .custom-menu-button.active .close-text {
      transform: translateY(-100%);
      opacity: 1;
    }

    /* Ensure CLOSE starts invisible */
    .menu-text-wrapper .close-text {
      opacity: 0;
    }

    /* Ensure MENU starts visible */
    .menu-text-wrapper .menu-text {
      opacity: 1;
    }

      /* ========================================
         HAMBURGER MENU (fallback when no menu button image is set)
         ======================================== */
      .hamburger-menu {
        display: none;
        flex-direction: column;
        justify-content: space-around;
        width: 30px;
        height: 24px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 10;
        position: relative;
      }

      {%- if section.settings.hamburger_background_image != blank -%}
      .hamburger-menu::before {
        content: '';
        position: absolute;
        top: -16px;
        bottom: -16px;
        left: -13px;
        right: -13px;
        z-index: -1;
        background-image: url('{{ section.settings.hamburger_background_image | img_url: 'master' }}');
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
      }
      {%- endif -%}

      .hamburger-menu .line {
        width: 100%;
        height: 3px;
        background-color: rgb(var(--color-scheme-text));
        transition: all 0.3s ease;
        border-radius: 2px;
        position: absolute;
        left: 0;
      }

      {%- if section.settings.hamburger_stripe_color != blank -%}
      .hamburger-menu .line {
        background-color: {{ section.settings.hamburger_stripe_color }};
      }
      {%- endif -%}

      .hamburger-menu .line:nth-child(1) {
        top: 0;
      }

      .hamburger-menu .line:nth-child(2) {
        top: 50%;
        transform: translateY(-50%);
      }

      .hamburger-menu .line:nth-child(3) {
        bottom: 0;
      }

      /* Hamburger to X animation */
      .hamburger-menu.active .line:nth-child(1) {
        top: 50%;
        transform: translateY(-50%) rotate(45deg);
      }

      .hamburger-menu.active .line:nth-child(2) {
        opacity: 0;
      }

      .hamburger-menu.active .line:nth-child(3) {
        bottom: 50%;
        transform: translateY(50%) rotate(-45deg);
      }

      /* ========================================
         HEADER LAYOUT
         ======================================== */
      .adjust-menu-on-overlay {
        position: relative;
        z-index: 100000;
      }

      .header-content-wrapper {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: var(--space-4);
      }

      #{{ section.id }} .header-left {
        grid-column: 1;
        justify-self: start;
      }

      #{{ section.id }} .header-right {
        grid-column: 3;
        justify-self: end;
        display: flex;
        align-items: center;
        gap: var(--space-4);
      }

      .responsive-logo-container {
        grid-column: 2;
        justify-self: center;
        transition: opacity 0.3s ease-out;
      }

      #{{ section.id }} .header-button-wrapper,
      #{{ section.id }} .header-cart-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s ease;
      }

      /* While the menu is open the shop button steps aside (the CLOSE pill and
         cart stay), matching the reference open state. */
      #{{ section.id }} .custom-shop-button {
        transition: opacity 0.3s ease-out, transform 0.3s ease;
      }

      #{{ section.id }}.menu-open .custom-shop-button {
        opacity: 0;
        pointer-events: none;
      }

      /* Desktop only: the centred header logo fades out so the big overlay
         logo (top-left, reference style) takes its place. */
      @media (min-width: 769px) {
        #{{ section.id }}.menu-open .responsive-logo-container {
          opacity: 0;
        }
      }

      /* ========================================
         MENU OVERLAY

         Full-viewport panel that slides down from the top (reference-site
         behaviour), with a solid scalloped edge at the bottom. The header bar
         stays above it (CLOSE pill + cart remain usable); its height is
         reserved as *padding-top* via --menu-header-offset, kept in sync by
         the section script.
         ======================================== */
      #{{ section.id }} .menu-overlay {
        --menu-header-offset: 0px;
        --menu-cloud-height: 80px;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        background-color: rgb(var(--color-scheme-background));
        color: rgb(var(--color-scheme-text));
        z-index: 9999;
        visibility: hidden;
        overflow: hidden;
        overscroll-behavior: contain;
        transform: translateY(-102%);
        transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1), visibility 0s 0.7s;
      }

      #{{ section.id }} .menu-overlay.active {
        transform: translateY(0);
        visibility: visible;
        transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1), visibility 0s 0s;
      }

      #{{ section.id }} .menu-content {
        position: absolute;
        inset: 0;
        z-index: 5;
        box-sizing: border-box;
        padding-top: calc(var(--menu-header-offset) + var(--space-4));
        padding-bottom: calc(var(--menu-cloud-height) + var(--space-6));
        padding-inline: var(--space-4);
        overflow-y: auto;
        overscroll-behavior: contain;
        touch-action: pan-y;
        color: rgb(var(--color-scheme-text));
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-content {
          padding-inline: var(--space-6);
        }
      }

      #{{ section.id }} .menu-layout {
        width: 100%;
        max-width: var(--container-max);
        margin-inline: auto;
        min-height: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
      }

      /* Mobile order: utility rows → links → email/social (reference mobile) */
      #{{ section.id }} .menu-nav {
        order: 1;
      }

      #{{ section.id }} .menu-side {
        order: 2;
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-layout {
          display: grid;
          grid-template-columns: minmax(240px, 5fr) 7fr;
          gap: var(--space-6);
          align-items: stretch;
        }

        #{{ section.id }} .menu-side {
          grid-column: 1;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          gap: var(--space-8);
        }

        #{{ section.id }} .menu-nav {
          grid-column: 2;
        }
      }

      /* --- Left column: big logo + email + socials --- */
      #{{ section.id }} .menu-logo {
        display: none;
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-logo {
          display: block;
          width: clamp(220px, 26vw, 420px);
        }

        #{{ section.id }} .menu-logo img {
          width: 100%;
          height: auto;
        }
      }

      #{{ section.id }} .menu-side-bottom {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
      }

      #{{ section.id }} .menu-email {
        color: rgb(var(--color-scheme-text));
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      #{{ section.id }} .menu-email:hover,
      #{{ section.id }} .menu-email:focus-visible {
        color: {{ section.settings.menu_accent_color | default: '#ACFF64' }};
      }

      #{{ section.id }} .menu-social a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        min-height: 48px;
        color: rgb(var(--color-scheme-text));
      }

      /* --- Utility rows (mobile only): Search / Account --- */
      #{{ section.id }} .menu-utility {
        list-style: none;
        margin: 0 0 var(--space-6);
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }

      #{{ section.id }} .menu-utility a {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        min-height: 48px;
        color: rgb(var(--color-scheme-text));
        text-decoration: none;
      }

      #{{ section.id }} .menu-utility a:hover,
      #{{ section.id }} .menu-utility a:focus-visible {
        color: {{ section.settings.menu_accent_color | default: '#ACFF64' }};
      }

      #{{ section.id }} .menu-utility .theme-icon {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
      }

      /* Theme icons ship with a hardcoded #000 stroke — follow the scheme text
         colour inside the overlay instead. */
      #{{ section.id }} .menu-utility .theme-icon path {
        stroke: currentColor;
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-utility {
          display: none;
        }
      }

      /* --- "My account" link above the nav (desktop only, reference style) --- */
      #{{ section.id }} .menu-account {
        display: none;
        color: rgb(var(--color-scheme-text));
        text-decoration: none;
        margin-bottom: var(--space-8);
      }

      #{{ section.id }} .menu-account:hover,
      #{{ section.id }} .menu-account:focus-visible {
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-account {
          display: inline-block;
        }
      }

      /* --- Main links: big, left-aligned, staggered reveal --- */
      #{{ section.id }} .menu-content nav ul.menu-links {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: clamp(var(--space-1), 1vh, var(--space-3));
      }

      #{{ section.id }} .menu-content nav ul.menu-links li {
        margin: 0;
        max-width: 100%;
        overflow: hidden;
      }

      /* "Hide on desktop" per-item setting */
      @media (min-width: 768px) {
        #{{ section.id }} .menu-content nav ul.menu-links li.hide-on-desktop {
          display: none;
        }
      }

    /* Menu items - closing animation (top to bottom). */
    #{{ section.id }} .menu-content nav ul.menu-links li a {
      display: inline-block;
      position: relative;
      text-decoration: none;
      color: rgb(var(--color-scheme-text));
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 9vw, 4rem);
      line-height: 1.08;
      padding: 0 var(--space-1);
      transform: translateY(100%) translateZ(0);
      opacity: 0;
      transition: transform 0.65s cubic-bezier(0.215, 0.61, 0.355, 1) 0ms,
                  opacity 0.65s cubic-bezier(0.215, 0.61, 0.355, 1) 0ms,
                  color 0.25s ease-out;
    }

    @media (min-width: 769px) {
      #{{ section.id }} .menu-content nav ul.menu-links li a {
        font-size: clamp(3rem, min(6.5vw, 11vh), 6rem);
      }
    }

    /* Opening animation (bottom to top) */
    #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a {
      transform: translateY(0) translateZ(0);
      opacity: 1;
    }

    /* Opening delays - top to bottom */
    {% for i in (1..10) %}
      #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li:nth-child({{ i }}) a {
        transition-delay: calc({{ i | minus: 1 }} * 0.09s + 0.35s);
      }
    {% endfor %}

    /* Closing delays - bottom to top (reverse) */
    {% for i in (1..10) %}
      #{{ section.id }} .menu-content nav ul.menu-links li:nth-child({{ i }}) a {
        transition-delay: calc(({{ menu_count }} - {{ i }}) * 0.06s);
      }
    {% endfor %}

      /* ========================================
         DECORATIVE STICKERS inside the overlay
         ======================================== */
      #{{ section.id }} .menu-sticker {
        position: absolute;
        z-index: 6;
        width: clamp(56px, 7vw, 110px);
        pointer-events: none;
      }

      #{{ section.id }} .menu-sticker img {
        width: 100%;
        height: auto;
        object-fit: contain;
      }

      #{{ section.id }} .menu-sticker--1 {
        left: 10%;
        top: 42%;
        transform: rotate(-12deg);
      }

      #{{ section.id }} .menu-sticker--2 {
        right: 7%;
        bottom: calc(var(--menu-cloud-height) - 20px);
        transform: rotate(9deg);
      }

      @media (max-width: 768px) {
        #{{ section.id }} .menu-sticker--1 {
          left: auto;
          right: 4%;
          top: 22%;
        }
      }

      /* ========================================
         SCALLOP FOOTER
         Solid contrast-colour semicircle edge along the bottom (reference
         style). Absolutely positioned; slides up once the panel is open.
         ======================================== */
      #{{ section.id }} .cloud-footer {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
        height: var(--menu-cloud-height);
        pointer-events: none;
        color: rgb(var(--color-scheme-text));
        transform: translateY(100%);
        transition: transform 0.7s cubic-bezier(0.215, 0.61, 0.355, 1) 0.15s;
      }

      #{{ section.id }} .menu-overlay.active .cloud-footer {
        transform: translateY(0);
      }

      #{{ section.id }} .cloud-footer svg {
        display: block;
        width: 100%;
        height: 100%;
      }

      #{{ section.id }} .section-content-custom-padding {
        padding: var(--space-6) var(--space-4);
      }

      @media (min-width: 768px) {
        #{{ section.id }} .section-content-custom-padding {
          padding: var(--space-12) var(--space-6);
        }
      }

      /* Hide menu buttons toggle — grid keeps logo centered automatically */
      #{{ section.id }}.hide-menu-buttons .header-left,
      #{{ section.id }}.hide-menu-buttons .header-right {
        display: none !important;
      }
  /* Dim all items when any item is hovered */
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links:hover li a {
    opacity: 0.35;
    transition-delay: 0s;
  }

  /* Keep hovered item at full opacity, with a bit of brand-appropriate tilt */
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:hover,
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:focus-visible {
    opacity: 1 !important;
    color: {{ section.settings.menu_accent_color | default: '#ACFF64' }};
    transform: translateY(0) translateZ(0) rotate(-2deg) scale(1.04);
    transition: transform 0.3s ease-out, opacity 0.3s ease-out, color 0.2s ease-out;
  }

  #{{ section.id }} .menu-content nav ul.menu-links li a:focus-visible,
  #{{ section.id }} .menu-account:focus-visible,
  #{{ section.id }} .menu-email:focus-visible,
  #{{ section.id }} .menu-utility a:focus-visible {
    outline: 2px solid {{ section.settings.menu_accent_color | default: '#ACFF64' }};
    outline-offset: var(--space-2);
  }

  /* Current page marker */
  #{{ section.id }} .menu-content nav ul.menu-links li a[aria-current='page'] {
    color: {{ section.settings.menu_accent_color | default: '#ACFF64' }};
  }

  /* Underline sweep */
  #{{ section.id }} .menu-overlay .menu-content nav ul.menu-links li a::after {
    content: '';
    position: absolute;
    bottom: 0.08em;
    left: 0;
    width: 0;
    height: 4px;
    border-radius: 2px;
    background-color: {{ section.settings.menu_accent_color | default: '#ACFF64' }};
    transition: width 0.45s cubic-bezier(0.215, 0.61, 0.355, 1) 0ms;
  }

  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:hover::after,
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:focus-visible::after,
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a[aria-current='page']::after {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section.id }} .menu-overlay,
    #{{ section.id }} .menu-overlay .cloud-footer,
    #{{ section.id }} .menu-content nav ul.menu-links li a {
      transition-duration: 0.01ms !important;
      transition-delay: 0ms !important;
    }

    #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:hover {
      transform: none;
    }
  }
      /* ========================================
         RESPONSIVE STYLES
         ======================================== */

      /* Mobile (max-width: 767px) */
      @media (max-width: 767px) {
        #{{ section.id }} .responsive-logo-container {
          width: {{ section.settings.logo_width_mobile }}% !important;
          min-width: {{ section.settings.logo_width_mobile }}% !important;
          max-width: {{ section.settings.logo_width_mobile }}% !important;
        }

        {%- if section.settings.menu_button_image != blank -%}
        /* Reference-style mobile header: pill buttons instead of hamburger.
           Sides size to content and the logo shrinks first, so the row can
           never overflow at 320px. */
        #{{ section.id }} .header-content-wrapper {
          grid-template-columns: auto minmax(0, 1fr) auto;
          gap: var(--space-2);
        }

        #{{ section.id }} .responsive-logo-container {
          width: auto !important;
          min-width: 0 !important;
          max-width: {{ section.settings.logo_width_mobile }}% !important;
        }

        #{{ section.id }} .responsive-logo-container img {
          max-width: 100%;
        }

        #{{ section.id }} .header-right {
          gap: var(--space-2);
        }

        #{{ section.id }} .header-button-wrapper {
          width: 76px;
          height: 48px;
        }

        #{{ section.id }} .header-cart-icon {
          width: var(--space-12);
          height: var(--space-12);
        }

        .custom-menu-button-text,
        .custom-shop-button-text {
          font-size: 16px;
          line-height: 24px;
          padding: var(--space-2) var(--space-3);
        }

        .custom-cart-button {
          padding: var(--space-3);
        }

        .menu-text-wrapper {
          min-width: 56px;
        }

        .hamburger-menu {
          display: none !important;
        }
        {%- else -%}
        #{{ section.id }} .header-right {
          gap: var(--space-2);
          display: none;
        }

        /* Show hamburger, hide custom menu button */
        .custom-menu-button,
        .custom-menu-button-text {
          display: none !important;
        }

        .hamburger-menu {
          display: flex !important;
        }
        {%- endif -%}
      }

      /* Tablet (768px - 1023px) */
      @media (min-width: 768px) and (max-width: 1023px) {
        #{{ section.id }} .responsive-logo-container {
          max-width: {{ section.settings.logo_width_tablet }}% !important;
        }

        #{{ section.id }} .menu-overlay {
          --menu-cloud-height: 110px;
        }

        #{{ section.id }} .header-cart-icon {
          width: var(--space-12);
          height: var(--space-12);
        }
      }

      /* Desktop (1024px+) */
      @media (min-width: 1024px) {
        #{{ section.id }} .menu-overlay {
          --menu-cloud-height: 140px;
        }
      }

      /* Desktop (1024px - 1439px) */
      @media (min-width: 1024px) and (max-width: 1439px) {
        #{{ section.id }} .responsive-logo-container {
          max-width: {{ section.settings.logo_width_desktop }}px !important;
        }

        #{{ section.id }} .header-button-wrapper {
          width: 100px;
          height: 70px;
        }

        #{{ section.id }} .header-cart-icon {
          width: var(--space-16);
          height: var(--space-16);
        }
      }

      /* Large Desktop (1440px - 1999px) */
      @media (min-width: 1440px) and (max-width: 1999px) {
        #{{ section.id }} .responsive-logo-container {
          max-width: {{ section.settings.logo_width_desktop_large }}px !important;
        }
      }

      /* XL Desktop (2000px+) */
      @media (min-width: 2000px) {
        #{{ section.id }} .responsive-logo-container {
          max-width: {{ section.settings.logo_width_desktop_xlarge }}px !important;
        }
      }

      /* ========================================
         OVERLAY OFFSET (if enabled)
         ======================================== */
      {%- if enable_overlay -%}
        #{{ section.id }} {
          --overlay-offset: {{ mobile_offset }}px;
        }

        @media (min-width: 990px) {
          #{{ section.id }} {
            --overlay-offset: {{ desktop_offset }}px;
          }
        }
      {%- endif -%}
{%- endstyle -%}

{%- if section.settings.home_page_only == false or template.name == 'index' -%}
  <section
    id="{{ section.id }}"
    class="relative bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %} {% if section.settings.hide_menu_buttons %}hide-menu-buttons{% endif %} {{ border_classes }}"
    data-color-scheme="{{ section.settings.color_scheme }}"
    role="banner"
  >
    <div
      id="menubar-{{ section.id }}"
      class="adjust-menu-on-overlay"
      {% if enable_overlay %}
        style="height: var(--overlay-offset);"
      {% endif %}
    >
      <div class="section-content px-section {% unless section.settings.disable_vertical_spacing %}section-content-custom-padding{% endunless %} {% if enable_overlay %}absolute top-0 left-0 right-0 pointer-events-none z-20{% endif %}">
        <div class="mx-auto max-w-site header-content-wrapper">
          {%- comment -%} Left Section - Menu Button / Hamburger {%- endcomment -%}
          <div class="header-left">
            <div class="header-button-wrapper" id="menuButton-{{ section.id }}">
              {%- comment -%} Hamburger Menu (fallback) {%- endcomment -%}
              <button class="hamburger-menu" aria-label="Open menu" aria-expanded="false" aria-controls="menuOverlay-{{ section.id }}">
                <span class="line"></span>
                <span class="line"></span>
                <span class="line"></span>
              </button>

              {%- comment -%} Custom Menu Button {%- endcomment -%}
              {%- if section.settings.menu_button_image != blank -%}
                <button class="custom-menu-button" aria-expanded="false" aria-controls="menuOverlay-{{ section.id }}">
                  <span class="custom-menu-button-text">
                    <span class="menu-text-wrapper">
                      <span class="menu-text">MENU</span>
                      <span class="close-text">CLOSE</span>
                    </span>
                  </span>
                </button>
              {%- else -%}
                <div
                  class="custom-menu-button-text"
                  style="background-color: #8bc34a; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #c62828; width: 100%; height: 100%;"
                >
                  MENU
                </div>
              {%- endif -%}
            </div>
          </div>

          {%- comment -%} Center Section - Logo {%- endcomment -%}
          {%- if logo != blank -%}
            <div class="responsive-logo-container">
              {{
                logo
                | image_url: width: 3000
                | image_tag: class: 'w-full', width: logo.width, alt: logo.alt
                | default: shop.name, loading: 'eager'
              }}
            </div>
          {%- else -%}
            <div class="font-heading break-word responsive-logo-container">
              {{ shop.name }}
            </div>
          {%- endif -%}

          {%- comment -%} Right Section - Shop Button and Cart {%- endcomment -%}
          <div class="header-right">
            {%- comment -%} Shop Button {%- endcomment -%}
            {%- if section.settings.shop_button_image != blank -%}
              <div class="header-button-wrapper">
                <button class="custom-shop-button">
                  <span class="custom-shop-button-text">SHOP</span>
                </button>
              </div>
            {%- else -%}
              <div
                class="header-button-wrapper"
                style="background-color: #90caf9; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #c62828;"
              >
                SHOP
              </div>
            {%- endif -%}

            {%- comment -%} Cart Icon {%- endcomment -%}
            {%- if section.settings.cart_icon_image != blank -%}
              <button class="custom-cart-button" aria-label="Cart">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="#c62828" aria-hidden="true">
                  <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                </svg>
              </button>
            {%- else -%}
              <div
                class="header-cart-icon"
                style="background-color: #c62828; display: flex; align-items: center; justify-content: center;"
              >
                <svg width="28" height="28" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                  <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
                </svg>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Menu Overlay - full-viewport panel, slides down from top {%- endcomment -%}
    <div
      class="menu-overlay bg-scheme-background text-scheme-text"
      id="menuOverlay-{{ section.id }}"
      data-color-scheme="{{ section.settings.overlay_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
    >
      <div id="menuContent-{{ section.id }}" class="menu-content">
        <div class="menu-layout">
          {%- comment -%} Left column: big logo on desktop, email + socials {%- endcomment -%}
          <div class="menu-side">
            {%- if logo != blank -%}
              <div class="menu-logo">
                {{
                  logo
                  | image_url: width: 900
                  | image_tag: width: logo.width, alt: logo.alt, loading: 'lazy'
                }}
              </div>
            {%- endif -%}

            <div class="menu-side-bottom">
              {%- if section.settings.contact_email != blank -%}
                <a class="menu-email btn-label" href="mailto:{{ section.settings.contact_email | escape }}">
                  {{- section.settings.contact_email -}}
                </a>
              {%- endif -%}
              {%- render 'social-icons', list_class: 'menu-social' -%}
            </div>
          </div>

          {%- comment -%} Right column: account link + big nav links {%- endcomment -%}
          <nav class="menu-nav" aria-label="Main menu">
            {%- if section.settings.show_utility_links -%}
              <ul class="menu-utility">
                <li>
                  <a class="btn-label" href="{{ routes.search_url }}">
                    {%- render 'icon-search' -%}
                    <span>{{ 'general.search.submit' | t }}</span>
                  </a>
                </li>
                <li>
                  <a class="btn-label" href="{{ account_url }}">
                    {%- render 'icon-account' -%}
                    <span>{{ section.settings.utility_account_label | default: 'Account' }}</span>
                  </a>
                </li>
              </ul>
            {%- endif -%}

            {%- if section.settings.account_label != blank -%}
              <a class="menu-account h3" href="{{ account_url }}">
                {{- section.settings.account_label -}}
              </a>
            {%- endif -%}

            <ul class="menu-links">
              {%- comment -%} Loop through menu items from settings {%- endcomment -%}
              {%- for i in (1..10) -%}
                {%- assign label_key = 'menu_item_' | append: i | append: '_label' -%}
                {%- assign link_key = 'menu_item_' | append: i | append: '_link' -%}
                {%- assign hide_desktop_key = 'menu_item_' | append: i | append: '_hide_on_desktop' -%}

                {%- assign label = section.settings[label_key] -%}
                {%- assign link = section.settings[link_key] -%}
                {%- assign hide_on_desktop = section.settings[hide_desktop_key] -%}

                {%- if label != blank -%}
                  <li class="menu-item-{{ i }}{% if hide_on_desktop %} hide-on-desktop{% endif %}">
                    <a
                      class="h1"
                      href="{{ link }}"
                      {% if link != blank and link == request.path %}aria-current="page"{% endif %}
                    >
                      {{- label -}}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        </div>
      </div>

      {%- comment -%} Decorative stickers (reference-style floating shapes) {%- endcomment -%}
      {%- if section.settings.overlay_sticker_1 != blank -%}
        <div class="menu-sticker menu-sticker--1" aria-hidden="true">
          {{ section.settings.overlay_sticker_1 | image_url: width: 300 | image_tag: alt: '', loading: 'lazy' }}
        </div>
      {%- endif -%}
      {%- if section.settings.overlay_sticker_2 != blank -%}
        <div class="menu-sticker menu-sticker--2" aria-hidden="true">
          {{ section.settings.overlay_sticker_2 | image_url: width: 300 | image_tag: alt: '', loading: 'lazy' }}
        </div>
      {%- endif -%}

      {%- comment -%} Bottom Scallop Edge {%- endcomment -%}
      <div class="cloud-footer" aria-hidden="true">
        <svg
          width="100%"
          height="240"
          viewBox="0 0 2400 240"
          preserveAspectRatio="none"
          xmlns="http://www.w3.org/2000/svg"
          focusable="false"
        >
          <path d="M 0,240 L 0,120 A 60,60 0 0,1 120,120 A 60,60 0 0,1 240,120 A 60,60 0 0,1 360,120 A 60,60 0 0,1 480,120 A 60,60 0 0,1 600,120 A 60,60 0 0,1 720,120 A 60,60 0 0,1 840,120 A 60,60 0 0,1 960,120 A 60,60 0 0,1 1080,120 A 60,60 0 0,1 1200,120 A 60,60 0 0,1 1320,120 A 60,60 0 0,1 1440,120 A 60,60 0 0,1 1560,120 A 60,60 0 0,1 1680,120 A 60,60 0 0,1 1800,120 A 60,60 0 0,1 1920,120 A 60,60 0 0,1 2040,120 A 60,60 0 0,1 2160,120 A 60,60 0 0,1 2280,120 A 60,60 0 0,1 2400,120 L 2400,240 Z" fill="currentColor"/>
        </svg>
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} Render Background Blocks {%- endcomment -%}
{%- liquid
  for block in section.blocks
    case block.type
      when 'background_shape'
        render 'block-background-shape', block: block
      when 'background_pattern'
        render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
    endcase
  endfor

  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'

  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor

  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

<script>
  (function () {
    const sectionId = '{{ section.id }}';
    const section = document.getElementById(sectionId);
    const menuButton = document.getElementById('menuButton-' + sectionId);
    const menuOverlay = document.getElementById('menuOverlay-' + sectionId);
    const hamburger = menuButton.querySelector('.hamburger-menu');
    const customMenuButton = menuButton.querySelector('.custom-menu-button');

    // The header bar sits above the overlay, so the links must sit in the
    // space *below* it. Expose that height as padding (not margin) via a custom
    // property, and keep it current as the header reflows.
    function syncHeaderOffset() {
      const bar = document.getElementById('menubar-' + sectionId) || section;
      menuOverlay.style.setProperty('--menu-header-offset', bar.offsetHeight + 'px');
    }

    syncHeaderOffset();
    window.addEventListener('resize', syncHeaderOffset);
    window.addEventListener('load', syncHeaderOffset);

    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(syncHeaderOffset).observe(section);
    }

    let originalOverflow;

    function setExpanded(value) {
      [hamburger, customMenuButton].forEach(function (btn) {
        if (btn) btn.setAttribute('aria-expanded', value ? 'true' : 'false');
      });
    }

    function openMenu() {
      syncHeaderOffset();

      originalOverflow = document.body.style.overflow;
      menuOverlay.classList.add('active');
      section.classList.add('menu-open');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      setExpanded(true);

      // Add active class to hamburger or custom button
      if (hamburger && window.getComputedStyle(hamburger).display !== 'none') {
        hamburger.classList.add('active');
      }
      if (customMenuButton && window.getComputedStyle(customMenuButton).display !== 'none') {
        customMenuButton.classList.add('active');
      }
    }

    function closeMenu() {
      menuOverlay.classList.remove('active');
      section.classList.remove('menu-open');
      document.body.style.overflow = originalOverflow || '';
      document.documentElement.style.overflow = '';
      setExpanded(false);

      // Remove active class from hamburger and custom button
      if (hamburger) {
        hamburger.classList.remove('active');
      }
      if (customMenuButton) {
        customMenuButton.classList.remove('active');
      }
    }

    if (menuButton && menuOverlay) {
      menuButton.addEventListener('click', function () {
        menuOverlay.classList.contains('active') ? closeMenu() : openMenu();
      });

      document.addEventListener('keydown', function (e) {
        if (!menuOverlay.classList.contains('active')) return;

        if (e.key === 'Escape') {
          closeMenu();
          return;
        }

        // Keep Tab focus inside the open menu (overlay links + the visible
        // toggle button and header cart).
        if (e.key === 'Tab') {
          const focusables = Array.prototype.slice
            .call(section.querySelectorAll('.menu-overlay a[href], .menu-overlay button, .hamburger-menu, .custom-menu-button, .custom-cart-button'))
            .filter(function (el) {
              return el.offsetParent !== null;
            });

          if (focusables.length === 0) return;

          const first = focusables[0];
          const last = focusables[focusables.length - 1];

          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }
  })();
</script>

