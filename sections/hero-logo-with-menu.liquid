{%- liquid
  assign logo = section.settings.logo | default: settings.logo
  assign enable_overlay = false

  if enable_overlay
    assign mobile_offset = section.settings.overlay_offset | times: 0.5
    assign desktop_offset = section.settings.overlay_offset
  endif

  case section.location
    when 'header'
      assign border_classes = 'border-b-section border-section-border'
    when 'footer'
      assign border_classes = 'border-t-section border-section-border'
  endcase

  # Count menu items from settings
  assign menu_count = 0
  for i in (1..10)
    assign label_key = 'menu_item_' | append: i | append: '_label'
    assign label = section.settings[label_key]
    if label != blank
      assign menu_count = menu_count | plus: 1
    endif
  endfor

  assign account_url = section.settings.account_link | default: routes.account_url
  assign shop_url = section.settings.shop_link | default: routes.all_products_collection_url
  assign accent_color = section.settings.menu_accent_color | default: '#ACFF64'
-%}

{%- style -%}
      /* ========================================
         PILL BUTTONS (CSS-only — no image assets)
         ======================================== */
      #{{ section.id }} .custom-menu-button,
      #{{ section.id }} .custom-shop-button,
      #{{ section.id }} .custom-cart-button {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: none;
        cursor: pointer;
        text-decoration: none;
        border-radius: 50%;
        box-shadow: var(--shadow-sm);
        transition: transform 0.3s ease;
      }

      #{{ section.id }} .custom-menu-button:focus-visible,
      #{{ section.id }} .custom-shop-button:focus-visible,
      #{{ section.id }} .custom-cart-button:focus-visible {
        outline: 3px solid var(--color-black);
        outline-offset: 2px;
      }

      /* MENU / CLOSE — lime oval */
      #{{ section.id }} .custom-menu-button {
        width: 96px;
        height: 52px;
        background-color: {{ accent_color }};
        transform: rotate(-8deg);
      }

      #{{ section.id }} .custom-menu-button:hover {
        transform: rotate(-2deg) scale(1.04);
      }

      /* SHOP NOW — cream oval, red text */
      #{{ section.id }} .custom-shop-button {
        min-width: 120px;
        height: 64px;
        padding: 0 var(--space-3);
        background-color: var(--color-cream);
        color: var(--color-red);
        transform: rotate(-4deg);
        font-family: var(--font-display);
        font-size: 20px;
        line-height: 1.1;
        text-transform: uppercase;
        text-align: center;
      }

      #{{ section.id }} .custom-shop-button:hover {
        transform: rotate(0deg) scale(1.04);
      }

      /* CART — red oval, cream text */
      #{{ section.id }} .custom-cart-button {
        width: 110px;
        height: 60px;
        background-color: var(--color-red);
        color: var(--color-cream);
        transform: rotate(4deg);
        font-family: var(--font-display);
        font-size: 24px;
        line-height: 1.1;
        text-transform: uppercase;
      }

      #{{ section.id }} .custom-cart-button:hover {
        transform: rotate(1deg) scale(1.04);
      }

      #{{ section.id }} .custom-menu-button-text {
        color: var(--color-red);
        font-family: var(--font-display);
        font-size: 24px;
        line-height: 32px;
        font-weight: 400;
        padding: 0;
      }

      /* Icon-only variants (shown on mobile) */
      #{{ section.id }} .pill-icon {
        display: none;
        align-items: center;
        justify-content: center;
      }

      #{{ section.id }} .pill-icon .theme-icon {
        width: 22px;
        height: 22px;
      }

      /* Theme icons ship with a hardcoded #000 stroke — follow the pill's
         text colour instead. */
      #{{ section.id }} .pill-icon .theme-icon path {
        stroke: currentColor;
      }

      /* Menu button text container for animation */
    .menu-text-wrapper {
      position: relative;
      overflow: hidden;
      height: 1.2em;
      display: block;
      min-width: 64px;
      text-align: center;
    }

    .menu-text-wrapper .menu-text,
    .menu-text-wrapper .close-text {
      display: block;
      transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1),
                  opacity 0.4s cubic-bezier(0.76, 0, 0.24, 1);
    }

    /* Initial state - MENU visible, CLOSE below */
    .menu-text-wrapper .close-text {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
    }

    /* Active state - MENU goes up and fades, CLOSE comes in and fades in */
    .custom-menu-button.active .menu-text {
      transform: translateY(-100%);
      opacity: 0;
    }

    .custom-menu-button.active .close-text {
      transform: translateY(-100%);
      opacity: 1;
    }

    /* Ensure CLOSE starts invisible */
    .menu-text-wrapper .close-text {
      opacity: 0;
    }

    /* Ensure MENU starts visible */
    .menu-text-wrapper .menu-text {
      opacity: 1;
    }

      /* ========================================
         HEADER LAYOUT — logo left, pills cluster
         ======================================== */
      .adjust-menu-on-overlay {
        position: relative;
        z-index: 100000;
      }

      #{{ section.id }} .header-content-wrapper {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
      }

      #{{ section.id }} .responsive-logo-container {
        min-width: 0;
        flex-shrink: 1;
        transition: opacity 0.3s ease-out;
      }

      #{{ section.id }} .responsive-logo-container img {
        max-width: 100%;
      }

      /* MENU pill slightly overlaps the logo */
      #{{ section.id }} .header-left {
        position: relative;
        z-index: 2;
        margin-left: -8px;
        flex-shrink: 0;
      }

      #{{ section.id }} .header-spacer {
        flex: 1 1 0;
        min-width: var(--space-2);
      }

      /* While the menu is open the shop button steps aside (the CLOSE pill and
         cart stay), and on desktop the header logo yields to the giant overlay
         wordmark. visibility:hidden also removes the shop pill from tab order. */
      #{{ section.id }} .custom-shop-button {
        transition: opacity 0.3s ease-out, visibility 0s 0.3s, transform 0.3s ease;
      }

      #{{ section.id }}.menu-open .custom-shop-button {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      @media (min-width: 769px) {
        #{{ section.id }}.menu-open .responsive-logo-container {
          opacity: 0;
        }
      }

      /* ========================================
         MENU OVERLAY

         Full-viewport panel that slides down from the top, with an animated
         scalloped edge along the bottom. The header bar stays above it (CLOSE
         pill + cart remain usable); its height is reserved as *padding-top*
         via --menu-header-offset, kept in sync by the section script.
         ======================================== */
      #{{ section.id }} .menu-overlay {
        --menu-header-offset: 0px;
        --menu-cloud-height: 96px;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        background-color: rgb(var(--color-scheme-background));
        color: rgb(var(--color-scheme-text));
        z-index: 9999;
        visibility: hidden;
        overflow: hidden;
        overscroll-behavior: contain;
        transform: translateY(-102%);
        transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1), visibility 0s 0.7s;
      }

      #{{ section.id }} .menu-overlay.active {
        transform: translateY(0);
        visibility: visible;
        transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1), visibility 0s 0s;
      }

      #{{ section.id }} .menu-content {
        position: absolute;
        inset: 0;
        z-index: 5;
        box-sizing: border-box;
        padding-top: calc(var(--menu-header-offset) + var(--space-4));
        padding-bottom: calc(var(--menu-cloud-height) + var(--space-6));
        padding-inline: var(--space-4);
        overflow-y: auto;
        overscroll-behavior: contain;
        touch-action: pan-y;
        color: rgb(var(--color-scheme-text));
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-content {
          padding-inline: var(--space-6);
        }
      }

      #{{ section.id }} .menu-layout {
        width: 100%;
        max-width: var(--container-max);
        margin-inline: auto;
        min-height: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
      }

      /* Mobile order: utility rows → links → tagline/email/social */
      #{{ section.id }} .menu-nav {
        order: 1;
      }

      #{{ section.id }} .menu-side {
        order: 2;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-8);
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-layout {
          display: grid;
          grid-template-columns: minmax(240px, 5fr) 7fr;
          gap: var(--space-6);
          align-items: stretch;
        }

        /* Explicit row 1 for both: the mobile `order` values would otherwise
           push the left column into an auto-placed second row. */
        #{{ section.id }} .menu-side {
          grid-column: 1;
          grid-row: 1;
          order: 0;
          justify-content: space-between;
        }

        #{{ section.id }} .menu-nav {
          grid-column: 2;
          grid-row: 1;
          order: 0;
        }
      }

      /* --- Left column: giant wordmark → tagline + sticker → email/socials --- */
      #{{ section.id }} .menu-logo {
        display: none;
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-logo {
          display: block;
          width: clamp(420px, 46vw, 640px);
          max-width: 100%;
          margin-left: -40px;
          transform: rotate(-3deg);
        }

        #{{ section.id }} .menu-logo img {
          width: 100%;
          height: auto;
        }
      }

      #{{ section.id }} .menu-tagline {
        display: flex;
        align-items: center;
        gap: var(--space-6);
      }

      #{{ section.id }} .menu-tagline p {
        margin: 0;
        font-family: var(--font-display);
        font-size: 24px;
        line-height: 1.12;
        text-transform: uppercase;
        color: var(--color-red);
        max-width: 420px;
      }

      #{{ section.id }} .menu-tagline img {
        width: 88px;
        height: auto;
        object-fit: contain;
        transform: rotate(8deg);
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-tagline p {
          font-size: 34px;
        }

        #{{ section.id }} .menu-tagline img {
          width: 120px;
        }
      }

      #{{ section.id }} .menu-side-bottom {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
      }

      #{{ section.id }} .menu-email {
        color: rgb(var(--color-scheme-text));
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      #{{ section.id }} .menu-email:hover,
      #{{ section.id }} .menu-email:focus-visible {
        color: {{ accent_color }};
      }

      #{{ section.id }} .menu-social a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        min-height: 48px;
        color: rgb(var(--color-scheme-text));
      }

      /* --- Utility rows (mobile only): Search / Account --- */
      #{{ section.id }} .menu-utility {
        list-style: none;
        margin: 0 0 var(--space-6);
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }

      #{{ section.id }} .menu-utility a {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        min-height: 48px;
        color: rgb(var(--color-scheme-text));
        text-decoration: none;
      }

      #{{ section.id }} .menu-utility a:hover,
      #{{ section.id }} .menu-utility a:focus-visible {
        color: {{ accent_color }};
      }

      #{{ section.id }} .menu-utility .theme-icon {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
      }

      #{{ section.id }} .menu-utility .theme-icon path {
        stroke: currentColor;
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-utility {
          display: none;
        }
      }

      /* --- "My account" link above the nav (desktop only) --- */
      #{{ section.id }} .menu-account {
        display: none;
        color: rgb(var(--color-scheme-text));
        text-decoration: none;
        margin-bottom: var(--space-8);
      }

      #{{ section.id }} .menu-account:hover,
      #{{ section.id }} .menu-account:focus-visible {
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-account {
          display: inline-block;
        }
      }

      /* --- Main links: big, left-aligned, staggered reveal --- */
      #{{ section.id }} .menu-content nav ul.menu-links {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: clamp(var(--space-1), 1vh, var(--space-3));
      }

      #{{ section.id }} .menu-content nav ul.menu-links li {
        margin: 0;
        max-width: 100%;
        overflow: hidden;
      }

      /* "Hide on desktop" per-item setting */
      @media (min-width: 768px) {
        #{{ section.id }} .menu-content nav ul.menu-links li.hide-on-desktop {
          display: none;
        }
      }

    /* Menu items - closing animation (top to bottom). */
    #{{ section.id }} .menu-content nav ul.menu-links li a {
      display: inline-block;
      position: relative;
      text-decoration: none;
      color: rgb(var(--color-scheme-text));
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 9vw, 4rem);
      line-height: 1.08;
      padding: 0 var(--space-1);
      transform: translateY(100%) translateZ(0);
      opacity: 0;
      transition: transform 0.65s cubic-bezier(0.215, 0.61, 0.355, 1) 0ms,
                  opacity 0.65s cubic-bezier(0.215, 0.61, 0.355, 1) 0ms,
                  color 0.25s ease-out;
    }

    @media (min-width: 769px) {
      #{{ section.id }} .menu-content nav ul.menu-links li a {
        font-size: clamp(3rem, min(6.5vw, 11vh), 6rem);
      }
    }

    /* Opening animation (bottom to top) */
    #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a {
      transform: translateY(0) translateZ(0);
      opacity: 1;
    }

    /* Opening delays - top to bottom */
    {% for i in (1..10) %}
      #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li:nth-child({{ i }}) a {
        transition-delay: calc({{ i | minus: 1 }} * 0.09s + 0.35s);
      }
    {% endfor %}

    /* Closing delays - bottom to top (reverse) */
    {% for i in (1..10) %}
      #{{ section.id }} .menu-content nav ul.menu-links li:nth-child({{ i }}) a {
        transition-delay: calc(({{ menu_count }} - {{ i }}) * 0.06s);
      }
    {% endfor %}

      /* ========================================
         DECORATIVE ELEMENTS inside the overlay
         Sticker and sky clouds pop in (scale 0 → 1) once the panel is open.
         ======================================== */
      #{{ section.id }} .menu-sticker {
        position: absolute;
        z-index: 6;
        width: clamp(56px, 7vw, 110px);
        pointer-events: none;
        transform: scale(0) rotate(9deg);
        transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s;
      }

      #{{ section.id }} .menu-overlay.active .menu-sticker {
        transform: scale(1) rotate(9deg);
      }

      #{{ section.id }} .menu-sticker img {
        width: 100%;
        height: auto;
        object-fit: contain;
      }

      #{{ section.id }} .menu-sticker--2 {
        right: 7%;
        bottom: calc(var(--menu-cloud-height) - 20px);
      }

      #{{ section.id }} .menu-cloud {
        position: absolute;
        z-index: 1;
        width: clamp(80px, 9vw, 140px);
        color: var(--color-sky);
        pointer-events: none;
        transform: scale(0);
        transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s;
      }

      #{{ section.id }} .menu-overlay.active .menu-cloud {
        transform: scale(1);
      }

      #{{ section.id }} .menu-cloud svg {
        display: block;
        width: 100%;
        height: auto;
        fill: currentColor;
      }

      #{{ section.id }} .menu-cloud--1 {
        left: 46%;
        top: 60px;
      }

      #{{ section.id }} .menu-cloud--2 {
        right: -30px;
        bottom: 260px;
      }

      @media (max-width: 767px) {
        #{{ section.id }} .menu-cloud--1 {
          display: none;
        }

        #{{ section.id }} .menu-cloud--2 {
          right: -26px;
          top: 26%;
          bottom: auto;
        }
      }

      /* ========================================
         SCALLOP FOOTER
         Big solid semicircle bumps along the bottom, scrolling slowly left →
         right. Two copies of the tiling SVG sit in a 200%-wide scroller; the
         translateY open-transition stays on .cloud-footer itself.
         ======================================== */
      #{{ section.id }} .cloud-footer {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
        height: var(--menu-cloud-height);
        overflow: hidden;
        pointer-events: none;
        color: rgb(var(--color-scheme-text));
        transform: translateY(100%);
        transition: transform 0.7s cubic-bezier(0.215, 0.61, 0.355, 1) 0.15s;
      }

      #{{ section.id }} .menu-overlay.active .cloud-footer {
        transform: translateY(0);
      }

      /* Each SVG copy spans 50% of the scroller, so scroller width controls
         bump width: 140% ⇒ each copy is 0.7× the viewport ⇒ bumps 30% narrower. */
      #{{ section.id }} .cloud-scroller {
        position: absolute;
        inset: 0;
        width: 140%;
        display: flex;
        animation: kd-scroll 20s linear infinite;
      }

      #{{ section.id }} .cloud-scroller svg {
        display: block;
        width: 50%;
        height: 100%;
        flex-shrink: 0;
      }

      @keyframes kd-scroll {
        from {
          transform: translateX(-50%);
        }
        to {
          transform: translateX(0);
        }
      }

      /* Mobile: same 7-bump SVG, but each copy spans 2× the viewport width,
         so the bumps stay wide instead of squeezing into pointy arcs. */
      @media (max-width: 767px) {
        #{{ section.id }} .cloud-scroller {
          width: 400%;
          animation-duration: 12s;
        }
      }

      #{{ section.id }} .section-content-custom-padding {
        padding: var(--space-6) var(--space-4);
      }

      @media (min-width: 768px) {
        #{{ section.id }} .section-content-custom-padding {
          padding: var(--space-12) var(--space-6);
        }
      }

      /* Hide menu buttons toggle — logo-only header */
      #{{ section.id }}.hide-menu-buttons .header-left,
      #{{ section.id }}.hide-menu-buttons .custom-shop-button,
      #{{ section.id }}.hide-menu-buttons .custom-cart-button {
        display: none !important;
      }
  /* Dim all items when any item is hovered */
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links:hover li a {
    opacity: 0.35;
    transition-delay: 0s;
  }

  /* Keep hovered item at full opacity, with a bit of brand-appropriate tilt */
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:hover,
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:focus-visible {
    opacity: 1 !important;
    color: {{ accent_color }};
    transform: translateY(0) translateZ(0) rotate(-2deg) scale(1.04);
    transition: transform 0.3s ease-out, opacity 0.3s ease-out, color 0.2s ease-out;
  }

  #{{ section.id }} .menu-content nav ul.menu-links li a:focus-visible,
  #{{ section.id }} .menu-account:focus-visible,
  #{{ section.id }} .menu-email:focus-visible,
  #{{ section.id }} .menu-utility a:focus-visible {
    outline: 2px solid {{ accent_color }};
    outline-offset: var(--space-2);
  }

  /* Current page marker */
  #{{ section.id }} .menu-content nav ul.menu-links li a[aria-current='page'] {
    color: {{ accent_color }};
  }

  /* Underline sweep */
  #{{ section.id }} .menu-overlay .menu-content nav ul.menu-links li a::after {
    content: '';
    position: absolute;
    bottom: 0.08em;
    left: 0;
    width: 0;
    height: 4px;
    border-radius: 2px;
    background-color: {{ accent_color }};
    transition: width 0.45s cubic-bezier(0.215, 0.61, 0.355, 1) 0ms;
  }

  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:hover::after,
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:focus-visible::after,
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a[aria-current='page']::after {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section.id }} .menu-overlay,
    #{{ section.id }} .menu-overlay .cloud-footer,
    #{{ section.id }} .menu-content nav ul.menu-links li a,
    #{{ section.id }} .menu-sticker,
    #{{ section.id }} .menu-cloud {
      transition-duration: 0.01ms !important;
      transition-delay: 0ms !important;
    }

    #{{ section.id }} .cloud-scroller {
      animation: none;
    }

    #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:hover {
      transform: none;
    }
  }
      /* ========================================
         RESPONSIVE STYLES
         ======================================== */

      /* Mobile (max-width: 767px) */
      @media (max-width: 767px) {
        #{{ section.id }} .header-content-wrapper {
          gap: var(--space-2);
        }

        #{{ section.id }} .responsive-logo-container {
          width: auto !important;
          min-width: 0 !important;
          max-width: {{ section.settings.logo_width_mobile }}% !important;
        }

        #{{ section.id }} .custom-menu-button {
          width: 82px;
          height: 48px;
        }

        #{{ section.id }} .custom-menu-button-text {
          font-size: 18px;
          line-height: 24px;
        }

        .menu-text-wrapper {
          min-width: 52px;
        }

        /* Shop + cart collapse to icon-only pills */
        #{{ section.id }} .custom-shop-button,
        #{{ section.id }} .custom-cart-button {
          width: 52px;
          min-width: 52px;
          height: 48px;
          padding: 0;
        }

        #{{ section.id }} .shop-label,
        #{{ section.id }} .cart-label {
          display: none;
        }

        #{{ section.id }} .pill-icon {
          display: flex;
        }
      }

      /* Tablet (768px - 1023px) */
      @media (min-width: 768px) and (max-width: 1023px) {
        #{{ section.id }} .responsive-logo-container {
          max-width: {{ section.settings.logo_width_tablet }}% !important;
        }

        #{{ section.id }} .menu-overlay {
          --menu-cloud-height: 130px;
        }
      }

      /* Desktop (1024px+) */
      @media (min-width: 1024px) {
        #{{ section.id }} .menu-overlay {
          --menu-cloud-height: 170px;
        }
      }

      /* Desktop (1024px - 1439px) */
      @media (min-width: 1024px) and (max-width: 1439px) {
        #{{ section.id }} .responsive-logo-container {
          max-width: {{ section.settings.logo_width_desktop }}px !important;
        }
      }

      /* Large Desktop (1440px - 1999px) */
      @media (min-width: 1440px) and (max-width: 1999px) {
        #{{ section.id }} .responsive-logo-container {
          max-width: {{ section.settings.logo_width_desktop_large }}px !important;
        }
      }

      /* XL Desktop (2000px+) */
      @media (min-width: 2000px) {
        #{{ section.id }} .responsive-logo-container {
          max-width: {{ section.settings.logo_width_desktop_xlarge }}px !important;
        }
      }

      /* ========================================
         OVERLAY OFFSET (if enabled)
         ======================================== */
      {%- if enable_overlay -%}
        #{{ section.id }} {
          --overlay-offset: {{ mobile_offset }}px;
        }

        @media (min-width: 990px) {
          #{{ section.id }} {
            --overlay-offset: {{ desktop_offset }}px;
          }
        }
      {%- endif -%}
{%- endstyle -%}

{%- if section.settings.home_page_only == false or template.name == 'index' -%}
  <section
    id="{{ section.id }}"
    class="relative bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %} {% if section.settings.hide_menu_buttons %}hide-menu-buttons{% endif %} {{ border_classes }}"
    data-color-scheme="{{ section.settings.color_scheme }}"
    role="banner"
  >
    <div
      id="menubar-{{ section.id }}"
      class="adjust-menu-on-overlay"
      {% if enable_overlay %}
        style="height: var(--overlay-offset);"
      {% endif %}
    >
      <div class="section-content px-section {% unless section.settings.disable_vertical_spacing %}section-content-custom-padding{% endunless %} {% if enable_overlay %}absolute top-0 left-0 right-0 pointer-events-none z-20{% endif %}">
        <div class="mx-auto max-w-site header-content-wrapper">
          {%- comment -%} Logo — left {%- endcomment -%}
          {%- if logo != blank -%}
            <div class="responsive-logo-container">
              {{
                logo
                | image_url: width: 3000
                | image_tag: class: 'w-full', width: logo.width, alt: logo.alt
                | default: shop.name, loading: 'eager'
              }}
            </div>
          {%- else -%}
            <div class="font-heading break-word responsive-logo-container">
              {{ shop.name }}
            </div>
          {%- endif -%}

          {%- comment -%} MENU / CLOSE pill — overlaps the logo {%- endcomment -%}
          <div class="header-left" id="menuButton-{{ section.id }}">
            <button
              class="custom-menu-button"
              aria-expanded="false"
              aria-controls="menuOverlay-{{ section.id }}"
            >
              <span class="custom-menu-button-text">
                <span class="menu-text-wrapper">
                  <span class="menu-text">MENU</span>
                  <span class="close-text">CLOSE</span>
                </span>
              </span>
            </button>
          </div>

          <div class="header-spacer" aria-hidden="true"></div>

          {%- comment -%} SHOP NOW pill (icon-only on mobile) {%- endcomment -%}
          <a class="custom-shop-button" href="{{ shop_url }}" aria-label="{{ section.settings.shop_label | default: 'Shop Now' | escape }}">
            <span class="shop-label">{{ section.settings.shop_label | default: 'Shop Now' }}</span>
            <span class="pill-icon" aria-hidden="true">{% render 'icon-bag' %}</span>
          </a>

          {%- comment -%} CART pill (icon-only on mobile) {%- endcomment -%}
          <a class="custom-cart-button" href="{{ routes.cart_url }}" aria-label="Cart">
            <span class="cart-label">Cart</span>
            <span class="pill-icon" aria-hidden="true">{% render 'icon-cart' %}</span>
          </a>
        </div>
      </div>
    </div>

    {%- comment -%} Menu Overlay - full-viewport panel, slides down from top {%- endcomment -%}
    <div
      class="menu-overlay bg-scheme-background text-scheme-text"
      id="menuOverlay-{{ section.id }}"
      data-color-scheme="{{ section.settings.overlay_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
    >
      <div id="menuContent-{{ section.id }}" class="menu-content">
        <div class="menu-layout">
          {%- comment -%} Left column: giant wordmark, tagline + sticker, email + socials {%- endcomment -%}
          <div class="menu-side">
            {%- if logo != blank -%}
              <div class="menu-logo">
                {{
                  logo
                  | image_url: width: 1300
                  | image_tag: width: logo.width, alt: logo.alt, loading: 'lazy'
                }}
              </div>
            {%- endif -%}

            {%- if section.settings.overlay_tagline != blank or section.settings.overlay_sticker_1 != blank -%}
              <div class="menu-tagline">
                {%- if section.settings.overlay_tagline != blank -%}
                  <p>{{ section.settings.overlay_tagline }}</p>
                {%- endif -%}
                {%- if section.settings.overlay_sticker_1 != blank -%}
                  {{ section.settings.overlay_sticker_1 | image_url: width: 300 | image_tag: alt: '', loading: 'lazy' }}
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="menu-side-bottom">
              {%- if section.settings.contact_email != blank -%}
                <a class="menu-email btn-label" href="mailto:{{ section.settings.contact_email | escape }}">
                  {{- section.settings.contact_email -}}
                </a>
              {%- endif -%}
              {%- render 'social-icons', list_class: 'menu-social' -%}
            </div>
          </div>

          {%- comment -%} Right column: account link + big nav links {%- endcomment -%}
          <nav class="menu-nav" aria-label="Main menu">
            {%- if section.settings.show_utility_links -%}
              <ul class="menu-utility">
                <li>
                  <a class="btn-label" href="{{ routes.search_url }}">
                    {%- render 'icon-search' -%}
                    <span>{{ 'general.search.submit' | t }}</span>
                  </a>
                </li>
                <li>
                  <a class="btn-label" href="{{ account_url }}">
                    {%- render 'icon-account' -%}
                    <span>{{ section.settings.utility_account_label | default: 'Account' }}</span>
                  </a>
                </li>
              </ul>
            {%- endif -%}

            {%- if section.settings.account_label != blank -%}
              <a class="menu-account h3" href="{{ account_url }}">
                {{- section.settings.account_label -}}
              </a>
            {%- endif -%}

            <ul class="menu-links">
              {%- comment -%} Loop through menu items from settings {%- endcomment -%}
              {%- for i in (1..10) -%}
                {%- assign label_key = 'menu_item_' | append: i | append: '_label' -%}
                {%- assign link_key = 'menu_item_' | append: i | append: '_link' -%}
                {%- assign hide_desktop_key = 'menu_item_' | append: i | append: '_hide_on_desktop' -%}

                {%- assign label = section.settings[label_key] -%}
                {%- assign link = section.settings[link_key] -%}
                {%- assign hide_on_desktop = section.settings[hide_desktop_key] -%}

                {%- if label != blank -%}
                  <li class="menu-item-{{ i }}{% if hide_on_desktop %} hide-on-desktop{% endif %}">
                    <a
                      class="h1"
                      href="{{ link }}"
                      {% if link != blank and link == request.path %}aria-current="page"{% endif %}
                    >
                      {{- label -}}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        </div>
      </div>

      {%- comment -%} Sky flower-cloud accents {%- endcomment -%}
      <div class="menu-cloud menu-cloud--1" aria-hidden="true">
        <svg viewBox="0 0 120 104" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <circle cx="60" cy="30" r="26"/>
          <circle cx="32" cy="44" r="24"/>
          <circle cx="88" cy="44" r="24"/>
          <circle cx="42" cy="72" r="24"/>
          <circle cx="78" cy="72" r="24"/>
        </svg>
      </div>
      <div class="menu-cloud menu-cloud--2" aria-hidden="true">
        <svg viewBox="0 0 120 104" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <circle cx="60" cy="30" r="26"/>
          <circle cx="32" cy="44" r="24"/>
          <circle cx="88" cy="44" r="24"/>
          <circle cx="42" cy="72" r="24"/>
          <circle cx="78" cy="72" r="24"/>
        </svg>
      </div>

      {%- comment -%} Floating sticker {%- endcomment -%}
      {%- if section.settings.overlay_sticker_2 != blank -%}
        <div class="menu-sticker menu-sticker--2" aria-hidden="true">
          {{ section.settings.overlay_sticker_2 | image_url: width: 300 | image_tag: alt: '', loading: 'lazy' }}
        </div>
      {%- endif -%}

      {%- comment -%} Bottom Scallop Edge — two tiling copies scroll left → right {%- endcomment -%}
      <div class="cloud-footer" aria-hidden="true">
        <div class="cloud-scroller">
          <svg viewBox="0 0 2800 300" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d="M 0,300 L 0,150 A 200,150 0 0 1 400,150 A 200,150 0 0 1 800,150 A 200,150 0 0 1 1200,150 A 200,150 0 0 1 1600,150 A 200,150 0 0 1 2000,150 A 200,150 0 0 1 2400,150 A 200,150 0 0 1 2800,150 L 2800,300 Z" fill="currentColor"/>
          </svg>
          <svg viewBox="0 0 2800 300" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d="M 0,300 L 0,150 A 200,150 0 0 1 400,150 A 200,150 0 0 1 800,150 A 200,150 0 0 1 1200,150 A 200,150 0 0 1 1600,150 A 200,150 0 0 1 2000,150 A 200,150 0 0 1 2400,150 A 200,150 0 0 1 2800,150 L 2800,300 Z" fill="currentColor"/>
          </svg>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} Render Background Blocks {%- endcomment -%}
{%- liquid
  for block in section.blocks
    case block.type
      when 'background_shape'
        render 'block-background-shape', block: block
      when 'background_pattern'
        render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
    endcase
  endfor

  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'

  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor

  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

<script>
  (function () {
    const sectionId = '{{ section.id }}';
    const section = document.getElementById(sectionId);
    const menuButton = document.getElementById('menuButton-' + sectionId);
    const menuOverlay = document.getElementById('menuOverlay-' + sectionId);
    const customMenuButton = menuButton.querySelector('.custom-menu-button');

    // The header bar sits above the overlay, so the links must sit in the
    // space *below* it. Expose that height as padding (not margin) via a custom
    // property, and keep it current as the header reflows.
    function syncHeaderOffset() {
      const bar = document.getElementById('menubar-' + sectionId) || section;
      menuOverlay.style.setProperty('--menu-header-offset', bar.offsetHeight + 'px');
    }

    syncHeaderOffset();
    window.addEventListener('resize', syncHeaderOffset);
    window.addEventListener('load', syncHeaderOffset);

    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(syncHeaderOffset).observe(section);
    }

    let originalOverflow;

    function openMenu() {
      syncHeaderOffset();

      originalOverflow = document.body.style.overflow;
      menuOverlay.classList.add('active');
      section.classList.add('menu-open');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      customMenuButton.setAttribute('aria-expanded', 'true');
      customMenuButton.classList.add('active');
    }

    function closeMenu() {
      menuOverlay.classList.remove('active');
      section.classList.remove('menu-open');
      document.body.style.overflow = originalOverflow || '';
      document.documentElement.style.overflow = '';
      customMenuButton.setAttribute('aria-expanded', 'false');
      customMenuButton.classList.remove('active');
    }

    if (menuButton && menuOverlay) {
      menuButton.addEventListener('click', function () {
        menuOverlay.classList.contains('active') ? closeMenu() : openMenu();
      });

      document.addEventListener('keydown', function (e) {
        if (!menuOverlay.classList.contains('active')) return;

        if (e.key === 'Escape') {
          closeMenu();
          return;
        }

        // Keep Tab focus inside the open menu (overlay links + the visible
        // toggle button and header cart).
        if (e.key === 'Tab') {
          const focusables = Array.prototype.slice
            .call(section.querySelectorAll('.menu-overlay a[href], .menu-overlay button, .custom-menu-button, .custom-cart-button'))
            .filter(function (el) {
              return el.offsetParent !== null;
            });

          if (focusables.length === 0) return;

          const first = focusables[0];
          const last = focusables[focusables.length - 1];

          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }
  })();
</script>

