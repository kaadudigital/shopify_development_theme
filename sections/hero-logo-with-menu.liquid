7.1446C116.509 24.6284 118.841 22.22 121.033 20.5772Z"/>
              </svg>
              {%- if cart_content == 'count' -%}
                <span class="kd-cart-sticker__label" aria-hidden="true">
                  <span class="kd-cart-sticker__count" data-cart-count>{{ cart.item_count }}</span>
                </span>
              {%- else -%}
                <span class="kd-cart-sticker__icon" aria-hidden="true">
                  {%- if section.settings.cart_icon_svg != blank -%}
                    {{ section.settings.cart_icon_svg }}
                  {%- else -%}
                    {{ section.settings.cart_icon | image_url: width: 200 | image_tag: alt: '', loading: 'eager' }}
                  {%- endif -%}
                </span>
                {%- if cart_content == 'icon_count' -%}
                  <span class="kd-cart-sticker__badge" data-count="{{ cart.item_count }}" aria-hidden="true">{{ cart.item_count }}</span>
                {%- endif -%}
              {%- endif -%}
            </a>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Menu Overlay - full-viewport panel, slides down from top {%- endcomment -%}
    <div
      class="menu-overlay bg-scheme-background text-scheme-text"
      id="menuOverlay-{{ section.id }}"
      data-color-scheme="{{ section.settings.overlay_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
    >
      <div id="menuContent-{{ section.id }}" class="menu-content">
        <div class="menu-layout">
          {%- comment -%} Left column: giant wordmark, tagline + sticker, email + socials {%- endcomment -%}
          <div class="menu-side">
            {%- if logo != blank -%}
              <div class="menu-logo">
                {{
                  logo
                  | image_url: width: 1300
                  | image_tag: width: logo.width, alt: logo.alt, loading: 'lazy'
                }}
              </div>
            {%- endif -%}

            {%- if section.settings.overlay_tagline_image != blank or section.settings.overlay_sticker_1 != blank -%}
              <div class="menu-tagline">
                {%- if section.settings.overlay_tagline_image != blank -%}
                  {{
                    section.settings.overlay_tagline_image
                    | image_url: width: 900
                    | image_tag: class: 'menu-tagline-image', alt: section.settings.overlay_tagline_image.alt, loading: 'lazy'
                  }}
                {%- endif -%}
                {%- if section.settings.overlay_sticker_1 != blank -%}
                  {{ section.settings.overlay_sticker_1 | image_url: width: 300 | image_tag: class: 'menu-tagline-sticker', alt: '', loading: 'lazy' }}
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="menu-side-bottom">
              {%- if section.settings.contact_email != blank -%}
                <a class="menu-email btn-label" href="mailto:{{ section.settings.contact_email | escape }}">
                  {{- section.settings.contact_email -}}
                </a>
              {%- endif -%}

              {%- liquid
                assign social_tiktok = section.settings.social_tiktok_link | default: settings.social_tiktok_link
                assign social_facebook = section.settings.social_facebook_link | default: settings.social_facebook_link
                assign social_instagram = section.settings.social_instagram_link | default: settings.social_instagram_link
              -%}
              {%- comment -%}
                Networks without a configured URL render as decorative icons
                (no link) so the row is always present; paste the profile URLs
                in the section settings (or Theme settings → Social) to make
                them clickable.
              {%- endcomment -%}
              <ul class="menu-social">
                <li>
                  {%- if social_tiktok != blank -%}
                    <a href="{{ social_tiktok }}" target="_blank" rel="noopener">
                      <span class="menu-social-icon" aria-hidden="true">{% render 'icon-tiktok' %}</span>
                      <span class="visually-hidden">TikTok</span>
                    </a>
                  {%- else -%}
                    <span class="menu-social-drop" aria-hidden="true">
                      <span class="menu-social-icon">{% render 'icon-tiktok' %}</span>
                    </span>
                  {%- endif -%}
                </li>
                <li>
                  {%- if social_facebook != blank -%}
                    <a href="{{ social_facebook }}" target="_blank" rel="noopener">
                      <span class="menu-social-icon" aria-hidden="true">{% render 'icon-facebook' %}</span>
                      <span class="visually-hidden">Facebook</span>
                    </a>
                  {%- else -%}
                    <span class="menu-social-drop" aria-hidden="true">
                      <span class="menu-social-icon">{% render 'icon-facebook' %}</span>
                    </span>
                  {%- endif -%}
                </li>
                <li>
                  {%- if social_instagram != blank -%}
                    <a href="{{ social_instagram }}" target="_blank" rel="noopener">
                      <span class="menu-social-icon" aria-hidden="true">{% render 'icon-instagram' %}</span>
                      <span class="visually-hidden">Instagram</span>
                    </a>
                  {%- else -%}
                    <span class="menu-social-drop" aria-hidden="true">
                      <span class="menu-social-icon">{% render 'icon-instagram' %}</span>
                    </span>
                  {%- endif -%}
                </li>
              </ul>
            </div>
          </div>

          {%- comment -%} Right column: account link + big nav links {%- endcomment -%}
          <nav class="menu-nav" aria-label="Main menu">
            {%- if section.settings.show_utility_links -%}
              <ul class="menu-utility">
                <li>
                  <a class="btn-label" href="{{ routes.search_url }}">
                    {%- render 'icon-search' -%}
                    <span>{{ 'general.search.submit' | t }}</span>
                  </a>
                </li>
                <li>
                  <a class="btn-label" href="{{ account_url }}">
                    {%- render 'icon-account' -%}
                    <span>{{ section.settings.utility_account_label | default: 'Account' }}</span>
                  </a>
                </li>
              </ul>
            {%- endif -%}

            {%- if section.settings.account_label != blank -%}
              <a class="menu-account h3" href="{{ account_url }}">
                {{- section.settings.account_label -}}
              </a>
            {%- endif -%}

            <ul class="menu-links">
              {%- comment -%} Loop through menu items from settings {%- endcomment -%}
              {%- for i in (1..10) -%}
                {%- assign label_key = 'menu_item_' | append: i | append: '_label' -%}
                {%- assign link_key = 'menu_item_' | append: i | append: '_link' -%}
                {%- assign hide_desktop_key = 'menu_item_' | append: i | append: '_hide_on_desktop' -%}

                {%- assign label = section.settings[label_key] -%}
                {%- assign link = section.settings[link_key] -%}
                {%- assign hide_on_desktop = section.settings[hide_desktop_key] -%}

                {%- if label != blank -%}
                  <li class="menu-item-{{ i }}{% if hide_on_desktop %} hide-on-desktop{% endif %}">
                    <a
                      class="h1"
                      href="{{ link }}"
                      {% if link != blank and link == request.path %}aria-current="page"{% endif %}
                    >
                      {{- label -}}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        </div>
      </div>

      {%- comment -%} Sky flower accents — 6 petals + centre, spinning, cursor-follow {%- endcomment -%}
      {%- capture flower_svg -%}
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <circle cx="90" cy="60" r="21"/>
          <circle cx="75" cy="86" r="21"/>
          <circle cx="45" cy="86" r="21"/>
          <circle cx="30" cy="60" r="21"/>
          <circle cx="45" cy="34" r="21"/>
          <circle cx="75" cy="34" r="21"/>
          <circle cx="60" cy="60" r="26"/>
        </svg>
      {%- endcapture -%}
      <div class="menu-cloud menu-cloud--1" data-depth="70" aria-hidden="true">
        <div class="menu-cloud-pop">{{ flower_svg }}</div>
      </div>
      <div class="menu-cloud menu-cloud--2" data-depth="100" aria-hidden="true">
        <div class="menu-cloud-pop">{{ flower_svg }}</div>
      </div>
      <div class="menu-cloud menu-cloud--3" data-depth="50" aria-hidden="true">
        <div class="menu-cloud-pop">{{ flower_svg }}</div>
      </div>
      <div class="menu-cloud menu-cloud--4" data-depth="85" aria-hidden="true">
        <div class="menu-cloud-pop">{{ flower_svg }}</div>
      </div>

      {%- comment -%} Floating sticker {%- endcomment -%}
      {%- if section.settings.overlay_sticker_2 != blank -%}
        <div class="menu-sticker menu-sticker--2" aria-hidden="true">
          {{ section.settings.overlay_sticker_2 | image_url: width: 300 | image_tag: alt: '', loading: 'lazy' }}
        </div>
      {%- endif -%}

      {%- comment -%} Bottom Scallop Edge — two tiling copies scroll left → right {%- endcomment -%}
      <div class="cloud-footer" aria-hidden="true">
        <div class="cloud-scroller">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 2800 300" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M 0,300 L 0,150 A 200,150 0 0 1 400,150 A 200,150 0 0 1 800,150 A 200,150 0 0 1 1200,150 A 200,150 0 0 1 1600,150 A 200,150 0 0 1 2000,150 A 200,150 0 0 1 2400,150 A 200,150 0 0 1 2800,150 L 2800,300 Z" fill="currentColor"/>
            </svg>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} Render Background Blocks {%- endcomment -%}
{%- liquid
  for block in section.blocks
    case block.type
      when 'background_shape'
        render 'block-background-shape', block: block
      when 'background_pattern'
        render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
    endcase
  endfor

  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'

  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor

  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

<script>
  (function () {
    const sectionId = '{{ section.id }}';
    const section = document.getElementById(sectionId);
    const menuButton = document.getElementById('menuButton-' + sectionId);
    const menuOverlay = document.getElementById('menuOverlay-' + sectionId);
    const customMenuButton = menuButton.querySelector('.custom-menu-button');

    // The header bar sits above the overlay, so the links must sit in the
    // space *below* it. Expose that height as padding (not margin) via a custom
    // property, and keep it current as the header reflows.
    // The overlay is fixed at the viewport top, so use where the bar *ends* on
    // screen (includes the announcement bar above it), not just its height.
    function syncHeaderOffset() {
      const bar = document.getElementById('menubar-' + sectionId) || section;
      const bottom = Math.max(bar.getBoundingClientRect().bottom, bar.offsetHeight);
      menuOverlay.style.setProperty('--menu-header-offset', Math.round(bottom) + 'px');
    }

    syncHeaderOffset();
    window.addEventListener('resize', syncHeaderOffset);
    window.addEventListener('load', syncHeaderOffset);

    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(syncHeaderOffset).observe(section);
    }

    let originalOverflow;

    function openMenu() {
      syncHeaderOffset();

      originalOverflow = document.body.style.overflow;
      menuOverlay.classList.add('active');
      section.classList.add('menu-open');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      customMenuButton.setAttribute('aria-expanded', 'true');
      customMenuButton.classList.add('active');
    }

    function closeMenu() {
      menuOverlay.classList.remove('active');
      section.classList.remove('menu-open');
      document.body.style.overflow = originalOverflow || '';
      document.documentElement.style.overflow = '';
      customMenuButton.setAttribute('aria-expanded', 'false');
      customMenuButton.classList.remove('active');
    }

    // Flowers drift toward the cursor while the menu is open. Each flower's
    // data-depth sets how far it travels; skipped under reduced motion.
    const clouds = menuOverlay.querySelectorAll('.menu-cloud');
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let parallaxRaf = null;
    let cursorX = 0;
    let cursorY = 0;

    document.addEventListener('mousemove', function (e) {
      if (motionQuery.matches || !menuOverlay.classList.contains('active')) return;

      cursorX = e.clientX / window.innerWidth - 0.5;
      cursorY = e.clientY / window.innerHeight - 0.5;

      if (parallaxRaf) return;
      parallaxRaf = requestAnimationFrame(function () {
        parallaxRaf = null;
        clouds.forEach(function (cloud) {
          const depth = parseFloat(cloud.getAttribute('data-depth')) || 24;
          cloud.style.setProperty('--kd-par-x', cursorX * depth + 'px');
          cloud.style.setProperty('--kd-par-y', cursorY * depth + 'px');
        });
      });
    });

    if (menuButton && menuOverlay) {
      menuButton.addEventListener('click', function () {
        menuOverlay.classList.contains('active') ? closeMenu() : openMenu();
      });

      document.addEventListener('keydown', function (e) {
        if (!menuOverlay.classList.contains('active')) return;

        if (e.key === 'Escape') {
          closeMenu();
          return;
        }

        // Keep Tab focus inside the open menu (overlay links + the visible
        // toggle button and header cart).
        if (e.key === 'Tab') {
          const focusables = Array.prototype.slice
            .call(section.querySelectorAll('.menu-overlay a[href], .menu-overlay button, .custom-menu-button, .custom-cart-button'))
            .filter(function (el) {
              return el.offsetParent !== null;
            });

          if (focusables.length === 0) return;

          const first = focusables[0];
          const last = focusables[focusables.length - 1];

          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }
  })();
</script>

