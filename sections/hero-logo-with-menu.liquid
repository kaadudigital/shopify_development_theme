{%- liquid
  assign logo = section.settings.logo | default: settings.logo
  assign enable_overlay = false

  if enable_overlay
    assign mobile_offset = section.settings.overlay_offset | times: 0.5
    assign desktop_offset = section.settings.overlay_offset
  endif

  case section.location
    when 'header'
      assign border_classes = 'border-b-section border-section-border'
    when 'footer'
      assign border_classes = 'border-t-section border-section-border'
  endcase

  # Count menu items from settings
  assign menu_count = 0
  for i in (1..10)
    assign label_key = 'menu_item_' | append: i | append: '_label'
    assign label = section.settings[label_key]
    if label != blank
      assign menu_count = menu_count | plus: 1
    endif
  endfor

  assign account_url = section.settings.account_link | default: routes.account_url
  assign shop_url = section.settings.shop_link | default: routes.all_products_collection_url
  assign accent_color = section.settings.menu_accent_color | default: '#ACFF64'
  assign cart_content = section.settings.cart_content | default: 'count'
  assign cart_has_icon = false
  if section.settings.cart_icon_svg != blank or section.settings.cart_icon != blank
    assign cart_has_icon = true
  endif
  if cart_has_icon == false
    assign cart_content = 'count'
  endif
-%}

{%- style -%}
      /* ========================================
         HEADER BAR (DS Header) — purple band, logo left,
         lime MENU cloud overlapping it, red shop cloud, starburst cart.
         Cloud buttons use .kd-btn (assets/base.bundle.css).
         ======================================== */
      #{{ section.id }} .custom-menu-button {
        transform: rotate(-6deg);
      }

      /* Nudge of the MENU cloud per device (settings "MENU button position") */
      #{{ section.id }} .header-left {
        top: {{ section.settings.menu_button_offset_y_mobile | default: 0 }}px;
        left: {{ section.settings.menu_button_offset_x_mobile | default: 0 }}px;
      }

      @media (min-width: 768px) {
        #{{ section.id }} .header-left {
          top: {{ section.settings.menu_button_offset_y_tablet | default: 0 }}px;
          left: {{ section.settings.menu_button_offset_x_tablet | default: 0 }}px;
        }
      }

      @media (min-width: 1200px) {
        #{{ section.id }} .header-left {
          top: {{ section.settings.menu_button_offset | default: 0 }}px;
          left: {{ section.settings.menu_button_offset_x | default: 0 }}px;
        }
      }

      #{{ section.id }} .custom-menu-button:hover {
        transform: rotate(-2deg);
      }

      #{{ section.id }} .custom-menu-button-text {
        font-family: var(--font-display);
        font-weight: 400;
      }

      /* CART — lime starburst sticker (DS: the cart icon is a starburst sticker) */
      #{{ section.id }} .kd-cart-sticker {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        --kd-cart-size: {{ section.settings.cart_size_mobile | default: 56 }}px;
        width: var(--kd-cart-size);
        height: var(--kd-cart-size);
        color: {{ section.settings.cart_text_color | default: '#ac0300' }};
        text-decoration: none;
        transform: rotate(-6deg);
      }

      #{{ section.id }} .kd-cart-sticker:hover {
        transform: rotate(6deg);
      }

      #{{ section.id }} .kd-cart-sticker__shape {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        fill: {{ section.settings.cart_shape_color | default: '#ACFF64' }};
        filter: drop-shadow(var(--shadow-card));
      }

      #{{ section.id }} .kd-cart-sticker__label {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: max(10px, calc(var(--kd-cart-size) * 0.16));
        line-height: 1;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      /* Count and badge scale with the sticker size */
      #{{ section.id }} .kd-cart-sticker__count {
        font-size: calc(var(--kd-cart-size) * 0.35);
      }

      /* Custom icon inside the sticker; inline SVG code follows the text colour via currentColor */
      #{{ section.id }} .kd-cart-sticker__icon {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: {{ section.settings.cart_icon_size | default: 50 }}%;
        height: {{ section.settings.cart_icon_size | default: 50 }}%;
      }

      #{{ section.id }} .kd-cart-sticker__icon svg,
      #{{ section.id }} .kd-cart-sticker__icon img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      /* Small count badge on the sticker's edge (icon + count mode); hidden while the cart is empty */
      #{{ section.id }} .kd-cart-sticker__badge {
        position: absolute;
        top: 4%;
        right: 4%;
        min-width: max(18px, calc(var(--kd-cart-size) * 0.32));
        height: max(18px, calc(var(--kd-cart-size) * 0.32));
        padding: 0 5px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: {{ section.settings.cart_text_color | default: '#ac0300' }};
        color: {{ section.settings.cart_shape_color | default: '#ACFF64' }};
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: max(11px, calc(var(--kd-cart-size) * 0.15));
        line-height: 1;
        transform: rotate(6deg);
      }

      #{{ section.id }} .kd-cart-sticker__badge[data-count='0'] {
        display: none;
      }

      @media (min-width: 768px) {
        #{{ section.id }} .kd-cart-sticker {
          --kd-cart-size: {{ section.settings.cart_size_tablet | default: 56 }}px;
        }
      }

      @media (min-width: 1200px) {
        #{{ section.id }} .kd-cart-sticker {
          --kd-cart-size: {{ section.settings.cart_size_desktop | default: 88 }}px;
        }
      }

      /* Menu button text container for animation */
    .menu-text-wrapper {
      position: relative;
      overflow: hidden;
      height: 1.2em;
      display: block;
      min-width: 64px;
      text-align: center;
    }

    .menu-text-wrapper .menu-text,
    .menu-text-wrapper .close-text {
      display: block;
      transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1),
                  opacity 0.4s cubic-bezier(0.76, 0, 0.24, 1);
    }

    /* Initial state - MENU visible, CLOSE below */
    .menu-text-wrapper .close-text {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
    }

    /* Active state - MENU goes up and fades, CLOSE comes in and fades in */
    .custom-menu-button.active .menu-text {
      transform: translateY(-100%);
      opacity: 0;
    }

    .custom-menu-button.active .close-text {
      transform: translateY(-100%);
      opacity: 1;
    }

    /* Ensure CLOSE starts invisible */
    .menu-text-wrapper .close-text {
      opacity: 0;
    }

    /* Ensure MENU starts visible */
    .menu-text-wrapper .menu-text {
      opacity: 1;
    }

      /* ========================================
         HEADER LAYOUT — logo left, pills cluster
         ======================================== */
      .adjust-menu-on-overlay {
        position: relative;
        z-index: 100000;
      }

      #{{ section.id }} .header-content-wrapper {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
      }

      /* Logo: full colour, never recoloured; 72px tall on mobile, 110px on tablet, 160px from 1200px */
      #{{ section.id }} .responsive-logo-container {
        min-width: 0;
        flex-shrink: 1;
        transition: opacity 0.3s ease-out;
      }

      #{{ section.id }} .responsive-logo-container img {
        display: block;
        width: auto;
        max-width: 100%;
        height: 72px;
      }

      /* MENU cloud overlaps the logo's right edge */
      #{{ section.id }} .header-left {
        position: relative;
        z-index: 2;
        margin-left: calc(-1 * var(--space-6));
        flex-shrink: 0;
      }

      /* Shop cloud + cart sit level with the logo baseline */
      #{{ section.id }} .header-actions {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        flex-shrink: 0;
      }

      @media (min-width: 768px) {
        #{{ section.id }} .responsive-logo-container img {
          height: 110px;
        }

        #{{ section.id }} .header-left,
        #{{ section.id }} .header-actions {
          margin-top: var(--space-6);
        }
      }

      @media (min-width: 1200px) {
        #{{ section.id }} .responsive-logo-container img {
          height: 160px;
        }

        #{{ section.id }} .header-left {
          margin-top: var(--space-9);
          margin-left: calc(-1 * var(--space-9));
        }

        #{{ section.id }} .header-actions {
          margin-top: var(--space-9);
        }
      }

      #{{ section.id }} .header-spacer {
        flex: 1 1 0;
        min-width: var(--space-2);
      }

      /* While the menu is open the shop button steps aside (the CLOSE pill and
         cart stay), and on desktop the header logo yields to the giant overlay
         wordmark. visibility:hidden also removes the shop pill from tab order. */
      #{{ section.id }} .custom-shop-button {
        transition: opacity 0.3s ease-out, visibility 0s 0.3s, transform 0.3s ease;
      }

      #{{ section.id }}.menu-open .custom-shop-button {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      @media (min-width: 769px) {
        #{{ section.id }}.menu-open .responsive-logo-container {
          opacity: 0;
        }
      }

      /* ========================================
         MENU OVERLAY

         Full-viewport panel that slides down from the top, with an animated
         scalloped edge along the bottom. The header bar stays above it (CLOSE
         pill + cart remain usable); its height is reserved as *padding-top*
         via --menu-header-offset, kept in sync by the section script.
         ======================================== */
      #{{ section.id }} .menu-overlay {
        --menu-header-offset: 0px;
        --menu-cloud-height: 96px;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        background-color: rgb(var(--color-scheme-background));
        color: rgb(var(--color-scheme-text));
        z-index: 9999;
        visibility: hidden;
        overflow: hidden;
        overscroll-behavior: contain;
        transform: translateY(-102%);
        transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1), visibility 0s 0.7s;
      }

      #{{ section.id }} .menu-overlay.active {
        transform: translateY(0);
        visibility: visible;
        transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1), visibility 0s 0s;
      }

      #{{ section.id }} .menu-content {
        position: absolute;
        inset: 0;
        z-index: 5;
        box-sizing: border-box;
        padding-top: calc(var(--menu-header-offset) + var(--space-4));
        /* Reserve only the VISIBLE strip height (full height + negative
           offset), not the part hanging below the viewport. */
        padding-bottom: calc(var(--menu-cloud-height) + var(--menu-cloud-offset, 0px) + var(--space-6));
        padding-inline: var(--space-4);
        overflow-y: auto;
        overscroll-behavior: contain;
        touch-action: pan-y;
        color: rgb(var(--color-scheme-text));
      }

      /* Mobile: gap between the header logo and the first menu row
         (setting "Mobile: space below the logo") */
      @media (max-width: 768px) {
        #{{ section.id }} .menu-content {
          padding-top: calc(var(--menu-header-offset) + {{ section.settings.menu_top_space_mobile | default: 40 }}px);
        }
      }

      /* Desktop content is height-scaled to always fit, so lock scrolling;
         mobile keeps overflow-y auto as a safety net for short viewports. */
      @media (min-width: 769px) {
        #{{ section.id }} .menu-content {
          padding-inline: var(--gutter);
          overflow-y: hidden;
        }
      }

      /* Full width like the header bar (no 1200px cap), so on 24"+ screens the
         wordmark stays at the left edge, lined up with the header logo. */
      #{{ section.id }} .menu-layout {
        width: 100%;
        margin-inline: auto;
        min-height: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--legacy-space-8);
      }

      /* Mobile order: utility rows → links → tagline/email/social */
      #{{ section.id }} .menu-nav {
        order: 1;
      }

      #{{ section.id }} .menu-side {
        order: 2;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--legacy-space-8);
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-layout {
          display: grid;
          grid-template-columns: minmax(240px, 5fr) 7fr;
          gap: var(--space-6);
          align-items: stretch;
        }

        /* Explicit row 1 for both: the mobile `order` values would otherwise
           push the left column into an auto-placed second row. */
        #{{ section.id }} .menu-side {
          grid-column: 1;
          grid-row: 1;
          order: 0;
          justify-content: space-between;
        }

        #{{ section.id }} .menu-nav {
          grid-column: 2;
          grid-row: 1;
          order: 0;
        }
      }

      /* --- Left column: giant wordmark → tagline + sticker → email/socials --- */
      #{{ section.id }} .menu-logo {
        display: none;
      }

      @media (min-width: 769px) {
        /* Pull the wordmark up into the header zone so the CLOSE pill sits on
           its upper edge instead of floating alone (--menu-header-offset is
           the header bar height, synced by the section script). */
        #{{ section.id }} .menu-logo {
          display: block;
          width: clamp(420px, 46vw, 640px);
          max-width: 100%;
          margin-left: -40px;
          margin-top: calc(-1 * var(--menu-header-offset) + var(--space-6));
          transform: rotate(-3deg);
        }

        #{{ section.id }} .menu-logo img {
          width: 100%;
          height: auto;
        }
      }

      /* Desktop: the CLOSE pill sits at a fixed spot (right of the header logo),
         so the wordmark gets a fixed height too (the 24" look, ~220px). Tall
         27"+ screens no longer grow it, short laptops still scale it by height. */
      @media (min-width: 1200px) {
        #{{ section.id }} .menu-logo {
          width: auto;
        }

        #{{ section.id }} .menu-logo img {
          width: auto;
          max-width: 100%;
          height: min(220px, 22dvh);
          max-height: none;
        }
      }

      /* Tablet: the gutter is only 32px, so drop the -40px pull and keep the
         wordmark inside the margin (desktop keeps the pull: 64px gutter). */
      @media (min-width: 769px) and (max-width: 1199px) {
        #{{ section.id }} .menu-logo {
          margin-left: 0;
        }
      }

      /* Tagline artwork — desktop only */
      #{{ section.id }} .menu-tagline {
        display: none;
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-tagline {
          display: flex;
          align-items: center;
          gap: var(--space-6);
        }

        #{{ section.id }} .menu-tagline-image {
          width: clamp(240px, 26vw, 420px);
          max-width: 100%;
          height: auto;
        }

        #{{ section.id }} .menu-tagline-sticker {
          width: 120px;
          height: auto;
          object-fit: contain;
          transform: rotate(8deg);
        }
      }

      /* Short desktop screens (13" laptops): scale the overlay art by
         viewport height so the left column never scrolls — scrolling slid
         the wordmark out from under the CLOSE pill. Taller screens keep the
         original sizes. */
      @media (min-width: 769px) and (max-height: 1023px) {
        #{{ section.id }} .menu-side {
          gap: var(--space-6);
        }

        #{{ section.id }} .menu-logo img {
          width: auto;
          max-width: 100%;
          max-height: 22dvh;
        }

        #{{ section.id }} .menu-tagline-image {
          width: auto;
          max-width: min(26vw, 420px);
          max-height: 24dvh;
        }

        #{{ section.id }} .menu-tagline-sticker {
          width: auto;
          max-height: 12dvh;
        }

        #{{ section.id }} .menu-account {
          margin-bottom: var(--space-6);
        }

        #{{ section.id }} .menu-content nav ul.menu-links li a {
          font-size: clamp(2.25rem, min(6vw, 8.5vh), 6rem);
        }
      }

      #{{ section.id }} .menu-side-bottom {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
      }

      #{{ section.id }} .menu-email {
        color: rgb(var(--color-scheme-text));
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      #{{ section.id }} .menu-email:hover,
      #{{ section.id }} .menu-email:focus-visible {
        opacity: 0.7;
      }

      #{{ section.id }} .menu-social {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: var(--space-2);
      }

      #{{ section.id }} .menu-social a,
      #{{ section.id }} .menu-social .menu-social-drop {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        min-height: 48px;
        color: rgb(var(--color-scheme-text));
      }

      #{{ section.id }} .menu-social a:hover,
      #{{ section.id }} .menu-social a:focus-visible {
        opacity: 0.7;
      }

      #{{ section.id }} .menu-social-icon {
        display: inline-block;
        width: 24px;
        height: 24px;
      }

      #{{ section.id }} .menu-social-icon svg {
        width: 100%;
        height: 100%;
        fill: currentColor;
      }

      /* --- Utility rows (mobile only): Search / Account --- */
      #{{ section.id }} .menu-utility {
        list-style: none;
        margin: 0 0 var(--space-6);
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }

      #{{ section.id }} .menu-utility a {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        min-height: 48px;
        color: rgb(var(--color-scheme-text));
        text-decoration: none;
      }

      #{{ section.id }} .menu-utility a:hover,
      #{{ section.id }} .menu-utility a:focus-visible {
        opacity: 0.7;
      }

      #{{ section.id }} .menu-utility .theme-icon {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
      }

      #{{ section.id }} .menu-utility .theme-icon path {
        stroke: currentColor;
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-utility {
          display: none;
        }
      }

      /* --- "My account" link above the nav (desktop only) --- */
      #{{ section.id }} .menu-account {
        display: none;
        color: rgb(var(--color-scheme-text));
        text-decoration: none;
        margin-bottom: var(--legacy-space-8);
      }

      #{{ section.id }} .menu-account:hover,
      #{{ section.id }} .menu-account:focus-visible {
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      @media (min-width: 769px) {
        #{{ section.id }} .menu-account {
          display: inline-block;
        }
      }

      /* --- Main links: big, left-aligned, staggered reveal --- */
      #{{ section.id }} .menu-content nav ul.menu-links {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: clamp(var(--space-1), 1vh, var(--space-3));
      }

      #{{ section.id }} .menu-content nav ul.menu-links li {
        margin: 0;
        max-width: 100%;
        overflow: hidden;
      }

      /* "Hide on desktop" per-item setting */
      @media (min-width: 768px) {
        #{{ section.id }} .menu-content nav ul.menu-links li.hide-on-desktop {
          display: none;
        }
      }

    /* Menu items - closing animation (top to bottom). */
    #{{ section.id }} .menu-content nav ul.menu-links li a {
      display: inline-block;
      position: relative;
      text-decoration: none;
      color: rgb(var(--color-scheme-text));
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 9vw, 4rem);
      line-height: 1.08;
      padding: 0 var(--space-1);
      transform: translateY(100%) translateZ(0);
      opacity: 0;
      transition: transform 0.65s cubic-bezier(0.215, 0.61, 0.355, 1) 0ms,
                  opacity 0.65s cubic-bezier(0.215, 0.61, 0.355, 1) 0ms,
                  color 0.25s ease-out;
    }

    @media (min-width: 769px) {
      #{{ section.id }} .menu-content nav ul.menu-links li a {
        font-size: clamp(3rem, min(6.5vw, 11vh), 6rem);
      }
    }

    /* Opening animation (bottom to top) */
    #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a {
      transform: translateY(0) translateZ(0);
      opacity: 1;
    }

    /* Opening delays - top to bottom */
    {% for i in (1..10) %}
      #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li:nth-child({{ i }}) a {
        transition-delay: calc({{ i | minus: 1 }} * 0.09s + 0.35s);
      }
    {% endfor %}

    /* Closing delays - bottom to top (reverse) */
    {% for i in (1..10) %}
      #{{ section.id }} .menu-content nav ul.menu-links li:nth-child({{ i }}) a {
        transition-delay: calc(({{ menu_count }} - {{ i }}) * 0.06s);
      }
    {% endfor %}

      /* ========================================
         DECORATIVE ELEMENTS inside the overlay
         Sticker and sky clouds pop in (scale 0 → 1) once the panel is open.
         ======================================== */
      #{{ section.id }} .menu-sticker {
        position: absolute;
        z-index: 6;
        width: clamp(56px, 7vw, 110px);
        pointer-events: none;
        transform: scale(0) rotate(9deg);
        transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s;
      }

      #{{ section.id }} .menu-overlay.active .menu-sticker {
        transform: scale(1) rotate(9deg);
      }

      #{{ section.id }} .menu-sticker img {
        width: 100%;
        height: auto;
        object-fit: contain;
      }

      #{{ section.id }} .menu-sticker--2 {
        right: 7%;
        bottom: calc(var(--menu-cloud-height) + var(--menu-cloud-offset, 0px) - 20px);
      }

      /* Flowers: outer div follows the cursor (parallax via --kd-par-*, set by
         the section script), inner div pops in, the SVG spins continuously. */
      #{{ section.id }} .menu-cloud {
        position: absolute;
        z-index: 1;
        width: clamp(80px, 9vw, 140px);
        color: var(--color-sky);
        pointer-events: none;
        transform: translate3d(var(--kd-par-x, 0px), var(--kd-par-y, 0px), 0);
        transition: transform 0.35s ease-out;
      }

      #{{ section.id }} .menu-cloud-pop {
        transform: scale(0);
        transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s;
      }

      #{{ section.id }} .menu-overlay.active .menu-cloud-pop {
        transform: scale(1);
      }

      #{{ section.id }} .menu-cloud svg {
        display: block;
        width: 100%;
        height: auto;
        fill: currentColor;
        animation: kd-spin 26s linear infinite;
      }

      @keyframes kd-spin {
        to {
          transform: rotate(360deg);
        }
      }

      #{{ section.id }} .menu-cloud--1 {
        left: 46%;
        top: 60px;
      }

      #{{ section.id }} .menu-cloud--2 {
        right: -30px;
        bottom: 260px;
      }

      #{{ section.id }} .menu-cloud--2 svg {
        animation-duration: 34s;
        animation-direction: reverse;
      }

      #{{ section.id }} .menu-cloud--3 {
        left: 4%;
        bottom: 220px;
        width: clamp(64px, 6vw, 96px);
      }

      #{{ section.id }} .menu-cloud--3 svg {
        animation-duration: 40s;
      }

      #{{ section.id }} .menu-cloud--4 {
        right: 16%;
        top: 18%;
        width: clamp(56px, 5vw, 84px);
      }

      #{{ section.id }} .menu-cloud--4 svg {
        animation-duration: 30s;
        animation-direction: reverse;
      }

      @media (max-width: 767px) {
        #{{ section.id }} .menu-cloud--1,
        #{{ section.id }} .menu-cloud--4 {
          display: none;
        }

        #{{ section.id }} .menu-cloud--2 {
          right: -26px;
          top: 26%;
          bottom: auto;
        }

        #{{ section.id }} .menu-cloud--3 {
          left: -20px;
          bottom: 34%;
        }
      }

      /* ========================================
         SCALLOP FOOTER
         Big solid semicircle bumps along the bottom, scrolling slowly left →
         right. Two copies of the tiling SVG sit in a 200%-wide scroller; the
         translateY open-transition stays on .cloud-footer itself.
         ======================================== */
      #{{ section.id }} .cloud-footer {
        position: absolute;
        left: 0;
        right: 0;
        /* Negative offset drops the strip below the viewport edge (clipped by
           the overlay) without flattening the bump proportions. */
        bottom: var(--menu-cloud-offset, 0px);
        z-index: 1;
        height: var(--menu-cloud-height);
        overflow: hidden;
        pointer-events: none;
        color: rgb(var(--color-scheme-text));
        transform: translateY(100%);
        transition: transform 0.7s cubic-bezier(0.215, 0.61, 0.355, 1) 0.15s;
      }

      #{{ section.id }} .menu-overlay.active .cloud-footer {
        transform: translateY(0);
      }

      /* Five tiling copies at a FIXED width on desktop (1400px ⇒ 7 bumps of a
         constant 200px each, independent of viewport width). Five copies keep
         even ultrawide screens covered at every animation phase; the loop
         shifts exactly one copy (--kd-scallop-shift). */
      #{{ section.id }} .cloud-scroller {
        --kd-scallop-shift: -1400px;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: max-content;
        display: flex;
        animation: kd-scroll 20s linear infinite;
      }

      #{{ section.id }} .cloud-scroller svg {
        display: block;
        width: 1400px;
        height: 100%;
        flex-shrink: 0;
      }

      @keyframes kd-scroll {
        from {
          transform: translateX(var(--kd-scallop-shift));
        }
        to {
          transform: translateX(0);
        }
      }

      /* Mobile: each copy spans 2× the viewport width, so the bumps stay wide
         instead of squeezing into pointy arcs. */
      @media (max-width: 767px) {
        #{{ section.id }} .cloud-scroller {
          --kd-scallop-shift: -200vw;
          animation-duration: 12s;
        }

        #{{ section.id }} .cloud-scroller svg {
          width: 200vw;
        }
      }

      /* DS Header padding: 16px top, gutter sides, 8px bottom */
      #{{ section.id }} .section-content-custom-padding {
        padding: var(--space-3) var(--gutter) var(--space-2);
      }

      @media (min-width: 768px) {
        #{{ section.id }} .section-content-custom-padding {
          padding: var(--space-4) var(--gutter) var(--space-2);
        }
      }

      /* Hide menu buttons toggle — logo-only header */
      #{{ section.id }}.hide-menu-buttons .header-left,
      #{{ section.id }}.hide-menu-buttons .header-actions {
        display: none !important;
      }
  /* Dim all items when any item is hovered */
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links:hover li a {
    opacity: 0.35;
    transition-delay: 0s;
  }

  /* Keep hovered item at full opacity with a subtle scale — no tilt, no
     colour change. */
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:hover,
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:focus-visible {
    opacity: 1 !important;
    transform: translateY(0) translateZ(0) scale(1.04);
    transition: transform 0.3s ease-out, opacity 0.3s ease-out;
  }

  #{{ section.id }} .menu-content nav ul.menu-links li a:focus-visible,
  #{{ section.id }} .menu-account:focus-visible,
  #{{ section.id }} .menu-email:focus-visible,
  #{{ section.id }} .menu-utility a:focus-visible,
  #{{ section.id }} .menu-social a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: var(--space-2);
  }

  /* Underline sweep (also marks the current page) */
  #{{ section.id }} .menu-overlay .menu-content nav ul.menu-links li a::after {
    content: '';
    position: absolute;
    bottom: 0.08em;
    left: 0;
    width: 0;
    height: 4px;
    border-radius: 2px;
    background-color: currentColor;
    transition: width 0.45s cubic-bezier(0.215, 0.61, 0.355, 1) 0ms;
  }

  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:hover::after,
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:focus-visible::after,
  #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a[aria-current='page']::after {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section.id }} .menu-overlay,
    #{{ section.id }} .menu-overlay .cloud-footer,
    #{{ section.id }} .menu-content nav ul.menu-links li a,
    #{{ section.id }} .menu-sticker,
    #{{ section.id }} .menu-cloud,
    #{{ section.id }} .menu-cloud-pop {
      transition-duration: 0.01ms !important;
      transition-delay: 0ms !important;
    }

    #{{ section.id }} .cloud-scroller,
    #{{ section.id }} .menu-cloud svg {
      animation: none;
    }

    #{{ section.id }} .menu-overlay.active .menu-content nav ul.menu-links li a:hover {
      transform: none;
    }
  }
      /* ========================================
         RESPONSIVE STYLES
         ======================================== */

      /* Mobile (max-width: 767px) — MENU cloud 44px, shop cloud hidden, cart 56px */
      @media (max-width: 767px) {
        #{{ section.id }} .header-content-wrapper {
          gap: var(--space-2);
        }

        #{{ section.id }} .custom-menu-button {
          height: 44px;
          padding: 0 var(--space-5);
          font-size: 15px;
        }

        .menu-text-wrapper {
          min-width: 44px;
        }

        #{{ section.id }} .custom-shop-button {
          display: none;
        }
      }

      /* Tablet (768px - 1023px) */
      @media (min-width: 768px) and (max-width: 1023px) {
        #{{ section.id }} .menu-overlay {
          --menu-cloud-height: 130px;
        }
      }

      /* Desktop (1024px+) */
      @media (min-width: 1024px) {
        #{{ section.id }} .menu-overlay {
          --menu-cloud-height: 170px;
          --menu-cloud-offset: -70px;
        }
      }

      /* ========================================
         OVERLAY OFFSET (if enabled)
         ======================================== */
      {%- if enable_overlay -%}
        #{{ section.id }} {
          --overlay-offset: {{ mobile_offset }}px;
        }

        @media (min-width: 990px) {
          #{{ section.id }} {
            --overlay-offset: {{ desktop_offset }}px;
          }
        }
      {%- endif -%}
{%- endstyle -%}

{%- if section.settings.home_page_only == false or template.name == 'index' -%}
  <section
    id="{{ section.id }}"
    class="relative bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %} {% if section.settings.hide_menu_buttons %}hide-menu-buttons{% endif %} {{ border_classes }}"
    data-color-scheme="{{ section.settings.color_scheme }}"
    role="banner"
  >
    <div
      id="menubar-{{ section.id }}"
      class="adjust-menu-on-overlay"
      {% if enable_overlay %}
        style="height: var(--overlay-offset);"
      {% endif %}
    >
      <div class="section-content px-section {% unless section.settings.disable_vertical_spacing %}section-content-custom-padding{% endunless %} {% if enable_overlay %}absolute top-0 left-0 right-0 pointer-events-none z-20{% endif %}">
        <div class="header-content-wrapper">
          {%- comment -%} Logo — left {%- endcomment -%}
          {%- if logo != blank -%}
            <div class="responsive-logo-container">
              {{
                logo
                | image_url: width: 3000
                | image_tag: class: 'w-full', width: logo.width, alt: logo.alt
                | default: shop.name, loading: 'eager'
              }}
            </div>
          {%- else -%}
            <div class="font-heading break-word responsive-logo-container">
              {{ shop.name }}
            </div>
          {%- endif -%}

          {%- comment -%} MENU / CLOSE pill — overlaps the logo {%- endcomment -%}
          <div class="header-left" id="menuButton-{{ section.id }}">
            <button
              class="kd-btn kd-btn--lime kd-btn--lg custom-menu-button"
              type="button"
              aria-expanded="false"
              aria-controls="menuOverlay-{{ section.id }}"
            >
              <svg class="kd-btn__cloud" aria-hidden="true" focusable="false"><use href="#kd-cloud"></use></svg>
              <span class="kd-btn__label custom-menu-button-text">
                <span class="menu-text-wrapper">
                  <span class="menu-text">MENU</span>
                  <span class="close-text">CLOSE</span>
                </span>
              </span>
            </button>
          </div>

          <div class="header-spacer" aria-hidden="true"></div>

          <div class="header-actions">
            {%- comment -%} Shop cloud (hidden on mobile) {%- endcomment -%}
            <a class="kd-btn kd-btn--red kd-btn--lg custom-shop-button" href="{{ shop_url }}">
              <svg class="kd-btn__cloud" aria-hidden="true" focusable="false"><use href="#kd-cloud"></use></svg>
              <span class="kd-btn__label">{{ section.settings.shop_label | default: 'Shop Now' }}</span>
            </a>

            {%- comment -%} Cart — lime starburst sticker with the item count {%- endcomment -%}
            <a
              class="kd-cart-sticker custom-cart-button"
              href="{{ routes.cart_url }}"
              aria-label="{{ 'layout.cart.title' | t | escape }} ({{ cart.item_count }})"
            >
              <svg class="kd-cart-sticker__shape" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
