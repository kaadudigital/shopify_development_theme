{%- comment -%}
  Kaadu DS PeopleCard carousel ("Wer profitiert"). Cards are 4 : 5 snap cards as in the mockup's desktop board
  (480 × 600; mobile min(340px, 85vw) wide) — spec S-03. Card: tint or photo under the dark fade, counter, outlined
  Fagies stat, title, one line; a card with a link shows "Mehr dazu". No back side any more (S-03).
  The action card is always the last card: «Action card» section settings, or a CTA card block if one exists
  (its filled-in fields win). Styles: "PEOPLE CARDS" in assets/base.bundle.css.
{%- endcomment -%}
{%- liquid
  assign cards = section.blocks | where: 'type', 'card'
  assign cta_block = section.blocks | where: 'type', 'cta_card' | first
  assign show_action = section.settings.show_action_card
  if cta_block
    assign show_action = true
  endif
  assign total = cards.size
  if show_action
    assign total = total | plus: 1
  endif
  assign position = 0

  assign shape_url = 'kd-card-shape.svg' | asset_url
  if section.settings.card_shape != blank
    assign shape_url = section.settings.card_shape | image_url: width: 1200
  endif
  assign shape_url_m = shape_url
  if section.settings.card_shape_mobile != blank
    assign shape_url_m = section.settings.card_shape_mobile | image_url: width: 1200
  endif
-%}

{%- style -%}
  #{{ section.id }} {
    {%- if section.settings.heading_follows_scheme %}
    --kd-pc-kicker: rgb(var(--color-scheme-text));
    --kd-pc-heading: rgb(var(--color-scheme-text));
    {%- else %}
    --kd-pc-kicker: {{ section.settings.kicker_color }};
    --kd-pc-heading: {{ section.settings.heading_color }};
    {%- endif %}
    --kd-pc-hint: {{ section.settings.hint_color }};
    --kd-pc-stat: {{ section.settings.stat_color }};
    --kd-pc-stat-m: {{ section.settings.stat_color_mobile }};
    --kd-pc-stat-outline: {{ section.settings.stat_outline_color }};
    --kd-pc-text: {{ section.settings.card_text_color }};
    --kd-pc-card-btn: {{ section.settings.card_button_color }};
    --kd-pc-cta-bg: {{ section.settings.cta_bg_color }};
    --kd-pc-cta-text: {{ section.settings.cta_text_color }};
    --kd-pc-cta-pill: {{ section.settings.cta_pill_color }};
    --kd-pc-cta-pill-text: {{ section.settings.cta_pill_text_color }};
    --kd-pc-cta-btn: {{ section.settings.cta_button_color }};
    --kd-pc-cta-btn-label: {{ section.settings.cta_button_label_color }};
    --kd-pc-btn: {{ section.settings.footer_button_color }};
    --kd-pc-btn-label: {{ section.settings.footer_button_label_color }};
    --kd-card-mask: url("{{ shape_url_m }}");
    --kd-card-outline: {{ section.settings.card_outline_color }};
    --kd-card-outline-w: {{ section.settings.card_outline_width }}px;
    --kd-people-n: {{ total }};
  }
  @media (min-width: 768px) {
    #{{ section.id }} { --kd-card-mask: url("{{ shape_url }}"); }
  }
  {%- comment -%} All cards fit (n × 480px card + 20px gaps + 2 × 64px gutter): nothing to scroll, so no scroll hint. !important beats the inline visibility the scroll motion (S-10) sets. {%- endcomment -%}
  {%- assign fit_width = total | times: 500 | minus: 20 | plus: 128 -%}
  @media (min-width: {{ fit_width }}px) {
    #{{ section.id }} .kd-people__hint { visibility: hidden !important; }
  }
{%- endstyle -%}

<section
  id="{{ section.id }}"
  class="kd-people{% if section.settings.card_shape_enabled %} kd-people--shaped{% if section.settings.card_outline %} kd-people--outlined{% endif %}{% endif %} relative overflow-hidden bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
  {% unless section.settings.scroll_motion %} data-kd-motion="off"{% endunless %}
>
  <div class="kd-section kd-people__header">
    <div class="kd-heading">
      {%- if section.settings.kicker != blank -%}
        <p class="kd-heading__kicker kd-label">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="kd-heading__title kd-display-h2">{{ section.settings.heading | escape | replace: '[br]', '<br>' }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.hint != blank -%}
      {%- assign hint_mobile = section.settings.hint_mobile | default: section.settings.hint -%}
      <p class="kd-people__hint kd-tag" aria-hidden="true">
        <span class="kd-people__hint--mobile">{{ hint_mobile | escape }}</span><span class="kd-people__hint--desktop">{{ section.settings.hint | escape }}</span>
      </p>
    {%- endif -%}
  </div>

  <div
    class="kd-carousel"
    {%- if section.settings.autoplay or section.settings.autoplay_mobile %}
      data-kd-autoplay
      data-autoplay-desktop="{{ section.settings.autoplay }}"
      data-autoplay-mobile="{{ section.settings.autoplay_mobile }}"
      data-autoplay-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
    {%- endif %}
    role="region"
    aria-label="{{ section.settings.heading | remove: '[br]' | strip_html | escape }}"
    tabindex="0"
  >
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'card' -%}
          {%- assign position = position | plus: 1 -%}
          {%- capture counter -%}{% if position < 10 %}0{% endif %}{{ position }} / {% if total < 10 %}0{% endif %}{{ total }}{%- endcapture -%}
          <article class="kd-card kd-card--{{ block.settings.tint | default: 'tint-cocoa' }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 960
                | image_tag:
                  class: 'kd-card__photo',
                  widths: '400, 600, 800, 960',
                  sizes: '(min-width: 768px) 480px, min(340px, 85vw)',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- endif -%}
            <div class="kd-card__fade" aria-hidden="true"></div>
            <p class="kd-card__count kd-label-sm">{{ counter }}</p>

            <div class="kd-card__body">
              {%- if block.settings.stat != blank -%}
                <p class="kd-card__stat">{{ block.settings.stat | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="kd-card__title kd-strong-lg">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="kd-card__text kd-body">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

            {%- if block.settings.link != blank -%}
              <div class="kd-card__actions">
                {%- render 'kd-button', label: section.settings.link_label, url: block.settings.link, variant: 'outline' -%}
              </div>
            {%- endif -%}
          </article>

      {%- endcase -%}
    {%- endfor -%}

    {%- if show_action -%}
      {%- liquid
        assign position = position | plus: 1
        assign a_pill = cta_block.settings.pill | default: section.settings.action_pill
        assign a_heading = cta_block.settings.heading | default: section.settings.action_heading
        assign a_text = cta_block.settings.text | default: section.settings.action_text
        assign a_label = cta_block.settings.button_label | default: section.settings.action_button_label
        assign a_link = cta_block.settings.button_link | default: section.settings.action_button_link | default: '/#probieren'
        assign a_note = cta_block.settings.note | default: section.settings.action_note
      -%}
      <article class="kd-card kd-card--cta" {% if cta_block %}{{ cta_block.shopify_attributes }}{% endif %}>
        <div class="kd-card__cta-top">
          <p class="kd-tag kd-card__pill">
            {%- if position < 10 %}0{% endif %}{{ position }} / {{ total }}{% if a_pill != blank %} · {{ a_pill | escape }}{% endif -%}
          </p>
          {%- if a_heading != blank -%}
            <h3 class="kd-card__cta-heading">{{ a_heading | escape }}</h3>
          {%- endif -%}
          {%- if a_text != blank -%}
            <p class="kd-card__cta-text kd-body">{{ a_text | escape }}</p>
          {%- endif -%}
        </div>
        <div class="kd-card__cta-bottom">
          {%- if a_label != blank -%}
            {%- render 'kd-button', label: a_label, url: a_link, size: 'md', full: true, class: 'kd-card__cta-button' -%}
          {%- endif -%}
          {%- if a_note != blank -%}
            <p class="kd-card__cta-note">{{ a_note | escape }}</p>
          {%- endif -%}
        </div>
      </article>
    {%- endif -%}
  </div>

  {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
    <div class="kd-section kd-people__footer">
      {%- render 'kd-button', label: section.settings.button_label, url: section.settings.button_link, size: 'md', class: 'kd-people__button' -%}
    </div>
  {%- endif -%}

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

