{%- comment -%}
  Kaadu DS PeopleCard carousel ("Wer profitiert"). Cards are 400 × 600 snap cards (mobile 310 × 560, proposed);
  front: tint or photo under the dark fade, counter, outlined Fagies stat, title, one line; "Details ↻" swaps in
  the back content (DS: no 3D transform). A card with a link shows "Mehr dazu" and navigates instead of flipping.
  The CTA card is the solid red last card. Styles: "PEOPLE CARDS" in assets/base.bundle.css; flip: assets/kaadu.js.
{%- endcomment -%}
{%- liquid
  assign cards = section.blocks | where: 'type', 'card'
  assign cta_cards = section.blocks | where: 'type', 'cta_card'
  assign total = cards.size | plus: cta_cards.size
  assign position = 0

  assign shape_url = 'kd-card-shape.svg' | asset_url
  if section.settings.card_shape != blank
    assign shape_url = section.settings.card_shape | image_url: width: 1200
  endif
  assign shape_url_m = shape_url
  if section.settings.card_shape_mobile != blank
    assign shape_url_m = section.settings.card_shape_mobile | image_url: width: 1200
  endif
-%}

{%- style -%}
  #{{ section.id }} {
    --kd-pc-kicker: {{ section.settings.kicker_color }};
    --kd-pc-heading: {{ section.settings.heading_color }};
    --kd-pc-hint: {{ section.settings.hint_color }};
    --kd-pc-stat: {{ section.settings.stat_color }};
    --kd-pc-stat-m: {{ section.settings.stat_color_mobile }};
    --kd-pc-stat-outline: {{ section.settings.stat_outline_color }};
    --kd-pc-text: {{ section.settings.card_text_color }};
    --kd-pc-fact: {{ section.settings.fact_color }};
    --kd-pc-card-btn: {{ section.settings.card_button_color }};
    --kd-pc-cta-bg: {{ section.settings.cta_bg_color }};
    --kd-pc-cta-text: {{ section.settings.cta_text_color }};
    --kd-pc-cta-pill: {{ section.settings.cta_pill_color }};
    --kd-pc-cta-pill-text: {{ section.settings.cta_pill_text_color }};
    --kd-pc-cta-btn: {{ section.settings.cta_button_color }};
    --kd-pc-cta-btn-label: {{ section.settings.cta_button_label_color }};
    --kd-pc-btn: {{ section.settings.footer_button_color }};
    --kd-pc-btn-label: {{ section.settings.footer_button_label_color }};
    --kd-card-mask: url("{{ shape_url_m }}");
    --kd-card-outline: {{ section.settings.card_outline_color }};
    --kd-card-outline-w: {{ section.settings.card_outline_width }}px;
    --kd-card-h-m: {{ section.settings.card_height_mobile | default: 420 }}px;
  }
  @media (min-width: 768px) {
    #{{ section.id }} { --kd-card-mask: url("{{ shape_url }}"); }
  }
{%- endstyle -%}

<section
  id="{{ section.id }}"
  class="kd-people{% if section.settings.card_shape_enabled %} kd-people--shaped{% if section.settings.card_outline %} kd-people--outlined{% endif %}{% endif %} relative overflow-hidden bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="kd-section kd-people__header">
    <div class="kd-heading">
      {%- if section.settings.kicker != blank -%}
        <p class="kd-heading__kicker kd-label">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="kd-heading__title kd-display-h2">{{ section.settings.heading | escape | replace: '[br]', '<br>' }}</h2>
      {%- endif -%}
    </div>
    {%- if section.settings.hint != blank -%}
      <p class="kd-people__hint kd-tag" aria-hidden="true">{{ section.settings.hint | escape }}</p>
    {%- endif -%}
  </div>

  <div
    class="kd-carousel"
    role="region"
    aria-label="{{ section.settings.heading | remove: '[br]' | strip_html | escape }}"
    tabindex="0"
  >
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'card' -%}
          {%- assign position = position | plus: 1 -%}
          {%- capture counter -%}{% if position < 10 %}0{% endif %}{{ position }} / {% if total < 10 %}0{% endif %}{{ total }}{%- endcapture -%}
          <article class="kd-card kd-card--{{ block.settings.tint | default: 'tint-cocoa' }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  class: 'kd-card__photo',
                  widths: '400, 600, 800',
                  sizes: '(min-width: 768px) 400px, 310px',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- endif -%}
            <div class="kd-card__fade" aria-hidden="true"></div>
            <p class="kd-card__count kd-label-sm">{{ counter }}</p>

            <div class="kd-card__body" id="kd-card-{{ block.id }}-front">
              {%- if block.settings.stat != blank -%}
                <p class="kd-card__stat">{{ block.settings.stat | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="kd-card__title kd-strong-lg">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="kd-card__text kd-body">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>

            {%- if block.settings.link == blank and block.settings.back_text != blank -%}
              <div class="kd-card__body kd-card__body--back" id="kd-card-{{ block.id }}-back" hidden>
                {%- if block.settings.title != blank -%}
                  <h3 class="kd-card__title kd-strong">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                <div class="kd-card__text kd-body">{{ block.settings.back_text }}</div>
                {%- if block.settings.back_fact != blank -%}
                  <div class="kd-card__fact kd-strong-sm">{{ block.settings.back_fact }}</div>
                {%- endif -%}
                {%- if block.settings.back_note != blank -%}
                  <p class="kd-card__note kd-body-sm">{{ block.settings.back_note | escape }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="kd-card__actions">
              {%- if block.settings.link != blank -%}
                {%- render 'kd-button', label: section.settings.link_label, url: block.settings.link, variant: 'outline' -%}
              {%- elsif block.settings.back_text != blank -%}
                {%- capture flip_attrs -%}data-kd-flip aria-pressed="false" aria-controls="kd-card-{{ block.id }}-front kd-card-{{ block.id }}-back" data-label-front="{{ section.settings.details_label | escape }}" data-label-back="{{ section.settings.back_label | escape }}"{%- endcapture -%}
                {%- render 'kd-button', label: section.settings.details_label, variant: 'outline', attrs: flip_attrs -%}
              {%- endif -%}
            </div>
          </article>

        {%- when 'cta_card' -%}
          {%- assign position = position | plus: 1 -%}
          <article class="kd-card kd-card--cta" {{ block.shopify_attributes }}>
            <div class="kd-card__cta-top">
              {%- if block.settings.pill != blank -%}
                <p class="kd-tag kd-card__pill">{{ block.settings.pill | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="kd-card__cta-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
            </div>
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              {%- render 'kd-button', label: block.settings.button_label, url: block.settings.button_link, size: 'md', full: true, class: 'kd-card__cta-button' -%}
            {%- endif -%}
          </article>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
    <div class="kd-section kd-people__footer">
      {%- render 'kd-button', label: section.settings.button_label, url: section.settings.button_link, size: 'md', class: 'kd-people__button' -%}
    </div>
  {%- endif -%}

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

