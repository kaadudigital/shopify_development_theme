<section
  class="scrolling-text-section bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  {%- render 'scrolling-text',
    class: 'py-2.5',
    text_class: 'h1'
  -%}
</section>

{%- style -%}
  #shopify-section-{{ section.id }} .scrolling-text-section {
    --scrolling-text-shape-size: {{ section.settings.shape_size }}em;
  }
  #shopify-section-{{ section.id }} .scrolling-text-section .h1 {
    letter-spacing: -0.01em;
  }
  #shopify-section-{{ section.id }} .scrolling-text__shape-svg {
    height: var(--scrolling-text-shape-size);
    width: var(--scrolling-text-shape-size);
    object-fit: contain;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "t:sections.scrolling_text.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:common.settings.paragraph_if_a_user"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:common.settings.text.label",
      "default": "ITS NOT FAIR!"
    },
    {
      "type": "checkbox",
      "id": "repeat_text",
      "default": true,
      "label": "t:common.settings.repeat_text.label",
      "info": "t:common.settings.repeat_text.info"
    },
    {
      "type": "header",
      "content": "Shape between text"
    },
    {
      "type": "select",
      "id": "shape_between_text",
      "label": "t:common.settings.shape_between_text.label",
      "options": [
        {
          "value": "none",
          "label": "t:common.options.none.label"
        },
        {
          "value": "circle",
          "label": "t:common.options.circle.label"
        },
        {
          "value": "custom_star",
          "label": "custom star"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "diamond",
          "label": "t:common.options.diamond.label"
        },
        {
          "value": "triangle",
          "label": "t:common.options.triangle.label"
        },
        {
          "value": "star",
          "label": "t:common.options.star.label"
        },
        {
          "value": "10_point_star",
          "label": "t:common.options.10_point_star.label"
        },
        {
          "value": "flower",
          "label": "t:common.options.flower.label"
        }
      ],
      "default": "10_point_star"
    },
    {
      "type": "image_picker",
      "id": "between_text_image",
      "label": "Image",
      "info": "Used when \"Image\" is selected above."
    },
    {
      "type": "range",
      "id": "shape_size",
      "min": 0.2,
      "max": 1.5,
      "step": 0.1,
      "unit": "em",
      "label": "Shape / image size",
      "info": "Relative to the text height (1em = headline height).",
      "default": 0.6
    },
    {
      "type": "checkbox",
      "id": "animate_shape_between_text",
      "default": true,
      "label": "t:common.settings.animate_shape_between_text.label",
      "info": "Does not apply to an image."
    },
    {
      "type": "header",
      "content": "Link & motion"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:common.settings.link.label"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 400,
      "step": 10,
      "label": "t:common.settings.speed.label",
      "default": 120
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:common.settings.direction.label",
      "options": [
        {
          "value": "",
          "label": "t:common.options.right_to_left.label"
        },
        {
          "value": "reverse",
          "label": "t:common.options.left_to_right.label"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "t:common.settings.header_color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme1",
      "label": "t:common.settings.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "use_gradient_background",
      "label": "t:common.settings.use_gradient_background.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.scrolling_text.name"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  }
}
{% endschema %}
