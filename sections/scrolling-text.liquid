{%- comment -%}
  Kaadu DS Ticker: lime band, red Fagies, ✶ separators, 22s loop (stops under reduced motion).
  Several phrases: separate them with "|" in the text setting. Styles: "TICKER" in assets/base.bundle.css.
  The phrase group is rendered twice so translateX(0 → -50%) loops seamlessly.
{%- endcomment -%}
{%- liquid
  assign phrases = section.settings.text | split: '|'
  assign ticker_link = section.settings.link
-%}
{%- capture ticker_group -%}
  {%- for i in (1..6) -%}
    {%- for phrase in phrases -%}
      {%- assign phrase_clean = phrase | strip -%}
      {%- if phrase_clean != blank -%}
        <span class="kd-ticker__item">{{ phrase_clean | escape }}</span><span class="kd-ticker__star">&#10038;</span>
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

<section
  id="{{ section.id }}"
  class="scrolling-text-section bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  {%- if ticker_link != blank -%}
    <a class="kd-ticker kd-ticker--link" href="{{ ticker_link }}" aria-label="{{ section.settings.text | replace: '|', ' · ' | escape }}">
  {%- else -%}
    <div class="kd-ticker">
  {%- endif -%}
      <div class="kd-ticker__track{% if section.settings.direction == 'reverse' %} kd-ticker__track--reverse{% endif %}" aria-hidden="true">
        <div class="kd-ticker__group">{{ ticker_group }}</div>
        <div class="kd-ticker__group">{{ ticker_group }}</div>
      </div>
  {%- if ticker_link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.scrolling_text.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:common.settings.paragraph_if_a_user"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:common.settings.text.label",
      "default": "ITS NOT FAIR!",
      "info": "Separate several phrases with \"|\", e.g. It's not fair! | Fuck middlemen"
    },
    {
      "type": "checkbox",
      "id": "repeat_text",
      "default": true,
      "label": "t:common.settings.repeat_text.label",
      "info": "Not used since the design-system redesign: the ticker always uses ✶ separators and the DS 22-second loop."
    },
    {
      "type": "header",
      "content": "Shape between text"
    },
    {
      "type": "select",
      "id": "shape_between_text",
      "label": "t:common.settings.shape_between_text.label",
      "options": [
        {
          "value": "none",
          "label": "t:common.options.none.label"
        },
        {
          "value": "circle",
          "label": "t:common.options.circle.label"
        },
        {
          "value": "custom_star",
          "label": "custom star"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "diamond",
          "label": "t:common.options.diamond.label"
        },
        {
          "value": "triangle",
          "label": "t:common.options.triangle.label"
        },
        {
          "value": "star",
          "label": "t:common.options.star.label"
        },
        {
          "value": "10_point_star",
          "label": "t:common.options.10_point_star.label"
        },
        {
          "value": "flower",
          "label": "t:common.options.flower.label"
        }
      ],
      "default": "10_point_star",
      "info": "Not used since the design-system redesign: the ticker always uses ✶ separators and the DS 22-second loop."
    },
    {
      "type": "image_picker",
      "id": "between_text_image",
      "label": "Image",
      "info": "Not used since the design-system redesign: the ticker always uses ✶ separators and the DS 22-second loop."
    },
    {
      "type": "range",
      "id": "shape_size",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "unit": "em",
      "label": "Shape / image size",
      "info": "Not used since the design-system redesign: the ticker always uses ✶ separators and the DS 22-second loop.",
      "default": 0.6
    },
    {
      "type": "checkbox",
      "id": "animate_shape_between_text",
      "default": true,
      "label": "t:common.settings.animate_shape_between_text.label",
      "info": "Not used since the design-system redesign: the ticker always uses ✶ separators and the DS 22-second loop."
    },
    {
      "type": "checkbox",
      "id": "animate_image_between_text",
      "default": false,
      "label": "Rotate image",
      "info": "Not used since the design-system redesign: the ticker always uses ✶ separators and the DS 22-second loop."
    },
    {
      "type": "header",
      "content": "Link & motion"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:common.settings.link.label"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 400,
      "step": 10,
      "label": "t:common.settings.speed.label",
      "default": 120,
      "info": "Not used since the design-system redesign: the ticker always uses ✶ separators and the DS 22-second loop."
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:common.settings.direction.label",
      "options": [
        {
          "value": "",
          "label": "t:common.options.right_to_left.label"
        },
        {
          "value": "reverse",
          "label": "t:common.options.left_to_right.label"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "t:common.settings.header_color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme1",
      "label": "t:common.settings.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "use_gradient_background",
      "label": "t:common.settings.use_gradient_background.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.scrolling_text.name"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  }
}
{% endschema %}
