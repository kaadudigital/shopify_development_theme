{%- comment -%}
  Stats around an image ("Perfekt in jeder Weise"), as in the landing-page mockup: heading, intro, then two stat
  tiles on each side of a square picture (from 992px) or the picture above a 2 × 2 tile grid (optionally a
  carousel), and a cloud button. Colours are section settings (mockup: red heading and stats, cream tiles on
  pink, red cloud); with «Use the colours below» off everything follows the colour scheme. Styles in
  assets/base.bundle.css (STATS AROUND AN IMAGE).
{%- endcomment -%}
{%- liquid
  # Carousel arrow silhouette. 'shape-defs' bails out on blank/'default', so a
  # blank setting simply leaves the arrows in the theme's default pill shape.
  assign arrow_shape = section.settings.arrow_shape
  if arrow_shape == 'default'
    assign arrow_shape = ''
  endif
  assign arrow_shape_id = section.id | append: '-arrow'
-%}

{%- if arrow_shape != blank -%}
  {%- render 'shape-defs', shape: arrow_shape, shape_id: arrow_shape_id -%}
{%- endif -%}

{%- style -%}
  #{{ section.id }} {
    {%- comment -%} Section colours only when "Use the colours below" is on; otherwise every --kd-iwh-* is unset and the
      CSS falls back to the colour scheme (background, text, body text, card, card text, accent 1 / contrast). {%- endcomment -%}
    {%- if section.settings.use_custom_colors -%}
      {%- liquid
        assign iwh_colors = 'bg:background_color,heading:heading_color,text:text_color,tile:tile_color,stat:stat_color,caption:caption_color,btn:button_color,btn-label:button_label_color' | split: ','
      -%}
      {%- for pair in iwh_colors -%}
        {%- assign kv = pair | split: ':' -%}
        {%- assign value = section.settings[kv[1]] -%}
        {%- if value != blank %}
    --kd-iwh-{{ kv[0] }}: {{ value }};
        {%- endif -%}
      {%- endfor %}
    {%- endif %}
    --image-max-width: {{ section.settings.max_width }}px;
    --kd-iwh-img: {{ section.settings.max_width }};
    --kd-iwh-tile-max: {{ section.settings.tile_max_width | default: 360 }}px;
  }
  {%- if section.settings.mobile_arrow_background != blank or section.settings.mobile_arrow_icon_color != blank %}
  {%- comment -%} Mobile carousel arrows. The ID selector outranks the theme's `.push-btn:hover .push-btn__surface`
    rule, so the chosen colours also hold on hover. {%- endcomment %}
  #{{ section.id }} .kaadu-iwh__arrows .push-btn__surface {
    {%- if section.settings.mobile_arrow_background != blank %}
    background: {{ section.settings.mobile_arrow_background }};
    {%- endif %}
    {%- if section.settings.mobile_arrow_icon_color != blank %}
    color: {{ section.settings.mobile_arrow_icon_color }};
    {%- endif %}
  }
  {%- endif %}
  {%- if arrow_shape != blank %}
  {%- comment -%} The arrow takes its silhouette from the shared clip-path library (snippets/shape-defs.liquid). Squared
    off to 48px first (the shapes are 1:1 and 48px is the minimum tap target); the inset border and offset shadow
    are dropped because neither follows the clip path. {%- endcomment %}
  #{{ section.id }} .kaadu-iwh__arrows .push-btn__surface {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: 0;
    box-shadow: none;
    -webkit-clip-path: url(#clip-{{ arrow_shape_id }});
    clip-path: url(#clip-{{ arrow_shape_id }});
  }
  #{{ section.id }} .kaadu-iwh__arrows .push-btn::after { display: none; }
  {%- endif %}
{%- endstyle -%}

{%- liquid
  # Section title is the <h2>, so the stats step down to <h3>.
  assign stat_tag = 'h2'
  if section.settings.title != blank
    assign stat_tag = 'h3'
  endif
  assign highlights = section.blocks | where: 'type', 'highlight'
  assign slideshow_on_mobile = section.settings.slideshow_on_mobile
  assign preload = false
  if section.index == 1
    assign preload = true
  endif
  assign loading = 'lazy'
  if section.index <= 3
    assign loading = 'eager'
  endif
  assign sizes = '(min-width: 992px) min(' | append: section.settings.max_width | append: 'px, 40vw), 100vw'
  assign mobile_tiles = ''
  assign left_tiles = ''
  assign right_tiles = ''
  assign tile_class = 'kd-iwh__tile'
  if section.settings.display_on_card
    assign tile_class = tile_class | append: ' kd-iwh__tile--card'
  endif
-%}

{%- render 'shape-defs', shape: section.settings.image_shape, shape_id: section.id, blob_type: section.settings.blob_type -%}

{%- capture image -%}
  {%- if section.settings.image != blank -%}
    {%- render 'media-image',
      media: section.settings.image,
      shape_id: section.id,
      shape: section.settings.image_shape,
      crop: section.settings.crop,
      rotate: section.settings.rotate_image,
      is_card: false,
      container_id: section.id,
      disable_media_style: section.settings.disable_media_style,
      preload: preload,
      loading: loading,
      sizes: sizes
    -%}
  {%- else -%}
    {%- render 'media-image-placeholder',
      shape_id: section.id,
      container_id: section.id,
      shape: section.settings.image_shape,
      crop: section.settings.crop,
      rotate: section.settings.rotate_image,
      is_card: false,
      blob_type: section.settings.blob_type,
      disable_media_style: section.settings.disable_media_style
    -%}
  {%- endif -%}
{%- endcapture -%}

{%- for block in highlights -%}
  {%- capture tile_body -%}
    {%- if block.settings.title != blank -%}
      <{{ stat_tag }} class="kd-iwh__stat">{{ block.settings.title | escape }}</{{ stat_tag }}>
    {%- endif -%}
    {%- if block.settings.text != blank -%}
      <p class="kd-iwh__caption">
        {%- if block.settings.text_mobile != blank -%}
          <span class="kd-iwh__d">{{ block.settings.text }}</span><span class="kd-iwh__m">{{ block.settings.text_mobile }}</span>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </p>
    {%- endif -%}
    {%- if block.settings.cta_link != blank and block.settings.cta_text != blank -%}
      <a href="{{ block.settings.cta_link }}" class="kd-link kd-iwh__tile-link">{{ block.settings.cta_text | escape }}</a>
    {%- endif -%}
  {%- endcapture -%}
  {%- capture tile_attrs -%}
    {% if block.settings.override_section_color_scheme %}data-color-scheme="{{ block.settings.color_scheme }}"{% endif %} {{ block.shopify_attributes }}
  {%- endcapture -%}
  {%- capture mobile_tile -%}
    <li class="{{ tile_class }}{% if slideshow_on_mobile %} splide__slide{% endif %}" {{ tile_attrs }}>{{ tile_body }}</li>
  {%- endcapture -%}
  {%- capture desktop_tile -%}
    <div class="{{ tile_class }}" {{ tile_attrs }}>{{ tile_body }}</div>
  {%- endcapture -%}
  {%- liquid
    assign mod = forloop.index0 | modulo: 2
    if mod == 0
      assign left_tiles = left_tiles | append: desktop_tile
    else
      assign right_tiles = right_tiles | append: desktop_tile
    endif
    assign mobile_tiles = mobile_tiles | append: mobile_tile
  -%}
{%- endfor -%}

<section
  id="{{ section.id }}"
  class="kd-iwh kd-section relative overflow-hidden{% if section.settings.use_gradient_background %} bg-scheme-gradient{% endif %}{% unless section.settings.show_intro_on_mobile %} kd-iwh--intro-d{% endunless %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
  {% unless section.settings.scroll_motion %} data-kd-motion="off"{% endunless %}
>
  <div class="kd-iwh__inner kd-wide relative z-10">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.intro != blank -%}
      <div class="kd-iwh__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kd-iwh__eyebrow kd-label">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="kd-iwh__heading kd-display-h2-tight">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="kd-iwh__intro kd-body-lg">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="kd-iwh__desktop">
      <div class="kd-iwh__col {{ section.settings.block_alignment_on_desktop }}">{{ left_tiles }}</div>
      <div class="kd-iwh__media">{{ image }}</div>
      <div class="kd-iwh__col {{ section.settings.block_alignment_on_desktop }}">{{ right_tiles }}</div>
    </div>

    <div class="kd-iwh__mobile">
      <div class="kd-iwh__media">{{ image }}</div>
      <div
        {% if slideshow_on_mobile %}id="slideshow-{{ section.id }}"{% endif %}
        class="kaadu-iwh__carousel{% if slideshow_on_mobile %} splide kd-iwh__carousel--slides{% endif %}"
      >
        <div class="{% if slideshow_on_mobile %}splide__track{% endif %}">
          <ul class="kd-iwh__grid{% if slideshow_on_mobile %} splide__list{% endif %}">
            {{ mobile_tiles }}
          </ul>
        </div>
        {%- if slideshow_on_mobile -%}
          <div class="splide__arrows kaadu-iwh__arrows">
            {%- render 'splide-navigation' -%}
          </div>
          <script class="slideshow-options" type="application/json">
            {
              "mediaQuery": "min",
              "arrows": true,
              "pagination": false,
              "rewind": true,
              "autoWidth": true,
              "gap": "12px",
              "focus": {{ section.settings.slideshow_focus | json }},
              "type": "{% if section.settings.autoscroll_mode != '0' %}loop{% elsif section.settings.slideshow_focus == 'left' %}slide{% else %}loop{% endif %}",
              "autoScroll": {
                "autoStart": {% if section.settings.autoscroll_mode == '0' %}false{% else %}true{% endif %},
                "speed": {{ section.settings.autoscroll_mode | plus: 0 | json }}
              },
              "breakpoints": {
                "992": {
                  "destroy": "true"
                }
              }
            }
          </script>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="kd-iwh__actions">
        {%- render 'kd-button', label: section.settings.button_label, url: section.settings.button_link, class: 'kd-iwh__button' -%}
        {%- if section.settings.button_note != blank -%}
          <p class="kd-iwh__note kd-body-sm">{{ section.settings.button_note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

