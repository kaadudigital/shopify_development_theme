{%- render 'kaadu-carousel-arrows',
  section_id: section.id,
  shape: section.settings.arrow_shape,
  bg: section.settings.arrow_background,
  icon: section.settings.arrow_icon_color
-%}

{%- comment -%}
  Featured Custom Info Tiles Section
  Displays custom information tiles with image, heading, and description
{%- endcomment -%}

{%- liquid
  # Blank means "no shape", not "inherit the theme-wide product tile shape".
  # The global is wave_tear, which clipped every info-tile image; see the
  # note at the top of snippets/info-tile.liquid.
  if section.settings.image_shape != ''
    assign image_shape = section.settings.image_shape
  else
    assign image_shape = 'default'
  endif

  assign mobile_grid_cols = section.settings.tiles_per_row_mobile
  assign layout_mobile = section.settings.layout_mobile
  assign layout_desktop = section.settings.layout_desktop

  case section.settings.tiles_per_row_desktop
    when 2
      assign desktop_grid_cols = 'lg:grid-cols-2'
    when 3
      assign desktop_grid_cols = 'lg:grid-cols-3'
    when 4
      assign desktop_grid_cols = 'lg:grid-cols-4'
    when 5
      assign desktop_grid_cols = 'lg:grid-cols-5'
  endcase

  case section.settings.mobile_slide_width
    when 'three_fifths'
      assign mobile_slide_width = 'w-3/5'
    when 'full_width'
      assign mobile_slide_width = 'w-full'
  endcase

  assign tiles_count = section.blocks.size

  # A carousel needs more than one slide to make sense.
  if tiles_count == 1
    assign layout_mobile = 'grid'
    assign layout_desktop = 'grid'
  endif

  # Splide is mounted whenever either breakpoint wants a carousel. Its
  # "destroy" option (declarative, mediaQuery-driven — see the
  # slideshow-options JSON below) unmounts/remounts it exactly at the
  # 990px breakpoint already used for sizing elsewhere in this file, so
  # the two layout settings can be configured independently without any
  # hand-rolled resize/JS branching.
  assign use_splide = false
  if layout_mobile == 'carousel' or layout_desktop == 'carousel'
    assign use_splide = true
  endif

  assign splide_destroy_mobile = true
  if layout_mobile == 'carousel'
    assign splide_destroy_mobile = false
  endif

  assign splide_destroy_desktop = true
  if layout_desktop == 'carousel'
    assign splide_destroy_desktop = false
  endif

  assign eager_loading_limit = mobile_grid_cols | plus: 0 | default: 1

  if layout_desktop == 'grid'
    if section.settings.display_on_card
      assign desktop_sizes = 'calc((100vw / ' | append: section.settings.tiles_per_row_desktop | append: ') - 2.5rem)'
    else
      assign desktop_sizes = 'calc(100vw / ' | append: section.settings.tiles_per_row_desktop | append: ')'
    endif
  else
    if section.settings.display_on_card
      assign desktop_sizes = 'calc(' | append: section.settings.desktop_slide_width | append: 'vw - 2.5rem)'
    else
      assign desktop_sizes = section.settings.desktop_slide_width | append: 'vw'
    endif
  endif

  if layout_mobile == 'grid'
    if section.settings.display_on_card
      if section.settings.tiles_per_row_mobile == '2'
        assign mobile_sizes = 'calc((100vw / ' | append: section.settings.tiles_per_row_mobile | append: ') - 1.25rem)'
      else
        assign mobile_sizes = 'calc((100vw / ' | append: section.settings.tiles_per_row_mobile | append: ') - 2.5rem)'
      endif
    else
      assign mobile_sizes = 'calc(100vw / ' | append: section.settings.tiles_per_row_mobile | append: ')'
    endif
  else
    if section.settings.display_on_card
      if mobile_slide_width == 'w-3/5'
        assign mobile_sizes = 'calc(60vw - 2.5rem)'
      else
        assign mobile_sizes = 'calc(100vw - 2.5rem)'
      endif
    else
      if mobile_slide_width == 'w-3/5'
        assign mobile_sizes = '60vw'
      else
        assign mobile_sizes = '100vw'
      endif
    endif
  endif

  assign sizes = '(min-width: 990px) ' | append: desktop_sizes | append: ', ' | append: mobile_sizes

  assign will_transform = use_splide
-%}

{%- comment -%} Generate shape definitions for all tiles {%- endcomment -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'info_tile' -%}
    {%- liquid
      assign tile_shape = image_shape
      if block.settings.image_shape_override != blank
        assign tile_shape = block.settings.image_shape_override
      endif

      assign shape_id = section.id | append: '-' | append: forloop.index0
    -%}
    {%- unless tile_shape == 'default' -%}
      {%- render 'collection-shape-defs', shape: tile_shape, section_id: shape_id, item_count: 1 -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}

<section
  class="relative overflow-hidden bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="section-content relative z-10 py-section-vertical-spacing">
    {%- if section.settings.eyebrow != blank or section.settings.title != '' or section.settings.subheading != '' -%}
      <div class="info-tiles__header w-full max-w-site mx-auto px-section">
        {%- if section.settings.eyebrow != blank -%}
          <h3 class="info-tiles__eyebrow h3 break-words text-center">
            {{ section.settings.eyebrow | escape }}
          </h3>
        {%- endif -%}

        {%- if section.settings.title != '' -%}
          <h2 class="info-tiles__heading inline-heading-rte h1 heading-style break-words text-center {{ settings.heading_drop_shadow_style }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != '' -%}
          <div class="info-tiles__subheading rte body mx-auto max-w-md text-center">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      {% if use_splide %}
        id="slideshow-{{ section.id }}"
      {% endif %}
      class="{% if section.settings.eyebrow != blank or section.settings.title != '' or section.settings.subheading != '' %}info-tiles__content{% endif %} {% if use_splide %}splide{% endif %}
        {% if layout_mobile == 'grid' %}px-section w-full max-w-site mx-auto{% endif %}
        {% if layout_desktop == 'grid' %}lg:px-section lg:w-full lg:max-w-site lg:mx-auto{% else %}lg:px-0 lg:w-full lg:max-w-none lg:mx-0{% endif %}"
    >
      <div class="{% if use_splide %}splide__track overflow-visible {% if settings.product_tiles_scatter %}splide__track--scattered{% endif %} {% if section.settings.display_on_card %}{% if settings.card_shadow_direction contains 'top' %}with-top-card-shadow{% else %}with-bottom-card-shadow{% endif %}{% endif %}{% endif %}">
        <ul class="
          {% if use_splide %}splide__list{% endif %}
          {% if layout_mobile == 'grid' or layout_desktop == 'grid' %}gap-theme{% endif %}
          {% if layout_mobile == 'grid' %}grid {% if mobile_grid_cols == '2' %}grid-cols-2{% else %}grid-cols-1{% endif %}{% endif %}
          {% if layout_desktop == 'grid' %}{{ desktop_grid_cols }}{% if layout_mobile != 'grid' %} lg:grid{% endif %}{% endif %}
        ">
          {%- for block in section.blocks -%}
            <li
              class="
                {% if use_splide %}splide__slide{% if layout_mobile == 'carousel' %} {{ mobile_slide_width }}{% endif %}{% endif %}
                {% if layout_desktop == 'grid' %}lg:w-auto{% endif %}
              "
              {{ block.shopify_attributes }}
            >
              {%- liquid
                if settings.product_tiles_scatter
                  if use_splide
                    capture class
                      cycle '-mt-4 ', 'mt-4 '
                    endcapture
                    capture scatter_position
                      cycle 'up', 'down'
                    endcapture
                  else
                    capture class
                      case section.settings.tiles_per_row_mobile
                        when '2'
                          cycle 'max-lg:-mt-4 ', 'max-lg:mt-4 '
                      endcase
                      case section.settings.tiles_per_row_desktop
                        when 3
                          cycle 'lg:mt-4 ', 'lg:-mt-4 ', 'lg:mt-4 '
                        when 2, 4
                          cycle 'lg:-mt-4 ', 'lg:mt-4 '
                        when 5
                          cycle 'lg:mt-4 ', 'lg:-mt-4 ', 'lg:mt-4 ', 'lg:-mt-4 ', 'lg:mt-4 '
                      endcase
                    endcapture
                  endif
                endif

                capture odd_even
                  cycle 'odd', 'even'
                endcapture

                assign tile_shape = image_shape
                if block.settings.image_shape_override != blank
                  assign tile_shape = block.settings.image_shape_override
                endif

                assign shape_id = section.id | append: '-' | append: forloop.index0

                if forloop.index <= eager_loading_limit
                  assign loading = 'eager'
                else
                  assign loading = 'lazy'
                endif

                if forloop.first
                  assign preload = true
                else
                  assign preload = false
                endif
              -%}

              {%- render 'info-tile',
                block: block,
                crop: section.settings.tiles_aspect_ratio,
                shape: image_shape,
                shape_override: block.settings.image_shape_override,
                shape_id: shape_id,
                display_on_card: section.settings.display_on_card,
                class: class,
                odd_even: odd_even,
                index: forloop.index0,
                tiles_per_row_mobile: section.settings.tiles_per_row_mobile,
                scatter_position: scatter_position,
                loading: loading,
                preload: preload,
                sizes: sizes,
                will_transform: will_transform
              -%}
            </li>
          {%- else -%}
            {%- comment -%} Placeholder when no blocks added {%- endcomment -%}
            {% for i in (1..3) %}
              <li class="
                {% if use_splide %}splide__slide{% if layout_mobile == 'carousel' %} {{ mobile_slide_width }}{% endif %}{% endif %}
                {% if layout_desktop == 'grid' %}lg:w-auto{% endif %}
              ">
                {%- liquid
                  if settings.product_tiles_scatter
                    if use_splide
                      capture class
                        cycle '-translate-y-4 ', 'translate-y-4 '
                      endcapture
                    else
                      capture class
                        case section.settings.tiles_per_row_mobile
                          when '2'
                            cycle 'max-lg:-translate-y-4 ', 'max-lg:translate-y-4 '
                        endcase
                        case section.settings.tiles_per_row_desktop
                          when 3
                            cycle 'lg:translate-y-4 ', 'lg:-translate-y-4 ', 'lg:translate-y-4 '
                          when 2, 4
                            cycle 'lg:-translate-y-4 ', 'lg:translate-y-4 '
                          when 5
                            cycle 'lg:translate-y-4 ', 'lg:-translate-y-4 ', 'lg:translate-y-4 ', 'lg:-translate-y-4 ', 'lg:translate-y-4 '
                        endcase
                      endcapture
                    endif
                  endif
                  capture odd_even
                    cycle 'odd', 'even'
                  endcapture
                  assign tile_shape = image_shape
                  if block.settings.image_shape_override != blank
                    assign tile_shape = block.settings.image_shape_override
                  endif

                  assign shape_id = section.id | append: '-' | append: forloop.index0
                -%}
                {%- render 'info-tile',
                  block: blank,
                  crop: section.settings.tiles_aspect_ratio,
                  shape: image_shape,
                  shape_id: shape_id,
                  display_on_card: section.settings.display_on_card,
                  class: class,
                  odd_even: odd_even,
                  index: forloop.index0,
                  will_transform: will_transform
                -%}
              </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- if use_splide -%}
        <div class="splide__arrows mt-5 items-center justify-center px-section
          {% if layout_mobile == 'grid' %}hidden{% else %}flex{% endif %}
          {% if layout_desktop == 'grid' %}lg:hidden{% else %}lg:flex{% endif %}
        ">
          {%- render 'splide-navigation' %}
        </div>
        <script class="slideshow-options" type="application/json">
          {
            "mediaQuery": "min",
            "destroy": {{ splide_destroy_mobile }},
            "arrows": true,
            "pagination": false,
            "rewind": true,
            "autoWidth": true,
            "gap": "1.25rem",
            "focus": {{ section.settings.slideshow_focus | json }},
            "type": "loop",
            "autoScroll": {
              "autoStart": {{ section.settings.autoscroll_enabled | json }},
              "speed": {% if section.settings.autoscroll_enabled %}{{ section.settings.autoscroll_direction | plus: 0 | json }}{% else %}0{% endif %}
            },
            "padding": {
              "left": "1.25rem",
              "right": "1.25rem"
            },
            "breakpoints": {
              "990": {
                "destroy": {{ splide_destroy_desktop }},
                "gap": "2.5rem",
                "padding": {
                  "left": "2.5rem",
                  "right": "2.5rem"
                }
              }
            }
          }
        </script>
        <style>
          {%- if layout_desktop == 'carousel' -%}
            @media (min-width: 990px) {
              #slideshow-{{ section.id }} .splide__slide {
                width: {{ section.settings.desktop_slide_width }}%;
              }
            }
          {%- endif -%}

          /* !important overrides Splide's own bundled CSS (.splide__list /
             .splide__slide in base.bundle.css), which otherwise wins the
             cascade over the plain lg:grid / lg:w-auto utility classes on
             these same elements regardless of source order once Splide's
             "is-initialized" state classes are involved. */
          {%- if layout_mobile == 'grid' -%}
            @media (max-width: 989px) {
              #slideshow-{{ section.id }} .splide__list {
                display: grid !important;
                grid-template-columns: repeat({% if mobile_grid_cols == '2' %}2{% else %}1{% endif %}, minmax(0, 1fr));
              }
              #slideshow-{{ section.id }} .splide__slide {
                width: auto !important;
              }
            }
          {%- endif -%}
          {%- if layout_desktop == 'grid' -%}
            @media (min-width: 990px) {
              #slideshow-{{ section.id }} .splide__list {
                display: grid !important;
                grid-template-columns: repeat({{ section.settings.tiles_per_row_desktop }}, minmax(0, 1fr));
              }
              #slideshow-{{ section.id }} .splide__slide {
                width: auto !important;
              }
            }
          {%- endif -%}
        </style>
      {%- endif -%}
    </div>
  </div>

  <style>
    /* Vertical rhythm per Kaadu Typography & Spacing Docs — mobile first,
       desktop overrides at 769px. All values from the --space-* scale. */
    .info-tiles__eyebrow {
      margin: 0 0 var(--space-4); /* overline → headline: 16px */
    }
    .info-tiles__heading {
      margin: 0;
    }
    .info-tiles__subheading {
      margin-top: var(--space-4); /* headline → subheading: 16px */
    }
    .info-tiles__content {
      margin-top: var(--space-6); /* header → tiles: 24px mobile */
    }

    @media (min-width: 769px) {
      .info-tiles__content {
        margin-top: var(--space-12); /* header → tiles: 48px desktop */
      }
    }
  </style>

  {%- liquid
    for block in section.blocks
      case block.type
        when 'background_shape'
          render 'block-background-shape', block: block
        when 'background_pattern'
          render 'block-background-pattern', block: block, scheme: section.settings.color_scheme
      endcase
    endfor
  -%}
</section>

{%- liquid
  assign stickers = section.blocks | where: 'type', 'sticker'
  assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
  for sticker in stickers
    render 'block-sticker', block: sticker
  endfor
  for shape_divider in shape_dividers
    render 'block-shape-divider', block: shape_divider
  endfor
-%}

{% schema %}
{
  "name": "Custom Info Tiles",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Short overline above the heading (H3 — Subheading style)"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Custom Info Tiles"
    },
    {
      "id": "subheading",
      "type": "text",
      "label": "Subheading",
      "default": "Share information using custom tiles"
    },
    {
      "type": "checkbox",
      "id": "display_on_card",
      "label": "Display tiles on card background",
      "default": true
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Layout (mobile)",
      "default": "carousel",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Layout (desktop)",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ]
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "paragraph",
      "content": "These settings only apply on breakpoints where Layout is set to Grid"
    },
    {
      "type": "select",
      "id": "tiles_per_row_mobile",
      "label": "Tiles per row (mobile)",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "tiles_per_row_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Tiles per row (desktop)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "paragraph",
      "content": "These settings only apply on breakpoints where Layout is set to Carousel"
    },
    {
      "type": "select",
      "id": "slideshow_focus",
      "label": "Slide focus",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_slide_width",
      "label": "Mobile slide width",
      "options": [
        {
          "value": "three_fifths",
          "label": "3/5 width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "three_fifths"
    },
    {
      "type": "range",
      "id": "desktop_slide_width",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Desktop slide width",
      "default": 40
