    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "paragraph",
      "content": "Only for screen sizes where the layout is «Carousel»."
    },
    {
      "type": "select",
      "id": "slideshow_focus",
      "label": "Slide focus",
      "default": "center",
