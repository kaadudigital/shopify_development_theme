    {
      "type": "checkbox",
      "id": "autoscroll_enabled",
      "label": "Auto-scroll",
      "default": false,
      "info": "Automatically scrolls the carousel on whichever breakpoints use the Carousel layout. Visitors can still swipe/drag to scroll manually."
    },
    {
      "type": "select",
      "id": "autoscroll_direction",
      "label": "Auto-scroll direction",
      "options": [
        {
          "value": "1",
          "label": "Right to left"
        },
        {
          "value": "-1",
          "label": "Left to right"
        }
      ],
