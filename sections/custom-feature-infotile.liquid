  "name": "Custom Info Tiles",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Short overline above the heading (H3 — Subheading style)"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Custom Info Tiles"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Share information using custom tiles"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Layout (mobile)",
      "default": "carousel",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Layout (desktop)",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "display_on_card",
      "label": "Tiles on a card background",
      "default": true
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "paragraph",
      "content": "Only for screen sizes where the layout is «Grid»."
    },
    {
      "type": "select",
      "id": "tiles_per_row_mobile",
      "label": "Tiles per row (mobile)",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "tiles_per_row_desktop",
      "label": "Tiles per row (desktop)",
      "default": 3,
      "min": 2,
      "max": 5,
      "step": 1
