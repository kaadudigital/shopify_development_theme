{% comment %}theme-check-disable MissingTemplate{% endcomment %}
{%- liquid
  if display_on_card
    assign desktop_sizes_base = 'calc(100vw - 5rem)'
    assign mobile_sizes_base = 'calc(100vw - 2.5rem)'
  else
    assign desktop_sizes_base = '100vw'
    assign mobile_sizes_base = '100vw'
  endif

  case image_size
    when 'third'
      assign text_width_desktop = 'lg:col-span-8'
      assign desktop_sizes = 'calc(' | append: desktop_sizes_base | append: ' / 3)'

      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-9 lg:col-end-13 '
      else
        assign image_width_desktop = 'lg:col-span-4'
      endif
    when 'three_fifths'
      assign text_width_desktop = 'lg:col-span-5'
      assign desktop_sizes = 'calc((' | append: desktop_sizes_base | append: ' / 12) * 7)'

      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-6 lg:col-end-13'
      else
        assign image_width_desktop = 'lg:col-span-7'
      endif
    when 'two_thirds'
      assign text_width_desktop = 'lg:col-span-4'
      assign desktop_sizes = 'calc((' | append: desktop_sizes_base | append: ' / 12) * 8)'

      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-5 lg:col-end-13'
      else
        assign image_width_desktop = 'lg:col-span-8'
      endif
  endcase

  assign mobile_sizes = mobile_sizes_base

  assign sizes = '(min-width: 990px) ' | append: desktop_sizes | append: ', ' | append: mobile_sizes

  unless loading
    assign loading = 'lazy'

    if section.index <= 3
      assign loading = 'eager'
    endif
  endunless

  unless preload
    assign preload = false
  endunless

  assign shape_button_source_mobile = button2_image_mobile | default: button2_image

  # Resolve mobile button labels — fall back to the desktop label when blank
  if button_label_mobile != blank
    assign button_label_mobile_display = button_label_mobile
  else
    assign button_label_mobile_display = button_label
  endif
  if button2_label_mobile != blank
    assign button2_label_mobile_display = button2_label_mobile
  else
    assign button2_label_mobile_display = button2_label
  endif

  # Handle text alignment for mobile vs desktop
  if mobile_text_alignment != blank
    assign mobile_text_class = mobile_text_alignment
  else
    assign mobile_text_class = text_alignment
  endif

  # Combine desktop and mobile text alignment classes
  assign combined_text_alignment = mobile_text_class | append: ' sm:' | append: text_alignment | append: ' lg:' | append: text_alignment | append: ' xl:' | append: text_alignment | append: ' 2xl:' | append: text_alignment
  # Handle mobile layout order
  if mobile_layout_order
    assign mobile_heading_order = 'order-1'
    assign mobile_image_order = 'order-2'
    assign mobile_text_order = 'order-3'
    assign mobile_button_order = 'order-4'
  else
    assign mobile_heading_order = ''
    assign mobile_image_order = ''
    assign mobile_text_order = ''
    assign mobile_button_order = ''
  endif
-%}

{%- render 'shape-defs', shape: image_shape, shape_id: section_id, index: index, blob_type: blob_type -%}

<div class="relative z-10 mx-auto max-w-site px-section">
  <div class="{% if display_on_card %}card{% endif %}">
    <div class="{% if display_on_card %}card__surface p-5 lg:p-8{% endif %} section-content relative z-10 mx-auto">
      <div class="grid grid-flow-row-dense grid-cols-1 gap-4 lg:gap-6 lg:grid-cols-12 {% if image_size == 'half' and image_position == 'right' %}reverse-flex-half{% elsif image_size == 'half' %}normal-flex-half{% endif %}">
        {%- comment -%} Mobile Layout when mobile_layout_order is enabled {%- endcomment -%}
        {%- if mobile_layout_order -%}
          {%- comment -%} Mobile: Heading first {%- endcomment -%}
          <div class="w-full col-span-1 lg:hidden {{ mobile_heading_order }}">
            {%- if h2_title != blank -%}
              <h3 class="image-with-text__eyebrow h3 {{ combined_text_alignment }}">{{ h2_title | escape }}</h3>
            {%- endif -%}
            {% if title != '' %}
              <h1 class="inline-heading-rte font-subheading {{ heading_size }} heading-style {{ settings.heading_drop_shadow_style }} break-words {{ combined_text_alignment }} h1 ">
                {{ title | escape | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' }}
              </h1>
            {% endif %}
          </div>

          {%- comment -%} Image column - responsive to both mobile order and desktop position {%- endcomment -%}
          <div class="kaadu-iw-image-wrap mx-auto lg:mx-0 {{ image_width_desktop }} {{ mobile_image_order }}">
            {%- if image != blank -%}
              {%- render 'media-image',
                media: image,
                shape_id: section_id,
                shape: image_shape,
                crop: crop,
                rotate: rotate_image,
                is_card: display_on_card,
                container_id: container_id,
                disable_media_style: disable_media_style,
                loading: loading,
                preload: preload,
                sizes: sizes
              -%}
            {%- else -%}
              {%- render 'media-image-placeholder',
                shape_id: section_id,
                container_id: section_id,
                shape: image_shape,
                crop: crop,
                rotate: rotate_image,
                is_card: display_on_card,
                blob_type: blob_type,
                disable_media_style: disable_media_style
              -%}
            {%- endif -%}
          </div>

          {%- comment -%} Text content column {%- endcomment -%}
          <div class="kaadu-iw-text-wrap flex items-center {{ text_width_desktop }} {% if image_size == 'half'%}min-width-on-lg-screen{% endif %}">
            <div class="w-full center-flex-column-custom">
              {%- comment -%} Desktop: Heading shown here {%- endcomment -%}
              <div class="w-full hidden lg:block">
                {%- if h2_title != blank -%}
                  <h3 class="image-with-text__eyebrow h3 {{ combined_text_alignment }}">{{ h2_title | escape }}</h3>
                {%- endif -%}
                {% if title != '' %}
                  <h1 class="inline-heading-rte font-subheading {{ heading_size }} heading-style {{ settings.heading_drop_shadow_style }} break-words {{ combined_text_alignment }} h1">
                    {{ title | escape | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' }}
                  </h1>
                {% endif %}
              </div>


              {%- comment -%} Mobile: Text content {%- endcomment -%}
              {% comment %} <div class="rte mt-5 max-w-2xl {{ combined_text_alignment }} {{ mobile_text_order }} {% if text_alignment contains 'center' %}lg:mx-auto{% elsif text_alignment contains 'right' %}lg:ml-auto{% endif %} {% if mobile_text_alignment contains 'center' %}mx-auto lg:mx-0{% elsif mobile_text_alignment contains 'right' %}ml-auto lg:ml-0{% endif %}"> {% endcomment %}
              <div class="rte w-full {{ mobile_text_order }} {{ combined_text_alignment }} lg:mt-6 mt-4 body">
                {{ richtext }}
              </div>
              <div class="mt-6 lg:mt-8 flex items-center custom-image-with-text-button-wrapper {{ mobile_button_order }} {{ combined_text_alignment }}">
                {%- if button2_link_type == 'url' and button2_link != blank and button2_label != '' -%}
                  <div>
                    <a href="{{ button2_link }}">
                      <button class="custom-shape-button">
                        <span class="custom-shape-button-text">
                          <span class="kaadu-iw-label--mobile">{{ button2_label_mobile_display }}</span><span class="kaadu-iw-label--desktop">{{ button2_label }}</span>
                        </span>
                      </button>
                    </a>
                  </div>
                {%- endif -%}
                {%- if button2_link_type == 'focus_element' and focus_element2_id != blank -%}
                  <div class="custom-btn-wrapper">
                    <button
                      onclick="console.log('Focus Element ID: {{ focus_element2_id }}'); document.getElementById('{{focus_element2_id}}')?.focus()"
                      class="inline-block custom-btn custom-shape-button"
                    >
                      <span class="custom-shape-button-text">
                        <span class="kaadu-iw-label--mobile">{{ button2_label_mobile_display }}</span><span class="kaadu-iw-label--desktop">{{ button2_label }}</span>
                      </span>
                    </button>
                  </div>
                {%- endif -%}
                {%- if button_link_type == 'url' and button_link != blank and button_label != '' -%}
                  <div>
                    <a href="{{ button_link }}" class="inline-block custom-btn">
                      <span class="push-btn__surface btn-secondary"><span class="kaadu-iw-label--mobile">{{ button_label_mobile_display }}</span><span class="kaadu-iw-label--desktop">{{ button_label }}</span></span>
                    </a>
                  </div>
                {%- endif -%}
                {%- if button_link_type == 'focus_element' and focus_element_id != blank -%}
                  <div class="custom-btn-wrapper">
                    <button
                      onclick="console.log('Focus Element ID: {{ focus_element_id }}'); document.getElementById('{{focus_element_id}}')?.focus()"
                      class="inline-block custom-btn"
                    >
                      <span class="push-btn__surface btn-secondary btn-label"><span class="kaadu-iw-label--mobile">{{ button_label_mobile_display }}</span><span class="kaadu-iw-label--desktop">{{ button_label }}</span></span>
                    </button>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>

        {%- else -%}
          {%- comment -%} Default layout when mobile_layout_order is disabled {%- endcomment -%}
          <div class="kaadu-iw-image-wrap {{ image_width_desktop }}">
            {%- if image != blank -%}
              {%- render 'media-image',
                media: image,
                shape_id: section_id,
                shape: image_shape,
                crop: crop,
                rotate: rotate_image,
                is_card: display_on_card,
                container_id: container_id,
                disable_media_style: disable_media_style,
                loading: loading,
                preload: preload,
                sizes: sizes
              -%}
            {%- else -%}
              {%- render 'media-image-placeholder',
                shape_id: section_id,
                container_id: section_id,
                shape: image_shape,
                crop: crop,
                rotate: rotate_image,
                is_card: display_on_card,
                blob_type: blob_type,
                disable_media_style: disable_media_style
              -%}
            {%- endif -%}
          </div>

          <div class="kaadu-iw-text-wrap flex items-center {{ text_width_desktop }} {% if image_size == 'half'%}min-width-on-lg-screen{% endif %} ">
            <div class="mx-auto w-full center-flex-column-custom">
              {%- if h2_title != blank -%}
                <h3 class="image-with-text__eyebrow h3 {{ combined_text_alignment }}">{{ h2_title | escape }}</h3>
              {%- endif -%}
              {% if title != '' %}
                <h1 class="inline-heading-rte font-subheading {{ heading_size }} heading-style {{ settings.heading_drop_shadow_style }} break-words {{ combined_text_alignment }} h1 ">
                  {{ title | escape | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' }}
                </h1>
              {% endif %}

              {% comment %} <div class="rte mt-5 max-w-2xl {{ combined_text_alignment }} {% if text_alignment contains 'center' %}lg:mx-auto{% elsif text_alignment contains 'right' %}lg:ml-auto{% endif %} {% if mobile_text_alignment contains 'center' %}mx-auto lg:mx-0{% elsif mobile_text_alignment contains 'right' %}ml-auto lg:ml-0{% endif %}"> {% endcomment %}
              <div class="rte w-full {{ combined_text_alignment }} lg:mt-6 mt-4 body ">
                {{ richtext }}
              </div>

              <div class="mt-6 lg:mt-8 flex items-center custom-image-with-text-button-wrapper {{ combined_text_alignment }}">
                 {%- if button2_link_type == 'url' and button2_link != blank and button2_label != '' -%}
                  <div>
                    <a href="{{ button2_link }}">
                      <button class="custom-shape-button">
                        <span class="custom-shape-button-text">
                          <span class="kaadu-iw-label--mobile">{{ button2_label_mobile_display }}</span><span class="kaadu-iw-label--desktop">{{ button2_label }}</span>
                        </span>
                      </button>
                    </a>
                  </div>
                {%- endif -%}
                {%- if button2_link_type == 'focus_element' and focus_element2_id != blank -%}
                  <div class="custom-btn-wrapper">
                    <button
                      onclick="console.log('Focus Element ID: {{ focus_element2_id }}'); document.getElementById('{{focus_element2_id}}')?.focus()"
                      class="inline-block custom-btn custom-shape-button"
                    >
                      <span class="custom-shape-button-text">
                        <span class="kaadu-iw-label--mobile">{{ button2_label_mobile_display }}</span><span class="kaadu-iw-label--desktop">{{ button2_label }}</span>
                      </span>
                    </button>
                  </div>
                {%- endif -%}
                {%- if button_link_type == 'url' and button_link != blank and button_label != '' -%}
                  <div>
                    <a href="{{ button_link }}" class="inline-block custom-btn">
                      <span class="push-btn__surface btn-secondary"><span class="kaadu-iw-label--mobile">{{ button_label_mobile_display }}</span><span class="kaadu-iw-label--desktop">{{ button_label }}</span></span>
                    </a>
                  </div>
                {%- endif -%}
                {%- if button_link_type == 'focus_element' and focus_element_id != blank -%}
                  <div class="custom-btn-wrapper">
                    <button
                      onclick="console.log('Focus Element ID: {{ focus_element_id }}'); document.getElementById('{{focus_element_id}}')?.focus()"
                      class="inline-block custom-btn"
                    >
                      <span class="push-btn__surface btn-secondary btn-label"><span class="kaadu-iw-label--mobile">{{ button_label_mobile_display }}</span><span class="kaadu-iw-label--desktop">{{ button_label }}</span></span>
                    </button>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
<style>
    .kaadu-iw-image-wrap {
      max-width: 600px;
      max-height: 660px;
    }
    @media (max-width: 768px) {
      .kaadu-iw-image-wrap {
        max-width: 100%;
        max-height: none;
      }
    }

    /* Text column mirrors the image side's cap so it can't sprawl across
       the full grid cell on wide viewports. Overridden in image_size=='half'
       below, where both columns intentionally split the row equally. */
    .kaadu-iw-text-wrap {
      max-width: 600px;
    }
    @media (max-width: 768px) {
      .kaadu-iw-text-wrap {
        max-width: 100%;
      }
    }

    .custom-image-with-text-button-wrapper {
      flex-direction: row;
      gap: var(--space-4);
    }
    @media (max-width: 490px) {
      .custom-image-with-text-button-wrapper {
        flex-direction: column;
      }
      /* Each button wrapper (plain <div> or .custom-btn-wrapper) fills the row */
      .custom-image-with-text-button-wrapper > * {
        width: 100%;
      }
      /* Primary "blob" shape button: full width, height follows the actual
         image's aspect ratio so it's never stretched or squashed */
      .custom-image-with-text-button-wrapper .custom-shape-button {
        width: 100%;
        {%- if shape_button_source_mobile != blank -%}
        aspect-ratio: {{ shape_button_source_mobile.aspect_ratio }};
        {%- endif -%}
        background-size: contain;
      }
      .custom-image-with-text-button-wrapper .custom-shape-button-text {
        padding-top: {{ section.settings.button2_padding_topbottom_mobile }}px;
        padding-bottom: {{ section.settings.button2_padding_topbottom_mobile }}px;
      }
      /* Secondary pill (.custom-btn wrapping .push-btn__surface) fills the row.
         The :not() guard avoids hitting the focus-element variant that doubles
         as .custom-shape-button. */
      .custom-image-with-text-button-wrapper .custom-btn:not(.custom-shape-button) {
        display: block;
        width: 100%;
      }
      .custom-image-with-text-button-wrapper .custom-btn:not(.custom-shape-button) .push-btn__surface {
        display: block;
        width: 100%;
        text-align: center;
      }
    }


    .center-flex-column-custom {
      display: flex;
      flex-direction: column;
      /* No align-items: center — children stretch to column width so that
         text-align on h3/h1/body lines up at the same x position. */
      align-items: stretch;
    }
    .custom-shape-button {
          background-size: contain;
          background-position: center;
          background-repeat: no-repeat;
          border: none;
          cursor: pointer;
          transition: transform 0.2s ease-out;
          position: relative;
          display: flex;
          align-items: center;
          justify-content: center;
          {%- if button2_image != blank -%}
          background-image: url('{{ button2_image | image_url: width: 800 }}');
          {%- endif -%}
    }
    {%- if button2_image_mobile != blank -%}
    @media (max-width: 490px) {
      .custom-shape-button {
        background-image: url('{{ button2_image_mobile | image_url: width: 600 }}');
      }
    }
    {%- endif -%}
  .custom-shape-button-text {
          color: {{ button_text_color_desktop | default: '#AE0000' }};
          font-family: var(--font-display);
          font-size: 20px;
          font-weight: 400;
          line-height: 24px;
          text-transform: uppercase;
          letter-spacing: 0.02em;
          padding: 0 var(--space-6);
        }
    @media (min-width: 491px) {
      .custom-shape-button-text {
        padding-top: {{ section.settings.button2_padding_topbottom }}px;
        padding-bottom: {{ section.settings.button2_padding_topbottom }}px;
      }
    }
    @media (max-width: 490px) {
      .custom-shape-button-text {
        color: {{ button_text_color_mobile | default: '#AE0000' }};
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 16px;
        line-height: 24px;
        letter-spacing: 0;
        text-align: center;
        vertical-align: middle;
      }
    }

    /* Label-content swap shares the 490px breakpoint with the button
       styling/layout rules above so all three flip together. */
    .kaadu-iw-label--mobile { display: none; }
    .kaadu-iw-label--desktop { display: inline; }
    @media (max-width: 490px) {
      .kaadu-iw-label--mobile { display: inline; }
      .kaadu-iw-label--desktop { display: none; }
    }

    @media (min-width: 1024px) {
      .normal-flex-half {
        display: flex;
        justify-content: center;
        gap: var(--space-6);
      }
      .min-width-on-lg-screen {
        min-width: 460px;
      }

      .reverse-flex-half {
        display: flex;
        justify-content: center;
        gap: var(--space-6);
        flex-direction: row-reverse;
      }
    }

    @media (min-width: 1280px) {
      .normal-flex-half,
      .reverse-flex-half {
        gap: var(--space-8);
      }
    }
</style>
