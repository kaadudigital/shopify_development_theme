{% comment %}theme-check-disable MissingTemplate{% endcomment %}
{%- comment -%}
  Kaadu DS image + text row (hero, vision, final CTA). Styles: "IMAGE WITH TEXT" in assets/base.bundle.css.

  - First section on the page (preload = true) is the hero: <h1> in .kd-display-hero, lead in .kd-lead,
    kicker in .kd-strong. Anywhere else: <h2> in .kd-display-h2, .kd-body-lg, red .kd-label kicker.
  - One cloud button + one ✶ text link (DS hero). When both buttons are set, button 2 is the cloud and
    button 1 the link; with only one button, it is the cloud. Cloud colours follow the colour scheme.
  - Optional cloud-button artwork (button2_image / button2_image_mobile, widths, label colours):
    replaces the DS cloud with brand artwork; the mobile artwork applies below 768px.
{%- endcomment -%}
{%- liquid
  unless loading
    assign loading = 'lazy'
    if preload
      assign loading = 'eager'
    endif
  endunless

  assign sizes = '(min-width: 1441px) 50vw, (min-width: 1200px) 620px, (min-width: 768px) 50vw, 100vw'

  assign is_hero = preload
  if heading_level == 'h1'
    assign is_hero = true
  elsif heading_level == 'h2'
    assign is_hero = false
  endif

  if is_hero
    assign heading_tag = 'h1'
    assign heading_class = 'kd-display-hero'
    assign kicker_class = 'kd-strong'
    assign text_class = 'kd-lead'
  else
    assign heading_tag = 'h2'
    assign heading_class = 'kd-display-h2'
    assign kicker_class = 'kd-label'
    assign text_class = 'kd-body-lg'
  endif

  assign mobile_align = mobile_text_alignment | default: text_alignment | remove: 'text-'
  assign desktop_align = text_alignment | default: 'text-left' | remove: 'text-'

  # Resolve mobile button labels — fall back to the desktop label when blank
  assign button_label_mobile_display = button_label_mobile | default: button_label
  assign button2_label_mobile_display = button2_label_mobile | default: button2_label

  # Which buttons are actually configured
  assign has_button1 = false
  if button_label != blank
    if button_link_type == 'focus_element' and focus_element_id != blank
      assign has_button1 = true
    elsif button_link_type != 'focus_element' and button_link != blank
      assign has_button1 = true
    endif
  endif
  assign has_button2 = false
  if button2_label != blank
    if button2_link_type == 'focus_element' and focus_element2_id != blank
      assign has_button2 = true
    elsif button2_link_type != 'focus_element' and button2_link != blank
      assign has_button2 = true
    endif
  endif

  # Cloud = button 2 when set, else button 1. Link = button 1 when the cloud is button 2.
  assign cloud_source = ''
  assign link_source = ''
  if has_button2
    assign cloud_source = '2'
    if has_button1
      assign link_source = '1'
    endif
  elsif has_button1
    assign cloud_source = '1'
  endif

  assign row_classes = 'kd-iw kd-section kd-iw--image-' | append: image_position | append: ' kd-iw--m-' | append: mobile_align | append: ' kd-iw--d-' | append: desktop_align
  if is_hero
    assign row_classes = row_classes | append: ' kd-iw--hero'
  endif
  if mobile_layout_order
    assign row_classes = row_classes | append: ' kd-iw--heading-first'
  endif
-%}

{%- render 'shape-defs', shape: image_shape, shape_id: section_id, index: index, blob_type: blob_type -%}

<div class="{{ row_classes }}">
  <div class="kd-wide kd-iw__grid">
    <div class="kd-iw__media">
      {%- if image != blank -%}
        {%- render 'media-image',
          media: image,
          shape_id: section_id,
          shape: image_shape,
          crop: crop,
          rotate: rotate_image,
          is_card: false,
          container_id: container_id,
          disable_media_style: disable_media_style,
          loading: loading,
          preload: preload,
          sizes: sizes
        -%}
      {%- else -%}
        {%- render 'media-image-placeholder',
          shape_id: section_id,
          container_id: section_id,
          shape: image_shape,
          crop: crop,
          rotate: rotate_image,
          is_card: false,
          blob_type: blob_type,
          disable_media_style: disable_media_style
        -%}
      {%- endif -%}
      {%- if image_caption != blank -%}
        <p class="kd-iw__caption kd-body-sm">{{ image_caption | escape }}</p>
      {%- endif -%}
    </div>

    {%- if h2_title != blank or title != blank -%}
      <div class="kd-iw__head">
        {%- if h2_title != blank -%}
          <p class="kd-iw__kicker {{ kicker_class }}">{{ h2_title }}</p>
        {%- endif -%}
        {%- if title != blank -%}
          <{{ heading_tag }} class="kd-iw__title {{ heading_class }}">
            {{- title | escape | replace: '[br]', '<br>' | replace: '[nbsp]', '&nbsp;' -}}
          </{{ heading_tag }}>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="kd-iw__body">
      {%- if richtext != blank -%}
        <div class="kd-iw__text rte {{ text_class }}">{{ richtext }}</div>
      {%- endif -%}

      {%- if cloud_source != '' -%}
        <div class="kd-iw__actions">
          {%- liquid
            if cloud_source == '2'
              assign c_type = button2_link_type
              assign c_link = button2_link
              assign c_focus = focus_element2_id
              assign c_label = button2_label
              assign c_label_m = button2_label_mobile_display
            else
              assign c_type = button_link_type
              assign c_link = button_link
              assign c_focus = focus_element_id
              assign c_label = button_label
              assign c_label_m = button_label_mobile_display
            endif
          -%}
          {%- if button2_image != blank -%}
            {%- style -%}
              #{{ section_id }} .kd-iw__actions .kd-btn--art {
                --kd-art-w: {{ button2_width_desktop | default: 200 }}px;
                --kd-art-ratio: {{ button2_image.aspect_ratio }};
                --kd-art-color: {{ button_text_color_desktop | default: '#ffffff' }};
                --kd-art-w-m: {{ button2_width_mobile | default: 150 }}px;
                --kd-art-ratio-m: {{ button2_image_mobile.aspect_ratio | default: button2_image.aspect_ratio }};
                --kd-art-color-m: {{ button_text_color_mobile | default: button_text_color_desktop | default: '#ffffff' }};
              }
            {%- endstyle -%}
          {%- endif -%}
          {%- capture c_label_html -%}
            <span class="kd-iw__label--mobile">{{ c_label_m | escape }}</span><span class="kd-iw__label--desktop">{{ c_label | escape }}</span>
          {%- endcapture -%}
          {%- if c_type == 'focus_element' -%}
            {%- capture c_attrs -%}data-kd-focus="{{ c_focus | escape }}"{%- endcapture -%}
            {%- render 'kd-button', label: c_label_html, size: 'lg', attrs: c_attrs, art: button2_image, art_mobile: button2_image_mobile -%}
          {%- else -%}
            {%- render 'kd-button', label: c_label_html, url: c_link, size: 'lg', art: button2_image, art_mobile: button2_image_mobile -%}
          {%- endif -%}

          {%- if link_source == '1' -%}
            {%- capture l_label_html -%}
              <span class="kd-iw__label--mobile">{{ button_label_mobile_display | escape }}</span><span class="kd-iw__label--desktop">{{ button_label | escape }}</span>
            {%- endcapture -%}
            {%- if button_link_type == 'focus_element' -%}
              <button type="button" class="kd-link kd-iw__link" data-kd-focus="{{ focus_element_id | escape }}">{{ l_label_html }}</button>
            {%- else -%}
              <a class="kd-link kd-iw__link" href="{{ button_link }}">{{ l_label_html }}</a>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
