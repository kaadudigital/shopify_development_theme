{%- comment -%}
  Cart lines (DS CartDrawer body): the shipping strip, one .kd-line per item (cut-out thumb, bold uppercase title,
  muted meta, outline stepper + "Entfernen", total), the Abo upsell and the discount-code form. Used by the drawer
  (snippets/drawer-cart.liquid) and the cart page (sections/cart.liquid); re-rendered through sections/cart-items.liquid
  by the Section Rendering API and morphed in by Alpine CartItems, so every Alpine hook of the stock Shapes
  snippet (data-cart-items, CartItem, CartItemQuantity, x-ref names, #cart form, the live region) is kept.
{%- endcomment -%}
<data-island
  x-data="CartItems"
  data-cart-items
  class="kd-drawer__items"
  on="idle"
>
  {%- if settings.enable_free_shipping_progress_in_cart and cart.item_count > 0 -%}
    {%- render 'kd-cart-shipping' -%}
  {%- endif -%}
  {%- if cart != empty -%}
    {%- liquid
      assign has_once_line = false
      assign abo_url = settings.kd_cart_abo_link
      for item in cart.items
        unless item.selling_plan_allocation
          assign has_once_line = true
          if abo_url == blank
            assign abo_url = item.url
          endif
          break
        endunless
      endfor
    -%}
    <div class="kd-drawer__body">
      <form
        action="{{ routes.cart_url }}"
        class="cart__contents critical-hidden"
        method="post"
        id="cart"
      >
        <ul :key="cart-items" class="kd-drawer__lines">
          {%- for item in cart.items -%}
            <li
              x-data="CartItem('{{ item.key }}')"
              class="kd-line"
              :class="{ 'kd-line--locked': locked }"
              key="CartItem-{{ forloop.index }}-{{ item.key }}"
              id="CartItem-{{ forloop.index }}-{{ item.key }}"
              data-line-item-key="{{ item.key }}"
            >
              <div class="kd-line__thumb">
                {%- if item.image != blank -%}
                  <a href="{{ item.url }}" aria-hidden="true" tabindex="-1">
                    {{
                      item
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        alt: '',
                        widths: '200, 400',
                        sizes: '96px'
                    }}
                  </a>
                {%- endif -%}
              </div>
              <div class="kd-line__main">
                <h3 class="kd-line__title">
                  <a href="{{ item.url }}">
                    {{- item.product.title -}}
                    {%- unless item.product.has_only_default_variant %} · {{ item.variant.title }}{% endunless -%}
                  </a>
                </h3>
                <div class="kd-line__meta">
                  <p>
                    {%- if item.selling_plan_allocation -%}
                      {{ item.selling_plan_allocation.selling_plan.name }}
                    {%- else -%}
                      {{ settings.kd_cart_once_label | default: 'Einmalig' }}
                    {%- endif -%}
                  </p>
                  {%- if settings.cart_vendor_enable -%}
                    <p>{{ item.vendor }}</p>
                  {%- endif -%}
                  {%- unless item.properties == empty -%}
                    {%- for p in item.properties -%}
                      {%- assign first_character_in_key = p.first | slice: 0 -%}
                      {%- unless p.last == blank or first_character_in_key == '_' -%}
                        <p>
                          {{ p.first }}:
                          {%- if p.last contains '/uploads/' -%}
                            <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                          {%- else -%}
                            {{ p.last }}
                          {%- endif -%}
                        </p>
                      {%- endunless -%}
                    {%- endfor -%}
                  {%- endunless -%}
                  {%- if item.line_level_discount_allocations != blank -%}
                    {%- for discount_allocation in item.line_level_discount_allocations -%}
                      <p>
                        {{- discount_allocation.discount_application.title -}}
                        {%- if discount_allocation.amount > 0 %} (−{{ discount_allocation.amount | money }}){% endif -%}
                      </p>
                    {%- endfor -%}
                  {%- endif -%}
                  {%- if item.unit_price_measurement -%}
                    <p>
                      {{ item.unit_price | money }} /
                      {%- if item.unit_price_measurement.reference_value != 1 -%}
                        {{ item.unit_price_measurement.reference_value }}
                      {%- endif -%}
                      {{ item.unit_price_measurement.reference_unit }}
                    </p>
                  {%- endif -%}
                </div>
                <p class="kd-line__total">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <del>
                      <span class="kd-sr">{{ 'cart.label.original_price' | t }}</span>
                      {{- item.original_line_price | money -}}
                    </del>
                    <span class="kd-sr">{{ 'cart.label.discounted_price' | t }}</span>
                    {{ item.final_line_price | money }}
                  {%- else -%}
                    {{ item.original_line_price | money }}
                  {%- endif -%}
                </p>
                <div
                  x-data="CartItemQuantity"
                  x-ref="quantityControl"
                  @remove="remove"
                  class="kd-line__controls"
                >
                  <div class="kd-stepper kd-stepper--outline" role="group" aria-label="{{ 'cart.label.quantity' | t | escape }}">
                    <svg class="kd-stepper__cloud" aria-hidden="true" focusable="false"><use href="#kd-cloud"></use></svg>
                    <button
                      type="button"
                      aria-label="{{ settings.kd_cart_qty_less | default: 'Weniger' | escape }}"
                      @click.prevent.stop="decrement"
                    >−</button>
                    <label class="kd-sr" for="updates_{{ item.key }}">{{ 'cart.label.quantity' | t }}</label>
                    <input
                      type="number"
                      name="updates[]"
                      id="updates_{{ item.key }}"
                      value="{{ item.quantity }}"
                      data-variant-id="{{ item.variant_id }}"
                      data-last-value="{{ item.quantity }}"
                      class="kd-stepper__value"
                      size="2"
                      min="1"
                      step="1"
                      x-ref="quantityInput"
                      x-model.number.fill="quantity"
                      @change="itemQuantityChange()"
                      @keyup.debounce.750ms="$dispatch('change')"
                      autocomplete="off"
                    >
                    <button
                      type="button"
                      aria-label="{{ settings.kd_cart_qty_more | default: 'Mehr' | escape }}"
                      @click.prevent.stop="increment"
                    >+</button>
                  </div>
                  <a class="kd-line__remove" href="{{ item.url_to_remove }}" @click.prevent="remove">
                    <span class="kd-sr">{{ 'cart.label.remove' | t: product: item.title }}</span>
                    <span aria-hidden="true">{{ 'cart.general.remove' | t }}</span>
                  </a>
                </div>
                <p
                  class="kd-error kd-line__error"
                  id="Line-item-error-{{ item.key }}"
                  role="alert"
                  data-item-title="{{ item.title | escape }}"
                  style="display: none;"
                  x-show="errorMessage"
                  x-text="errorMessage"
                ></p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </form>

      {%- if settings.kd_cart_abo_enable and has_once_line -%}
        <div class="kd-drawer__abo">
          <div class="kd-drawer__abo-body">
            {%- if settings.kd_cart_abo_title != blank -%}
              <p class="kd-drawer__abo-title">{{ settings.kd_cart_abo_title }}</p>
            {%- endif -%}
            {%- if settings.kd_cart_abo_text != blank -%}
              <p class="kd-drawer__abo-text">{{ settings.kd_cart_abo_text }}</p>
            {%- endif -%}
          </div>
          {%- if settings.kd_cart_abo_link_label != blank -%}
            <a class="kd-drawer__abo-link" href="{{ abo_url }}">{{ settings.kd_cart_abo_link_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if settings.kd_cart_code_enable -%}
        {%- liquid
          assign applied_codes = ''
          assign has_invalid_code = false
          for discount_code in cart.discount_codes
            if discount_code.applicable
              assign applied_codes = applied_codes | append: discount_code.code | append: ','
            else
              assign has_invalid_code = true
            endif
          endfor
        -%}
        <form
          class="kd-drawer__code"
          action="{{ routes.cart_url }}"
          method="post"
          data-kd-discount
          data-codes="{{ applied_codes | escape }}"
          data-error="{{ settings.kd_cart_code_error | default: 'Dieser Code ist nicht gültig.' | escape }}"
        >
          <label class="kd-drawer__code-label" for="kd-cart-code">
            {{- settings.kd_cart_code_label | default: 'Gutschein- oder Rabattcode' -}}
          </label>
          <div class="kd-drawer__code-row">
            <input
              class="kd-drawer__input"
              id="kd-cart-code"
              type="text"
              name="discount"
              placeholder="{{ settings.kd_cart_code_placeholder | default: 'Code eingeben' | escape }}"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
            >
            {%- assign code_button_label = settings.kd_cart_code_button | default: 'Einlösen' -%}
            {%- render 'kd-button', label: code_button_label, type: 'submit', size: 'md' -%}
          </div>
          {%- if cart.discount_codes.size > 0 -%}
            <ul class="kd-drawer__codes">
              {%- for discount_code in cart.discount_codes -%}
                <li>
                  <button
                    type="button"
                    class="kd-drawer__code-tag{% unless discount_code.applicable %} kd-drawer__code-tag--invalid{% endunless %}"
                    data-kd-discount-remove="{{ discount_code.code | escape }}"
                    aria-label="{{ settings.kd_cart_code_remove | default: 'Code entfernen' | escape }}: {{ discount_code.code | escape }}"
                  >
                    {{ discount_code.code }} <span aria-hidden="true">✕</span>
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <p class="kd-error kd-drawer__code-error" data-kd-discount-error role="alert" {% unless has_invalid_code %}hidden{% endunless %}>
            {{- settings.kd_cart_code_error | default: 'Dieser Code ist nicht gültig.' -}}
          </p>
        </form>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="kd-drawer__empty">
      <p>{{ settings.kd_cart_empty_text | default: 'Dein Warenkorb ist leer.' }}</p>
      {%- if settings.kd_cart_empty_button_label != blank -%}
        {%- assign empty_url = settings.kd_cart_empty_button_link | default: routes.all_products_collection_url -%}
        {%- render 'kd-button', label: settings.kd_cart_empty_button_label, url: empty_url, size: 'md' -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</data-island>
<p
  class="kd-sr"
  id="cart-live-region-text"
  aria-live="polite"
  role="status"
  aria-hidden="true"
>
  {{ 'cart.general.new_subtotal' | t }}:
  {{ cart.total_price | money_with_currency }}
</p>
