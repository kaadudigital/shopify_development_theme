{%- comment -%}
  Cart foot (DS CartDrawer): subtotal, cart-level discounts and shipping rows, the red long-cloud checkout button
  carrying the total, and the note. Used by the drawer and the cart page; re-rendered through
  sections/cart-footer.liquid and morphed in by Alpine CartFooter (data-cart-footer, #cart-errors and the
  additional-checkout-buttons wrapper are the hooks it relies on).
{%- endcomment -%}
<data-island
  x-data="CartFooter"
  data-cart-footer
  class="kd-drawer__foot"
  on="idle"
>
  {%- if cart != empty -%}
    <dl class="kd-drawer__rows">
      <div class="kd-drawer__row">
        <dt>{{ 'cart.general.subtotal' | t }}</dt>
        <dd>{{ cart.items_subtotal_price | money }}</dd>
      </div>
      {%- for discount_application in cart.cart_level_discount_applications -%}
        <div class="kd-drawer__row kd-drawer__row--discount">
          <dt>
            <span class="kd-sr">{{ 'customer.order.discount' | t }}:</span>
            {{- discount_application.title -}}
          </dt>
          <dd>−{{ discount_application.total_allocated_amount | money }}</dd>
        </div>
      {%- endfor -%}
      <div class="kd-drawer__row">
        <dt>{{ settings.kd_cart_shipping_label | default: 'Versand' }}</dt>
        <dd>{%- render 'kd-cart-shipping', mode: 'value' -%}</dd>
      </div>
    </dl>

    <input
      class="no-js kd-drawer__update"
      type="submit"
      name="update"
      value="{{ 'cart.general.update' | t }}"
      form="cart"
    >
    {%- capture checkout_label -%}
      {{ settings.kd_cart_checkout_label | default: 'Zur Kasse' }} · {{ cart.total_price | money }}
    {%- endcapture -%}
    {%- render 'kd-button',
      label: checkout_label,
      type: 'submit',
      size: 'lg',
      full: true,
      cloud: 'long',
      class: 'kd-drawer__checkout',
      attrs: 'name="checkout" form="cart"'
    -%}

    {%- if additional_checkout_buttons and template == 'cart' and settings.enable_accelerated_checkout -%}
      <div class="kd-drawer__dynamic cart__dynamic-checkout-buttons additional-checkout-buttons">
        {{ content_for_additional_checkout_buttons }}
      </div>
    {%- endif -%}

    {%- if settings.kd_cart_note != blank -%}
      <p class="kd-drawer__note">{{ settings.kd_cart_note }}</p>
    {%- endif -%}
    <div class="kd-error kd-drawer__errors" id="cart-errors" role="alert"></div>
  {%- endif -%}
</data-island>
