{%- liquid
  if display_on_card
    assign desktop_sizes_base = 'calc(100vw - 5rem)'
    assign mobile_sizes_base = 'calc(100vw - 2.5rem)'
  else
    assign desktop_sizes_base = '100vw'
    assign mobile_sizes_base = '100vw'
  endif

  case image_size
    when 'third'
      assign text_width_desktop = 'lg:col-span-8'
      assign desktop_sizes = 'calc(' | append: desktop_sizes_base | append: ' / 3)'

      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-9 lg:col-end-13'
      else
        assign image_width_desktop = 'lg:col-span-4'
      endif
    when 'half'
      assign text_width_desktop = 'lg:col-span-6'
      assign desktop_sizes = 'calc(' | append: desktop_sizes_base | append: ' / 2)'

      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-7 lg:col-end-13'
      else
        assign image_width_desktop = 'lg:col-span-6'
      endif
    when 'three_fifths'
      assign text_width_desktop = 'lg:col-span-5'
      assign desktop_sizes = 'calc((' | append: desktop_sizes_base | append: ' / 12) * 7)'

      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-6 lg:col-end-13'
      else
        assign image_width_desktop = 'lg:col-span-7'
      endif
    when 'two_thirds'
      assign text_width_desktop = 'lg:col-span-4'
      assign desktop_sizes = 'calc((' | append: desktop_sizes_base | append: ' / 12) * 8)'

      if image_position == 'right'
        assign image_width_desktop = 'lg:col-start-5 lg:col-end-13'
      else
        assign image_width_desktop = 'lg:col-span-8'
      endif
  endcase

  assign mobile_sizes = mobile_sizes_base

  assign sizes = '(min-width: 990px) ' | append: desktop_sizes | append: ', ' | append: mobile_sizes

  unless loading
    assign loading = 'lazy'

    if section.index <= 3
      assign loading = 'eager'
    endif
  endunless

  unless preload
    assign preload = false
  endunless

  # Build responsive alignment classes
  # mobile class is used as-is, desktop class gets lg: prefix
  assign desktop_text_alignment = text_alignment | replace: 'text-', 'lg:text-'

  # Eyebrow + heading align independently of the body text alignment
  if heading_alignment == blank
    assign heading_alignment = text_alignment
  endif
  if heading_alignment_mobile == blank
    assign heading_alignment_mobile = text_alignment_mobile
  endif
  assign desktop_heading_alignment = heading_alignment | replace: 'text-', 'lg:text-'

  # mx-auto / ml-auto logic for mobile
  if text_alignment_mobile contains 'center'
    assign mobile_mx = 'mx-auto'
  elsif text_alignment_mobile contains 'right'
    assign mobile_mx = 'ml-auto'
  else
    assign mobile_mx = ''
  endif

  # mx-auto / ml-auto logic for desktop
  if text_alignment contains 'center'
    assign desktop_mx = 'lg:mx-auto'
  elsif text_alignment contains 'right'
    assign desktop_mx = 'lg:ml-auto'
  else
    assign desktop_mx = ''
  endif
-%}

{%- render 'shape-defs', shape: image_shape, shape_id: section_id, index: index, blob_type: blob_type -%}

<div class="kaadu-iht__container relative z-10 mx-auto max-w-site px-section">
  <div class="flex flex-col items-center {% if display_on_card %}card{% endif %}">
    {%- if eyebrow != blank or title != '' or subheading != '' -%}
      <div class="kaadu-iht__header w-full">
        {%- if eyebrow != blank -%}
          <h3 class="kaadu-iht__eyebrow h3 break-words {{ heading_alignment_mobile }} {{ desktop_heading_alignment }}">
            {{ eyebrow | escape }}
          </h3>
        {%- endif -%}
        {%- if title != '' -%}
          {%- if heading_level == 'h1' -%}
            <h1 class="kaadu-iht__heading inline-heading-rte h1 heading-style {{ settings.heading_drop_shadow_style }} break-words {{ heading_alignment_mobile }} {{ desktop_heading_alignment }}">
              {{ title }}
            </h1>
          {%- else -%}
            <h2 class="kaadu-iht__heading inline-heading-rte h2 heading-style {{ settings.heading_drop_shadow_style }} break-words {{ heading_alignment_mobile }} {{ desktop_heading_alignment }}">
              {{ title }}
            </h2>
          {%- endif -%}
        {%- endif -%}
        {%- if subheading != '' -%}
          <div class="kaadu-iht__subheading rte h3 break-words {{ text_alignment_mobile }} {{ desktop_text_alignment }}">
            {{ subheading }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="{% if display_on_card %}card__surface p-5 lg:p-10{% endif %} kaadu-iht__content section-content relative z-10 mx-auto w-full">
      <div class="kaadu-iht__grid grid grid-flow-row-dense grid-cols-1 lg:grid-cols-12">
        <div class="{{ image_width_desktop }}">
          {%- if image != blank -%}
            {%- render 'media-image',
              media: image,
              shape_id: section_id,
              shape: image_shape,
              crop: crop,
              rotate: rotate_image,
              is_card: display_on_card,
              container_id: container_id,
              disable_media_style: disable_media_style,
              loading: loading,
              preload: preload,
              sizes: sizes
            -%}
          {%- else -%}
            {%- render 'media-image-placeholder',
              shape_id: section_id,
              container_id: section_id,
              shape: image_shape,
              crop: crop,
              rotate: rotate_image,
              is_card: display_on_card,
              blob_type: blob_type,
              disable_media_style: disable_media_style
            -%}
          {%- endif -%}
          {%- if image_caption != blank -%}
            <p class="kaadu-iht__image-caption caption">{{ image_caption | escape }}</p>
          {%- endif -%}
        </div>
        <div class="flex items-center {{ text_width_desktop }}">
          <div class="{{ text_alignment_mobile }} {{ desktop_text_alignment }} w-full">
            {%- if richtext != '' -%}
              <div class="kaadu-iht__body rte body max-w-2xl {{ mobile_mx }} {{ desktop_mx }}">
                {{ richtext }}
              </div>
            {%- endif -%}

            {%- if button_link != blank and button_label != '' -%}
              <div class="kaadu-iht__cta">
                <a href="{{ button_link }}" class="custom-btn inline-block">
                  <span class="push-btn__surface btn-secondary">{{ button_label }}</span>
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    {%- if conclusion_heading != '' -%}
      <div class="kaadu-iht__conclusion rte h3 break-words w-full {{ text_alignment_mobile }} {{ desktop_text_alignment }}">
        {{ conclusion_heading }}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  /* Content never grows past the design-system container (1200px) —
     on wider viewports the section background stays full-bleed while
     the grid centres and whitespace absorbs the extra width. */
  .kaadu-iht__container {
    max-width: var(--container-max);
  }

  /* Vertical rhythm per Kaadu Typography & Spacing Docs — mobile first,
     desktop overrides at 769px. All values from the --space-* scale. */
  .kaadu-iht__eyebrow {
    margin: 0 0 var(--space-4); /* overline → headline: 16px */
  }
  .kaadu-iht__heading {
    margin: 0;
  }
  .kaadu-iht__subheading {
    margin-top: var(--space-4); /* headline → subheading: 16px */
  }
  .kaadu-iht__content {
    margin-top: var(--space-6); /* section headline → content: 48px desktop, half on mobile */
  }
  .kaadu-iht__grid {
    gap: var(--space-4); /* grid gutter: 16px mobile */
  }
  .kaadu-iht__image-caption {
    margin-top: var(--space-2);
  }
  .kaadu-iht__cta {
    margin-top: var(--space-8); /* body → CTA group: 32px */
  }
  .kaadu-iht__conclusion {
    margin-top: var(--space-6);
  }

  @media (min-width: 769px) {
    .kaadu-iht__content {
      margin-top: var(--space-12);
    }
    .kaadu-iht__grid {
      gap: var(--space-6); /* grid gutter: 24px desktop */
    }
    .kaadu-iht__conclusion {
      margin-top: var(--space-12);
    }
  }
</style>
