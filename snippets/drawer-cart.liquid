{%- comment -%}
  Cart drawer (DS CartDrawer; mockup "Cart (Drawer)" / "Cart Mobile"). Rendered by layout/theme.liquid when the
  cart type is "modal" and teleported into the Shapes right-drawer shell (snippets/right-drawer.liquid), which
  supplies the scrim, the slide-in, focus trap and Escape. Alpine hooks (ModalCart, CartItems, CartFooter) are
  the stock Shapes ones; the look is the Kaadu design system (assets/base.bundle.css, CART DRAWER block).
  Copy and colours: Theme settings › Cart › Kaadu cart drawer.
{%- endcomment -%}
<data-island
  x-data="ModalCart({openOnAddToCart: {{ settings.open_modal_on_add_to_cart }}})"
  x-cloak
  x-init="initTeleport($root);"
  on="idle"
>
  <div>
    <template data-should-teleport="#right-drawer-slot">
      <div
        x-show="$store.modals.rightDrawer.contents === 'cart'"
        class="kd-drawer"
        :data-modal-label="$store.modals.rightDrawer.contents === 'cart'? '{{ settings.kd_cart_title | default: 'Dein Warenkorb' | escape }}' : false"
        data-cart-drawer
      >
        {%- render 'kd-cart-vars' -%}
        <div class="kd-drawer__edge" aria-hidden="true"></div>
        <div class="kd-drawer__head">
          <h2 class="kd-drawer__title" tabindex="-1">
            {{ settings.kd_cart_title | default: 'Dein Warenkorb' }}
            <span class="kd-sr">
              -
              <span x-text="$store.cart_count.countWithText"></span>
            </span>
          </h2>
          <button
            type="button"
            class="kd-btn-round"
            @click.prevent="$store.modals.close('cart')"
            aria-label="{{ 'general.accessibility.close_modal' | t | escape }}"
          >
            <span aria-hidden="true">✕</span>
          </button>
        </div>
        {% render 'cart-items' %}
        {% render 'cart-footer' %}
      </div>
    </template>
  </div>
</data-island>
